#!/usr/bin/env python3
"""Read-only quality assessment for one agent run.

Prints a JSON report. Does not write the task database, dispatch an agent,
or publish an experience rule.
"""

import argparse
import json
import sys
from pathlib import Path


HERDR_ROOT = Path(__file__).resolve().parent.parent
if str(HERDR_ROOT) not in sys.path:
    sys.path.insert(0, str(HERDR_ROOT))

from herdr.quality_assessment import assess_task_run


def main() -> int:
    parser = argparse.ArgumentParser(description="只读评估一次 Agent 执行的质量")
    sub = parser.add_subparsers(dest="command", required=True)
    assess = sub.add_parser("assess", help="评估一个 task_id + run_id，输出 JSON")
    assess.add_argument("--task-id", required=True)
    assess.add_argument("--run-id", required=True)
    assess.add_argument("--db-path", default=None, help="状态库路径；默认使用 HAFlow 状态库")
    args = parser.parse_args()
    db_path = Path(args.db_path) if args.db_path else None
    report = assess_task_run(args.task_id, args.run_id, db_path=db_path)
    json.dump(report, sys.stdout, ensure_ascii=False, indent=2, sort_keys=True)
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
