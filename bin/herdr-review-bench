#!/usr/bin/env python3
"""bin/herdr-review-bench

Entry point for HAFlow code review benchmark execution, judging, and comparison.
Supports:
  bin/herdr-review-bench run --config <cfg.json> --output <dir>
  bin/herdr-review-bench compare --before <dir> --after <dir> --output <file>
"""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import time

HERDR_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(HERDR_ROOT))

from herdr.review_benchmark import (
    DEFAULT_CONTEXT_BUDGET_CHARS,
    DEFAULT_CONTEXT_MODE,
    VALID_CONTEXT_MODES,
    compare_benchmarks,
    extract_and_validate_metrics,
    generate_chinese_report,
    prepare_isolated_workspace,
    pr_key,
    resolve_agent_identity,
    review_diff,
    review_pr,
    run_agent_review,
    validate_candidate_output,
    validate_context_config,
    validate_manifest,
)


def load_benchmark_config(config_path: Path) -> dict:
    """Load benchmark configuration supporting JSON and YAML formats."""
    text = config_path.read_text(encoding="utf-8")
    if config_path.suffix.lower() in (".yaml", ".yml"):
        import yaml
        config = yaml.safe_load(text)
    else:
        try:
            config = json.loads(text)
        except Exception:
            import yaml
            config = yaml.safe_load(text)
    if not isinstance(config, dict):
        raise ValueError(f"Configuration file must be a dictionary, got {type(config).__name__}")
    return config


REVIEWBENCH_LOCKED_SHA = "e1cb1a0dad8105ebea45caa00c194eaf2d2e7b5d"


def find_or_setup_reviewbench(
    target_cache_dir: Optional[Path] = None,
    target_sha: str = REVIEWBENCH_LOCKED_SHA,
) -> Tuple[Path, str]:
    """Find local or cache ReviewBench repository and ensure it is checked out at target SHA

    with strictly reproducible dependencies locked via `npm ci`.
    Sequence:
    1. Clone if missing
    2. Checkout target_sha strictly
    3. Verify HEAD == target_sha
    4. Run `npm ci` so dependencies match the locked revision
    Returns (cache_dir, verified_actual_sha).
    """
    cache_dir = target_cache_dir or Path(os.path.expanduser("~/.cache/review-bench-src"))
    if not cache_dir.exists() or not (cache_dir / ".git").exists():
        cache_dir.parent.mkdir(parents=True, exist_ok=True)
        print(f"Cloning ReviewBench into {cache_dir}...")
        subprocess.run(
            ["git", "clone", "https://github.com/review-bench/ReviewBench", str(cache_dir)],
            check=True,
        )

    # 1. Fetch to ensure target_sha is present locally
    subprocess.run(
        ["git", "-C", str(cache_dir), "checkout", "-f", target_sha],
        check=True,
        capture_output=True,
    )

    # 2. Verify HEAD matches target_sha
    actual_sha = subprocess.run(
        ["git", "-C", str(cache_dir), "rev-parse", "HEAD"],
        capture_output=True,
        text=True,
        check=True,
    ).stdout.strip()
    if not actual_sha.startswith(target_sha) and not target_sha.startswith(actual_sha):
        raise RuntimeError(
            f"ReviewBench repo HEAD ({actual_sha}) does not match expected target SHA ({target_sha})"
        )

    # 3. Ensure exact dependencies locked via npm ci (or npm install if no package-lock)
    node_modules = cache_dir / "node_modules"
    pkg_lock = cache_dir / "package-lock.json"
    install_cmd = ["npm", "ci"] if pkg_lock.exists() else ["npm", "install"]
    print(f"Ensuring locked dependencies via {' '.join(install_cmd)} at {actual_sha[:8]}...")
    subprocess.run(
        install_cmd,
        cwd=str(cache_dir),
        check=True,
        capture_output=True,
    )

    return cache_dir, actual_sha


def cmd_run(args: argparse.Namespace) -> int:
    config_path = Path(args.config).resolve()
    if not config_path.exists():
        print(f"Error: configuration file not found: {config_path}", file=sys.stderr)
        return 1

    try:
        config = load_benchmark_config(config_path)
    except Exception as exc:
        print(f"Error loading configuration file {config_path}: {exc}", file=sys.stderr)
        return 1

    output_dir = Path(args.output).resolve()
    candidate_dir = output_dir / "candidate"
    scoring_dir = output_dir / "scoring"
    workspaces_dir = output_dir / "workspaces"

    # Clean prior-run candidates, scoring, and temporary workspaces to prevent contamination
    if candidate_dir.exists():
        shutil.rmtree(candidate_dir)
    if scoring_dir.exists():
        shutil.rmtree(scoring_dir)
    if workspaces_dir.exists():
        shutil.rmtree(workspaces_dir)

    output_dir.mkdir(parents=True, exist_ok=True)
    candidate_dir.mkdir(parents=True, exist_ok=True)
    scoring_dir.mkdir(parents=True, exist_ok=True)

    manifest_path = Path(config.get("benchmark", {}).get("manifest", "tests/fixtures/review_benchmark/corpus/manifest.json"))
    if not manifest_path.is_absolute():
        manifest_path = (HERDR_ROOT / manifest_path).resolve()

    golden_dir = Path(config.get("benchmark", {}).get("golden_dir", "tests/fixtures/review_benchmark/golden"))
    if not golden_dir.is_absolute():
        golden_dir = (HERDR_ROOT / golden_dir).resolve()

    if not manifest_path.exists():
        print(f"Error: manifest file not found: {manifest_path}", file=sys.stderr)
        return 1

    with open(manifest_path, "r", encoding="utf-8") as f:
        manifest_entries = json.load(f)

    validate_manifest(manifest_entries)

    agent_name = config.get("agent", "agy")
    review_cfg = config.get("review", {})
    system_prompt = review_cfg.get("system_prompt")
    timeout_sec = review_cfg.get("timeout_seconds", 300)

    # 1. Context mode configuration & fail-fast validation before execution
    context_mode = review_cfg.get("context_mode", DEFAULT_CONTEXT_MODE)
    context_budget_chars = review_cfg.get("context_budget_chars", DEFAULT_CONTEXT_BUDGET_CHARS)
    try:
        validate_context_config(context_mode, context_budget_chars)
    except ValueError as ve:
        print(f"Error: Invalid review context configuration: {ve}", file=sys.stderr)
        return 1

    # 2. Agent & model identity resolution
    agent_info = resolve_agent_identity(agent_name, review_cfg)
    model_name = agent_info.get("model_name", "unknown")
    model_conf = agent_info.get("model_confirmed", False)
    cli_ver = agent_info.get("cli_version", "unknown")
    if "cli_version" not in review_cfg and cli_ver != "unknown":
        review_cfg["cli_version"] = cli_ver

    print(f"=== Starting Review Benchmark Run: {config.get('name', 'benchmark')} ===")
    print(f"Manifest PRs: {len(manifest_entries)}")
    print(f"Agent: {agent_name} (model: {model_name}, confirmed: {model_conf}, cli: {cli_ver})")
    print(f"Context mode: {context_mode} (budget: {context_budget_chars} chars)")
    if not model_conf:
        print(f"    ⚠ Notice: Reviewer model identity unconfirmed ({agent_info.get('details', {}).get('source', 'unknown')})")
    print(f"Output directory: {output_dir}")

    t_start = time.time()
    execution_summary: Dict[str, Any] = {
        "total_planned": len(manifest_entries),
        "completed": 0,
        "failed": 0,
        "fallback_count": 0,
        "failure_details": {},
        "fallback_details": {},
        "samples": [],
        "elapsed_seconds": 0.0,
        "total_review_time_ms": 0,
        "requested_context_mode": context_mode,
        "context_budget_chars": context_budget_chars,
        "effective_context_modes": {},
        "candidate_findings_map": {},
    }

    # Step 1 & 2: Review execution in isolated workspaces
    candidate_files = []
    for idx, entry in enumerate(manifest_entries):
        key = pr_key(entry["repo"], entry["pr_number"], entry["head"])
        label = f"[{idx + 1}/{len(manifest_entries)}] {key}"
        print(f"\n--> Preparing workspace for {label}")
        t_sample_start = time.time()

        ws_dir = workspaces_dir / key
        try:
            # Use current repo root as source if repo matches or clone
            source_repo = str(HERDR_ROOT)
            _, diff_content = prepare_isolated_workspace(
                repo_url_or_path=source_repo,
                base_sha=entry["base"],
                head_sha=entry["head"],
                target_dir=ws_dir,
            )

            # Ensure ReviewBench repo-dir symlink structure: <owner>__<repo>/<head[:8]> -> ../<key>
            nwo = entry.get("nwo", "allinai0506/HAFlow")
            owner_repo = nwo.replace("/", "__")
            owner_repo_dir = workspaces_dir / owner_repo
            owner_repo_dir.mkdir(parents=True, exist_ok=True)
            head_link = owner_repo_dir / entry["head"][:8]
            if not head_link.exists():
                try:
                    head_link.symlink_to(f"../{key}")
                except Exception:
                    pass

            print(f"    Invoking review Agent '{agent_name}' ({context_mode})...")
            candidate_output = run_agent_review(
                agent_name=agent_name,
                repo_dir=ws_dir,
                pr_info=entry,
                diff_content=diff_content,
                timeout_seconds=timeout_sec,
                system_prompt=system_prompt,
                context_mode=context_mode,
                context_budget_chars=context_budget_chars,
                review_cfg=review_cfg,
            )

            validate_candidate_output(candidate_output)

            candidate_file = candidate_dir / f"{key}.json"
            candidate_file.write_text(json.dumps(candidate_output, indent=2, ensure_ascii=False), encoding="utf-8")
            candidate_files.append(candidate_file)

            if "audit" in candidate_output:
                audit_dir = output_dir / "audit"
                audit_dir.mkdir(parents=True, exist_ok=True)
                audit_file = audit_dir / f"{key}.context-audit.json"
                audit_file.write_text(json.dumps(candidate_output["audit"], indent=2, ensure_ascii=False), encoding="utf-8")

            if "agent_identity" in candidate_output:
                sample_agent_id = candidate_output["agent_identity"]
                if not agent_info.get("model_confirmed") and sample_agent_id.get("model_confirmed"):
                    agent_info = sample_agent_id
                    execution_summary["agent_identity"] = agent_info
                elif agent_info.get("model_confirmed") and sample_agent_id.get("model_name") != agent_info.get("model_name"):
                    agent_info["model_confirmed"] = False
                    agent_info.setdefault("details", {})["mismatch"] = (
                        f"multiple models detected across samples: {agent_info.get('model_name')} vs {sample_agent_id.get('model_name')}"
                    )

            c_meta = candidate_output.get("context_meta", {})
            eff_mode = c_meta.get("effective_context_mode", context_mode)
            execution_summary["effective_context_modes"][eff_mode] = execution_summary["effective_context_modes"].get(eff_mode, 0) + 1
            if eff_mode != context_mode or c_meta.get("fallback_reason"):
                execution_summary["fallback_count"] += 1
                execution_summary["fallback_details"][key] = c_meta.get("fallback_reason")

            review_ms = candidate_output.get("usage", {}).get("time_in_ms")
            if review_ms is None:
                review_ms = int((time.time() - t_sample_start) * 1000)
            execution_summary["total_review_time_ms"] += review_ms

            sample_record = {
                "key": key,
                "repo": entry.get("repo"),
                "pr_number": entry.get("pr_number"),
                "base": entry.get("base"),
                "head": entry.get("head"),
                "status": "completed",
                "requested_context_mode": c_meta.get("requested_context_mode", context_mode),
                "effective_context_mode": eff_mode,
                "fallback_reason": c_meta.get("fallback_reason"),
                "prompt_chars": candidate_output.get("prompt_meta", {}).get("prompt_chars"),
                "prompt_fingerprint": candidate_output.get("prompt_meta", {}).get("prompt_fingerprint"),
                "context_chars": c_meta.get("context_chars"),
                "context_fingerprint": c_meta.get("context_fingerprint"),
                "base_diff_chars": c_meta.get("base_diff_chars"),
                "time_in_ms": review_ms,
                "tokens": candidate_output.get("usage", {}).get("tokens"),
                "findings_count": len(candidate_output.get("findings", [])),
            }
            execution_summary["samples"].append(sample_record)

            execution_summary["completed"] += 1
            execution_summary["candidate_findings_map"][key] = candidate_output.get("findings", [])
            print(f"    ✓ Review finished, findings: {len(candidate_output['findings'])}")

        except Exception as exc:
            failed_time_ms = int((time.time() - t_sample_start) * 1000)
            execution_summary["total_review_time_ms"] += failed_time_ms
            execution_summary["failed"] += 1
            execution_summary["failure_details"][key] = str(exc)
            execution_summary["samples"].append({
                "key": key,
                "repo": entry.get("repo"),
                "pr_number": entry.get("pr_number"),
                "base": entry.get("base"),
                "head": entry.get("head"),
                "status": "failed",
                "requested_context_mode": context_mode,
                "time_in_ms": failed_time_ms,
                "error": str(exc),
            })
            print(f"    ✗ Review execution FAILED: {exc}", file=sys.stderr)

    t_review_end = time.time()
    review_stage_elapsed_seconds = round(t_review_end - t_start, 2)
    execution_summary["review_stage_elapsed_seconds"] = review_stage_elapsed_seconds

    # Step 2.5: Compute aggregated usage and character summary
    total_prompt_chars = 0
    total_context_chars = 0
    samples_with_chars = 0
    token_metrics = ["input_tokens", "output_tokens", "thinking_tokens", "total_tokens"]
    token_stats = {k: {"sum": 0, "count": 0} for k in token_metrics}

    for s in execution_summary["samples"]:
        if s.get("status") == "completed":
            p_len = s.get("prompt_chars")
            c_len = s.get("context_chars")
            if isinstance(p_len, int):
                total_prompt_chars += p_len
                samples_with_chars += 1
            if isinstance(c_len, int):
                total_context_chars += c_len

            toks = s.get("tokens")
            if isinstance(toks, dict):
                inp = toks.get("input_tokens") if toks.get("input_tokens") is not None else toks.get("prompt_tokens")
                out = toks.get("output_tokens") if toks.get("output_tokens") is not None else toks.get("completion_tokens")
                thk = toks.get("thinking_tokens") if toks.get("thinking_tokens") is not None else toks.get("reasoning_tokens")
                tot = toks.get("total_tokens")

                val_map = {
                    "input_tokens": inp,
                    "output_tokens": out,
                    "thinking_tokens": thk,
                    "total_tokens": tot,
                }
                for k, v in val_map.items():
                    if isinstance(v, (int, float)):
                        token_stats[k]["sum"] += int(v)
                        token_stats[k]["count"] += 1

    completed_cnt = execution_summary["completed"]
    token_details = {}
    formatted_tokens = {}

    for k in token_metrics:
        c = token_stats[k]["count"]
        s = token_stats[k]["sum"]
        if c == 0:
            formatted_tokens[k] = "未知"
            token_details[k] = {"raw_sum": None, "count": 0, "total_samples": completed_cnt, "is_complete": False}
        elif c == completed_cnt:
            formatted_tokens[k] = s
            token_details[k] = {"raw_sum": s, "count": c, "total_samples": completed_cnt, "is_complete": True}
        else:
            formatted_tokens[k] = f"{s} (已知部分合计: {c}/{completed_cnt} 样本)"
            token_details[k] = {"raw_sum": s, "count": c, "total_samples": completed_cnt, "is_complete": False}

    usage_summary = {
        "total_review_time_ms": execution_summary["total_review_time_ms"],
        "avg_review_time_ms": round(execution_summary["total_review_time_ms"] / max(completed_cnt, 1), 2),
        "tokens_available": any(token_stats[k]["count"] > 0 for k in token_metrics),
        "input_tokens": formatted_tokens["input_tokens"],
        "output_tokens": formatted_tokens["output_tokens"],
        "thinking_tokens": formatted_tokens["thinking_tokens"],
        "total_tokens": formatted_tokens["total_tokens"],
        "token_details": token_details,
        "avg_prompt_chars": round(total_prompt_chars / max(samples_with_chars, 1), 1) if samples_with_chars > 0 else 0.0,
        "avg_context_chars": round(total_context_chars / max(samples_with_chars, 1), 1) if samples_with_chars > 0 else 0.0,
    }
    execution_summary["usage_summary"] = usage_summary
    execution_summary["agent_identity"] = agent_info

    # Step 3: Call ReviewBench official judge
    results_file = scoring_dir / "results.json"
    details_file = scoring_dir / "results.details.json"
    judge_cfg = config.get("judge", {})
    provider = judge_cfg.get("provider", "deepseek")
    model_id = judge_cfg.get("model", "deepseek-v4-flash")
    scorer_sha = judge_cfg.get("sha", REVIEWBENCH_LOCKED_SHA)

    rb_dir, actual_scorer_sha = find_or_setup_reviewbench(target_sha=scorer_sha)

    judge_cmd = [
        "npm", "run", "judge", "--",
        "--candidate", str(candidate_dir),
        "--golden", str(golden_dir),
        "--manifest", str(manifest_path),
        "--provider", provider,
        "--model", model_id,
        "--output", str(results_file),
        "--repo-dir", str(workspaces_dir),
        "--concurrency", "1",
        "--no-strict",
    ]

    print(f"\n--> Invoking official ReviewBench judge ({provider}/{model_id})...")
    judge_success = False
    t_judge_start = time.time()
    try:
        proc = subprocess.run(
            judge_cmd,
            cwd=str(rb_dir),
            capture_output=True,
            text=True,
            timeout=600,
        )
        if proc.returncode == 0:
            judge_success = True
            print("    ✓ ReviewBench judge scoring completed successfully.")
        else:
            print(f"    ⚠ ReviewBench judge exited with code {proc.returncode}")
            print(f"    Judge stderr:\n{proc.stderr[:1000]}")
    except Exception as exc:
        print(f"    ⚠ Could not invoke ReviewBench judge: {exc}")
    t_judge_end = time.time()
    judge_elapsed_seconds = round(t_judge_end - t_judge_start, 2)
    execution_summary["judge_elapsed_seconds"] = judge_elapsed_seconds
    total_e2e_elapsed_seconds = round(t_judge_end - t_start, 2)
    execution_summary["elapsed_seconds"] = total_e2e_elapsed_seconds
    execution_summary["total_e2e_elapsed_seconds"] = total_e2e_elapsed_seconds

    # Step 4: Load results and generate Chinese report
    results_raw = {}
    details_json = []
    results_parse_ok = False
    if results_file.exists():
        try:
            results_raw = json.loads(results_file.read_text(encoding="utf-8"))
            results_parse_ok = True
        except Exception:
            results_parse_ok = False
    if details_file.exists():
        try:
            details_json = json.loads(details_file.read_text(encoding="utf-8"))
        except Exception:
            pass

    # Extract & validate metrics
    extracted_metrics = extract_and_validate_metrics(results_raw) if results_parse_ok else None

    # Strict run success criteria:
    # 1. subprocess returned 0
    # 2. results file exists and is parseable
    # 3. required metrics are complete and valid
    is_run_successful = bool(judge_success and results_parse_ok and extracted_metrics is not None)

    version_info = {
        "code_sha": subprocess.run(["git", "rev-parse", "HEAD"], capture_output=True, text=True).stdout.strip() or "HEAD",
        "agent_config": f"{agent_name} ({config_path.name})",
        "context_mode": context_mode,
        "context_budget_chars": context_budget_chars,
        "agent_identity": agent_info,
        "judge_config": f"{provider}/{model_id}",
        "scorer_sha": actual_scorer_sha,
        "cost_usd": "未知 (直连 API)",
    }

    if is_run_successful:
        # Wrap results with explicit status="completed" and normalized metrics for downstream compare
        results_json = dict(results_raw)
        results_json["status"] = "completed"
        results_json["metrics"] = extracted_metrics
    else:
        results_json = {
            "metrics": None,
            "status": "judge_failed",
            "error": "ReviewBench official judge did not complete successfully or produce valid required metrics.",
        }

    results_json["execution_summary"] = execution_summary
    results_json["usage_summary"] = usage_summary
    results_json["agent_identity"] = agent_info
    results_json["version_info"] = version_info
    results_json["judge_config"] = f"{provider}/{model_id}"
    results_json["scorer_sha"] = actual_scorer_sha
    results_json["context_config"] = {
        "context_mode": context_mode,
        "context_budget_chars": context_budget_chars,
    }
    results_file.write_text(json.dumps(results_json, indent=2, ensure_ascii=False), encoding="utf-8")

    # Mirror results.json to top-level output for standard CLI contract
    top_results_file = output_dir / "results.json"
    top_results_file.write_text(json.dumps(results_json, indent=2, ensure_ascii=False), encoding="utf-8")

    # Build report.md
    report_md = generate_chinese_report(
        results_json=results_json,
        details_json=details_json,
        execution_summary=execution_summary,
        version_info=version_info,
    )

    report_file = output_dir / "report.md"
    report_file.write_text(report_md, encoding="utf-8")
    print(f"\n✓ Generated report: {report_file}")
    print(f"✓ Generated results: {top_results_file}")

    if not is_run_successful:
        print("\n✗ Benchmark run FAILED at scoring step (judge failed, results missing, or metrics incomplete).", file=sys.stderr)
        return 1

    return 0


def cmd_compare(args: argparse.Namespace) -> int:
    before_dir = Path(args.before).resolve()
    after_dir = Path(args.after).resolve()
    output_file = Path(args.output).resolve() if args.output else None

    if not before_dir.exists():
        print(f"Error: before directory not found: {before_dir}", file=sys.stderr)
        return 1
    if not after_dir.exists():
        print(f"Error: after directory not found: {after_dir}", file=sys.stderr)
        return 1

    try:
        report = compare_benchmarks(before_dir, after_dir, output_file)
        if output_file:
            print(f"✓ Comparison report written to: {output_file}")
        else:
            print(report)
        return 0
    except Exception as exc:
        print(f"Error comparing runs: {exc}", file=sys.stderr)
        return 1


def cmd_review(args: argparse.Namespace) -> int:
    repo_dir = Path(args.repo).resolve()
    pr_info = {
        "title": args.title or "CLI Review",
        "body": args.body or "",
    }
    shadow_mode = args.shadow or os.environ.get("HERDR_REVIEW_SHADOW_MODE", "").strip().lower() in ("1", "true", "yes")

    if args.diff:
        diff_path = Path(args.diff).resolve()
        if not diff_path.exists():
            print(f"Error: diff file not found: {diff_path}", file=sys.stderr)
            return 1
        diff_content = diff_path.read_text(encoding="utf-8")
        result = review_diff(
            repo_dir=repo_dir,
            diff_content=diff_content,
            pr_info=pr_info,
            reviewer_agent=args.agent,
            shadow_agent=args.shadow_agent,
            shadow_mode=shadow_mode,
            timeout_seconds=args.timeout,
            context_mode=args.context_mode,
            context_budget_chars=args.context_budget,
        )
    elif args.base:
        head = args.head or "HEAD"
        result = review_pr(
            repo_dir=repo_dir,
            base_ref=args.base,
            head_ref=head,
            pr_info=pr_info,
            reviewer_agent=args.agent,
            shadow_agent=args.shadow_agent,
            shadow_mode=shadow_mode,
            timeout_seconds=args.timeout,
            context_mode=args.context_mode,
            context_budget_chars=args.context_budget,
        )
    else:
        print("Error: either --diff <file> or --base <ref> must be provided", file=sys.stderr)
        return 1

    if args.output:
        out_path = Path(args.output).resolve()
        out_path.parent.mkdir(parents=True, exist_ok=True)
        out_path.write_text(json.dumps(result, indent=2, ensure_ascii=False), encoding="utf-8")
        print(f"✓ Review findings written to: {out_path}")
    else:
        print(json.dumps(result, indent=2, ensure_ascii=False))

    return 0


def cmd_auto_pr_review(args: argparse.Namespace) -> int:
    from herdr.pr_review_bot import execute_auto_pr_review

    repo_dir = Path(args.repo).resolve()
    result = execute_auto_pr_review(
        repo_dir=repo_dir,
        base_sha=args.base,
        head_sha=args.head,
        pr_number=args.pr_number,
        pr_title=args.pr_title or "",
        pr_body=args.pr_body or "",
        output_dir=Path(args.output_dir),
        github_token=args.github_token,
        repo_slug=args.repo_slug,
        reviewer_agent=args.agent or "rule",
        shadow_agent=args.shadow_agent or "agy",
        timeout_seconds=args.timeout,
    )
    print(f"=== Auto PR Review Finished: Status={result.get('status')} Shadow={result.get('shadow_status')} ===")
    print(f"Artifacts saved to: {args.output_dir}")
    comment_res = result.get("comment_result", {})
    print(f"PR Comment status: {comment_res.get('status')} (URL: {comment_res.get('comment_url', 'N/A')})")
    if result.get("status") == "failed":
        return 1
    return 0


def main() -> None:
    parser = argparse.ArgumentParser(description="HAFlow Code Review Benchmark Tool")
    subparsers = parser.add_subparsers(dest="subcommand", required=True)

    # run command
    run_parser = subparsers.add_parser("run", help="Run benchmark on historical cases")
    run_parser.add_argument("--config", required=True, help="Path to run configuration JSON")
    run_parser.add_argument("--output", required=True, help="Path to output directory")

    # compare command
    compare_parser = subparsers.add_parser("compare", help="Compare two benchmark runs")
    compare_parser.add_argument("--before", required=True, help="Before benchmark directory")
    compare_parser.add_argument("--after", required=True, help="After benchmark directory")
    compare_parser.add_argument("--output", default=None, help="Output comparison markdown path")

    # review command
    review_parser = subparsers.add_parser("review", help="Execute code review on a git diff or commit range")
    review_parser.add_argument("--repo", default=".", help="Repository root path (default: current directory)")
    review_parser.add_argument("--base", default=None, help="Base git commit reference")
    review_parser.add_argument("--head", default="HEAD", help="Head git commit reference (default: HEAD)")
    review_parser.add_argument("--diff", default=None, help="Path to git diff file")
    review_parser.add_argument("--agent", default=None, help="Reviewer agent (default: rule-contract-context-v1 or env)")
    review_parser.add_argument("--shadow", action="store_true", help="Enable shadow review alongside primary")
    review_parser.add_argument("--shadow-agent", default=None, help="Shadow reviewer agent (default: rule-contract-context-v1 or agy)")
    review_parser.add_argument("--title", default=None, help="PR or commit title")
    review_parser.add_argument("--body", default=None, help="PR or commit description")
    review_parser.add_argument("--context-mode", choices=["diff_only", "existing_four_tier"], default="existing_four_tier", help="Context assembly mode: diff_only or existing_four_tier (default: existing_four_tier)")
    review_parser.add_argument("--context-budget", type=int, default=35000, help="Context budget in characters (default: 35000)")
    review_parser.add_argument("--timeout", type=int, default=180, help="Timeout in seconds")
    review_parser.add_argument("--output", default=None, help="Output JSON path for findings")

    # auto-pr-review command
    auto_parser = subparsers.add_parser("auto-pr-review", help="Execute automated PR review with artifact upload & PR comment")
    auto_parser.add_argument("--repo", default=".", help="Repository root path (default: current directory)")
    auto_parser.add_argument("--base", required=True, help="PR Base commit SHA")
    auto_parser.add_argument("--head", required=True, help="PR Head commit SHA")
    auto_parser.add_argument("--pr-number", required=True, help="PR Number")
    auto_parser.add_argument("--pr-title", default="", help="PR Title")
    auto_parser.add_argument("--pr-body", default="", help="PR Body")
    auto_parser.add_argument("--output-dir", default=".omc/review_artifacts", help="Output directory for 4 audit artifacts")
    auto_parser.add_argument("--github-token", default=None, help="GitHub token for writing comment (or GITHUB_TOKEN env)")
    auto_parser.add_argument("--repo-slug", default=None, help="GitHub repository slug (e.g. allinai0506/HAFlow)")
    auto_parser.add_argument("--agent", default="rule", help="Primary reviewer agent (default: rule)")
    auto_parser.add_argument("--shadow-agent", default="agy", help="Shadow reviewer agent (default: agy)")
    auto_parser.add_argument("--timeout", type=int, default=180, help="Review timeout in seconds")

    args = parser.parse_args()
    if args.subcommand == "run":
        sys.exit(cmd_run(args))
    elif args.subcommand == "compare":
        sys.exit(cmd_compare(args))
    elif args.subcommand == "review":
        sys.exit(cmd_review(args))
    elif args.subcommand == "auto-pr-review":
        sys.exit(cmd_auto_pr_review(args))


if __name__ == "__main__":
    main()
