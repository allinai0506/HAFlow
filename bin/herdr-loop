#!/opt/homebrew/bin/python3
"""Herdr Autonomous Loop Driver (herdr-loop).

CLI for managing Pane-level inner loops and automated evaluation cycles
under the 5-element paradigm (Goal, Metrics, Data, Markdown, Cron).
"""

import argparse
import json
import os
import subprocess
import sys
import time
from pathlib import Path

# Ensure herdr package is in path
HERDR_ROOT = Path(__file__).resolve().parent.parent
if str(HERDR_ROOT) not in sys.path:
    sys.path.insert(0, str(HERDR_ROOT))

from herdr.evaluator import (
    LOOP_DIR_NAME,
    MetricVector,
    calculate_metrics,
    generate_blocker_report,
    get_loop_dir,
    init_loop,
    is_converged,
    read_baseline_lint,
    read_state,
    render_evaluation_markdown,
    render_metrics_markdown,
    write_state,
)


def _log_stamp(path: Path) -> tuple[int, int, int, int] | None:
    try:
        stat = path.stat()
        return stat.st_ino, stat.st_size, stat.st_mtime_ns, stat.st_ctime_ns
    except OSError:
        return None


def _exit_receipts(stdout: str) -> tuple[dict[str, int], list[str]]:
    """Only one native shell exit receipt per step is valid evidence."""
    receipts = {}
    seen = set()
    errors = set()
    for line in stdout.splitlines():
        name, separator, value = line.partition("=")
        if not separator or name not in {"TEST_EXIT", "LINT_EXIT", "REPRO_EXIT"}:
            continue
        if name in seen:
            errors.add(f"duplicate_exit_receipt:{name}")
            continue
        seen.add(name)
        try:
            code = int(value)
        except ValueError:
            errors.add(f"invalid_exit_receipt:{name}")
            continue
        if not 0 <= code <= 255:
            errors.add(f"invalid_exit_receipt:{name}")
            continue
        receipts[name] = code
    return receipts, sorted(errors)


def _fresh_step_log(path: Path, before, errors: list[str], step: str) -> str:
    stamp = _log_stamp(path)
    if stamp is None:
        errors.append(f"missing_step_log:{step}")
        return ""
    if stamp == before:
        errors.append(f"stale_step_log:{step}")
        return ""
    try:
        return path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        errors.append(f"unreadable_step_log:{step}")
        return ""


def run_evaluation(target_dir: Path) -> tuple[MetricVector, bool, str]:
    """Run EVALUATOR.sh, compute metrics, update all markdown & json files."""
    loop_dir = get_loop_dir(target_dir)
    evaluator_sh = loop_dir / "EVALUATOR.sh"
    if not evaluator_sh.exists():
        raise FileNotFoundError(f"Evaluator script not found at {evaluator_sh}")

    log_dir = loop_dir / "logs"
    log_dir.mkdir(parents=True, exist_ok=True)

    paths = {step: log_dir / f"{step}.log" for step in ("test", "lint", "repro")}
    before = {step: _log_stamp(path) for step, path in paths.items()}
    evaluation_errors = []
    # GOAL.md is the existing program-generated command contract, including
    # the optional repro command. Keep existing task clones compatible.
    try:
        goal = (loop_dir / "GOAL.md").read_text(encoding="utf-8")
        repro_required = any(line.startswith("- **靶向复现用例**:") for line in goal.splitlines())
    except (OSError, UnicodeError):
        evaluation_errors.append("goal_contract_unreadable")
        repro_required = False

    evaluation_exit = 127
    receipt_output = ""
    try:
        runner = subprocess.run(
            [str(evaluator_sh)],
            cwd=str(target_dir),
            text=True,
            capture_output=True,
            timeout=300,
        )
        evaluation_exit = runner.returncode
        receipt_output = runner.stdout
    except subprocess.TimeoutExpired as exc:
        evaluation_exit = 124
        partial = exc.stdout or ""
        receipt_output = partial.decode("utf-8", "replace") if isinstance(partial, bytes) else partial
    except OSError:
        evaluation_errors.append("evaluator_start_failed")
    if evaluation_exit != 0:
        evaluation_errors.append(f"evaluator_exit:{evaluation_exit}")
    receipts, receipt_errors = _exit_receipts(receipt_output)
    evaluation_errors.extend(receipt_errors)
    repro_stamp = _log_stamp(paths["repro"])
    repro_required = repro_required or "REPRO_EXIT" in receipts or (
        repro_stamp is not None and repro_stamp != before["repro"]
    )
    required_steps = ["test", "lint"] + (["repro"] if repro_required else [])
    logs = {}
    for step in required_steps:
        name = step.upper() + "_EXIT"
        if name not in receipts:
            evaluation_errors.append(f"missing_exit_receipt:{name}")
        logs[step] = _fresh_step_log(paths[step], before[step], evaluation_errors, step)
    test_exit = receipts.get("TEST_EXIT", 124 if evaluation_exit == 124 else 1)
    lint_exit = receipts.get("LINT_EXIT", 1)
    repro_exit = receipts.get("REPRO_EXIT", 1) if repro_required else 0
    test_log = logs["test"]
    lint_log = logs["lint"]
    repro_log = logs.get("repro")

    # Baseline-aware gate: pre-existing debt recorded at init does not block.
    baseline_lint, baseline_type = read_baseline_lint(loop_dir)

    # Calculate metrics
    metrics = calculate_metrics(
        test_output=test_log,
        test_exit_code=test_exit,
        lint_output=lint_log,
        lint_exit_code=lint_exit,
        repro_output=repro_log,
        repro_exit_code=repro_exit if repro_log is not None else None,
        baseline_lint_errors=baseline_lint,
        baseline_type_errors=baseline_type,
        evaluation_exit_code=evaluation_exit,
        evaluation_errors=evaluation_errors,
    )

    state = read_state(loop_dir)
    iteration = state.get("iteration", 0) + 1
    max_iter = state.get("max_iterations", 5)
    converged = is_converged(metrics)

    def _write_atomic(path: Path, content: str):
        tmp_path = path.with_suffix(path.suffix + f".tmp.{os.getpid()}")
        tmp_path.write_text(content, encoding="utf-8")
        tmp_path.replace(path)

    # Persist METRICS.json
    _write_atomic(loop_dir / "METRICS.json", json.dumps(metrics.to_dict(), indent=2, ensure_ascii=False))
    
    # Persist METRICS.md
    _write_atomic(loop_dir / "METRICS.md", render_metrics_markdown(metrics, iteration, max_iter))
    
    # Persist EVALUATION.md
    err_context = ""
    if not converged:
        snippets = []
        if (test_exit != 0 or metrics.failing_tests) and test_log.strip():
            snippets.append(f"--- 基础测试输出 ---\n{test_log.strip()}")
        if lint_exit != 0 and lint_log.strip():
            snippets.append(f"--- 质量与静态检查输出 ---\n{lint_log.strip()}")
        if repro_exit != 0 and repro_log and repro_log.strip():
            snippets.append(f"--- 靶向复现用例输出 ---\n{repro_log.strip()}")
        err_context = "\n\n".join(snippets)

    _write_atomic(loop_dir / "EVALUATION.md", render_evaluation_markdown(metrics, iteration, max_iter, err_context))

    # Update STATE.md
    new_status = "converged" if converged else ("exhausted" if iteration >= max_iter else "iterating")
    write_state(loop_dir, iteration, max_iter, new_status, converged)

    # Auto-generate BLOCKER.md when loop is exhausted without convergence
    if not converged and iteration >= max_iter:
        generate_blocker_report(loop_dir, metrics, iteration, max_iter)

    # Atomic evaluation snapshot — written LAST after STATE.md and BLOCKER.md.
    #
    # This is the SOLE source of truth for Semantic Supervisor evidence.
    # By carrying every field needed by extract_test_evidence() in one file that
    # is replaced atomically, we eliminate the torn-snapshot window that exists
    # when METRICS.json is overwritten at the START of a new iteration while
    # EVAL_DONE.json / STATE.md still reflect the previous iteration.
    #
    # METRICS.json and STATE.md continue to serve herdr-loop (display, blocker
    # report, etc.) — Supervisor evidence is read exclusively from EVAL_DONE.json.
    _write_atomic(
        loop_dir / "EVAL_DONE.json",
        json.dumps({
            "iteration": iteration,
            "completed_at": time.time(),
            "status": new_status,
            "converged": converged,
            "max_iterations": max_iter,
            "total_tests": metrics.total_tests,
            "passed_tests": metrics.passed_tests,
            "failing_tests": list(metrics.failing_tests or []),
            "lint_errors": metrics.lint_errors,
            "type_errors": metrics.type_errors,
            "baseline_lint_errors": metrics.baseline_lint_errors,
            "baseline_type_errors": metrics.baseline_type_errors,
            "new_lint_errors": metrics.new_lint_errors,
            "new_type_errors": metrics.new_type_errors,
            "composite_score": round(float(metrics.composite_score), 2),
            "has_repro_test": bool(metrics.has_repro_test),
            "evaluation_exit_code": evaluation_exit,
            "evaluation_errors": evaluation_errors,
        }, ensure_ascii=False),
    )

    return metrics, converged, new_status

def main():
    parser = argparse.ArgumentParser(description="Herdr Autonomous Loop CLI")
    sub = parser.add_subparsers(dest="command", required=True)

    # init
    init_cmd = sub.add_parser("init", help="Initialize .herdr-loop in directory")
    init_cmd.add_argument("--dir", default=".", help="Target project/clone directory")
    init_cmd.add_argument("--goal", required=True, help="Task goal")
    init_cmd.add_argument("--acceptance", default="", help="Acceptance criteria")
    init_cmd.add_argument("--test-cmd", default="", help="Test execution command")
    init_cmd.add_argument("--lint-cmd", default="", help="Lint execution command")
    init_cmd.add_argument("--repro-cmd", default="", help="Target reproduction test command")
    init_cmd.add_argument("--max-iter", type=int, default=5, help="Max iteration count")

    # eval
    eval_cmd = sub.add_parser("eval", help="Run evaluation and update metrics")
    eval_cmd.add_argument("--dir", default=".", help="Target project/clone directory")

    # status
    status_cmd = sub.add_parser("status", help="Get current loop score and state")
    status_cmd.add_argument("--dir", default=".", help="Target project/clone directory")

    args = parser.parse_args()
    target_dir = Path(args.dir).resolve()

    if args.command == "init":
        init_loop(
            target_dir=target_dir,
            goal=args.goal,
            acceptance=args.acceptance,
            test_cmd=args.test_cmd,
            lint_cmd=args.lint_cmd,
            max_iterations=args.max_iter,
            repro_cmd=args.repro_cmd,
        )
        # Baseline-aware gate: snapshot pre-edit lint debt (best-effort).
        try:
            from herdr.evaluator import parse_lint_output as _parse_lint
            from herdr.evaluator import write_baseline_lint as _write_baseline
            _snapshot_cmd = (args.lint_cmd or "").strip()
            if _snapshot_cmd:
                _proc = subprocess.run(
                    _snapshot_cmd,
                    cwd=str(target_dir),
                    text=True,
                    capture_output=True,
                    timeout=120,
                    shell=True,
                )
                _out = (_proc.stdout or "") + (_proc.stderr or "")
                _write_baseline(
                    target_dir / LOOP_DIR_NAME,
                    _parse_lint(_out, _proc.returncode),
                    0,
                )
        except Exception as _exc:
            print(f"[HERDR_LOOP_WARN] Failed to snapshot lint baseline: {_exc}")
        sys.exit(0)

    elif args.command == "eval":
        metrics, converged, loop_status = run_evaluation(target_dir)
        print(f"[HERDR_LOOP_SCORE] {metrics.composite_score}")
        print(f"[HERDR_LOOP_CONVERGED] {converged}")
        if not converged and loop_status == "exhausted":
            blocker_path = get_loop_dir(target_dir) / "BLOCKER.md"
            print(f"[HERDR_LOOP_EXHAUSTED] Max iterations reached. BLOCKER.md at {blocker_path}")
            print("[HERDR_LOOP_ACTION] Output HERDR_TASK_BLOCKER:<task_id> to escalate to Coordinator")
        sys.exit(0 if converged else 1)

    elif args.command == "status":
        loop_dir = get_loop_dir(target_dir)
        state = read_state(loop_dir)
        m_file = loop_dir / "METRICS.json"
        score = 0.0
        if m_file.exists():
            data = json.loads(m_file.read_text(encoding="utf-8"))
            score = data.get("composite_score", 0.0)
        print(json.dumps({"state": state, "score": score}, ensure_ascii=False, indent=2))
        sys.exit(0)


if __name__ == "__main__":
    main()
