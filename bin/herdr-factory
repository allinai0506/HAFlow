        active_workflows_for_project,
        workflow_creation_lock,
    )
    from herdr.workflow import list_templates, load_template, get_ready_nodes
    from herdr import kernel
except ImportError:
    from herdr_pane_pool import list_slots_for_project, bind_pane, unbind_pane
    from herdr_agent_router import ensure_pool_for_project, describe_project_pool, set_workflow_agent_override
    from herdr_kernel import *
    from herdr_projects import (
        detect_git_root,
        ensure_project,
        load_projects,
        load_workflows,
        project_by_root,
        project_for_workflow,
        register_workflow,
        generate_workflow_id,
        mark_workflow_startup_ready,
        workflow_config_for,
        active_workflows_for_project,
        workflow_creation_lock,
    )
    from herdr_workflow import list_templates, load_template, get_ready_nodes

HOME = Path.home()
ROOT = HOME / ".herdr-controller"
TASKS_FILE = ROOT / "tasks.json"
POLICIES_FILE = ROOT / "stage-policies.json"
PROJECTS_FILE = ROOT / "projects.json"
WORKFLOWS_FILE = ROOT / "workflows.json"
SERVICE = f"gui/{os.getuid()}/com.user.herdr-controller"

STAGES = [
    "requirements",
    "plan",
    "implementation",
    "test",
    "review",
    "wrapup",
]


def run(cmd, check=True):
    return subprocess.run(
        cmd,
        text=True,
        capture_output=True,
        check=check,
    )


def load_json(path, default=None):
    if default is None:
        default = {}
    try:
        return json.loads(Path(path).read_text(encoding="utf-8"))
    except Exception:
        return default


def _get_store():
    from herdr.state_store import get_state_store
    if os.environ.get("HERDR_STATE_DB"):
        return get_state_store(Path(os.environ["HERDR_STATE_DB"]))
    t_file = globals().get("TASKS_FILE") or os.environ.get("TASKS_FILE")
    if t_file:
        p = Path(t_file)
        db_path = p.parent / "state.db" if p.name == "tasks.json" else p.with_suffix(".db")
        if db_path.parent.exists():
            return get_state_store(db_path=db_path)
    wf_file = globals().get("WORKFLOWS_FILE") or os.environ.get("WORKFLOWS_FILE")
    if wf_file:
        p = Path(wf_file)
        db_path = p.parent / "state.db" if p.name == "workflows.json" else p.with_suffix(".db")
        if db_path.parent.exists():
            return get_state_store(db_path=db_path)
    return get_state_store()


def tasks_for(workflow_id):
    try:
        store = _get_store()
        return store.list_tasks(workflow_id=workflow_id)
    except Exception:
        data = load_json(TASKS_FILE, {"tasks": []})
        return [
            t
            for t in data.get("tasks", [])
            if t.get("workflow_id") == workflow_id
        ]


def resolve_project(explicit_path=None, create=True, template_name=None):
    root = detect_git_root(explicit_path or os.getcwd())
    if create:
        return ensure_project(root, template_name=template_name)
    return project_by_root(root)


def project_command(path=None, workspace=None, template=None):
    if workspace:
        from herdr.projects import adopt_workspace_as_project
        project = adopt_workspace_as_project(workspace, root=path, template_name=template)
    else:
        project = resolve_project(path, create=True, template_name=template)
    print(json.dumps(project, ensure_ascii=False, indent=2))
    return 0


def projects_command():
    data = load_projects()
    projects = list(data.get("projects", {}).values())
    if not projects:
        print("No registered projects.")
        return 0

    print("Registered Herdr projects:")
    for p in projects:
        print(
            f"- {p.get('project_name')}  "
            f"{p.get('project_root')}  "
            f"workspace={p.get('workspace_id')}  "
            f"coordinator={p.get('coordinator_pane_id')}"
        )
    return 0


def unregister_command(path=None, close_workspace=False, force=False):
    from herdr.projects import unregister_project, detect_git_root
    target = path
    if not target:
        try:
            target = detect_git_root(os.getcwd())
        except Exception:
            target = os.getcwd()
    try:
        record = unregister_project(target, close_workspace=close_workspace, force=force)
        print(f"项目已成功注销: {record.get('project_name', target)} ({record.get('project_root', '')})")
        if close_workspace and record.get('workspace_id'):
            print(f"对应 Herdr 空间 {record['workspace_id']} 已关闭。")
        return 0
    except (ValueError, RuntimeError) as e:
        print(f"注销失败: {e}", file=sys.stderr)
        return 1


def doctor():
    checks = []

    def add(name, ok, detail=""):
        checks.append((name, ok, detail))

    for p in [
        HERDR_ROOT / "services" / "herdr-controller.py",
        HERDR_ROOT / "bin" / "herdr-task",
        HERDR_ROOT / "services" / "herdr-worker.py",
        HERDR_ROOT / "herdr" / "projects.py",
        TASKS_FILE,
        POLICIES_FILE,
        PROJECTS_FILE,
        WORKFLOWS_FILE,
    ]:
        add(f"file {p.name}", p.exists(), str(p))

    r = run(["herdr", "status"], check=False)
    add(
        "Herdr server",
        r.returncode == 0 and "status: running" in r.stdout,
        "running" if "status: running" in r.stdout else "not running",
    )

    r = run(["launchctl", "print", SERVICE], check=False)
    add(
        "Controller service",
        r.returncode == 0 and "state = running" in r.stdout,
        "running" if r.returncode == 0 else "not running",
    )

    projects = load_projects().get("projects", {})
    for root, project in projects.items():
        ws = project.get("workspace_id", "")
        coord = project.get("coordinator_pane_id", "")

        r = run(["herdr", "workspace", "get", ws], check=False)
        add(
            f"project {project.get('project_name')} workspace",
            r.returncode == 0,
            ws,
        )

        r = run(["herdr", "agent", "get", coord], check=False)
        add(
            f"project {project.get('project_name')} coordinator",
            r.returncode == 0,
            coord,
        )

    failed = False
    print("Herdr Factory Doctor")
    print("=" * 64)
    for name, ok, detail in checks:
        mark = "PASS" if ok else "FAIL"
        print(f"[{mark}] {name}" + (f" — {detail}" if detail else ""))
        failed = failed or not ok
    print("=" * 64)
    print("DOCTOR: FAIL" if failed else "DOCTOR: PASS")
    return 1 if failed else 0


def run_workflow_preflight(project, workflow_id, agent=None):
    """Run Deep Preflight once and store a workflow-scoped healthy Agent set."""
    script = HERDR_ROOT / "bin" / "herdr-deep-preflight"
    if not script.exists():
        script = HERDR_ROOT / "herdr" / "deep_preflight.py"
    if not script.exists():
        raise RuntimeError(f"Deep Preflight 未安装: {script}")

    cmd = [
        str(script),
        "--project-id",
        project["project_id"],
        "--deep",
        "--json",
    ]
    if agent and agent != "auto":
        cmd.extend(["--agent", agent])

    r = run(
        cmd,
        check=False,
    )

    if r.returncode != 0:
        raise RuntimeError(
            r.stderr.strip()
            or r.stdout.strip()
            or "Deep Preflight 执行失败"
        )

    try:
        result = json.loads(r.stdout)
    except Exception as e:
        raise RuntimeError("Deep Preflight JSON 解析失败") from e

    agents = result.get("agents", [])
    healthy = [
        item["agent"]
        for item in agents
        if item.get("final_status") == "READY"
    ]
    unhealthy = {
        item["agent"]: item.get("final_status")
        for item in agents
        if item.get("final_status") != "READY"
    }

    if not healthy:
        raise RuntimeError(
            "Deep Preflight 未发现任何 READY Agent，拒绝启动 Workflow"
        )

    store = None
    record = None
    try:
        store = _get_store()
        record = store.get_workflow(workflow_id)
    except Exception:
        pass

    if record is None:
        wf_fallback = Path(os.environ.get("WORKFLOWS_FILE") or WORKFLOWS_FILE)
        data = load_json(wf_fallback, {"workflows": {}})
        record = data.setdefault("workflows", {}).get(workflow_id)
        if record is None:
            raise RuntimeError(f"Workflow registry missing: {workflow_id}")

    record["healthy_agents"] = healthy
    record["unhealthy_agents"] = unhealthy
    record["preflight_checked_at"] = datetime.now().isoformat(timespec="seconds")

    store = _get_store()
    store.save_workflow(record)

    # 投影必须经 StateStore 同步(环境变量感知)，严禁直写硬编码路径，
    # 否则测试/沙盒写入会覆盖线上 workflows.json。
    try:
        from herdr.state_store import sync_workflows_projection
    except ImportError:
        from herdr_state_store import sync_workflows_projection
    sync_workflows_projection(store=store)

    print("PREFLIGHT_READY=" + ",".join(healthy))
    if unhealthy:
        print(
            "PREFLIGHT_EXCLUDED="
            + ",".join(f"{k}:{v}" for k, v in unhealthy.items())
        )

    return healthy, unhealthy



def _reject_if_active_workflow(project, force=False):
    """同一项目工作流共享协调者 Pane 与阶段拓扑，并行注册只会产生幽灵竞争。"""
    active = active_workflows_for_project(project["project_id"])
    if not active or force:
        return
    lines = [f"项目 {project['project_name']} 已有活跃 Workflow，拒绝重复创建："]
    for entry in active:
        subject = entry.get("requirement_subject") or "（无主题）"
        lines.append(f"  - {entry['workflow_id']}  主题: {subject}")
    lines.append(
        "同一项目共享协调者 Pane，不支持并行工作流。"
        "请在控制台查看进度，或运行 herdr-task close-workflow <workflow_id> 清理后重试；"
        "确需排队创建请加 --force。"
    )
    print("\n".join(lines), file=sys.stderr)
    raise SystemExit(2)


def start_workflow(
    requirement,
    workflow_id=None,
    e2e=False,
    project_path=None,
    agent_override="auto",
    template=None,
    force=False,
    title=None,
):
    project = resolve_project(project_path, create=True, template_name=template)

    if not workflow_id:
        prefix = "e2e" if e2e else "wf"
        workflow_id = generate_workflow_id(project, prefix=prefix)

    # 检查与注册必须持同一把进程锁，否则两个并发创建都能通过活跃检查。
    with workflow_creation_lock(project["project_id"]):
        _reject_if_active_workflow(project, force=force or e2e)
        register_workflow(workflow_id, project, requirement=requirement, title=title or "")

    ensure_pool_for_project(project["project_id"])
    healthy_agents, unhealthy_agents = run_workflow_preflight(
        project,
        workflow_id,
        agent=agent_override if agent_override and agent_override != "auto" else None,
    )

    if agent_override and agent_override != "auto":
        if agent_override not in healthy_agents:
            status = unhealthy_agents.get(agent_override, "NOT_READY")
            raise RuntimeError(
                f"指定 Agent '{agent_override}' 未通过 Deep Preflight: {status}"
            )

    set_workflow_agent_override(workflow_id, agent_override)
    mark_workflow_startup_ready(
        workflow_id,
        healthy_agents=healthy_agents,
        unhealthy_agents=unhealthy_agents,
    )

    wf_cfg = workflow_config_for(workflow_id) or {}
    nodes = wf_cfg.get("nodes", [])
    ready_nodes = get_ready_nodes(wf_cfg, set()) if nodes else []
    first_node_id = ready_nodes[0]["id"] if ready_nodes else (nodes[0]["id"] if nodes else "requirements")
    nodes_summary = ", ".join(f"{n['id']} ({n.get('label', n['id'])})" for n in nodes) if nodes else "标准开发 6 节点"

    extra = ""
    if e2e:
        extra = (
            "这是 E2E 纯流程测试：所有阶段不得修改项目文件；"
            "使用 integration_mode=none 和 task_type=test。"
            "验收以 Agent 生命周期到 done/agent_done 且 "
            "verify-baseline=BASELINE_MATCH 为准；"
            "不得因为 OpenCode alternate-screen 读取为空白而返工。"
        )

    prompt = f"""请按照 Herdr 工作流规范启动 Workflow。

project_name: {project['project_name']}
project_root: {project['project_root']}
workspace_id: {project['workspace_id']}
workflow_id: {workflow_id}
workflow_title: {title or '（未命名）'}
workflow_template: {wf_cfg.get('workflow_template', template)}
workflow_nodes: {nodes_summary}
workflow_config: {project['workflow_file']}

用户需求：
{requirement}

{extra}

执行要求：
1. 这是项目 {project['project_name']}，所有 Task 必须属于 workflow_id={workflow_id}。
2. 从首个就绪节点 {first_node_id} 开始。
3. 创建 Task 必须使用 ~/HAFlow/bin/herdr-task launch。
4. 每次 launch 必须显式指定：
   --workflow-id {workflow_id}
   --node <node_id>
   --source {project['project_root']}
5. 不允许手工创建 Clone、Pane、Branch、Agent。
6. 每个 Task 必须明确 goal 和 acceptance criteria。
7. 当前节点必要 Task 派发完成后结束当前回合。
8. 后续节点推进交给 Controller 自动根据 DAG 依赖推进。
9. 不得读取、修改或推进其他项目/其他 Workflow。
10. 创建 Task 时默认使用 --agent auto，让 Agent Router 根据 node + task_type 动态选择执行者。
11. 如果用户为当前 Workflow 指定了固定 Agent，该指定优先于自动路由。
12. 同一节点可以创建多个 Task，并由 Router 分配给不同 Agent；不要默认把所有 Task 都交给同一个 Agent。
13. 当前 Workflow 已在启动前执行 Deep Preflight；Router 只能从该 Workflow 的 healthy_agents 中选择 Agent。
""".strip()

    print(f"PROJECT={project['project_name']}")
    print(f"PROJECT_ROOT={project['project_root']}")
    print(f"WORKSPACE_ID={project['workspace_id']}")
    coordinator = project["coordinator_pane_id"]
    print(f"COORDINATOR_PANE={coordinator}")
    print(f"WORKFLOW_ID={workflow_id}")
    return workflow_id


def status(workflow_id):
    tasks = tasks_for(workflow_id)
    project = project_for_workflow(workflow_id) or {}

    if not tasks:
        print(f"No tasks for workflow: {workflow_id}")
        return 1

    print(
        f"Project: {project.get('project_name', 'legacy/unknown')} "
        f"({project.get('project_root', '-')})"
    )
    print(f"Workflow: {workflow_id}")
    print("=" * 88)

    cfg = workflow_config_for(workflow_id)
    nodes_to_show = []
    if cfg and cfg.get("nodes"):
        nodes_to_show = [(n["id"], n.get("label", n["id"])) for n in cfg["nodes"]]
    else:
        nodes_to_show = [(s, s) for s in STAGES]

    for node_id, label in nodes_to_show:
        node_tasks = [
            t for t in tasks
            if t.get("node") == node_id or t.get("stage") == node_id
        ]
        display_name = f"{node_id} ({label})" if label != node_id else node_id
        if not node_tasks:
            print(f"{display_name:28} -")
            continue

        states = ", ".join(
            f"{t['task_id']}={t['status']}"
            for t in node_tasks
        )
        print(f"{display_name:28} {states}")

    print("=" * 88)
    return 0


def _update_workflow_status(workflow_id, target_status, action_label):
    store = _get_store()
    wf = store.get_workflow(workflow_id)
    if not wf:
        print(f"Workflow {workflow_id} not found")
        return 1

    from herdr import kernel
    try:
        kernel.transition_workflow(
            workflow_id=workflow_id,
            to_status=target_status,
            reason=action_label,
            source="herdr-factory",
            store=store,
        )
    except Exception as exc:
        print(f"Error transitioning workflow {workflow_id}: {exc}", file=sys.stderr)
        raise

    print(f"Workflow {workflow_id} {action_label}")
    return 0


def pause_workflow(workflow_id):
    try:
        res = kernel.pause_workflow(workflow_id)
        if res.get("ok"):
            print(f"Workflow {workflow_id} paused")
            return 0
    except Exception:
        pass
    return _update_workflow_status(workflow_id, "paused", "paused")


def resume_workflow(workflow_id):
    try:
        res = kernel.resume_workflow(workflow_id)
        if res.get("ok"):
            print(f"Workflow {workflow_id} resumed")
            return 0
    except Exception:
        pass
    return _update_workflow_status(workflow_id, "running", "resumed")


def step_command(workflow_id):
    try:
        res = kernel.step_workflow(workflow_id)
        if res.get("ok"):
            print(f"Workflow {workflow_id} stepped: node={res.get('stepped_node')} ({res.get('stepped_label')})")
            return 0
        else:
            print(f"Workflow {workflow_id} cannot step: {res.get('reason')}")
            return 1
    except Exception as e:
        print(f"Step failed: {e}")
        return 1


def rollback_command(workflow_id, target_node_id, reason="manual_rollback"):
    try:
        res = kernel.rollback_workflow(workflow_id, target_node_id, reason=reason)
        print(f"Workflow {workflow_id} rolled back to node {target_node_id}")
        print(f"Affected nodes: {', '.join(res.get('affected_nodes', []))}")
        print(f"Invalidated tasks: {', '.join(res.get('invalidated_tasks', [])) or 'none'}")
        return 0
    except Exception as e:
        print(f"Rollback failed: {e}")
        return 1


def force_pass_command(workflow_id, gate_node_id, note="human forced pass", operator="human"):
    try:
        res = kernel.force_pass_gate(workflow_id, gate_node_id, note=note, operator=operator)
        print(f"Gate {gate_node_id} for workflow {workflow_id} marked as passed.")
        print(f"Updated tasks: {', '.join(res.get('updated_tasks', [])) or 'none'}")
        return 0
    except Exception as e:
        print(f"Force pass failed: {e}")
        return 1


def checkpoint_command(action, workflow_id, tag=None, checkpoint_id=None):
    try:
        if action == "save":
            res = kernel.create_checkpoint(workflow_id, tag=tag)
            print(f"Checkpoint saved: {res.get('checkpoint_id')} (tasks: {res.get('task_count')})")
            return 0
        elif action == "list":
            cps = kernel.list_checkpoints(workflow_id)
            if not cps:
                print(f"No checkpoints found for workflow {workflow_id}")
                return 0
            print(f"{'CHECKPOINT ID':<42} {'TAG':<20} {'TASKS':<6} {'STATUS':<10} {'CREATED AT'}")
            print("-" * 95)
            for cp in cps:
                ts = datetime.fromtimestamp(cp.get("created_at", 0)).strftime("%Y-%m-%d %H:%M:%S")
                print(f"{cp.get('checkpoint_id'):<42} {cp.get('tag', ''):<20} {cp.get('task_count', 0):<6} {cp.get('workflow_status', ''):<10} {ts}")
            return 0
        elif action == "restore":
            if not checkpoint_id:
                print("Error: checkpoint_id is required for restore")
                return 1
            res = kernel.restore_checkpoint(workflow_id, checkpoint_id)
            print(f"Workflow {workflow_id} restored to checkpoint {checkpoint_id} ({res.get('restored_tasks')} tasks)")
            return 0
        else:
            print(f"Unknown checkpoint action: {action}")
            return 1
    except Exception as e:
        print(f"Checkpoint operation failed: {e}")
        return 1


def e2e(project_path=None):
    workflow_id = start_workflow(
        "验证当前项目的 Herdr Factory 六阶段可以全自动推进。"
        "这是纯流程测试，不允许修改任何项目文件。",
        workflow_id=None,
        e2e=True,
        project_path=project_path,
    )

    if not workflow_id:
        print("E2E: FAIL (start)")
        return 1

    print(f"E2E started: {workflow_id}")
    deadline = time.time() + 20 * 60
    last_snapshot = None

    while time.time() < deadline:
        tasks = tasks_for(workflow_id)
        snapshot = tuple(sorted(
            (
                t.get("stage"),
                t.get("task_id"),
                t.get("status"),
            )
            for t in tasks
        ))

        if snapshot and snapshot != last_snapshot:
            print()
            for stage, task_id, state in snapshot:
                print(f"{stage:16} {task_id:40} {state}")
            last_snapshot = snapshot

        if any(t.get("status") == "failed" for t in tasks):
            print("E2E: FAIL (task failed)")
            return 1

        seen = {t.get("stage") for t in tasks}
        all_cleaned = bool(tasks) and all(
            t.get("status") == "cleaned"
            for t in tasks
        )

        if set(STAGES) <= seen and all_cleaned:
            print("E2E: PASS")
            return 0

        time.sleep(5)

    print("E2E: FAIL (timeout)")
    return 1


def agents_command(project_path=None):
    project = resolve_project(project_path, create=True)
    pool = describe_project_pool(project["project_id"])
    print(json.dumps({"project_name": project["project_name"], "project_root": project["project_root"], **pool}, ensure_ascii=False, indent=2))
    return 0


def slots_command(project_path=None):
    project = resolve_project(project_path, create=True)
    slots = list_slots_for_project(project)
    print(json.dumps({
        "project_name": project["project_name"],
        "workspace_id": project["workspace_id"],
        "slots": slots,
    }, ensure_ascii=False, indent=2))
    return 0


def slot_bind_command(pane_id, agent, project_path=None):
    project = resolve_project(project_path, create=True)
    slots = list_slots_for_project(project)
    target = next((s for s in slots if s.get("pane_id") == pane_id), None)
    if not target:
        print(f"Pane {pane_id} is not a user-created stage Pane in project {project['project_name']}")
        return 2
    bind_pane(pane_id, agent)
    print(f"BOUND pane={pane_id} stage={target.get('stage')} agent={agent}")
    return 0


def slot_unbind_command(pane_id):
    unbind_pane(pane_id)
    print(f"UNBOUND pane={pane_id}")
    return 0


def templates_command():
    templates = list_templates()
    print("Available Workflow Templates")
    print("=" * 72)
    for name, info in sorted(templates.items()):
        label = info.get("label", name)
        desc = info.get("description", "")
        count = info.get("node_count", 0)
        ver = info.get("version", "1.0")
        print(f"{name:26} [{ver}] {label} ({count} nodes)")
        if desc:
            print(f"  {desc}")
    print("=" * 72)
    return 0


def main():
    parser = argparse.ArgumentParser(description="Herdr Software Factory")
    sub = parser.add_subparsers(dest="command", required=True)

    sub.add_parser("doctor")
    sub.add_parser("templates")
    sub.add_parser("projects")

    proj_cmd = sub.add_parser("project")
    proj_cmd.add_argument("project")
    proj_cmd.add_argument("--workspace", help="已有空间 Workspace ID（将空间采纳为工厂项目）")
    proj_cmd.add_argument("--template", default=None, help="覆盖工作流模板（默认保留已有或使用默认模板）")

    unreg_cmd = sub.add_parser("unregister")
    unreg_cmd.add_argument("project", help="项目根目录或 project_id")
    unreg_cmd.add_argument("--close-workspace", action="store_true", help="同时关闭绑定的空间")
    unreg_cmd.add_argument("--force", action="store_true", help="有活跃工作流时强制注销")

    slots_cmd = sub.add_parser("slots")
    slots_cmd.add_argument("--project", default=None)

    bind_cmd = sub.add_parser("slot-bind")
    bind_cmd.add_argument("pane_id")
    bind_cmd.add_argument("agent")
    bind_cmd.add_argument("--project", default=None)

    unbind_cmd = sub.add_parser("slot-unbind")
    unbind_cmd.add_argument("pane_id")

    agents_cmd = sub.add_parser("agents")
    agents_cmd.add_argument("--project", default=None)

    run_cmd = sub.add_parser("run")
    run_cmd.add_argument("requirement", nargs="+")
    run_cmd.add_argument("--workflow-id")
    run_cmd.add_argument("--project", default=None)
    run_cmd.add_argument("--title", default=None, help="需求简要标题（可选；留空时自动根据需求生成）")
    run_cmd.add_argument("--agent", default="auto", choices=["auto", "opencode", "codex", "claude", "qodercli", "agy", "pi", "grok", "kimi"])
    run_cmd.add_argument("--template", default=None, help="工作流模板（缺省:新项目用默认模板,已有项目沿用当前模板）")
    run_cmd.add_argument("--force", action="store_true")

    status_cmd = sub.add_parser("status")
    status_cmd.add_argument("workflow_id")

    pause_cmd = sub.add_parser("pause", help="暂停工作流自动调度推进")
    pause_cmd.add_argument("workflow_id")

    resume_cmd = sub.add_parser("resume", help="恢复工作流自动调度推进")
    resume_cmd.add_argument("workflow_id")

    step_cmd = sub.add_parser("step", help="单步推进就绪节点 (工作流需处于 paused 状态)")
    step_cmd.add_argument("workflow_id")

    rb_cmd = sub.add_parser("rollback", help="回溯工作流至指定历史节点并级联作废下游任务")
    rb_cmd.add_argument("workflow_id")
    rb_cmd.add_argument("target_node_id")
    rb_cmd.add_argument("--reason", default="manual_rollback", help="回溯原因")

    fp_cmd = sub.add_parser("force-pass", help="人工强制放行门禁节点")
    fp_cmd.add_argument("workflow_id")
    fp_cmd.add_argument("gate_node_id")
    fp_cmd.add_argument("--note", default="human forced pass", help="审计说明")
    fp_cmd.add_argument("--operator", default="human", help="操作人标识")

    cp_cmd = sub.add_parser("checkpoint", help="工作流运行态快照管理")
    cp_sub = cp_cmd.add_subparsers(dest="cp_action", required=True)
    cp_save = cp_sub.add_parser("save", help="创建运行态快照")
    cp_save.add_argument("workflow_id")
    cp_save.add_argument("--tag", default=None, help="快照标签")
    cp_list = cp_sub.add_parser("list", help="列出工作流历史快照")
    cp_list.add_argument("workflow_id")
    cp_res = cp_sub.add_parser("restore", help="恢复工作流快照")
    cp_res.add_argument("workflow_id")
    cp_res.add_argument("checkpoint_id")

    e2e_cmd = sub.add_parser("e2e")
    e2e_cmd.add_argument("--project")

    args = parser.parse_args()

    if args.command == "doctor":
        sys.exit(doctor())

    if args.command == "templates":
        sys.exit(templates_command())

    if args.command == "project":
        sys.exit(project_command(args.project, workspace=args.workspace, template=args.template))

    if args.command == "projects":
        sys.exit(projects_command())

    if args.command == "unregister":
        sys.exit(unregister_command(args.project, close_workspace=args.close_workspace, force=args.force))

    if args.command == "slots":
        sys.exit(slots_command(args.project))

    if args.command == "slot-bind":
        sys.exit(slot_bind_command(args.pane_id, args.agent, args.project))

    if args.command == "slot-unbind":
        sys.exit(slot_unbind_command(args.pane_id))

    if args.command == "agents":
        sys.exit(agents_command(args.project))

    if args.command == "run":
        workflow_id = start_workflow(
            " ".join(args.requirement),
            args.workflow_id,
            e2e=False,
            project_path=args.project,
            agent_override=args.agent,
            template=args.template,
            force=args.force,
            title=args.title,
        )
        sys.exit(0 if workflow_id else 1)

    if args.command == "status":
        sys.exit(status(args.workflow_id))

    if args.command == "pause":
        sys.exit(pause_workflow(args.workflow_id))

    if args.command == "resume":
        sys.exit(resume_workflow(args.workflow_id))

    if args.command == "step":
        sys.exit(step_command(args.workflow_id))

    if args.command == "rollback":
        sys.exit(rollback_command(args.workflow_id, args.target_node_id, reason=args.reason))

    if args.command == "force-pass":
        sys.exit(force_pass_command(args.workflow_id, args.gate_node_id, note=args.note, operator=args.operator))

    if args.command == "checkpoint":
        sys.exit(checkpoint_command(args.cp_action, args.workflow_id, tag=getattr(args, "tag", None), checkpoint_id=getattr(args, "checkpoint_id", None)))

    if args.command == "e2e":
        sys.exit(e2e(args.project))


if __name__ == "__main__":
    main()
