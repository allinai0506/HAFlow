def _enforce_wrapup_review_closure(task_id, task, *, skip, note, operator=None,
                                   operator_token=None, operator_credentials=None):
    """CLI-side pre-check for the shared wrapup review-closure invariant.

    The authoritative gate lives in ``herdr.kernel.transition_task`` — every
    completion source (CLI ``set``, the controller's CAS auto-accept path and
    repair flows) funnels through it. This pre-check only exists for a
    friendly refusal message. The audited ``--skip-review-closure`` bypass
    requires an authenticated operator identity independent of the task worker
    plus the ``HERDR_OPERATOR=1`` shell capability (task workers do not carry it);
    it records a ``review_closure_skipped`` event, which also satisfies the
    kernel gate (Codex review P1, Issue #228 Item 1).
    """
    from herdr import review_closure
    store = _get_store()
    if skip:
        reason = str(note or "").strip()
        if not reason:
            print(
                "[REVIEW CLOSURE SKIP REFUSED] --skip-review-closure requires "
                "--note with the audited reason",
                file=sys.stderr,
            )
            sys.exit(2)
        operator_id = str(operator or "").strip()
        if not operator_id:
            print(
                "[REVIEW CLOSURE SKIP REFUSED] --skip-review-closure requires "
                "--operator <identity> (an operator independent of the task "
                "worker)",
                file=sys.stderr,
            )
            sys.exit(2)
        if os.environ.get("HERDR_OPERATOR") != "1":
            print(
                "[REVIEW CLOSURE SKIP REFUSED] the emergency bypass requires an "
                "operator shell capability (HERDR_OPERATOR=1); task workers do "
                "not carry it",
                file=sys.stderr,
            )
            sys.exit(2)
        auth_ok, auth_why = review_closure.authenticate_operator(
            store, task, operator_id,
            token=operator_token,
            credentials_path=operator_credentials,
        )
        if not auth_ok:
            print(
                f"[REVIEW CLOSURE SKIP REFUSED] operator authentication failed: {auth_why}",
                file=sys.stderr,
            )
            sys.exit(2)
        head = review_closure.clone_head_sha(task.get("clone_path"))
        if not head:
            print(
                "[REVIEW CLOSURE SKIP REFUSED] cannot bind the bypass: the "
                "task clone/HEAD is unavailable (keep the clone retained or "
                "fix clone_path before bypassing)",
                file=sys.stderr,
            )
            sys.exit(2)
        store.record_event(
            "review_closure_skipped",
            {"task_id": task_id, "reason": reason, "head_sha": head, "operator": operator_id},
            task_id=task_id,
            workflow_id=task.get("workflow_id"),
            node_id=task.get("node") or task.get("stage"),
            source="herdr-task",
        )
        print(f"[REVIEW CLOSURE SKIPPED] {task_id}: completion allowed with audited bypass")
        return

    ok, why = review_closure.check_completion_allowed(store, task, bind_guard=False)
    if ok:
        print(f"[REVIEW CLOSURE RECEIPT] {task_id}: receipt present")
        return
    print(f"[REVIEW CLOSURE REQUIRED] {why}", file=sys.stderr)
    sys.exit(2)


def record_review_closure(task_id, pr_url=None, ci_status=None, findings=None,
                          deferred=False, reason=None, head_sha=None,
                          unresolved_p1=None, unresolved_p2=None):
    """Record the machine-readable review-closure receipt for a task.

    The receipt is what the completion transition validates for wrapup tasks:
    the head SHA it closed out (a later commit makes it stale) plus, for a
    normal closure, the delivery PR URL, ``ci_status=pass``, the structured
    unresolved P1/P2 counts (P1 must be 0) and a disposition text — or, for a
    deferred closure, a reason with the blocking evidence. Content is
    validated here so an unacceptable receipt can never be written; when the
    task clone is readable the supplied head must match its current HEAD.
    """
    from herdr import review_closure
    data = load_tasks()
    task = find_task(data, task_id)
    if not task:
        print(f"Task not found: {task_id}")
        sys.exit(1)
    payload = {
        "task_id": task_id,
        "pr_url": str(pr_url or "").strip(),
        "ci_status": str(ci_status or "").strip().lower(),
        "findings": str(findings or "").strip(),
        "deferred": bool(deferred),
        "reason": str(reason or "").strip(),
        "head_sha": str(head_sha or "").strip().lower(),
        "unresolved_p1": unresolved_p1,
        "unresolved_p2": unresolved_p2,
    }
    ok, why = review_closure.validate_receipt_payload(
        payload, require_verification=False,
    )
    if not ok:
        print(f"[REVIEW CLOSURE REFUSED] {why}", file=sys.stderr)
        sys.exit(2)
    current_head = review_closure.clone_head_sha(task.get("clone_path"))
    if current_head and current_head != payload["head_sha"]:
        print(
            f"[REVIEW CLOSURE REFUSED] --head-sha {payload['head_sha'][:12]} "
            f"does not match the task clone HEAD {current_head[:12]}; the "
            "receipt must certify the current reviewed head",
            file=sys.stderr,
        )
        sys.exit(2)
    store = _get_store()
    if not deferred:
        identity_why = review_closure.identity_mismatch(
            store, task, payload["pr_url"], payload["head_sha"],
        )
        if identity_why:
            print(
                f"[REVIEW CLOSURE REFUSED] delivery identity check failed: {identity_why}",
                file=sys.stderr,
            )
            sys.exit(2)
        verified, detail, verification = review_closure.verify_against_forge(
            payload["pr_url"], payload["head_sha"],
            declared_p2=payload.get("unresolved_p2"),
            findings=payload.get("findings"),
        )

        if not verified:
            print(
                f"[REVIEW CLOSURE REFUSED] forge verification failed: {detail}",
                file=sys.stderr,
            )
            sys.exit(2)
        payload["verification"] = verification
    else:
        evidence_ok, evidence_detail, evidence = review_closure.collect_deferred_evidence(store, task)
        if not evidence_ok:
            print(
                f"[REVIEW CLOSURE REFUSED] deferred is not justified: {evidence_detail}",
                file=sys.stderr,
            )
            sys.exit(2)
        payload["verification"] = evidence
    ok, why = review_closure.validate_receipt_payload(payload)
    if not ok:
        print(f"[REVIEW CLOSURE REFUSED] {why}", file=sys.stderr)
        sys.exit(2)
    store.record_event(
        "review_closure_recorded",
        payload,
        task_id=task_id,
        workflow_id=task.get("workflow_id"),
        node_id=task.get("node") or task.get("stage"),
        source="herdr-task",
    )
    print("[REVIEW CLOSURE RECORDED] " + json.dumps(payload, ensure_ascii=False))


def _is_gate_task(t):
    if not t:
        return False
    if t.get("gate") is False:
        return False

    workflow_id = t.get("workflow_id")
    node_id = t.get("node") or t.get("stage")

    # Authoritative workflow configuration check FIRST
    wf_cfg = None
    if workflow_id:
        try:
            from herdr.projects import workflow_config_for
            wf_cfg = workflow_config_for(workflow_id) or {}
        except Exception:
            pass
    if not wf_cfg and t.get("workflow_config") and node_id:
        try:
            import yaml
            from pathlib import Path
            p = Path(t["workflow_config"]).expanduser()
            if p.exists():
                with open(p, "r", encoding="utf-8") as f:
                    wf_cfg = yaml.safe_load(f) or {}
        except Exception:
            pass

    if wf_cfg and isinstance(wf_cfg, dict):
        for n in wf_cfg.get("nodes", []):
            if n.get("id") == node_id:
                if n.get("gate") or n.get("node_type") == "gate":
                    return True
                if n.get("node_type") in ("agent", "implementation", "worker", "code") and not n.get("gate"):
                    return False
                break

    if t.get("gate") is True:
        return True

    # Legacy fallback: exact names or word-boundary tokens, NOT arbitrary substring
    node = str(node_id or "").lower()
    if node in ("test", "review", "wrapup", "gate", "cleanroom", "cleanroom_test", "cleanroom_review", "cleanroom_gate"):
        return True
    if re.search(r"(^|[_-])(gate|cleanroom)($|[_-])", node):
        return True
    return bool(t.get("gate"))


def _gate_verdict_file_candidates(task):
    """PR #250 & Codex review: Return ordered list of candidate gate-verdict file paths."""
    candidates = []
    task_id = task.get("task_id") or task.get("id")
    if task_id:
        try:
            from herdr.direct_dispatch import gate_verdict_path
            candidates.append(gate_verdict_path(task_id))
        except Exception:
            pass
        override = os.environ.get("HERDR_GATE_VERDICT_DIR")
        vdir = Path(override).expanduser() if override else (Path.home() / ".herdr-controller" / "gate-verdicts")
        candidates.append(str(vdir / f"{task_id}.json"))

    clone_path = task.get("clone_path")
    if clone_path:
        candidates.append(os.path.join(clone_path, ".herdr/gate-verdict.json"))
        candidates.append(os.path.join(clone_path, ".herdr", "gate-verdict.json"))

    seen = set()
    result = []
    for c in candidates:
        if c and c not in seen:
            seen.add(c)
            result.append(c)
    return result


def _authenticate_gate_verdict_evidence(task, expected_verdict=None):
    """Authenticate durable gate verdict evidence from disk for task.

    Verifies that a valid gate verdict file exists for the task, belongs to
    the current execution epoch, has a fresh mtime (not older than rework_started_at,
    and not in the future beyond clock skew allowance), and matches expected_verdict.

    Returns (True, (verdict, note, affected_ids, st_mtime)) if valid and matches expected_verdict.
    Returns (False, err_msg) if missing, stale, invalid, or mismatched.
    """
    candidates = _gate_verdict_file_candidates(task)
    rework_started = task.get("rework_started_at")
    expected_token = task.get("execution_token") or task.get("rework_request_id")
    skew_limit = 5.0
    try:
        raw_skew = os.environ.get("HERDR_MAX_CLOCK_SKEW_SECONDS")
        if raw_skew is not None and raw_skew.strip():
            skew_limit = float(raw_skew.strip())
    except Exception:
        skew_limit = 5.0

    now = time.time()
    found_any = False
    last_err = "no durable gate verdict file found"

    for path in candidates:
        try:
            if not os.path.exists(path):
                continue
            found_any = True
            st = os.stat(path)
            if rework_started and st.st_mtime < (rework_started - 1.0):
                last_err = f"gate verdict file {path} is stale (mtime {st.st_mtime} < rework_started {rework_started})"
                continue
            if (st.st_mtime - now) > skew_limit:
                last_err = f"gate verdict file {path} has future timestamp exceeding clock skew allowance ({st.st_mtime - now:.1f}s > {skew_limit}s)"
                continue
            with open(path, "r", encoding="utf-8") as f:
                payload = json.load(f)
            if not isinstance(payload, dict):
                last_err = f"gate verdict file {path} is not a valid JSON dictionary"
                continue
            if expected_token:
                file_token = (
                    payload.get("execution_token")
                    or payload.get("rework_request_id")
                    or payload.get("rework_token")
                )
                if not file_token or file_token != expected_token:
                    # Codex Review Round 7 P2: Authenticate operator bypass receipts as a trusted path
                    bypass = payload.get("bypass")
                    tid = task.get("task_id") or task.get("id")
                    if bool(tid) and isinstance(bypass, dict) and (bypass.get("task_id") == tid) and bypass.get("bypass_id"):
                        pass
                    else:
                        last_err = f"execution token mismatch in {path} ({file_token} != {expected_token})"
                        continue
            file_v = str(payload.get("verdict") or "").strip().lower()
            if file_v not in ("pass", "blocked"):
                last_err = f"gate verdict file {path} contains invalid verdict: '{file_v}'"
                continue
            if expected_verdict:
                norm_exp = str(expected_verdict).strip().lower()
                if file_v != norm_exp:
                    return False, f"durable gate verdict on disk changed to '{file_v}' (expected '{norm_exp}')"
            note = str(payload.get("note") or "").strip()
            affected_ids = []
            if file_v == "blocked":
                raw_aff = payload.get("affected_task_ids")
                if raw_aff is not None:
                    if not isinstance(raw_aff, list):
                        print(
                            f"[ADOPT VERDICT WARN] Malformed affected_task_ids in {path}: "
                            f"expected list, got {type(raw_aff).__name__}; rejecting attribution",
                            file=sys.stderr,
                        )
                        affected_ids = []
                    else:
                        valid = True
                        ids = []
                        for item in raw_aff:
                            text = str(item).strip() if isinstance(item, str) else ""
                            if not text:
                                valid = False
                                break
                            if text not in ids:
                                ids.append(text)
                        if valid:
                            affected_ids = ids
                        else:
                            print(
                                f"[ADOPT VERDICT WARN] Malformed affected_task_ids in {path}: "
                                f"contains non-string or blank item; rejecting attribution",
                                file=sys.stderr,
                            )
                            affected_ids = []
            return True, (file_v, note, affected_ids, st.st_mtime)
        except Exception as exc:
            last_err = f"error inspecting gate verdict candidate {path}: {exc}"
            continue

    if not found_any:
        return False, "no durable gate verdict file found"
    return False, last_err


