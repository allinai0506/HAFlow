def _finalize_one(
    task,
    purge_clones=False,
    dry_run=False,
    close_claim=None,
    output_override="",
    reclaim_archive=None,
    reclaim_plan=None,
):
    from herdr.task_cli_teardown import finalize_one

    return finalize_one(
        task,
        purge_clones=purge_clones,
        dry_run=dry_run,
        close_claim=close_claim,
        output_override=output_override,
        reclaim_archive=reclaim_archive,
        reclaim_plan=reclaim_plan,
        deps={
            "clone_root": CLONE_ROOT,
            "finalize_advance": FINALIZE_ADVANCE,
            "advance_to_cleaned": _advance_to_cleaned,
            "close_owned_pane": _close_owned_pane,
            "close_task_identity": _close_task_identity,
            "get_store": _get_store,
            "record_output_retention": _record_output_retention,
            "teardown_output_guard": _teardown_output_guard,
            "clone_deletable": clone_deletable,
            "close_pane": close_pane,
            "delete_clone_safely": delete_clone_safely,
            "dump_transcript": dump_transcript,
            "set_status": set_status,
        },
    )


def finalize_task(task_id, force=False, purge_clones=False):
    from herdr.task_cli_delivery import finalize_task as handle_finalize

    return handle_finalize(
        task_id,
        force=force,
        purge_clones=purge_clones,
        load_tasks=load_tasks,
        find_task=find_task,
        teardown_blocking_statuses=TEARDOWN_BLOCKING_STATUSES,
        finalize_one=_finalize_one,
    )


