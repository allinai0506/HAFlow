def load_workflow(workflow_id=None):
    if workflow_id:
        try:
            store = get_state_store()
            wf = store.get_workflow(workflow_id)
            if wf:
                return normalize_workflow(wf)
        except Exception:
            pass
        workflow = workflow_config_for(workflow_id)
        if workflow:
            return workflow

    with open(WORKFLOW_FILE, "r", encoding="utf-8") as f:
        return normalize_workflow(json.load(f))


def resolve_node(node_id, workflow_id=None):
    if workflow_id:
        try:
            runtime = ensure_node_runtime(workflow_id, node_id)
            wf = load_workflow(workflow_id)
            next_stage = None
            for s in wf.get("stages", []):
                if (s.get("key") or s.get("id")) == node_id:
                    next_stage = s.get("next")
                    break
            return {
                "workspace_id": runtime["workspace_id"],
                "node_id": runtime["node_id"],
                "stage_key": runtime["node_id"],
                "stage_label": runtime["node_label"],
                "node_label": runtime["node_label"],
                "tab_id": runtime["tab_id"],
                "anchor_pane_id": runtime["anchor_pane_id"],
                "depends_on": runtime.get("depends_on", []),
                "next": next_stage,
                "agent_policy": runtime.get("agent_policy", {}),
                "purpose": runtime.get("purpose", ""),
                "default_integration_mode": runtime.get("default_integration_mode", "none"),
                "default_task_type": runtime.get("default_task_type", "docs"),
                "required_outputs": runtime.get("required_outputs", []),
                "rules": runtime.get("rules", []),
            }
        except Exception:
            # Fallback if Herdr daemon isn't running or during unit testing
            pass

    workflow = load_workflow(workflow_id)
    node = find_node(workflow, node_id)
    if node:
        anchor = node.get("anchor_pane_id")
        next_stage = None
        for s in workflow.get("stages", []):
            if (s.get("key") or s.get("id")) == node_id:
                next_stage = s.get("next")
                break
        return {
            "workspace_id": workflow.get("workspace_id", ""),
            "node_id": node["id"],
            "stage_key": node["id"],
            "stage_label": node["label"],
            "node_label": node["label"],
            "tab_id": node.get("tab_id"),
            "anchor_pane_id": anchor,
            "depends_on": node.get("depends_on", []),
            "agent_policy": node.get("agent_policy", {}),
            "next": next_stage,
        }

    for stage in workflow.get("stages", []):
        if stage.get("key") == node_id or stage.get("id") == node_id:
            return {
                "workspace_id": workflow.get("workspace_id", ""),
                "node_id": stage.get("key") or stage.get("id"),
                "stage_key": stage.get("key") or stage.get("id"),
                "stage_label": stage.get("label", ""),
                "node_label": stage.get("label", ""),
                "tab_id": stage.get("tab_id"),
                "anchor_pane_id": stage.get("anchor_pane_id"),
                "next": stage.get("next"),
            }

    raise RuntimeError(f"Unknown workflow node/stage: {node_id}")


resolve_stage = resolve_node


def _now():
    return time.time()


def _coerce_epoch(value):
    try:
        if value is None or value == "":
            return None
        return float(value)
    except (TypeError, ValueError):
        return None


def _init_status_history(task, initial_status, now):
    task["created_at"] = now
    task["updated_at"] = now
    task["last_activity_at"] = now
    task["status_history"] = [
        {
            "status": initial_status,
            "at": now,
            "from": None,
            "to": initial_status,
        }
    ]


def _append_status_history(task, old_status, new_status, now):
    history = task.get("status_history")
    if not isinstance(history, list):
        history = []
        if old_status:
            history.append(
                {
                    "status": old_status,
                    "at": task.get("updated_at") or now,
                    "from": None,
                    "to": old_status,
                }
            )
    history.append(
        {
            "status": new_status,
            "at": now,
            "from": old_status,
            "to": new_status,
        }
    )
    task["status_history"] = history


def _safe_float(value):
    return _coerce_epoch(value)


def _elapsed_seconds(started_at, now):
    started = _safe_float(started_at)
    if started is None:
        return None
    elapsed = now - started
    if elapsed < 0:
        return 0
    return round(elapsed, 2)


def _task_status_trajectory(task):
    history = task.get("status_history")
    if isinstance(history, list) and history:
        result = []
        for entry in history:
            if isinstance(entry, dict):
                status = entry.get("to") or entry.get("status")
            else:
                status = None

            if status and (not result or result[-1] != status):
                result.append(status)

        if result:
            return result

    status = task.get("status")
    return [status] if status else []


def _agent_runtime_status(pane_id):
    if not pane_id:
        return None

    try:
        proc = subprocess.run(
            ["herdr", "agent", "get", pane_id],
            text=True,
            capture_output=True,
            timeout=3,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    if proc.returncode != 0:
        return None

    try:
        return json.loads(proc.stdout).get("result", {}).get("agent", {}).get(
            "agent_status"
        )
    except Exception:
        return None


def _normalize_workflow_nodes(workflow):
    nodes = workflow.get("nodes")
    if nodes is None:
        nodes = workflow.get("stages", [])
    return [
        {
            "id": item.get("id") or item.get("key"),
            "label": item.get("label") or item.get("name") or item.get("id") or item.get("key"),
            "next": item.get("next"),
        }
        for item in nodes
        if (item.get("id") or item.get("key"))
    ]


def _node_task_status_counts(tasks_for_node):
    counts = {
        "total": 0,
        "active": 0,
        "blocked": 0,
        "failed": 0,
        "completed": 0,
        "superseded": 0,
    }

    for task in tasks_for_node:
        status = task.get("status")
        # Superseded tasks (replaced or abandoned) must not pollute the live
        # totals. Keep this predicate in sync with is_node_complete in
        # services/herdr-controller.py and node_status below.
        if status == "superseded" or task.get("superseded_by"):
            counts["superseded"] += 1
            continue
        counts["total"] += 1
        if status in ACTIVE_TASK_STATUSES or (status in ("pending",)):
            counts["active"] += 1
        if status == "blocked":
            counts["blocked"] += 1
        if status == "failed":
            counts["failed"] += 1
        if status in COMPLETED_TASK_STATUSES:
            counts["completed"] += 1

    return counts


def _task_healthy_status(task_status, runtime_status, load=0):
    if task_status in TERMINAL_STATUSES and task_status != "failed":
        return "READY" if load == 0 else "BUSY"

    if task_status in {"failed", "superseded"}:
        return "FAILED" if task_status == "failed" else "OFF"

    if task_status == "blocked":
        return "BLOCKED"

    if task_status in {"dispatched", "working", "rework", "agent_done"}:
        if runtime_status in {"working", "done", "active"}:
            return "BUSY"
        if runtime_status == "blocked":
            return "BLOCKED"
        if runtime_status in {"idle", None, "unknown"}:
            return "STALE"
        return "BUSY"

    if task_status == "idle":
        if load > 0:
            return "STALE"
        return "OFF"

    if task_status == "pending":
        return "READY" if runtime_status is None else "BUSY"

    return "READY"


def _trajectory_bucket(elapsed):
    if elapsed is None:
        return None
    if elapsed <= 600:
        return "normal"
    if elapsed <= 1800:
        return "slow"
    return "stuck"


def _task_summaries_for_ops(tasks, include_detail=False, now=None):
    now = _now() if now is None else float(now)
    summaries = []
    for task in tasks:
        started_at = _coerce_epoch(task.get("started_at") or task.get("created_at"))
        started_at = started_at if started_at is not None else None
        last_activity = (
            _coerce_epoch(task.get("last_activity_at"))
            or _coerce_epoch(task.get("updated_at"))
            or now
        )
        summary = {
            "task_id": task.get("task_id"),
            "agent": task.get("agent"),
            "status": task.get("status"),
            "node": task.get("node") or task.get("stage"),
            "started_at": started_at,
            "last_activity_at": last_activity,
            "elapsed": _elapsed_seconds(started_at, now),
            "elapsed_bucket": _trajectory_bucket(_elapsed_seconds(started_at, now)),
            "pane_id": task.get("pane_id"),
        }
        if include_detail:
            summary["status_trajectory"] = _task_status_trajectory(task)
        summaries.append(summary)
    return summaries


def _format_age(seconds):
    if seconds is None:
        return None
    if seconds < 60:
        return "刚刚"

    mins = int(seconds // 60)
    if mins < 60:
        return f"{mins}m ago"

    hours = mins // 60
    mins = mins % 60
    return f"{hours}h {mins}m ago"


def _collect_workflow_node_metadata(workflow):
    nodes = _normalize_workflow_nodes(workflow)
    node_meta = {}
    for node in nodes:
        node_id = node.get("id")
        if node_id:
            node_meta[node_id] = {
                "label": node.get("label", node_id),
                "next": node.get("next"),
            }
    return node_meta


def _safe_workflow(workflow_id):
    if not workflow_id:
        return None, "unknown-workflow"

    try:
        workflow = load_workflow(workflow_id)
        workflow_label = workflow.get("name") or workflow_id
        return workflow, workflow_label
    except Exception:
        return None, workflow_id


def _safe_text(value):
    return str(value) if value is not None else ""


def _anomaly_reason_text(task):
    return " ".join(
        part.lower()
        for part in [
            _safe_text(task.get("failure")),
            _safe_text(task.get("failure_reason")),
            _safe_text(task.get("error")),
            _safe_text(task.get("message")),
            _safe_text(task.get("result")),
            _safe_text(task.get("last_result")),
            _safe_text(task.get("sentinel_reason")),
        ]
        if part
    ).strip()


def _contains_any(source, *candidates):
    if not source:
        return False

    return any(candidate in source for candidate in candidates)


def _classify_task_anomalies(task, runtime_status, now):
    status = task.get("status")
    reason_text = _anomaly_reason_text(task)
    anomalies = []

    if status == "blocked":
        anomalies.append("BLOCKED")
    if status == "failed":
        if "auth" in reason_text or "login" in reason_text or "登录" in reason_text:
            anomalies.append("AUTH_REQUIRED")
        elif (
            "token" in reason_text
            and (
                "exhaust" in reason_text
                or "limit" in reason_text
                or "insufficient" in reason_text
                or "额度" in reason_text
            )
        ):
            anomalies.append("TOKEN_EXHAUSTED")
        elif "trust" in reason_text:
            anomalies.append("TRUST_REQUIRED")
        elif (
            "update" in reason_text
            and ("blocked" in reason_text or "阻塞" in reason_text or "失败" in reason_text)
        ):
            anomalies.append("UPDATE_BLOCKED")
        elif (
            "anchor" in reason_text
            and ("missing" in reason_text or "不存在" in reason_text)
        ):
            anomalies.append("ANCHOR_MISSING")
        elif (
            "pane" in reason_text
            and ("missing" in reason_text or "不存在" in reason_text or "找不到" in reason_text)
        ):
            anomalies.append("PANE_NOT_FOUND")
        elif _contains_any(
            reason_text,
            "agent_process_crash",
            "controller_recovery",
            "controller restart",
            "recovery",
        ):
            anomalies.append("CONTROLLER_RECOVERY")
        elif _coerce_epoch(task.get("failed_at")) is not None and (
            now - _coerce_epoch(task.get("failed_at")) > 180
        ):
            # 长时间失败后仍停留，不易恢复时，提升为控制器级异常提示。
            anomalies.append("CONTROLLER_RECOVERY")
        else:
            anomalies.append("FAILED")

    if status in ACTIVE_TASK_STATUSES:
        if not task.get("pane_id"):
            anomalies.append("PANE_NOT_FOUND")
        elif runtime_status is None:
            anomalies.append("CONTROLLER_RECOVERY")

    if status == "failed" and not anomalies:
        anomalies.append("FAILED")

    last_activity = _coerce_epoch(task.get("last_activity_at")) or _coerce_epoch(
        task.get("updated_at")
    ) or _coerce_epoch(task.get("created_at"))
    if (
        status in ("dispatched", "working", "agent_done", "rework", "blocked")
        and runtime_status in {"idle", "unknown", None}
        and last_activity is not None
        and (now - last_activity) > 600
    ):
        anomalies.append("BLOCKED")

    if (
        status in ("pending", "dispatched")
        and not task.get("acceptance_criteria")
        and last_activity is not None
        and (now - last_activity) > 1200
    ):
        anomalies.append("AUTH_REQUIRED")

    seen = []
    ordered = [
        "BLOCKED",
        "FAILED",
        "AUTH_REQUIRED",
        "TOKEN_EXHAUSTED",
        "TRUST_REQUIRED",
        "UPDATE_BLOCKED",
        "ANCHOR_MISSING",
        "PANE_NOT_FOUND",
        "CONTROLLER_RECOVERY",
    ]
    for kind in ordered:
        if kind in anomalies and kind not in seen:
            seen.append(kind)

    return seen


def _suggested_actions_for_anomaly(kind, task):
    actions = ANOMALY_ACTIONS.get(kind, [])
    pane_id = task.get("pane_id")
    task_id = task.get("task_id")
    links = {
        "open_task": f"herdr-task get {task_id}" if task_id else None,
        "open_pane": f"herdr pane read {pane_id} --source visible" if pane_id else None,
        "open_logs": f"herdr pane read {pane_id} --source logfile" if pane_id else None,
        "retry_task": f"herdr-task dispatch {task_id} --prompt \"<重新下发 prompt>\"" if task_id else None,
    }

    return {
        "kind": kind,
        "actions": [action for action in actions],
        "links": {k: v for k, v in links.items() if v},
    }


def _select_drilldown_task(tasks_for_node):
    def _sort_key(task):
        started = _coerce_epoch(task.get("started_at"))
        if started is None:
            started = 0
        last = _coerce_epoch(task.get("last_activity_at")) or _coerce_epoch(task.get("updated_at")) or 0
        return (task.get("status") in ACTIVE_TASK_STATUSES, last, started)

    selected = None
    for task in tasks_for_node:
        if task.get("status") == "failed":
            selected = task
            break
    if selected is not None:
        return selected

    candidates = [
        task for task in tasks_for_node
        if task.get("status") not in TERMINAL_STATUSES
    ]
    if not candidates:
        # All tasks terminal — prefer the latest authoritative task (the
        # replacement) so drilldown never lands on a retired one.
        authoritative = [
            task for task in tasks_for_node
            if task.get("status") != "superseded" and not task.get("superseded_by")
        ]
        pool = authoritative or tasks_for_node
        return max(
            pool,
            key=lambda task: (
                _coerce_epoch(task.get("updated_at"))
                or _coerce_epoch(task.get("last_activity_at"))
                or _coerce_epoch(task.get("created_at"))
                or 0
            ),
        )

    candidates.sort(key=_sort_key, reverse=True)
    return candidates[0]


def _build_workflow_cards(workflows_tasks, now):
    cards = []
    for workflow_id in sorted(workflows_tasks):
        wf_tasks = workflows_tasks.get(workflow_id, [])
        workflow, workflow_label = _safe_workflow(workflow_id)
        node_meta = _collect_workflow_node_metadata(workflow or {})

        all_nodes = {}
        for task in wf_tasks:
            node_id = task.get("node") or task.get("stage") or "unknown"
            all_nodes.setdefault(node_id, []).append(task)

        # 显示到 dashboard 时只做“卡片”层面的聚合，不直接展开所有 Task 明细。
        nodes = []
        completed = 0
        working = 0
        blocked = 0
        failed = 0
        superseded = 0
        total = 0

        for node_id, node_tasks in sorted(all_nodes.items()):
            counts = _node_task_status_counts(node_tasks)
            drilldown_task = _select_drilldown_task(node_tasks)
            total += counts["total"]
            working += counts["active"]
            completed += counts["completed"]
            blocked += counts["blocked"]
            failed += counts["failed"]
            superseded += counts["superseded"]
            status = "empty"
            if counts["total"] == 0 and counts["superseded"] > 0:
                # Every task on this node was replaced or abandoned — surface
                # it distinctly instead of masquerading as an empty node.
                status = "superseded"
            elif counts["failed"] > 0:
                status = "failed"
            elif counts["blocked"] > 0:
                status = "blocked"
            elif counts["completed"] == counts["total"] and counts["total"] > 0:
                status = "completed"
            elif counts["active"] > 0:
                status = "in_progress"
            elif counts["total"] > 0:
                status = "pending"

            node_summary = {
                "node_id": node_id,
                "node_label": (node_meta.get(node_id) or {}).get(
                    "label",
                    node_id,
                ),
                "total": counts["total"],
                "active": counts["active"],
                "completed": counts["completed"],
                "blocked": counts["blocked"],
                "failed": counts["failed"],
                "superseded": counts["superseded"],
                "status": status,
                "drilldown_task": drilldown_task.get("task_id") if drilldown_task else None,
            }
            nodes.append(node_summary)

        non_terminal = [
            task
            for task in wf_tasks
            if task.get("status") not in TERMINAL_STATUSES
        ]
        started = [
            _coerce_epoch(task.get("started_at"))
            or _coerce_epoch(task.get("created_at"))
            for task in non_terminal
            if _coerce_epoch(task.get("started_at"))
            or _coerce_epoch(task.get("created_at"))
        ]
        runtime = now - min(started) if started else None

        card = {
            "workflow_id": workflow_id,
            "workflow_label": workflow_label,
            "tasks": {
                "total": total,
                "active": working,
                "completed": completed,
                "blocked": blocked,
                "failed": failed,
                "superseded": superseded,
            },
            "runtime_seconds": round(runtime, 2) if runtime is not None else None,
            "runtime_bucket": _trajectory_bucket(runtime),
            "nodes": nodes,
        }
        cards.append(card)

    return cards


def _build_agent_fleet(tasks, now):
    seen = set()
    for task in tasks:
        agent = task.get("agent")
        if isinstance(agent, str) and agent.strip():
            seen.add(agent.strip())

    all_agents = sorted(set(KNOWN_AGENTS + [agent for agent in seen if agent]))
    task_by_agent = {}
    for task in tasks:
        agent = task.get("agent")
        if not agent:
            continue
        task_by_agent.setdefault(agent, []).append(task)

    fleet = []
    runtime_cache = {}
    for agent in all_agents:
        agent_tasks = task_by_agent.get(agent, [])
        active_tasks = [
            task
            for task in agent_tasks
            if task.get("status") not in TERMINAL_STATUSES
            and task.get("status") != "superseded"
        ]

        load = len(active_tasks)
        current_task = None
        for task in active_tasks:
            last = (
                _coerce_epoch(task.get("last_activity_at"))
                or _coerce_epoch(task.get("updated_at"))
                or _coerce_epoch(task.get("created_at"))
                or 0
            )
            candidate = task
            if current_task is None:
                current_task = candidate
                continue
            candidate_last = (
                _coerce_epoch(candidate.get("last_activity_at"))
                or _coerce_epoch(candidate.get("updated_at"))
                or _coerce_epoch(candidate.get("created_at"))
                or 0
            )
            current_last = (
                _coerce_epoch(current_task.get("last_activity_at"))
                or _coerce_epoch(current_task.get("updated_at"))
                or _coerce_epoch(current_task.get("created_at"))
                or 0
            )
            if candidate_last > current_last:
                current_task = candidate

        pane_id = current_task.get("pane_id") if current_task else None
        if pane_id and pane_id in runtime_cache:
            runtime_status = runtime_cache[pane_id]
        elif pane_id:
            runtime_status = _agent_runtime_status(pane_id)
            runtime_cache[pane_id] = runtime_status
        else:
            runtime_status = None

        current_task_status = current_task.get("status") if current_task else None
        current_task_id = current_task.get("task_id") if current_task else None
        last_activity = (
            _coerce_epoch(current_task.get("last_activity_at"))
            if current_task
            else None
        )
        if last_activity is None and current_task is not None:
            last_activity = (
                _coerce_epoch(current_task.get("updated_at"))
                or _coerce_epoch(current_task.get("created_at"))
            )

        started = None
        if current_task:
            started = _coerce_epoch(current_task.get("started_at")) or _coerce_epoch(
                current_task.get("created_at")
            )

        health = _task_healthy_status(current_task_status, runtime_status, load)
        is_stale = False
        if current_task_status in ACTIVE_TASK_STATUSES and runtime_status in {"idle", "unknown", None}:
            is_stale = True

        latest_result = None
        finished_candidates = [
            task for task in agent_tasks
            if task.get("status") in COMPLETED_TASK_STATUSES or task.get("status") == "failed"
        ]
        if finished_candidates:
            finished_candidates.sort(
                key=lambda item: (
                    _coerce_epoch(item.get("updated_at"))
                    or _coerce_epoch(item.get("last_activity_at"))
                    or 0
                )
            )
            latest_result = finished_candidates[-1].get("status")

        fleet.append(
            {
                "agent": agent,
                "health": health,
                "task_status": current_task_status,
                "current_task": current_task_id,
                "load": load,
                "runtime_seconds": _elapsed_seconds(started, now) if started else None,
                "runtime_bucket": _trajectory_bucket(
                    _elapsed_seconds(started, now) if started else None
                ),
                "last_result": latest_result or "-",
                "runtime_status": runtime_status,
                "last_event_seconds": (now - last_activity) if last_activity else None,
                "last_event": _format_age((now - last_activity) if last_activity else None),
                "stale": is_stale,
                "drilldown": {
                    "open_pane": f"herdr pane focus {pane_id}" if pane_id else None,
                },
            }
        )

    return sorted(
        fleet,
        key=lambda item: (-item["load"], item["agent"]),
    )


def _build_anomalies(tasks, now):
    anomalies = []
    runtime_cache = {}
    for task in tasks:
        if task.get("status") == "superseded":
            continue

        pane_id = task.get("pane_id")
        if pane_id and pane_id in runtime_cache:
            runtime_status = runtime_cache[pane_id]
        elif pane_id:
            runtime_status = _agent_runtime_status(pane_id)
            runtime_cache[pane_id] = runtime_status
        else:
            runtime_status = None

        kinds = _classify_task_anomalies(task, runtime_status, now)
        if not kinds:
            continue

        for kind in kinds:
            suggestion = _suggested_actions_for_anomaly(kind, task)
            last_activity = (
                _coerce_epoch(task.get("last_activity_at"))
                or _coerce_epoch(task.get("updated_at"))
                or _coerce_epoch(task.get("created_at"))
            )
            anomalies.append(
                {
                    "kind": kind,
                    "workflow_id": task.get("workflow_id"),
                    "task_id": task.get("task_id"),
                    "agent": task.get("agent"),
                    "node": task.get("node") or task.get("stage"),
                    "pane_id": task.get("pane_id"),
                    "last_event_seconds": (now - last_activity) if last_activity else None,
                    "last_event": _format_age((now - last_activity) if last_activity else None),
                    "actions": suggestion["actions"],
                    "links": suggestion["links"],
                }
            )

    return anomalies


def _build_boss_summary(tasks, workflows, anomalies):
    running_workflows = 0
    for workflow_id in workflows:
        wf_tasks = workflows.get(workflow_id, [])
        if any(
            task.get("status") in ACTIVE_TASK_STATUSES or task.get("status") in ("pending", "dispatched")
            for task in wf_tasks
            if task.get("status") != "superseded"
        ):
            running_workflows += 1

    working_agents = set()
    for task in tasks:
        if (
            task.get("status") in ACTIVE_TASK_STATUSES
            and task.get("status") != "superseded"
        ):
            working_agents.add(task.get("agent"))

    return {
        "working_agents": len([a for a in working_agents if a]),
        "running_workflows": running_workflows,
        "blocked_workflows": [
            workflow_id
            for workflow_id in sorted(workflows)
            if any(task.get("status") == "blocked" for task in workflows.get(workflow_id, []))
        ],
        "attention_required": len(anomalies),
    }


def _ops_center_payload(workflow_id=None, now=None, include_tasks=False):
    now = _now() if now is None else float(now)
    data = load_tasks()

    all_tasks = data.get("tasks", [])
    if workflow_id:
        workflow_ids = {workflow_id}
        tasks = [task for task in all_tasks if task.get("workflow_id") == workflow_id]
    else:
        tasks = all_tasks
        workflow_ids = {task.get("workflow_id") for task in tasks if task.get("workflow_id")}

    # 确保当前查询范围中至少有工作流分组，避免前端无法渲染卡片。
    if workflow_id and workflow_id not in workflow_ids:
        workflow_ids = {workflow_id}

    workflows = {wf_id: [] for wf_id in workflow_ids}
    for task in tasks:
        wf = task.get("workflow_id")
        if wf in workflows:
            workflows[wf].append(task)

    workflow_cards = _build_workflow_cards(workflows, now)
    agent_fleet = _build_agent_fleet(tasks, now)
    anomalies = _build_anomalies(tasks, now)
    boss = _build_boss_summary(tasks, workflows, anomalies)
    task_summaries = _task_summaries_for_ops(tasks, include_detail=include_tasks, now=now)

    payload = {
        "generated_at": int(now),
        "scope": workflow_id or "all",
        "boss": boss,
        "workflow_cards": workflow_cards,
        "agent_fleet": agent_fleet,
        "anomalies": anomalies,
    }

    if include_tasks:
        payload["task_summaries"] = task_summaries
        payload["count"] = len(task_summaries)
    else:
        payload["task_summaries"] = [
            {
                "task_id": item["task_id"],
                "agent": item["agent"],
                "status": item["status"],
                "node": item["node"],
                "elapsed": item["elapsed"],
                "last_event": _format_age(
                    now
                    - (
                        item["last_activity_at"]
                        if item["last_activity_at"] is not None
                        else now
                    )
                ),
            }
            for item in task_summaries
        ]
        payload["count"] = len(task_summaries)

    return payload


def ops_center(args):
    payload = _ops_center_payload(
        workflow_id=getattr(args, "workflow_id", None),
        include_tasks=getattr(args, "include_tasks", False),
    )
    print(json.dumps(payload, ensure_ascii=False, indent=2))


def _get_store():
    if os.environ.get("HERDR_STATE_DB"):
        return get_state_store(Path(os.environ["HERDR_STATE_DB"]))
    t_file = globals().get("TASKS_FILE") or os.environ.get("TASKS_FILE")
    if t_file:
        p = Path(t_file)
        db_path = p.parent / "state.db" if p.name == "tasks.json" else p.with_suffix(".db")
        if db_path.parent.exists():
            return get_state_store(db_path=db_path)
    wf_file = globals().get("WORKFLOW_FILE") or globals().get("WORKFLOWS_FILE") or os.environ.get("WORKFLOW_FILE") or os.environ.get("WORKFLOWS_FILE")
    if wf_file:
        p = Path(wf_file)
        db_path = p.parent / "state.db" if p.name in ("workflows.json", "workflow.json") else p.with_suffix(".db")
        if db_path.parent.exists():
            return get_state_store(db_path=db_path)
    return get_state_store()


def load_tasks():
    store = _get_store()
    return {"tasks": store.list_tasks()}


def save_tasks(data):
    store = _get_store()
    for t in data.get("tasks", []):
        if t.get("task_id"):
            store.save_task(t)

    # Sync backward-compatible JSON mirror (SQLite -> JSON only)
    t_file = globals().get("TASKS_FILE") or os.environ.get("TASKS_FILE")
    sync_tasks_projection(store=store, tasks_file=Path(t_file) if t_file else None)


def find_task(data, task_id):
    for task in data["tasks"]:
        if task["task_id"] == task_id:
            return task
    return None


def add_task(args):
    data = load_tasks()

    if find_task(data, args.task_id):
        print(f"Task already exists: {args.task_id}")
        sys.exit(1)

    node_id = getattr(args, "node", None) or getattr(args, "stage", None)
    if not node_id:
        print("Error: either --node or --stage is required")
        sys.exit(1)

    task = {
        "task_id": args.task_id,
        "workflow_id": args.workflow_id,
        "run_id": new_run_id(),
        "node": node_id,
        "stage": node_id,
        "workspace_id": args.workspace,
        "pane_id": args.pane,
        "agent": args.agent,
        "clone_path": args.clone,
        "integration_mode": args.integration_mode,
        "status": "pending",
        "goal": args.goal,
        "acceptance_criteria": args.acceptance,
    }
    now = _now()
    _init_status_history(
        task,
        "pending",
        now,
    )

    data["tasks"].append(task)
    save_tasks(data)

    trajectory_ledger = TrajectoryLedger(getattr(_get_store(), "db_path", None))
    record_trajectory_event_best_effort(
        task, "run_started", ledger=trajectory_ledger, status="pending"
    )
    record_trajectory_event_best_effort(
        task, "task_started", ledger=trajectory_ledger, status="pending"
    )

    print(f"Task registered: {args.task_id}")


def get_task(task_id):
    data = load_tasks()
    task = find_task(data, task_id)

    if not task:
        print(f"Task not found: {task_id}")
        sys.exit(1)

    print(
        json.dumps(
            task,
            ensure_ascii=False,
            indent=2
        )
    )


def cmd_observe(args):
    """Trajectory Observer 只读入口: 观察一个 Run 并输出结构化 Finding。

    旁路能力:只读 Trajectory/Runtime/日志,只写 trajectory_findings 分析表,
    绝不改变 Task/Workflow/Runtime 状态;没有任何证据时输出空 findings。
    """
    try:
        from herdr.observer import harness as observer_harness
        from herdr.trajectory import run_id_for_task
    except Exception as exc:
        print(f"[OBSERVE] observer unavailable: {exc}", file=sys.stderr)
        sys.exit(1)

    store = _get_store()
    task = None
    run_id = args.run_id

    if args.task_id:
        task = store.get_task(args.task_id)
        if not task:
            print(f"[OBSERVE] task not found: {args.task_id}", file=sys.stderr)
            sys.exit(1)
        if not run_id:
            run_id = run_id_for_task(task)
    # --run-id alone is enough: observe_run resolves the task (runtime/logs)
    # from the run's own trajectory facts.

    if not run_id:
        print("[OBSERVE] --run-id or --task-id is required", file=sys.stderr)
        sys.exit(2)

    findings = observer_harness.observe_run(
        run_id,
        task=task,
        store=store,
        use_model=not getattr(args, "no_model", False),
    )
    payload = [finding.to_mapping() for finding in findings]
    if getattr(args, "json", False):
        print(json.dumps({"run_id": run_id, "findings": payload}, ensure_ascii=False, indent=2))
        return
    if not findings:
        print(f"[OBSERVE] run={run_id} findings=0 (no evidence-backed problem detected)")
        return
    for finding in findings:
        print(
            f"[{finding.severity.upper()}] {finding.finding_type} "
            f"node={finding.node or '-'} action={finding.recommended_action} "
            f"confidence={finding.confidence:.2f}"
        )
        print(f"  {finding.summary}")
        for item in finding.evidence[:3]:
            print(f"  evidence: {json.dumps(item, ensure_ascii=False)}")


def cmd_compact(args):
    """Create a bounded ContextPack without mutating execution state."""
    from herdr.context_compact import compact_run

    store = _get_store()
    task = None
    if getattr(args, "task_id", None):
        task = store.get_task(args.task_id)
        if not task:
            print(f"[COMPACT] task not found: {args.task_id}", file=sys.stderr)
            sys.exit(1)
    try:
        provider = None
        if not getattr(args, "no_model", False):
            try:
                from herdr.observer.harness import get_provider
                provider = get_provider()
            except Exception as exc:
                print(f"[COMPACT] provider unavailable: {type(exc).__name__}: {exc}", file=sys.stderr)
        pack = compact_run(args.run_id, task=task, store=store, provider=provider)
    except Exception as exc:
        print(f"[COMPACT] failed: {type(exc).__name__}: {exc}", file=sys.stderr)
        sys.exit(1)
    if getattr(args, "json", False):
        print(json.dumps(pack.to_mapping(), ensure_ascii=False, indent=2))
        return
    print(f"ContextPack {pack.context_id} run={pack.run_id} sequence={pack.source_event_sequence}")
    print(f"Goal: {pack.goal or '-'}")
    print(f"State: {json.dumps(pack.current_state, ensure_ascii=False)}")
    print(f"Verified facts: {len(pack.verified_facts)} | Findings: {len(pack.important_findings)}")
    print(f"Evidence refs: {len(pack.evidence_refs)} | Artifact refs: {len(pack.artifact_refs)}")


def cmd_metrics(args):
    """Read-only, run-scoped Harness Metrics summary."""
    from herdr.metrics import get_run_metrics

    try:
        store = _get_store()
        metrics = get_run_metrics(args.run_id, db_path=getattr(store, "db_path", None))
    except ValueError as exc:
        print(f"[METRICS] {exc}", file=sys.stderr)
        sys.exit(2)
    except Exception as exc:
        print(f"[METRICS] failed: {type(exc).__name__}: {exc}", file=sys.stderr)
        sys.exit(1)

    if getattr(args, "json", False):
        print(json.dumps(metrics.to_mapping(), ensure_ascii=False, indent=2, sort_keys=True))
        return

    print(f"Harness Metrics run={metrics.run_id}")
    print(f"Status: {metrics.final_status or '-'} | completed={metrics.task_completed}")
    print(f"Wall time: {metrics.wall_time_seconds if metrics.wall_time_seconds is not None else '-'}s")
    print(f"Trajectory: {metrics.trajectory_events} | Observations: {metrics.observations_created} ({metrics.observation_bytes} bytes)")
    print(f"Findings: {metrics.findings_created} | Context packs: {metrics.context_packs_created}")
    print(f"Verification: {metrics.verification_passed}/{metrics.verification_total} passed, {metrics.verification_failed} failed")
    print(f"Model requests: {metrics.model_requests if metrics.model_requests is not None else 'unsupported'}")


def cmd_eval(args):
    """Evaluate one run; --record persists the fact via eval_store."""
    from herdr.eval_engine import evaluate_run, record_run_eval

    try:
        store = _get_store()
        db_path = getattr(store, "db_path", None)
        if getattr(args, "record", False):
            stored = record_run_eval(
                args.run_id, revision=getattr(args, "revision", None),
                db_path=db_path,
            )
            payload = stored
            label = "EVAL_RECORDED"
        else:
            payload = evaluate_run(args.run_id, db_path=db_path)
            label = "EVAL"
    except ValueError as exc:
        print(f"[EVAL] {exc}", file=sys.stderr)
        sys.exit(2)
    except Exception as exc:  # noqa: BLE001 -- CLI boundary reports and exits nonzero
        print(f"[EVAL] failed: {type(exc).__name__}: {exc}", file=sys.stderr)
        sys.exit(1)

    if getattr(args, "json", False):
        print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True))
        return
    verdict = payload.get("verdict")
    warnings = payload.get("warnings") or []
    print(f"[{label}] run={payload.get('run_id')} verdict={verdict} "
          f"final_status={payload.get('final_status')} "
          f"requirements_satisfied={payload.get('requirements_satisfied')} "
          f"verification_passed={payload.get('verification_passed')} "
          f"human_intervention_count={payload.get('human_intervention_count')}")
    if warnings:
        print(f"Warnings: {', '.join(str(w) for w in warnings)}")


def cmd_replay(args):
    """Replay a historical run; --dry-run plans without any write."""
    import json as _json

    from herdr.replay_engine import replay_run

    definition = None
    if getattr(args, "definition", None):
        try:
            definition = _json.loads(args.definition)
        except ValueError as exc:
            print(f"[REPLAY] invalid --definition JSON: {exc}", file=sys.stderr)
            sys.exit(2)
    elif getattr(args, "definition_file", None):
        try:
            definition = _json.loads(
                Path(args.definition_file).expanduser().read_text(encoding="utf-8")
            )
        except (OSError, ValueError) as exc:
            print(f"[REPLAY] cannot read --definition-file: {exc}", file=sys.stderr)
            sys.exit(2)

    policy = None
    if getattr(args, "policy", None):
        try:
            policy = _json.loads(args.policy)
        except ValueError as exc:
            print(f"[REPLAY] invalid --policy JSON: {exc}", file=sys.stderr)
            sys.exit(2)
        if not isinstance(policy, dict):
            print("[REPLAY] --policy must be a JSON object", file=sys.stderr)
            sys.exit(2)
    elif getattr(args, "policy_file", None):
        try:
            policy = _json.loads(
                Path(args.policy_file).expanduser().read_text(encoding="utf-8")
            )
        except (OSError, ValueError) as exc:
            print(f"[REPLAY] cannot read --policy-file: {exc}", file=sys.stderr)
            sys.exit(2)
        if not isinstance(policy, dict):
            print("[REPLAY] --policy-file must contain a JSON object", file=sys.stderr)
            sys.exit(2)

    try:
        store = _get_store()
        out = replay_run(
            args.source_run,
            replay_run_id=getattr(args, "replay_run", None),
            workflow_id=getattr(args, "workflow_id", None),
            task_id=getattr(args, "task_id", None),
            definition=definition,
            policy=policy,
            agent=getattr(args, "agent", None),
            goal=getattr(args, "goal", None),
            prompt=getattr(args, "prompt", None),
            source=getattr(args, "source", None) or "replay",
            launch=bool(getattr(args, "launch", False)),
            run_preflight=bool(getattr(args, "run_preflight", False)),
            dry_run=bool(getattr(args, "dry_run", False)),
            db_path=getattr(store, "db_path", None),
        )
    except ValueError as exc:
        print(f"[REPLAY] {exc}", file=sys.stderr)
        sys.exit(2)
    except Exception as exc:  # noqa: BLE001 -- CLI boundary reports and exits nonzero
        print(f"[REPLAY] failed: {type(exc).__name__}: {exc}", file=sys.stderr)
        sys.exit(1)

    if getattr(args, "json", False):
        print(json.dumps(out, ensure_ascii=False, indent=2, sort_keys=True, default=str))
        return
    mode = "DRY_RUN" if out.get("dry_run") else "REPLAYED"
    print(f"[REPLAY_{mode}] {out['spec']['source_run_id']} -> {out['spec']['replay_run_id']}")
    print(f"Workflow: {out.get('workflow_id')} | Snapshot: {out.get('snapshot') or '-'}")
    if out.get("launch_argv"):
        print(f"Launch: {' '.join(str(p) for p in out['launch_argv'])}")
    if out.get("preflight_argv"):
        print(f"Preflight: {' '.join(str(p) for p in out['preflight_argv'])}")
    if out.get("warnings"):
        print(f"Warnings: {', '.join(str(w) for w in out['warnings'])}")


def cmd_eval_compare(args):
    """Compare two recorded eval rows factually."""
    from herdr.eval_engine import compare_evals
    from herdr.eval_store import get_eval_result, get_latest_eval_result

    try:
        store = _get_store()
        db_path = getattr(store, "db_path", None)
        if getattr(args, "before_revision", None) is not None:
            before = get_eval_result(
                args.before_run, int(args.before_revision), db_path=db_path)
        else:
            before = get_latest_eval_result(args.before_run, db_path=db_path)
        if getattr(args, "after_revision", None) is not None:
            after = get_eval_result(
                args.after_run, int(args.after_revision), db_path=db_path)
        else:
            after = get_latest_eval_result(args.after_run, db_path=db_path)
        diff = compare_evals(before, after)
    except ValueError as exc:
        print(f"[EVAL_COMPARE] {exc}", file=sys.stderr)
        sys.exit(2)
    except Exception as exc:  # noqa: BLE001 -- CLI boundary reports and exits nonzero
        print(f"[EVAL_COMPARE] failed: {type(exc).__name__}: {exc}", file=sys.stderr)
        sys.exit(1)

    if getattr(args, "json", False):
        print(json.dumps(diff, ensure_ascii=False, indent=2, sort_keys=True))
        return
    print(f"[EVAL_COMPARE] {diff['verdict_transition']} changed={diff['verdict_changed']}")
    if diff.get("final_status_transition"):
        print(f"Final status: {diff['final_status_transition']} "
              f"changed={diff.get('final_status_changed')}")
    if diff.get("task_status_transition"):
        print(f"Task status: {diff['task_status_transition']} "
              f"changed={diff.get('task_status_changed')}")
    if diff.get("task_id_changed"):
        print(f"Task: {(diff.get('before') or {}).get('task_id')} -> "
              f"{(diff.get('after') or {}).get('task_id')}")
    if diff.get("workflow_id_changed"):
        print(f"Workflow: {(diff.get('before') or {}).get('workflow_id')} -> "
              f"{(diff.get('after') or {}).get('workflow_id')}")
    if diff.get("warnings_added"):
        print(f"Warnings added: {', '.join(diff['warnings_added'])}")
    if diff.get("warnings_removed"):
        print(f"Warnings removed: {', '.join(diff['warnings_removed'])}")


def set_status(task_id, new_status, verdict=None, note=None):
    data = load_tasks()
    task = find_task(data, task_id)

    if not task:
        print(f"Task not found: {task_id}")
        sys.exit(1)

    if new_status not in TRANSITIONS:
        print(f"Invalid status: {new_status}")
        sys.exit(1)

    if (verdict or note) and new_status != "completed":
        print("verdict/note only apply to 'set <task> completed'")
        sys.exit(2)

    if verdict == "blocked" and not (note or "").strip():
        print("blocked verdict requires --note with the blocker list")
        sys.exit(2)

    # 先写入字段再判同状态:同状态重复 set completed 补落 verdict 也要生效。
    if verdict:
        task["stage_verdict"] = verdict

    if note:
        task["stage_verdict_note"] = note

    old_status = task["status"]

    if old_status == new_status:
        if verdict or note:
            updates = {}
            if verdict:
                updates["stage_verdict"] = verdict
            if note:
                updates["stage_verdict_note"] = note
            store = _get_store()
            try:
                from herdr import kernel
                kernel.update_task_metadata(
                    task_id=task_id,
                    updates=updates,
                    store=store,
                )
            except Exception as exc:
                print(f"Error updating task {task_id}: {exc}", file=sys.stderr)
                sys.exit(2)

            if verdict:
                _record_gate_note(task, verdict, note)

            print(f"{task_id}: already {new_status}; verdict/note updated")
            return

        print(f"{task_id}: already {new_status}")
        return

    if new_status not in TRANSITIONS.get(old_status, set()):
        print(
            f"Illegal transition: "
            f"{task_id}: {old_status} -> {new_status}"
        )
        sys.exit(2)

    metadata = {}
    if verdict:
        metadata["stage_verdict"] = verdict
    if note:
        metadata["stage_verdict_note"] = note

    store = _get_store()
    try:
        from herdr import kernel
        res = kernel.transition_task(
            task_id=task_id,
            to_status=new_status,
            reason="cli_set_status",
            source="herdr-task",
            metadata=metadata,
            store=store,
        )
    except Exception as exc:
        print(f"Error transitioning task {task_id}: {exc}", file=sys.stderr)
        sys.exit(2)

    t_file = globals().get("TASKS_FILE") or os.environ.get("TASKS_FILE")
    sync_tasks_projection(store=store, tasks_file=Path(t_file) if t_file else None)

    if new_status in ACTIVE_TASK_STATUSES:
        _clear_suppress_auto_close(task.get("workflow_id") or res.get("workflow_id"))

    if verdict:
        _record_gate_note(task, verdict, note)

    print(f"{task_id}: {old_status} -> {new_status}")


def auto_init_task_loop(clone_path, goal, acceptance_list, test_cmd=None, lint_cmd=None, repro_cmd=None, node=None, task_type=None):
    """Auto-initialize .herdr-loop contract and evaluator inside the task clone."""
    # Skip auto-init for non-implementation/non-code nodes unless explicit test_cmd is provided
    if not test_cmd:
        if task_type in {"docs"}:
            return
        if node and any(k in str(node).lower() for k in ("review", "design", "doc", "wrapup")):
            return

    try:
        from herdr.evaluator import init_loop
    except Exception:
        return

    acceptance = "\n".join(f"- {a}" for a in acceptance_list) if acceptance_list else ""
    clone = Path(clone_path)

    # Detect test command if not provided
    if not test_cmd:
        if (clone / "package.json").exists():
            test_cmd = "npm test"
        elif (clone / "pytest.ini").exists() or (clone / "tests").is_dir():
            test_cmd = "pytest"
        elif (clone / "Cargo.toml").exists():
            test_cmd = "cargo test"

    # Detect lint command if not provided
    if not lint_cmd:
        if (clone / "package.json").exists():
            try:
                pkg_data = json.loads((clone / "package.json").read_text(encoding="utf-8"))
                if "lint" in pkg_data.get("scripts", {}):
                    lint_cmd = "npm run lint"
            except Exception:
                pass
        elif (clone / "pyproject.toml").exists():
            lint_cmd = "ruff check ."

    try:
        init_loop(
            target_dir=clone,
            goal=goal,
            acceptance=acceptance,
            test_cmd=test_cmd or "pytest",
            lint_cmd=lint_cmd or "true",
            repro_cmd=repro_cmd or "",
        )
    except Exception as e:
        print(f"[HERDR_LOOP_WARN] Failed to auto-init loop: {e}")
        return

    # Baseline-aware gate: snapshot pre-edit lint debt once at init.
    # Eval then gates only on NEW defects (current - baseline).
    # Best-effort: never fail task launch when snapshot is unavailable.
    try:
        from herdr.evaluator import parse_lint_output, write_baseline_lint
        snapshot_cmd = (lint_cmd or "true").strip() or "true"
        if snapshot_cmd != "true":
            proc = subprocess.run(
                snapshot_cmd,
                cwd=str(clone),
                text=True,
                capture_output=True,
                timeout=120,
                shell=True,
            )
            snapshot_output = (proc.stdout or "") + (proc.stderr or "")
            baseline_lint = parse_lint_output(snapshot_output, proc.returncode)
            write_baseline_lint(clone / ".herdr-loop", baseline_lint, 0)
    except Exception as e:
        print(f"[HERDR_LOOP_WARN] Failed to snapshot lint baseline: {e}")


def _launch_task(args):
    data = load_tasks()

    if find_task(data, args.task_id):
        print(f"Task already exists: {args.task_id}")
        sys.exit(1)

    node_id = getattr(args, "node", None) or getattr(args, "stage", None)
    if not node_id:
        print("Error: either --node or --stage is required")
        sys.exit(1)

    # Live topology is the source of truth.
    # Internal tab/pane IDs are repaired immediately before every Task launch.
    stage_config = ensure_stage_topology(
        args.workflow_id,
        node_id,
    )

    workspace_id = stage_config[
        "workspace_id"
    ]

    parent_pane = stage_config[
        "anchor_pane_id"
    ]

    project = project_for_workflow(
        args.workflow_id
    ) or {}

    exec_fields = execution_fields_from_workflow(project)
    try:
        validate_integration_for_execution(
            exec_fields["execution_mode"],
            args.integration_mode,
        )
        validate_onto_for_execution(
            exec_fields["execution_mode"],
            getattr(args, "onto", None),
        )
    except ValueError as exc:
        print(str(exc))
        sys.exit(2)

    source_repo = os.path.realpath(
        os.path.expanduser(
            project.get("project_root")
            or args.source
        )
    )

    base_branch = (
        project.get("base_branch")
        or "dev"
    )

    onto_branch = getattr(args, "onto", None)

    if onto_branch:
        try:
            ensure_branch_available(
                onto_branch,
                data.get("tasks", []),
                task_id=args.task_id,
            )
        except BranchOwnershipError as exc:
            print(f"[BRANCH OWNERSHIP ERROR] {exc}")
            sys.exit(2)

        # Fix-loop 续接:任务必须落在既有分支(如开放中的 PR 分支)上。
        fetch = subprocess.run(
            [
                "git", "-C", source_repo,
                "fetch", "origin", onto_branch,
            ],
            text=True,
            capture_output=True,
        )
        remote_ref = subprocess.run(
            [
                "git", "-C", source_repo,
                "rev-parse", "--verify", "--quiet",
                f"refs/remotes/origin/{onto_branch}",
            ],
            text=True,
            capture_output=True,
        )

        if fetch.returncode != 0 or remote_ref.returncode != 0:
            print(
                f"Onto branch not found on origin: {onto_branch}\n"
                f"{(fetch.stderr.strip() or fetch.stdout.strip())}"
            )
            sys.exit(2)

    requested_agent = args.agent if args.agent else "auto"

    resolved_agent = choose_agent(
        args.workflow_id,
        node_id,
        args.task_type,
        requested_agent,
        reservation_key=args.task_id,
    )

    prebuilt_pane = acquire_pane_for_task(
        args.workflow_id,
        node_id,
        resolved_agent,
    )

    # integration_mode=git 时，
    # 源仓库 tracked 文件必须 clean。
    # untracked 文件允许存在，因为 CoW Clone 需要保留完整上下文。
    if args.integration_mode == "git":
        source = os.path.realpath(
            os.path.expanduser(args.source)
        )

        tracked_status = subprocess.check_output(
            [
                "git",
                "-C",
                source,
                "status",
                "--porcelain",
                "--untracked-files=no"
            ],
            text=True
        ).strip()

        if tracked_status:
            print(
                "Source repository has tracked changes; "
                "refusing git-integrated Task:"
            )
            print(tracked_status)
            sys.exit(3)

    # 1. 创建 Clone + Pane + Agent
    worker_script = HERDR_ROOT / "services" / "herdr-worker.py"
    if not worker_script.exists():
        worker_script = Path(os.path.expanduser("~/HAFlow/services/herdr-worker.py"))

    worker_cmd = [
        str(worker_script),
        "--task-id", args.task_id,
        "--source", args.source,
        "--agent", resolved_agent,
        "--task-type", args.task_type,
    ]
    if exec_fields["execution_mode"] == "context":
        worker_cmd += [
            "--execution-mode", "context",
            "--context-json",
            json.dumps(exec_fields.get("context") or {}),
        ]
    else:
        worker_cmd += ["--base-branch", base_branch]

    try:
        from herdr import workflow_docs as wd
        worker_cmd += [
            "--shared-docs", str(wd.workflow_docs_dir(args.workflow_id))
        ]
    except Exception:
        pass

    if onto_branch:
        worker_cmd += ["--onto", onto_branch]

    if prebuilt_pane:
        worker_cmd += ["--pane-id", prebuilt_pane]
    else:
        worker_cmd += ["--parent-pane", parent_pane]

    worker = subprocess.run(
        worker_cmd,
        text=True,
        capture_output=True
    )

    if worker.returncode != 0:
        print(
            "Worker failed:",
            worker.stderr.strip()
            or worker.stdout.strip()
        )
        sys.exit(1)

    worker_result = None

    for line in worker.stdout.splitlines():
        if line.startswith("HERDR_WORKER_RESULT="):
            worker_result = json.loads(
                line.split("=", 1)[1]
            )
            break

    if not worker_result:
        print("Worker result not found")
        print(worker.stdout)
        sys.exit(1)

    clone_path = worker_result["clone"]
    branch = worker_result["branch"]
    try:
        ensure_branch_available(
            branch,
            data.get("tasks", []),
            task_id=args.task_id,
        )
    except BranchOwnershipError as exc:
        print(f"[BRANCH OWNERSHIP ERROR] {exc}")
        sys.exit(2)
    baseline_untracked = worker_result.get(
        "baseline_untracked",
        []
    )
    baseline_fingerprint = worker_result.get(
        "baseline_fingerprint",
        {
            "tracked": {},
            "untracked": {}
        }
    )
    pane_id = worker_result["pane_id"]
    pane_source = worker_result.get(
        "pane_source",
        "dynamic"
    )

    print(f"[WORKER] clone={clone_path}")
    print(f"[WORKER] pane={pane_id}")
    print(f"[WORKER] pane_source={pane_source}")
    print(f"[WORKER] agent={resolved_agent} requested={requested_agent}")

    # 2. 初始化工位自优化微循环 (.herdr-loop)
    auto_init_task_loop(
        clone_path,
        args.goal,
        args.acceptance,
        test_cmd=getattr(args, "test_cmd", None),
        lint_cmd=getattr(args, "lint_cmd", None),
        repro_cmd=getattr(args, "repro_cmd", None),
        node=node_id,
        task_type=args.task_type,
    )

    # 3. 注册 Task
    data = load_tasks()

    now = _now()
    run_id = new_run_id()

    # RuntimeState:只记录本次真实执行的位置证据,不改变任务编排字段。
    try:
        from herdr import runtime_state as _runtime_state
    except ImportError:
        _runtime_state = None

    runtime = None
    if _runtime_state is not None:
        runtime = _runtime_state.build_runtime_state(
            agent=resolved_agent,
            agent_session_id=worker_result.get("agent_session_id"),
            agent_name=worker_result.get("agent_name"),
            workspace_id=workspace_id,
            tab_id=stage_config.get("tab_id"),
            pane_id=pane_id,
            cwd=clone_path,
            status="running",
            now=now,
        )

    task = {
        "task_id": args.task_id,
        "workflow_id": args.workflow_id,
        "run_id": run_id,
        "project_id": project.get("project_id"),
        "project_name": project.get("project_name"),
        "source_repo": source_repo,
        "base_branch": base_branch,
        "coordinator_pane_id": project.get("coordinator_pane_id"),
        "workflow_config": project.get("workflow_file"),
        "node": node_id,
        "node_label": stage_config.get("node_label") or stage_config.get("stage_label", ""),
        "stage": node_id,
        "stage_label": stage_config.get("stage_label") or stage_config.get("node_label", ""),
        "tab_id": stage_config["tab_id"],
        "workspace_id": workspace_id,
        "pane_id": pane_id,
        "pane_source": pane_source,
        "pane_persistent": True,
        "agent": resolved_agent,
        "requested_agent": requested_agent,
        "clone_path": clone_path,
        "branch": branch,
        "baseline_untracked": baseline_untracked,
        "baseline_fingerprint": baseline_fingerprint,
        "integration_mode": args.integration_mode,
        "status": "pending",
        "goal": args.goal,
        "acceptance_criteria": args.acceptance,
    }
    if exec_fields["execution_mode"] == "context":
        # Git 模式任务记录保持字节级不变；context 附加字段仅在 context 模式出现。
        task["execution_mode"] = "context"
        task["context"] = exec_fields.get("context") or {}
    if runtime is not None:
        task["runtime"] = runtime
    _init_status_history(
        task,
        "pending",
        now,
    )

    data["tasks"].append(task)
    save_tasks(data)

    trajectory_ledger = TrajectoryLedger(getattr(_get_store(), "db_path", None))
    record_trajectory_event_best_effort(
        task, "run_started", ledger=trajectory_ledger, status="pending"
    )
    record_trajectory_event_best_effort(
        task, "task_started", ledger=trajectory_ledger, status="pending"
    )
    record_trajectory_event_best_effort(
        task,
        "agent_started",
        ledger=trajectory_ledger,
        status=(task.get("runtime") or {}).get("status") or "running",
    )

    release_agent_reservation(
        args.task_id
    )

    print(f"[REGISTERED] {args.task_id}")

    # 4. Dispatch
    dispatch_task(
        args.task_id,
        args.prompt
    )

def dispatch_task(task_id, prompt):
    # Reliable delivery protocol:
    # 1) try herdr agent prompt
    # 2) verify lifecycle / prompt marker
    # 3) if prompt is sitting in the composer, focus + Enter
    # 4) if it never arrived, focus + send-text + delayed Enter
    data = load_tasks()
    task = find_task(data, task_id)

    if not task:
        print(f"Task not found: {task_id}")
        sys.exit(1)

    if task["status"] != "pending":
        print(
            f"Task cannot dispatch from status: "
            f"{task['status']}"
        )
        sys.exit(2)

    loop_dir = Path(task.get("clone_path", "")) / ".herdr-loop"
    loop_suffix = ""
    if loop_dir.exists():
        loop_suffix = (
            "\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"
            + "【工位内循环铁律 - Inner Loop Protocol】\n"
            + "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"
            + "工位已装配量化评估环境，请严格遵循以下工作法则：\n\n"
            + "【正常完成流程】\n"
            + "1. 阅读 .herdr-loop/GOAL.md 了解目标契约与验收标准；\n"
            + "2. 实现或修改代码；\n"
            + "3. 运行自检评估：~/HAFlow/bin/herdr-loop eval\n"
            + "   → 查看 .herdr-loop/EVALUATION.md 了解失败原因；\n"
            + "4. 若自检未通过（得分 < 100.0），继续就地修改，回到步骤 2；\n"
            + "5. 自检 100% 通过后，方可输出完成标记。\n\n"
            + "【铁律禁止项】\n"
            + "❌ 严禁在自检未通过前输出完成标记（HERDR_TASK_DONE）；\n"
            + "❌ 严禁在自检未通过时放弃工位或声称无法继续；\n"
            + "❌ 严禁向上层汇报局部问题（如单个语法错误）—— 工位负责就地解决；\n\n"
            + "【熔断求助流程（连续自愈失败≥3次）】\n"
            + "若遇到外部依赖或环境障碍导致连续 3 次自愈仍未通过，执行以下步骤：\n"
            + "1. 运行 ~/HAFlow/bin/herdr-loop eval 更新最终评分；\n"
            + "2. 检查 .herdr-loop/STATE.md，若 status=exhausted，说明已达上限；\n"
            + "3. 在终端输出求助总结（包含复现路径与阻碍点）；\n"
            + "4. 在终端单独输出一行：HERDR_TASK_BLOCKER:" + task_id + "\n"
            + "   （表示工位主动请求总指挥仲裁，等待外部指示）；\n"
            + "5. 不要输出 HERDR_TASK_DONE，静默等待。\n"
        )

    context_suffix = ""
    if task.get("execution_mode") == "context":
        block = render_context_reference_block(task.get("context") or {})
        if block:
            context_suffix = "\n\n" + block + "\n"

    prompt = (
        prompt
        + context_suffix
        + loop_suffix
        + "\nHERDR orchestration protocol:\n"
        + "HERDR_ORCH_TASK:" + task_id + "\n"
        + "When all requested work is genuinely finished, output on its own line "
        + "the prefix HERDR_TASK_DONE: followed immediately by this task id. "
        + "Do not quote it and do not output it before the task is complete.\n"
    )

    pane_id = task["pane_id"]
    marker = "HERDR_ORCH_TASK:" + task_id

    def _run(cmd, timeout=None):
        try:
            return subprocess.run(
                cmd,
                text=True,
                capture_output=True,
                timeout=timeout,
            )
        except subprocess.TimeoutExpired as exc:
            return subprocess.CompletedProcess(
                cmd, 124, "", f"command timed out after {timeout}s: {exc}"
            )

    def _status():
        r = _run(["herdr", "agent", "get", pane_id])
        if r.returncode != 0:
            return None
        try:
            return json.loads(r.stdout)["result"]["agent"].get("agent_status")
        except Exception:
            return None

    def _visible():
        r = _run([
            "herdr", "pane", "read",
            pane_id,
            "--source", "visible"
        ])
        return (r.stdout or "") + "\n" + (r.stderr or "")

    def _focus():
        _run(["herdr", "agent", "focus", pane_id])
        time.sleep(0.25)

    def _press_enter():
        return _run([
            "herdr", "pane", "send-keys",
            pane_id, "enter"
        ])

    def _send_full_prompt():
        _focus()
        r1 = _run([
            "herdr", "pane", "send-text",
            pane_id, prompt
        ])
        time.sleep(0.35)
        r2 = _press_enter()
        return r1.returncode == 0 and r2.returncode == 0

    # Clear previous conversation context before dispatching new task.
    # Sends /clear to reset agent history so each task starts with a clean slate.
    _run(["herdr", "agent", "focus", pane_id])
    time.sleep(0.25)
    _run(["herdr", "pane", "send-text", pane_id, "/clear"])
    _run(["herdr", "pane", "send-keys", pane_id, "enter"])
    print(f"[CONTEXT CLEAR] task={task_id} pane={pane_id}")

    # Wait for /clear to complete (agent returns to idle)
    clear_deadline = time.time() + 8
    while time.time() < clear_deadline:
        state = _status()
        if state in {"idle", None}:
            break
        time.sleep(0.4)

    set_status(task_id, "dispatched")
    time.sleep(1.5)

    primary = _run(
        [
            "herdr",
            "agent",
            "prompt",
            pane_id,
            prompt,
        ],
        timeout=PROMPT_DELIVERY_TIMEOUT,
    )
    if primary.returncode == 124:
        print(f"[PROMPT TIMEOUT] task={task_id} pane={pane_id} after={PROMPT_DELIVERY_TIMEOUT}s")

    deadline = time.time() + 6
    while time.time() < deadline:
        state = _status()
        screen = _visible()

        if state in {"working", "blocked", "done"}:
            print(f"[PROMPT DELIVERED] task={task_id} via=agent-prompt state={state}")
            print(f"Task dispatched: {task_id} -> {pane_id}")
            return

        if marker in screen and state in {"idle", "unknown", None}:
            _focus()
            _press_enter()
            time.sleep(1.0)

            state2 = _status()
            if state2 in {"working", "blocked", "done"}:
                print(f"[PROMPT DELIVERED] task={task_id} via=enter-fallback state={state2}")
                print(f"Task dispatched: {task_id} -> {pane_id}")
                return

        time.sleep(0.5)

    if marker not in _visible():
        ok = _send_full_prompt()
        if not ok:
            set_status(task_id, "failed")
            print(
                f"Prompt delivery failed for {task_id}: "
                f"{primary.stderr or primary.stdout}"
            )
            sys.exit(3)
        print(f"[PROMPT FALLBACK] task={task_id} via=send-text+enter")
    else:
        print(f"[PROMPT PENDING] task={task_id} marker-visible; sentinel will monitor")

    print(f"Task dispatched: {task_id} -> {pane_id}")


INTERNAL_UNTRACKED_EXACT = {".agent-task-context", ".herdr-loop", ".herdr"}
INTERNAL_UNTRACKED_PREFIXES = (".herdr-loop/", ".herdr/")


def _is_internal_untracked(path):
    if path in INTERNAL_UNTRACKED_EXACT:
        return True

    return path.startswith(INTERNAL_UNTRACKED_PREFIXES)


def fingerprint_file(repo, relpath):
    path = Path(repo) / relpath

    if not path.exists() and not path.is_symlink():
        return "__MISSING__"

    if path.is_symlink():
        return "symlink:" + os.readlink(path)

    if not path.is_file():
        return "__NON_FILE__"

    h = hashlib.sha256()

    with path.open("rb") as f:
        while True:
            chunk = f.read(1024 * 1024)

            if not chunk:
                break

            h.update(chunk)

    return h.hexdigest()


def current_workspace_fingerprint(repo):
    tracked_result = subprocess.run(
        [
            "git",
            "-C",
            repo,
            "diff",
            "--name-only",
            "-z",
            "HEAD",
            "--"
        ],
        text=True,
        capture_output=True
    )

    if tracked_result.returncode != 0:
        raise RuntimeError(
            tracked_result.stderr.strip()
            or tracked_result.stdout.strip()
        )

    tracked_paths = [
        item
        for item in tracked_result.stdout.split("\0")
        if item
    ]

    untracked_result = subprocess.run(
        [
            "git",
            "-C",
            repo,
            "ls-files",
            "--others",
            "--exclude-standard",
            "-z"
        ],
        text=True,
        capture_output=True
    )

    if untracked_result.returncode != 0:
        raise RuntimeError(
            untracked_result.stderr.strip()
            or untracked_result.stdout.strip()
        )

    untracked_paths = [
        item
        for item in untracked_result.stdout.split("\0")
        if item and not _is_internal_untracked(item)
    ]

    return {
        "tracked": {
            p: fingerprint_file(repo, p)
            for p in tracked_paths
        },
        "untracked": {
            p: fingerprint_file(repo, p)
            for p in untracked_paths
        }
    }


def execution_fields_from_workflow(workflow_record):
    """Workflow 记录 → Task 继承的执行契约字段（纯函数）。

    legacy/git 工作流只返回 execution_mode=git；context 工作流附带 binding。
    """
    record = workflow_record or {}
    fields = {"execution_mode": execution_mode(record)}
    if fields["execution_mode"] == "context":
        fields["context"] = dict(record.get("context") or {})
    return fields


def context_workspace_fingerprint(repo):
    """非 Git Task Workspace 的文件指纹：全部按 untracked 计，忽略内部装配文件。"""
    repo_path = Path(repo)
    untracked = {}

    for path in sorted(repo_path.rglob("*")):
        if path.is_dir():
            continue
        rel = path.relative_to(repo_path).as_posix()
        top = rel.split("/", 1)[0]
        if top in (".agent-task-context", ".herdr-loop", ".git"):
            continue
        if _is_internal_untracked(rel):
            continue
        untracked[rel] = fingerprint_file(repo, rel)

    return {"tracked": {}, "untracked": untracked}


def verify_baseline(task_id):
    data = load_tasks()
    task = find_task(data, task_id)

    if not task:
        print(f"Task not found: {task_id}")
        sys.exit(1)

    clone = task.get("clone_path")

    if not clone or not os.path.isdir(clone):
        print(f"Clone not found: {clone}")
        sys.exit(2)

    baseline = task.get("baseline_fingerprint")

    if baseline is None:
        print(
            f"Task has no baseline_fingerprint: "
            f"{task_id}"
        )
        sys.exit(3)

    current = (
        context_workspace_fingerprint(clone)
        if task.get("execution_mode") == "context"
        else current_workspace_fingerprint(clone)
    )

    changes = []

    for kind in ("tracked", "untracked"):
        before = baseline.get(kind, {})
        after = current.get(kind, {})

        all_paths = sorted(
            set(before.keys()) | set(after.keys())
        )

        for relpath in all_paths:
            old = before.get(
                relpath,
                "__NOT_PRESENT__"
            )
            new = after.get(
                relpath,
                "__NOT_PRESENT__"
            )

            if old != new:
                changes.append({
                    "type": kind,
                    "path": relpath,
                    "baseline": old,
                    "current": new
                })

    if not changes:
        print("BASELINE_MATCH")
        return

    print("TASK_CHANGED:")

    for item in changes:
        print(
            f"- [{item['type']}] "
            f"{item['path']}"
        )

    print(
        "HERDR_BASELINE_RESULT="
        + json.dumps(
            {
                "task_id": task_id,
                "baseline_match": False,
                "changes": changes
            },
            ensure_ascii=False
        )
    )


def verify_metrics(task_id, min_score=99.9, if_present=False):
    """Verify that .herdr-loop/METRICS.json exists and meets required score threshold."""
    data = load_tasks()
    task = find_task(data, task_id)

    if not task:
        print(f"Task not found: {task_id}")
        sys.exit(1)

    clone = task.get("clone_path")
    if not clone or not os.path.isdir(clone):
        print(f"Clone not found: {clone}")
        sys.exit(2)

    loop_dir = Path(clone) / ".herdr-loop"
    metrics_file = loop_dir / "METRICS.json"

    if not metrics_file.exists():
        if if_present:
            print(f"TASK_METRICS: skipped (no .herdr-loop configured for task {task_id})")
            sys.exit(0)
        print(f"No metrics found for task {task_id} (.herdr-loop/METRICS.json missing)")
        sys.exit(3)

    try:
        metrics_data = json.loads(metrics_file.read_text(encoding="utf-8"))
    except Exception as e:
        print(f"Invalid metrics file: {e}")
        sys.exit(4)

    score = float(metrics_data.get("composite_score", 0.0))
    passed = score >= min_score

    print(f"TASK_METRICS: score={score:.2f} (target>={min_score:.2f}) passed={passed}")
    print(
        "HERDR_METRICS_RESULT="
        + json.dumps(
            {
                "task_id": task_id,
                "score": score,
                "target": min_score,
                "passed": passed,
                "metrics": metrics_data,
            },
            ensure_ascii=False,
        )
    )

    if not passed:
        sys.exit(5)


def _with_git_operation_lock(*, include_source_repo=False):
    """Serialize Git operations and fail closed while another Git process runs."""
    def decorate(func):
        @wraps(func)
        def wrapped(task_id, *args, **kwargs):
            task = find_task(load_tasks(), task_id)
            paths = []
            if task and task.get("clone_path"):
                paths.append(task["clone_path"])
            if include_source_repo and task:
                project = project_for_workflow(task.get("workflow_id")) or {}
                source = task.get("source_repo") or project.get("project_root")
                if source:
                    paths.append(source)
            try:
                with ExitStack() as stack:
                    locks = []
                    for path in dict.fromkeys(paths):
                        lock = GitOperationLock(path)
                        lock.acquire()
                        stack.callback(lock.release)
                        locks.append(path)
                    for path in locks:
                        ensure_no_git_processes(path)
                    return func(task_id, *args, **kwargs)
            except (GitOperationBusyError, GitProcessActiveError) as exc:
                print(f"[GIT BUSY] task={task_id}: {exc}")
                sys.exit(75)
        return wrapped
    return decorate


def launch_task(args):
    """Serialize launch-time branch ownership check and task registration."""
    source = getattr(args, "source", None)
    if not source:
        return _launch_task(args)
    try:
        with GitOperationLock(source):
            ensure_no_git_processes(source)
            return _launch_task(args)
    except (GitOperationBusyError, GitProcessActiveError) as exc:
        print(f"[GIT BUSY] launch: {exc}")
        sys.exit(75)


@_with_git_operation_lock()
def commit_task(task_id, message=None):
    data = load_tasks()
    task = find_task(data, task_id)

    if not task:
        print(f"Task not found: {task_id}")
        sys.exit(1)

    if task.get("execution_mode") == "context":
        print(
            f"Context-mode task has no git commit path; "
            f"deliverables live in task workspace: {task_id}"
        )
        sys.exit(2)

    if task["status"] != "completed":
        print(
            f"Task cannot commit from status: "
            f"{task['status']}"
        )
        sys.exit(2)

    clone = task.get("clone_path")

    if not clone:
        print("Task missing clone_path")
        sys.exit(1)

    clone = os.path.realpath(
        os.path.expanduser(clone)
    )

    baseline_untracked = set(
        task.get("baseline_untracked", [])
    )

    # 当前 untracked
    result = subprocess.run(
        [
            "git",
            "-C",
            clone,
            "ls-files",
            "--others",
            "--exclude-standard",
            "-z"
        ],
        text=True,
        capture_output=True
    )

    if result.returncode != 0:
        print(result.stderr.strip())
        sys.exit(1)

    current_untracked = {
        item
        for item in result.stdout.split("\0")
        if item
    }

    # 只允许提交 Task 新产生的 untracked（内部控制文件不属于业务交付）
    task_untracked = sorted(
        item
        for item in current_untracked - baseline_untracked
        if not _is_internal_untracked(item)
    )

    # tracked 文件在 Task 创建前要求 clean，
    # 因此当前 tracked 修改全部属于该 Task。
    subprocess.run(
        [
            "git",
            "-C",
            clone,
            "add",
            "-u"
        ],
        check=True
    )

    if task_untracked:
        subprocess.run(
            [
                "git",
                "-C",
                clone,
                "add",
                "--",
                *task_untracked
            ],
            check=True
        )

    # 必须确实存在 staged changes
    staged = subprocess.run(
        [
            "git",
            "-C",
            clone,
            "diff",
            "--cached",
            "--quiet"
        ]
    )

    if staged.returncode == 0:
        print(
            f"Task has no changes to commit: "
            f"{task_id}"
        )
        sys.exit(3)

    if message is None:
        message = f"task: {task_id}"

    result = subprocess.run(
        [
            "git",
            "-C",
            clone,
            "commit",
            "-m",
            message
        ],
        text=True
    )

    if result.returncode != 0:
        print(
            f"Commit failed: {task_id}"
        )
        sys.exit(result.returncode)

    commit_hash = subprocess.check_output(
        [
            "git",
            "-C",
            clone,
            "rev-parse",
            "HEAD"
        ],
        text=True
    ).strip()

    # 保存 commit hash
    from herdr import kernel
    kernel.update_task_metadata(task_id, {"commit": commit_hash}, store=_get_store())

    set_status(
        task_id,
        "committed"
    )

    print(f"[COMMITTED] {task_id}")
    print(f"[COMMIT] {commit_hash}")


@_with_git_operation_lock(include_source_repo=True)
def integrate_task(task_id):
    data = load_tasks()
    task = find_task(data, task_id)

    if not task:
        print(f"Task not found: {task_id}")
        sys.exit(1)

    if task.get("execution_mode") == "context":
        print(
            f"Context-mode task has no git integrate path; "
            f"deliverables live in task workspace: {task_id}"
        )
        sys.exit(2)

    if task["status"] != "committed":
        print(
            f"Task cannot integrate from status: "
            f"{task['status']}"
        )
        sys.exit(2)

    clone = task.get("clone_path")
    branch = task.get("branch")

    if not clone or not branch:
        print("Task missing clone_path or branch")
        sys.exit(1)

    clone = os.path.realpath(
        os.path.expanduser(clone)
    )

    baseline = task.get("baseline_fingerprint")
    if baseline is None:
        print(
            f"Task has no baseline_fingerprint: "
            f"{task_id}"
        )
        sys.exit(3)

    current = current_workspace_fingerprint(clone)

    if current != baseline:
        print(
            "Clone working tree differs from "
            "Task baseline after commit:"
        )

        for kind in ("tracked", "untracked"):
            before = baseline.get(kind, {})
            after = current.get(kind, {})
            for relpath in sorted(set(before) | set(after)):
                if (
                    before.get(relpath, "__NOT_PRESENT__")
                    != after.get(relpath, "__NOT_PRESENT__")
                ):
                    print(f"- [{kind}] {relpath}")

        sys.exit(3)

    print("[BASELINE RESTORED] working tree matches Task baseline")

    project = project_for_workflow(
        task.get("workflow_id")
    ) or {}

    base_branch = (
        task.get("base_branch")
        or project.get("base_branch")
        or "dev"
    )

    main_repo = (
        task.get("source_repo")
        or project.get("project_root")
    )

    if not main_repo:
        print("Task missing source_repo/project_root")
        sys.exit(4)

    main_repo = os.path.realpath(
        os.path.expanduser(main_repo)
    )

    try:
        ensure_branch_available(
            branch,
            data.get("tasks", []),
            task_id=task_id,
        )
    except BranchOwnershipError as exc:
        print(f"[BRANCH OWNERSHIP ERROR] {exc}")
        sys.exit(5)

    subprocess.run(
        [
            "git",
            "-C",
            clone,
            "fetch",
            "origin",
            base_branch
        ],
        check=True
    )

    subprocess.run(
        [
            "git",
            "-C",
            clone,
            "rebase",
            f"origin/{base_branch}"
        ],
        check=True
    )

    relation = subprocess.check_output(
        [
            "git",
            "-C",
            clone,
            "rev-list",
            "--left-right",
            "--count",
            f"origin/{base_branch}...HEAD"
        ],
        text=True
    ).strip().split()

    if len(relation) != 2 or relation[0] != "0":
        print(
            "Task branch is not based cleanly "
            f"on latest origin/{base_branch}"
        )
        sys.exit(4)

    herdr_ref = f"refs/herdr/tasks/{task_id}"

    subprocess.run(
        [
            "git",
            "-C",
            main_repo,
            "fetch",
            clone,
            f"{branch}:{herdr_ref}",
            "--force"
        ],
        check=True
    )

    subprocess.run(
        [
            "git",
            "-C",
            main_repo,
            "branch",
            "-f",
            branch,
            herdr_ref
        ],
        check=True
    )

    integration_branch = (
        f"herdr/integration-{task_id}"
    )

    # Integration only updates refs. Tracked edits remain protected, while
    # unrelated untracked files no longer participate in the operation.
    tracked_status = subprocess.check_output(
        [
            "git",
            "-C",
            main_repo,
            "status",
            "--porcelain",
            "--untracked-files=no"
        ],
        text=True
    ).strip()

    if tracked_status:
        print("Main repository has tracked changes")
        print(tracked_status)
        sys.exit(5)

    subprocess.run(
        [
            "git",
            "-C",
            main_repo,
            "update-ref",
            f"refs/heads/{integration_branch}",
            herdr_ref,
        ],
        check=True,
    )

    from herdr import kernel
    kernel.update_task_metadata(task_id, {
        "integration_branch": integration_branch,
        "integration_ref": herdr_ref,
        "base_branch": base_branch,
        "source_repo": main_repo,
    }, store=_get_store())

    set_status(
        task_id,
        "integrated"
    )

    print(f"[INTEGRATED] {task_id}")
    print(f"[PROJECT] {main_repo}")
    print(f"[BASE BRANCH] {base_branch}")
    print(f"[TASK BRANCH] {branch}")
    print(f"[INTEGRATION BRANCH] {integration_branch}")
    print(f"[HERDR REF] {herdr_ref}")

def cleanup_task(task_id):
    data = load_tasks()
    task = find_task(data, task_id)

    if not task:
        print(f"Task not found: {task_id}")
        sys.exit(1)

    if task["status"] != "cleanup_ready":
        print(
            f"Task cannot cleanup from status: "
            f"{task['status']}"
        )
        sys.exit(2)

    # Logical cleanup only.
    # Workspace / Stage Tab / Task Pane / Task Clone are retained.
    from herdr import kernel
    kernel.update_task_metadata(task_id, {
        "resource_retention": "persistent",
        "pane_retained": True,
        "clone_retained": True,
    }, store=_get_store())

    set_status(
        task_id,
        "cleaned"
    )

    print(f"[PANE RETAINED] {task.get('pane_id')}")
    print(f"[CLONE RETAINED] {task.get('clone_path')}")
    print(f"[LOGICAL CLEANUP] {task_id} -> cleaned")


def purge_task(task_id):
    data = load_tasks()
    task = find_task(data, task_id)

    if not task:
        print(f"Task not found: {task_id}")
        sys.exit(1)

    if task.get("status") in TEARDOWN_BLOCKING_STATUSES:
        print(
            f"Task can only purge from a settled status, "
            f"current={task.get('status')}"
        )
        sys.exit(2)

    pane_id = task.get("pane_id")
    clone_path = task.get("clone_path")

    if pane_id:
        subprocess.run(
            [
                "herdr",
                "pane",
                "close",
                pane_id
            ],
            text=True,
            capture_output=True
        )
        print(f"[PANE PURGED] {pane_id}")

    if clone_path:
        if delete_clone_safely(clone_path):
            print(f"[CLONE PURGED] {clone_path}")
        elif os.path.exists(clone_path):
            print(
                f"Unsafe clone path, refusing delete: "
                f"{clone_path}"
            )
            sys.exit(3)

    from herdr import kernel
    kernel.update_task_metadata(task_id, {
        "pane_retained": False,
        "clone_retained": False,
        "resource_retention": "purged",
    }, store=_get_store())

    print(f"[PURGED] {task_id}")


# ---------------------------------------------------------------------------
# Physical teardown (finalize / close-workflow)
#
# 设计原则:任务生而隔离(独立 pane + CoW clone + 全新会话),
# 死而清零。上下文只在任务体内生存,跨任务唯一合法通道是固化产物。
# 销毁前必须先把 pane 终端转写固化为证据(herdr 不持久化 scrollback)。
# ---------------------------------------------------------------------------

def _herdr(*args):
    """调用 herdr CLI;显式解析绝对路径以兼容 LaunchAgent 精简 PATH。"""
    binary = resolve_binary("herdr") or "herdr"
    return subprocess.run(
        [binary, *args],
        text=True,
        capture_output=True,
    )


def delete_clone_safely(clone_path):
    """删除 CoW clone;仅允许 ~/.herdr-controller/clones 下的路径。"""
    if not clone_path:
        return False
    clone_real = os.path.realpath(os.path.expanduser(clone_path))
    try:
        common = os.path.commonpath([CLONE_ROOT, clone_real])
    except ValueError:
        return False
    if common != CLONE_ROOT or clone_real == CLONE_ROOT:
        return False
    if not os.path.exists(clone_real):
        return False
    shutil.rmtree(clone_real)
    return True


def clone_deletable(task):
    """clone 承载的成果是否已安全沉淀。

    integration_ref/branch 存在说明 Controller 已完成 integrate;
    superseded 任务从未交付,由替代任务负责成果。其余情况
    (如 mode=none 的 docs 任务)成果只存在于 clone 与终端转写中,
    默认保留 clone,由 --purge-clones 显式授权删除。
    """
    if task.get("integration_ref") or task.get("integration_branch"):
        return True, "integrated"
    if task.get("status") == "superseded":
        return True, "superseded"
    if task.get("status") == "committed":
        return False, "committed but not integrated — run herdr-task integrate first"
    return False, "no integration evidence"


def dump_transcript(task):
    """把 pane 终端转写落盘为验收证据;尽力而为,失败不阻塞。"""
    pane_id = task.get("pane_id")
    if not pane_id:
        return None
    read = _herdr(
        "pane", "read", pane_id,
        "--source", "recent-unwrapped",
        "--lines", "20000",
    )
    if read.returncode != 0 or not read.stdout.strip():
        return None

    task_dir = os.path.join(EVIDENCE_ROOT, task.get("task_id", "unknown"))
    os.makedirs(task_dir, exist_ok=True)
    path = os.path.join(task_dir, "terminal.log")
    with open(path, "w", encoding="utf-8") as f:
        f.write(read.stdout)

    meta = {
        "task_id": task.get("task_id"),
        "pane_id": pane_id,
        "agent": task.get("agent"),
        "dumped_at": _now(),
        "agent_session": None,
    }
    info = _herdr("pane", "get", pane_id)
    try:
        pane = json.loads(info.stdout)["result"]["pane"]
        meta["agent_session"] = pane.get("agent_session")
    except Exception:
        pass
    with open(os.path.join(task_dir, "meta.json"), "w", encoding="utf-8") as f:
        json.dump(meta, f, ensure_ascii=False, indent=2)
    return path


def close_pane(pane_id):
    if not pane_id:
        return False
    return _herdr("pane", "close", pane_id).returncode == 0


def _advance_to_cleaned(task_id, status):
    """按 FINALIZE_ADVANCE 链把已验收任务推进到 cleaned。"""
    while status in FINALIZE_ADVANCE:
        nxt = FINALIZE_ADVANCE[status]
        try:
            set_status(task_id, nxt)
        except SystemExit:
            break
        status = nxt
    return status


def _finalize_one(task, purge_clones=False, dry_run=False):
    """对单个已收敛任务执行物理收尾,返回报告行。幂等。"""
    task_id = task.get("task_id")
    status = task.get("status")
    pane_id = task.get("pane_id")

    row = {
        "task_id": task_id,
        "agent": task.get("agent"),
        "stage": task.get("stage"),
        "status": status,
        "pane_id": pane_id,
        "clone_path": task.get("clone_path"),
        "pane_closed": False,
        "evidence": None,
        "clone_deleted": False,
        "clone_retained_reason": None,
        "action": "finalized",
    }

    deletable, reason = clone_deletable(task)

    if dry_run:
        row["action"] = "dry-run"
        row["pane_closed"] = bool(pane_id)
        row["clone_deleted"] = bool(
            task.get("clone_path") and (deletable or purge_clones)
        )
        if not deletable and not purge_clones:
            row["clone_retained_reason"] = reason
        return row

    row["evidence"] = dump_transcript(task)
    row["pane_closed"] = close_pane(pane_id)

    if task.get("clone_path"):
        if deletable or purge_clones:
            row["clone_deleted"] = delete_clone_safely(task["clone_path"])
            if not row["clone_deleted"]:
                row["clone_retained_reason"] = "clone path absent or unsafe"
        else:
            row["clone_retained_reason"] = reason

    if status in FINALIZE_ADVANCE:
        row["status"] = _advance_to_cleaned(task_id, status)

    store = _get_store()
    record = store.get_task(task_id)
    if record:
        from herdr import kernel
        meta_updates = {
            "pane_retained": False,
            "resource_retention": "purged",
        }
        if row["evidence"]:
            meta_updates["evidence"] = row["evidence"]
        kernel.update_task_metadata(task_id, meta_updates, store=store)
    return row


def finalize_task(task_id, force=False, purge_clones=False):
    data = load_tasks()
    task = find_task(data, task_id)

    if not task:
        print(f"Task not found: {task_id}")
        sys.exit(1)

    status = task.get("status")
    blocked = status in TEARDOWN_BLOCKING_STATUSES
    if blocked or (status == "failed" and not force):
        print(
            f"Task cannot finalize while {status}; "
            "only settled tasks can be torn down "
            "(use --force for failed tasks)."
        )
        sys.exit(2)

    row = _finalize_one(task, purge_clones=purge_clones)

    print(f"[FINALIZE] {task_id} status={row['status']} "
          f"pane_closed={row['pane_closed']}")
    if row["evidence"]:
        print(f"[EVIDENCE] {row['evidence']}")
    if row["clone_deleted"]:
        print(f"[CLONE PURGED] {task.get('clone_path')}")
    elif row["clone_retained_reason"]:
        print(
            f"[CLONE RETAINED] {task.get('clone_path')} "
            f"({row['clone_retained_reason']}; "
            "use --purge-clones to force)"
        )
    print(f"[FINALIZED] {task_id}")
    return row


def _load_workflow_entry(workflow_id):
    store = _get_store()
    wf = store.get_workflow(workflow_id)
    all_wfs = {w["workflow_id"]: w for w in store.list_workflows() if w.get("workflow_id")}
    return wf, all_wfs


def _mark_workflow_completed(workflow_id, outcome="delivered", force=False):
    store = _get_store()
    entry, _ = _load_workflow_entry(workflow_id)
    if entry is None:
        print(f"[WORKFLOW RECORD] no entry for {workflow_id}; skip marking")
        return

    try:
        from herdr import kernel
        kernel.transition_workflow(
            workflow_id=workflow_id,
            to_status="completed",
            reason=f"workflow_completed: {outcome}",
            source="herdr-task",
            metadata={"outcome": outcome, "completed_at": _now()},
            force=force,
            store=store,
        )
    except Exception as exc:
        print(f"Error marking workflow {workflow_id} completed: {exc}", file=sys.stderr)
        raise

    wf_file = globals().get("WORKFLOWS_FILE") or os.environ.get("WORKFLOWS_FILE") or WORKFLOWS_FILE
    sync_workflows_projection(store=store, wf_file=Path(wf_file) if wf_file else None)


def _workflow_stage_tabs(workflow_id, tasks):
    """从项目 workflow 配置解析阶段 tab 与归属 pane 集合。

    返回 dict:tab_ids / coordinator_pane / workspace_id / owned_pane_ids。
    """
    empty = {
        "tab_ids": [],
        "coordinator_pane": None,
        "workspace_id": None,
        "owned_pane_ids": set(),
    }
    project = project_for_workflow(workflow_id) or {}
    cfg_file = (
        project.get("workflow_file")
        or next(
            (t.get("workflow_config") for t in tasks if t.get("workflow_config")),
            None,
        )
    )
    if not cfg_file or not os.path.exists(cfg_file):
        return empty
    try:
        with open(cfg_file, "r", encoding="utf-8") as f:
            cfg = json.load(f)
    except (json.JSONDecodeError, OSError):
        return empty

    items = cfg.get("nodes") or cfg.get("stages", [])
    tab_ids = sorted({
        item.get("tab_id") for item in items if item.get("tab_id")
    })
    owned_pane_ids = {
        item.get("anchor_pane_id")
        for item in items
        if item.get("anchor_pane_id")
    }
    owned_pane_ids |= {
        t.get("pane_id") for t in tasks if t.get("pane_id")
    }
    return {
        "tab_ids": tab_ids,
        "coordinator_pane": (cfg.get("coordinator") or {}).get("pane_id"),
        "workspace_id": cfg.get("workspace_id"),
        "owned_pane_ids": owned_pane_ids,
    }


def _live_workspace_panes(workspace_id):
    """返回 workspace 存活 pane 列表;不可用时返回 None(宁可保留现场)。"""
    listing = _herdr("pane", "list", "--workspace", workspace_id)
    if listing.returncode != 0:
        return None
    try:
        result = json.loads(listing.stdout).get("result", {})
        panes = result.get("panes", result) if isinstance(result, dict) else result
        return panes or []
    except (json.JSONDecodeError, TypeError):
        return None


def _foreign_panes_in_tab(live_panes, tab_id, owned_pane_ids):
    """筛选 tab 内不属于本 workflow 的存活 pane。

    阶段 tab 可能被连续多个 workflow 复用;关闭 tab 会连带销毁
    共存的其他现场,所以有外来 pane 时必须放弃关 tab。
    """
    return sorted(
        pane_id
        for pane in (live_panes or [])
        if pane.get("tab_id") == tab_id
        and (pane_id := pane.get("pane_id"))
        and pane_id not in owned_pane_ids
    )


def resolve_workflow_id_for_close(input_id=None):
    entries = load_workflows().get("workflows", {})
    if input_id:
        if input_id in entries:
            return input_id
        tasks = load_tasks().get("tasks", [])
        if any(t.get("workflow_id") == input_id for t in tasks):
            return input_id

        # Suffix / substring match among active (non-terminal) workflows
        non_terminal = {wid: e for wid, e in entries.items() if e.get("status") not in {"completed"}}
        matches = [wid for wid in non_terminal if wid.endswith(input_id) or f"-{input_id}" in wid or input_id in wid]
        if len(matches) == 1:
            print(f"[AUTO RESOLVE] 匹配到活跃工作流: {matches[0]}")
            return matches[0]
        elif len(matches) > 1:
            print(f"[AMBIGUOUS WORKFLOW ID] 输入 '{input_id}' 匹配到多个活跃工作流: {', '.join(matches)}")
            sys.exit(1)

        all_matches = [wid for wid in entries if wid.endswith(input_id) or f"-{input_id}" in wid or input_id in wid]
        if len(all_matches) == 1:
            print(f"[AUTO RESOLVE] 匹配到工作流: {all_matches[0]}")
            return all_matches[0]
        elif len(all_matches) > 1:
            print(f"[AMBIGUOUS WORKFLOW ID] 输入 '{input_id}' 匹配到多个工作流: {', '.join(all_matches)}")
            sys.exit(1)

        return input_id

    # If input_id is not provided, detect from current git workspace
    try:
        root = detect_git_root()
        proj = project_by_root(root)
        if proj:
            pid = proj.get("project_id")
            active = [wid for wid, e in entries.items() if e.get("project_id") == pid and e.get("status") not in {"completed"}]
            if len(active) == 1:
                print(f"[AUTO DETECT] 检测到当前项目 {proj.get('project_name')} 唯一活跃工作流: {active[0]}")
                return active[0]
            elif len(active) > 1:
                print(f"当前项目存在多个活跃工作流，请显式指定 workflow_id:\n  " + "\n  ".join(active))
                sys.exit(1)
    except Exception:
        pass

    print("请指定 workflow_id，例如: herdr-task close-workflow <workflow_id>")
    sys.exit(1)


def close_workflow(
    workflow_id,
    include_coordinator=False,
    purge_clones=False,
    dry_run=False,
    abandon=False,
    force=False,
):
    data = load_tasks()
    tasks = [
        t for t in data["tasks"]
        if t.get("workflow_id") == workflow_id
    ]
    entry, _ = _load_workflow_entry(workflow_id)
    if not tasks and entry is None:
        print(f"Unknown workflow (no tasks, no record): {workflow_id}")
        sys.exit(1)

    # 1. Preflight Gate: Validate workflow transition to 'closing' BEFORE any teardown side effects
    if entry:
        from herdr.transitions import validate_workflow_transition
        validate_workflow_transition(
            entry.get("status", "pending"),
            "closing",
            force=force,
        )

    if not tasks:
        # 中止在注册任何 Task 之前的运行:没有可销毁的资源,
        # 视为平凡完成,仅做登记与状态清理。
        print(f"[CLOSE REPORT] workflow={workflow_id} (no tasks)")
        if not dry_run:
            _mark_workflow_completed(workflow_id, force=force)
            stage_reset(workflow_id)
            print(f"[WORKFLOW CLOSED] {workflow_id}")
        else:
            print("[DRY RUN] no changes were made")
        return {
            "workflow_id": workflow_id,
            "dry_run": dry_run,
            "tasks": [],
            "tabs_closed": [],
            "tabs_skipped": {},
            "coordinator_closed": False,
            "include_coordinator": include_coordinator,
        }

    base_branch = (entry or {}).get("base_branch") or "main"

    blocked_verdicts = [
        t["task_id"] for t in tasks
        if t.get("status") != "superseded"
        and t.get("stage_verdict") == "blocked"
    ]
    if blocked_verdicts and not abandon:
        print(
            "[CLOSE ABORT] workflow has blocked gate verdicts awaiting "
            "fix-loop resolution: " + ", ".join(blocked_verdicts)
        )
        print(
            "Resolve via fix-loop (or supersede stale verdicts); "
            "to abandon the deliverable explicitly:"
        )
        print(f"  herdr-task close-workflow {workflow_id} --abandon")
        sys.exit(2)

    blocking = [
        t["task_id"] for t in tasks
        if t.get("status") in TEARDOWN_BLOCKING_STATUSES
    ]
    if blocking:
        print(
            "[CLOSE ABORT] workflow has unsettled tasks: "
            + ", ".join(blocking)
        )
        sys.exit(2)

    # completed/committed 且 git 集成的任务尚未走完 commit/integrate 管线;
    # 物理收尾会把它们直接推进到 cleaned,在跑的 git 子进程随后撞
    # 'cleaned -> committed' 非法转移,交付分支落不进集成链路
    # (2026-09-17 wf-nexusarchive-0917-01 wrapup 实测)。
    unsettled_git = [
        t["task_id"] for t in tasks
        if t.get("status") in ("completed", "committed")
        and (t.get("integration_mode") or "none") == "git"
    ]
    if unsettled_git:
        print(
            "[CLOSE ABORT] workflow has git tasks awaiting finalize "
            "(commit/integrate not settled): "
            + ", ".join(unsettled_git)
        )
        print(
            "  等待 Controller 终化重试收敛;或手工收口: "
            "herdr-task commit <task_id>(completed)/ "
            "herdr-task integrate <task_id>(committed);"
        )
        print(
            "  确要丢弃交付物时: herdr-task supersede <task_id> --reason ..."
        )
        sys.exit(2)

    # 2. Acquire exclusive closing ownership via State Transition Gateway to block concurrent transitions
    if not dry_run and entry:
        from herdr import kernel
        store = _get_store()
        kernel.transition_workflow(
            workflow_id=workflow_id,
            to_status="closing",
            reason=f"close_workflow: {'abandoned' if abandon else 'delivered'}",
            source="herdr-task",
            force=force,
            store=store,
        )

    if dry_run:
        print(f"[DRY RUN] close-workflow {workflow_id}")

    report = {
        "workflow_id": workflow_id,
        "dry_run": dry_run,
        "tasks": [],
        "tabs_closed": [],
        "tabs_skipped": {},
        "coordinator_closed": False,
        "include_coordinator": include_coordinator,
    }

    for task in tasks:
        if task.get("status") == "failed":
            report["tasks"].append({
                "task_id": task.get("task_id"),
                "status": "failed",
                "action": "retained-failed",
                "clone_retained_reason": "failed task kept for debugging",
            })
            continue
        report["tasks"].append(
            _finalize_one(task, purge_clones=purge_clones, dry_run=dry_run)
        )

    topo = _workflow_stage_tabs(workflow_id, tasks)
    live_panes = (
        _live_workspace_panes(topo["workspace_id"])
        if topo["workspace_id"] else None
    )
    for tab_id in topo["tab_ids"]:
        if not topo["workspace_id"]:
            report["tabs_skipped"][tab_id] = (
                "workspace unknown; cannot verify ownership"
            )
            continue
        if live_panes is None:
            report["tabs_skipped"][tab_id] = "pane list unavailable"
            continue
        foreign = _foreign_panes_in_tab(
            live_panes, tab_id, topo["owned_pane_ids"]
        )
        if foreign:
            report["tabs_skipped"][tab_id] = (
                f"shared with foreign panes: {foreign}"
            )
            continue
        if dry_run:
            report["tabs_closed"].append(tab_id)
        elif _herdr("tab", "close", tab_id).returncode == 0:
            report["tabs_closed"].append(tab_id)
    if not dry_run:
        _mark_workflow_completed(
            workflow_id,
            outcome="abandoned" if abandon else "delivered",
            force=force,
        )
        stage_reset(workflow_id)

    coordinator_pane = (
        topo.get("coordinator_pane")
        or (entry or {}).get("coordinator_pane_id")
    )
    if include_coordinator and not dry_run:
        report["coordinator_closed"] = close_pane(coordinator_pane)

    # ---- 收尾报告 ----
    print(f"[CLOSE REPORT] workflow={workflow_id} dry_run={dry_run}")
    for row in report["tasks"]:
        line = (
            f"  {row.get('task_id')} status={row.get('status')} "
            f"action={row.get('action')}"
        )
        if row.get("evidence"):
            line += f" evidence={row['evidence']}"
        if row.get("clone_retained_reason"):
            line += f" clone_retained({row['clone_retained_reason']})"
        print(line)
    print(f"  tabs_closed={report['tabs_closed'] or '[]'}")
    if report.get("tabs_skipped"):
        for tab_id, reason in report["tabs_skipped"].items():
            print(f"  tab_skipped={tab_id} ({reason})")
    if include_coordinator:
        print(f"  coordinator_closed={report['coordinator_closed']}")
    else:
        print(
            "  [COORDINATOR KEPT] "
            f"pane={coordinator_pane or 'unknown'} — "
            "完成知识沉淀并合并 PR 后，请按以下步骤收尾：\n"
            "    1. 运行 six-step-finish 技能执行破坏性收尾步骤（步骤 3 最终确认 + 步骤 4-6）：\n"
            f"       bash .agents/skills/six-step-finish/scripts/finish-task.sh "
            f"<任务分支> --base {base_branch} --forge none\n"
            "       （<任务分支> 替换为已合入的任务分支名；存在多个已合入分支时分别对每个分支执行）\n"
            "       （绝对兜底：~/.agents/skills/six-step-finish/scripts/finish-task.sh）\n"
            "    2. 确认收尾完成后，运行：\n"
            f"       herdr-task close-workflow {workflow_id} --include-coordinator"
        )

    if dry_run:
        print("[DRY RUN] no changes were made")
    else:
        print(f"[WORKFLOW CLOSED] {workflow_id}")
    return report


def node_status(workflow_id, node_key):
    node = resolve_node(node_key, workflow_id)

    data = load_tasks()

    tasks = [
        task
        for task in data["tasks"]
        if task.get("workflow_id") == workflow_id
        and (task.get("node") == node_key or task.get("stage") == node_key)
    ]

    if not tasks:
        result = {
            "workflow_id": workflow_id,
            "node_id": node_key,
            "node": node_key,
            "stage": node_key,
            "node_label": node["node_label"],
            "stage_label": node["stage_label"],
            "status": "empty",
            "complete": False,
            "depends_on": node.get("depends_on", []),
            "next_stage": node.get("next"),
            "tasks": []
        }

        print(
            json.dumps(
                result,
                ensure_ascii=False,
                indent=2
            )
        )
        return

    # Superseded tasks do not block node completion — they were replaced by
    # another task whose outcome is the authoritative result for this node.
    active_tasks = [
        task for task in tasks
        if task.get("status") != "superseded" and not task.get("superseded_by")
    ]

    if not active_tasks:
        # All tasks were superseded with no replacement — treat as incomplete.
        complete = False
    else:
        complete = all(
            task.get("status") in (
                "completed",
                "committed",
                "integrated",
                "cleanup_ready",
                "cleaned"
            )
            for task in active_tasks
        )

    result = {
        "workflow_id": workflow_id,
        "node_id": node_key,
        "node": node_key,
        "stage": node_key,
        "node_label": node["node_label"],
        "stage_label": node["stage_label"],
        "status": (
            "completed"
            if complete
            else "in_progress"
        ),
        "complete": complete,
        "depends_on": node.get("depends_on", []),
        "next_stage": node.get("next"),
        "tasks": [
            {
                "task_id": task["task_id"],
                "status": task["status"]
            }
            for task in tasks
        ]
    }

    print(
        json.dumps(
            result,
            ensure_ascii=False,
            indent=2
        )
    )


stage_status = node_status


def supersede_task(task_id, new_task_id=None, reason=None):
    """Mark a task as superseded (replaced by another task or abandoned).

    Superseded tasks are excluded from node completion calculations,
    allowing the DAG to advance when replacement tasks complete successfully.
    """
    data = load_tasks()
    task = find_task(data, task_id)

    if not task:
        print(f"Task not found: {task_id}")
        sys.exit(1)

    old_status = task["status"]
    if "superseded" not in TRANSITIONS.get(old_status, set()):
        print(
            f"Illegal transition: "
            f"{task_id}: {old_status} -> superseded"
        )
        sys.exit(2)

    meta = {}
    if new_task_id:
        meta["superseded_by"] = new_task_id
    if reason:
        meta["supersede_reason"] = reason

    store = _get_store()
    try:
        from herdr import kernel
        kernel.transition_task(
            task_id=task_id,
            to_status="superseded",
            reason=reason or "superseded",
            source="herdr-task",
            metadata=meta,
            store=store,
        )
    except Exception as exc:
        print(f"Error superseding task {task_id}: {exc}", file=sys.stderr)
        sys.exit(2)

    t_file = globals().get("TASKS_FILE") or os.environ.get("TASKS_FILE")
    sync_tasks_projection(store=store, tasks_file=Path(t_file) if t_file else None)

    msg = f"{task_id}: {old_status} -> superseded"
    if new_task_id:
        msg += f" (by {new_task_id})"
    print(msg)


def pause_task(task_id, reason=None):
    """Pause an in-flight task (dispatched/working/rework)."""
    if reason:
        from herdr import kernel
        try:
            kernel.update_task_metadata(task_id, {"pause_reason": reason}, store=_get_store())
        except ValueError:
            print(f"Task not found: {task_id}")
            sys.exit(1)
    set_status(task_id, "paused")


def resume_task(task_id):
    """Resume a paused task back to working or rework based on history."""
    data = load_tasks()
    task = find_task(data, task_id)
    if not task:
        print(f"Task not found: {task_id}")
        sys.exit(1)
    if task.get("status") != "paused":
        print(f"Task {task_id} is not paused (currently: {task.get('status')})")
        sys.exit(2)
    target = "working"
    history = task.get("status_history", [])
    for h in reversed(history):
        if h.get("to") == "paused" and h.get("from") in ("working", "rework", "dispatched", "blocked"):
            target = h.get("from")
            break
    set_status(task_id, target)


def _clear_suppress_auto_close(workflow_id):
    """Fix-loop reopen 闩:该 workflow 任一任务进入 ACTIVE 时清除。

    闩存在的意义是封住 reopen 后"旧任务仍全为完成系、周期 sweep
    立即 auto-close"的自消除窗口;首个 fix task 落盘即为摘除时机,
    此时 implementation 节点已回归未完成。
    """
    if not workflow_id:
        return

    store = _get_store()
    entry = store.get_workflow(workflow_id)
    if entry is None or not entry.get("suppress_auto_close"):
        return

    from herdr import kernel
    kernel.update_workflow_metadata(workflow_id, {"suppress_auto_close": None}, store=store)

    print(f"[AUTO-CLOSE LATCH CLEARED] workflow={workflow_id}")


def reopen_workflow(workflow_id):
    """重开已关闭的 workflow(fix-loop 续用同一 workflow/PR 上下文)。

    仅 completed 可重开;总指挥 pane 必须存活(验收与派发的消息终点)。
    重开即置 suppress_auto_close 闩,防止周期 sweep 在 fix task 派发前
    将 workflow 自消除回 completed。
    """
    entry, entries = _load_workflow_entry(workflow_id)

    if entry is None:
        print(f"Unknown workflow: {workflow_id}")
        sys.exit(1)

    if entry.get("status") != "completed":
        print(
            f"[REOPEN ABORT] workflow={workflow_id} "
            f"status={entry.get('status')}: only completed workflows can reopen"
        )
        sys.exit(2)

    coordinator_pane = entry.get("coordinator_pane_id")

    if not coordinator_pane:
        print(
            f"[REOPEN ABORT] workflow={workflow_id}: "
            "record has no coordinator_pane_id"
        )
        sys.exit(2)

    listing = _herdr("pane", "list")
    alive = False

    if listing.returncode == 0:
        try:
            result = json.loads(listing.stdout).get("result", {})
            panes = (
                result.get("panes", result)
                if isinstance(result, dict)
                else result
            )
            alive = any(
                pane.get("pane_id") == coordinator_pane
                for pane in (panes or [])
            )
        except (json.JSONDecodeError, TypeError):
            alive = False

    if not alive:
        print(
            f"[REOPEN ABORT] coordinator pane {coordinator_pane} is not alive; "
            "rebuild the coordinator pane first, then reopen"
        )
        sys.exit(2)

    store = _get_store()
    try:
        from herdr import kernel
        kernel.transition_workflow(
            workflow_id=workflow_id,
            to_status="in_progress",
            reason="workflow_reopened",
            source="herdr-task",
            metadata={"suppress_auto_close": True, "reopened_at": _now()},
            store=store,
        )
    except Exception as exc:
        print(f"Error reopening workflow {workflow_id}: {exc}", file=sys.stderr)
        sys.exit(2)

    wf_file = globals().get("WORKFLOWS_FILE") or os.environ.get("WORKFLOWS_FILE") or WORKFLOWS_FILE
    sync_workflows_projection(store=store, wf_file=Path(wf_file) if wf_file else None)

    stage_reset(workflow_id)

    print(
        f"[WORKFLOW REOPENED] {workflow_id} "
        f"(suppress_auto_close latch set; clears on first active task)"
    )


def stage_reset(workflow_id, stage=None):
    """Clear stage-state.json advance lock(s) for a workflow.

    Removes 'queued' or 'notified' entries that may be permanently
    preventing the Controller from re-triggering stage advance events.
    Use when a workflow is stuck and manual intervention is needed.
    """
    stage_path = STAGE_STATE_FILE
    if not os.path.exists(stage_path):
        print("stage-state.json not found — nothing to reset.")
        return

    with open(stage_path, "r", encoding="utf-8") as f:
        state = json.load(f)

    prefix = f"{workflow_id}:"
    removed = []
    for key in list(state.keys()):
        if key.startswith(prefix):
            if stage is None or key == f"{prefix}{stage}":
                del state[key]
                removed.append(key)

    tmp = stage_path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(state, f, ensure_ascii=False, indent=2)
    os.replace(tmp, stage_path)

    if removed:
        for k in removed:
            print(f"[RESET] cleared: {k}")
    else:
        target = f"{prefix}{stage}" if stage else f"{prefix}*"
        print(f"[RESET] no entries found for: {target}")


def force_advance(workflow_id, stage=None):
    """Force re-evaluation of stage advance for a workflow.

    Clears existing stage-state locks for the given stage(s) so the
    Controller daemon will re-check DAG completion and re-notify the
    coordinator on its next cycle (~2 s).
    """
    stage_reset(workflow_id, stage)
    print(
        f"[ADVANCE] stage-state cleared for workflow={workflow_id}."
        " Controller will re-evaluate within ~2 seconds."
    )

def list_tasks(workflow_id=None):
    data = load_tasks()

    tasks = data["tasks"]

    if workflow_id:
        tasks = [
            task
            for task in tasks
            if task.get("workflow_id") == workflow_id
        ]

    print(
        json.dumps(
            {"tasks": tasks},
            ensure_ascii=False,
            indent=2
        )
    )


def _task_head_sha(task):
    """Best-effort: task branch head sha from its CoW clone (gate evidence)."""
    task = task or {}
    task_id = task.get("task_id") or ""
    branch = task.get("branch") or ""
    if not task_id or not branch:
        return ""
    clone_root = Path(
        os.environ.get("HERDR_CLONES_DIR")
        or (Path.home() / ".herdr-controller" / "clones")
    )
    clone = clone_root / task_id
    if not clone.exists():
        return ""
    try:
        result = subprocess.run(
            ["git", "-C", str(clone), "rev-parse", "--short", branch],
            text=True,
            capture_output=True,
            timeout=5,
        )
        if result.returncode == 0:
            return result.stdout.strip()
    except Exception:
        pass
    return ""


def note_add(args):
    from herdr import workflow_docs as wd

    task = None
    if args.task:
        task = find_task(load_tasks(), args.task)
        if not task:
            print(f"Task not found: {args.task}")
            sys.exit(1)

    if args.file:
        note_file = Path(args.file).expanduser()
        if not note_file.exists():
            print(f"Note file not found: {note_file}")
            sys.exit(2)
        try:
            with note_file.open(encoding="utf-8") as handle:
                body = handle.read(wd.MAX_BODY + 1)
        except OSError as exc:
            print(f"Error reading note file: {exc}")
            sys.exit(2)
    else:
        body = args.text or ""

    node = args.node or (task.get("node") or task.get("stage") if task else None)
    agent = args.agent or (task.get("agent") if task else None)
    base_sha = args.base_sha or _task_head_sha(task) or None

    try:
        record = wd.append_note(
            args.workflow_id,
            kind=args.kind,
            title=args.title,
            body=body,
            node=node,
            task_id=args.task or "",
            agent=agent,
            source=args.source,
            base_sha=base_sha,
            round=args.round,
            invalidates=args.invalidates,
        )
    except ValueError as exc:
        print(f"Error: {exc}")
        sys.exit(2)

    print(f"[NOTE_ADDED] {record['note_id']}")
    print(f"[NOTE_DIR] {wd.workflow_docs_dir(args.workflow_id)}")


def note_list(args):
    from herdr import workflow_docs as wd

    try:
        annotated = wd.annotate_notes(
            wd.load_notes(args.workflow_id),
            current_base_sha=args.current_base_sha,
        )
    except ValueError as exc:
        print(f"Error: {exc}")
        sys.exit(2)
    if args.node:
        annotated = [n for n in annotated if (n.get("node") or "") == args.node]
    if args.limit and args.limit > 0:
        annotated = annotated[-args.limit:]

    if args.json:
        print(json.dumps(
            {
                "workflow_id": args.workflow_id,
                "docs_dir": str(wd.workflow_docs_dir(args.workflow_id)),
                "notes": annotated,
            },
            ensure_ascii=False,
            indent=2,
        ))
        return

    print(f"=== 工作流共享文档 [{args.workflow_id}] ===")
    print(f"目录: {wd.workflow_docs_dir(args.workflow_id)}")
    if not annotated:
        print("暂无条目")
        return
    for note in annotated:
        stale = (
            f"[STALE: {note.get('stale_reason') or 'stale'}] "
            if note.get("stale")
            else ""
        )
        print(
            f"{stale}[{note.get('kind')}][{note.get('node') or '-'}] "
            f"{note.get('title')} ({note.get('note_id')})"
        )


def _record_gate_note(task, verdict, note):
    """Best-effort machine evidence: gate verdict -> workflow shared docs."""
    try:
        from herdr import workflow_docs as wd

        workflow_id = task.get("workflow_id")
        if not workflow_id:
            return
        provenance = wd.provenance_from_task(task)
        base_sha = provenance["base_sha"] or _task_head_sha(task)
        title = f"{provenance['node'] or '未知节点'} 门禁结论 {verdict}"

        for existing in wd.load_notes(workflow_id):
            if (
                existing.get("kind") == "gate"
                and existing.get("task_id") == provenance["task_id"]
                and existing.get("title") == title
                and (existing.get("base_sha") or "") == (base_sha or "")
            ):
                return

        wd.append_note(
            workflow_id,
            kind="gate",
            title=title,
            body=note or "",
            node=provenance["node"],
            task_id=provenance["task_id"],
            agent=provenance["agent"],
            source=wd.SOURCE_CONTROLLER,
            base_sha=base_sha,
        )
    except Exception as exc:
        print(f"[NOTE EVIDENCE WARN] {exc}")


