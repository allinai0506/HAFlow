        baseline,
        head,
        log_commits=_git_log_commits,
        commit_paths=_git_commit_paths,
    )


def _git_head_history(clone, head, limit=100):
    from herdr.git_adoption_probe import git_head_history

    return git_head_history(
        clone,
        head,
        limit=limit,
        log_commits=_git_log_commits,
        commit_paths=_git_commit_paths,
    )


def _adopt_head_if_attributable(task_id, task, clone, allow_rebase=False):
    from herdr.task_cli_adoption import adopt_head_if_attributable

    return adopt_head_if_attributable(
        task_id,
        task,
        clone,
        allow_rebase=allow_rebase,
        get_store=_get_store,
        adoption_skew_seconds=_adoption_skew_seconds,
        git_head_sha=_git_head_sha,
        git_current_branch=_git_current_branch,
        git_is_ancestor=_git_is_ancestor,
        git_interval_commits=_git_interval_commits,
        git_head_history=_git_head_history,
        git_remote_contained_shas=_git_remote_contained_shas,
        coerce_epoch=_coerce_epoch,
        set_status=set_status,
    )


def _publish_integrated_task(task_id):
    from herdr.scheduler_facts import publish_integrated_candidate

    try:
        publish_integrated_candidate(_get_store(), task_id)
    except ValueError as exc:
        # Legacy integration can finish, but cannot silently publish a candidate.
        print(f"[CANDIDATE PUBLICATION REJECTED] {exc}", file=sys.stderr)


@_with_git_operation_lock(include_source_repo=True)
def integrate_task(task_id):
    from herdr.task_cli_integration import integrate_task as handle_integration
    return handle_integration(
        task_id, load_tasks=load_tasks, find_task=find_task, get_store=_get_store,
        ensure_branch_available=ensure_branch_available,
        branch_ownership_error=BranchOwnershipError, set_status=set_status,
        clear_finalize_escalation=clear_finalize_escalation,
        publish_integrated_task=_publish_integrated_task,
        git_head_sha=_git_head_sha, git_is_ancestor=_git_is_ancestor,
        current_workspace_fingerprint=current_workspace_fingerprint,
        project_for_workflow=project_for_workflow,
    )


