    )
    print(json.dumps(payload, ensure_ascii=False, indent=2))


def _state_db_path():
    from herdr.task_cli_state import state_db_path

    return state_db_path(
        environ=os.environ,
        tasks_file=globals().get("TASKS_FILE"),
        workflow_file=globals().get("WORKFLOW_FILE"),
        workflows_file=globals().get("WORKFLOWS_FILE"),
        default_workflow_file=_DEFAULT_WORKFLOW_FILE,
    )


