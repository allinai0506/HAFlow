@_with_git_operation_lock()
def commit_task(task_id, message=None, allow_rebase=False):
    from herdr.task_cli_delivery import commit_task as handle_commit_task

    return handle_commit_task(
        task_id,
        message=message,
        allow_rebase=allow_rebase,
        load_tasks=load_tasks,
        find_task=find_task,
        get_store=_get_store,
        is_internal_untracked=_is_internal_untracked,
        adopt_head_if_attributable=_adopt_head_if_attributable,
        set_status=set_status,
        run_commit_index_command=_run_commit_index_command,
    )


@_with_git_operation_lock(include_source_repo=True)
def integrate_task(task_id):
