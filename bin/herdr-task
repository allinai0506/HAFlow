def _safe_workflow(workflow_id):
    if not workflow_id:
        return None, "unknown-workflow"
    try:
        workflow = load_workflow(workflow_id)
        return workflow, workflow.get("name") or workflow_id
    except Exception:
        return {"configuration_error": "workflow_config_invalid"}, workflow_id

def _build_workflow_cards(workflows_tasks, now, all_tasks=None, workflow_lookup=None):
    return _ops_center_build_workflow_cards(
        workflows_tasks, now, all_tasks=all_tasks,
        workflow_lookup=workflow_lookup or _safe_workflow)

def _ops_center_payload(workflow_id=None, now=None, include_tasks=False, *,
                        snapshot_tasks=None, workflow_lookup=None, runtime_probe=None):
    data = load_tasks() if snapshot_tasks is None else {"tasks": snapshot_tasks}
    return _ops_center_projection_payload(
        workflow_id, now, include_tasks, snapshot_tasks=data.get("tasks", []),
        workflow_lookup=workflow_lookup or _safe_workflow,
        runtime_probe=runtime_probe or _agent_runtime_status)


def ops_center(args):
    from herdr.ops_center import build_ops_center_payload
    payload = build_ops_center_payload(
        workflow_id=getattr(args, "workflow_id", None),
        include_tasks=getattr(args, "include_tasks", False),
        db_path=_state_db_path(),
    )
    print(json.dumps(payload, ensure_ascii=False, indent=2))


def _state_db_path():
    if os.environ.get("HERDR_STATE_DB"):
        return Path(os.environ["HERDR_STATE_DB"])
    t_file = globals().get("TASKS_FILE") or os.environ.get("TASKS_FILE")
    if t_file:
        p = Path(t_file)
        db_path = p.parent / "state.db" if p.name == "tasks.json" else p.with_suffix(".db")
        if db_path.parent.exists():
            return db_path
    legacy_wf_file = globals().get("WORKFLOW_FILE")
    if legacy_wf_file == _DEFAULT_WORKFLOW_FILE and not os.environ.get("WORKFLOW_FILE"):
        legacy_wf_file = None  # Default config path is not an explicit DB selector.
    wf_file = legacy_wf_file or globals().get("WORKFLOWS_FILE") or os.environ.get("WORKFLOW_FILE") or os.environ.get("WORKFLOWS_FILE")
    if wf_file:
        p = Path(wf_file)
        db_path = p.parent / "state.db" if p.name in ("workflows.json", "workflow.json") else p.with_suffix(".db")
        if db_path.parent.exists():
            return db_path
    return None


def _get_store():
    db_path = _state_db_path()
    return get_state_store(db_path=db_path) if db_path is not None else get_state_store()

def load_tasks():
    store = _get_store()
    return {"tasks": store.list_tasks()}


def save_tasks(data):
    store = _get_store()
    for t in data.get("tasks", []):
        if t.get("task_id"):
            store.save_task(t)

    # Sync backward-compatible JSON mirror (SQLite -> JSON only)
    t_file = globals().get("TASKS_FILE") or os.environ.get("TASKS_FILE")
    sync_tasks_projection(store=store, tasks_file=Path(t_file) if t_file else None)


def find_task(data, task_id):
    for task in data["tasks"]:
        if task["task_id"] == task_id:
            return task
    return None


def add_task(args):
    data = load_tasks()

    if find_task(data, args.task_id):
        print(f"Task already exists: {args.task_id}")
        sys.exit(1)

    node_id = getattr(args, "node", None) or getattr(args, "stage", None)
    if not node_id:
        print("Error: either --node or --stage is required")
        sys.exit(1)

    task = {
        "task_id": args.task_id,
        "workflow_id": args.workflow_id,
        "run_id": new_run_id(),
        "node": node_id,
        "stage": node_id,
        "workspace_id": args.workspace,
        "pane_id": args.pane,
        "agent": args.agent,
        "clone_path": args.clone,
        "integration_mode": args.integration_mode,
        "status": "pending",
        "goal": args.goal,
        "acceptance_criteria": args.acceptance,
    }
    # Enterprise experience attribution: persist only when provided so legacy
    # records stay byte-identical.
    if getattr(args, "customer", None):
        task["customer"] = str(args.customer).strip()
    if getattr(args, "business_task_type", None):
        task["business_task_type"] = str(args.business_task_type).strip()
    if getattr(args, "mandatory_experience_rules", False):
        task["mandatory_experience_rules"] = True
    now = _now()
    _init_status_history(
        task,
        "pending",
        now,
    )

    data["tasks"].append(task)
    save_tasks(data)

    trajectory_ledger = TrajectoryLedger(getattr(_get_store(), "db_path", None))
    record_trajectory_event_best_effort(
        task, "run_started", ledger=trajectory_ledger, status="pending"
    )
    record_trajectory_event_best_effort(
        task, "task_started", ledger=trajectory_ledger, status="pending"
    )

    print(f"Task registered: {args.task_id}")


def get_task(task_id):
    data = load_tasks()
    task = find_task(data, task_id)

    if not task:
        print(f"Task not found: {task_id}")
        sys.exit(1)

    print(
        json.dumps(
            task,
            ensure_ascii=False,
            indent=2
        )
    )


