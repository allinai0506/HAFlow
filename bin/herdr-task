    return handle_integration(
        task_id, load_tasks=load_tasks, find_task=find_task, get_store=_get_store,
        ensure_branch_available=ensure_branch_available,
        branch_ownership_error=BranchOwnershipError, set_status=set_status,
        clear_finalize_escalation=clear_finalize_escalation,
        publish_integrated_task=_publish_integrated_task,
        git_head_sha=_git_head_sha, git_is_ancestor=_git_is_ancestor,
        current_workspace_fingerprint=current_workspace_fingerprint,
        project_for_workflow=project_for_workflow,
    )


def cleanup_task(task_id):
