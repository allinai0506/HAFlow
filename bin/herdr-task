def bypass_gate_cli(task_id, reason, operator="human", note=None, as_json=False, expected_version=None):
    """Universal human-in-the-loop gate bypass CLI entrypoint."""
    from herdr import kernel
    try:
        res = kernel.bypass_task_gate(
            task_id,
            reason=reason,
            operator=operator,
            note=note,
            expected_version=expected_version,
        )
        if as_json:
            print(json.dumps(res, indent=2, ensure_ascii=False))
            return 0
        print(
            f"[GATE BYPASS] task={task_id} bypass_id={res.get('bypass_id')} "
            f"verdict={res.get('previous_verdict')} -> {res.get('stage_verdict')} "
            f"status={res.get('previous_status')} -> {res.get('status')} "
            f"reason=\"{res.get('reason')}\" operator={res.get('operator')}"
        )
        print("HERDR_GATE_BYPASS_RESULT=" + json.dumps(res, ensure_ascii=False))
        return 0
    except Exception as exc:
        print(f"Error bypassing gate for task {task_id}: {exc}", file=sys.stderr)
        sys.exit(1)


def adopt_verdict_cli(task_id, verdict=None, note=None, operator="human", as_json=False):
    from herdr.task_cli_status import adopt_task_verdict
    return adopt_task_verdict(
        task_id, verdict, note, operator, as_json,
        load_tasks=load_tasks, find_task=find_task, is_gate_task=_is_gate_task,
        authenticate_evidence=_authenticate_gate_verdict_evidence,
        set_task_status=set_status,
    )


def _with_git_operation_lock(*, include_source_repo=False):
    from herdr.task_cli_git_lock import with_git_operation_lock

    return with_git_operation_lock(
        include_source_repo=include_source_repo,
        deps={
            "load_tasks": load_tasks,
            "find_task": find_task,
            "project_for_workflow": project_for_workflow,
            "GitOperationLock": GitOperationLock,
            "ensure_no_git_processes": ensure_no_git_processes,
            "GitOperationBusyError": GitOperationBusyError,
            "GitProcessActiveError": GitProcessActiveError,
        },
    )


def _capture_pane_transcript(pane):
    from herdr.task_cli_resources import capture_pane_transcript
    return capture_pane_transcript(pane, herdr=_herdr)


