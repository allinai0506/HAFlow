def _herdr(*args):
    """调用 herdr CLI;显式解析绝对路径以兼容 LaunchAgent 精简 PATH。"""
    binary = resolve_binary("herdr") or "herdr"
    return subprocess.run(
        [binary, *args],
        text=True,
        capture_output=True,
        timeout=20,
    )


def delete_clone_safely(clone_path):
    """删除 CoW clone;仅允许 ~/.herdr-controller/clones 下的路径。"""
    if not clone_path:
        return False
    clone_real = os.path.realpath(os.path.expanduser(clone_path))
    try:
        common = os.path.commonpath([CLONE_ROOT, clone_real])
    except ValueError:
        return False
    if common != CLONE_ROOT or clone_real == CLONE_ROOT:
        return False
    if not os.path.exists(clone_real):
        return False
    shutil.rmtree(clone_real)
    return True


def _teardown_output_guard(task):
    """Bounded read-only output gate before closing a Pane or deleting its clone."""
    from herdr.repo_hygiene import teardown_output_diagnosis
    from herdr.bounded_tools import run_bounded
    clone = task.get("clone_path")
    if clone and os.path.lexists(os.path.expanduser(clone)):
        path = Path(clone).expanduser()
        if path.is_symlink():
            return {"reason": "clone_identity_unknown"}
        from herdr.clone_archive import is_residual_clone_shell
        if task.get("clone_archive") and is_residual_clone_shell(path):
            return {"reason": ""}
        tag = path / ".herdr-launch-identity.json"
        if tag.exists():
            try:
                identity = json.loads(tag.read_text()) if not tag.is_symlink() and tag.stat().st_size <= 8192 else {}
            except (OSError, ValueError):
                identity = {}
            if identity.get("task_id") != task.get("task_id") or (task.get("run_id") and identity.get("run_id") != task.get("run_id")):
                return {"reason": "clone_identity_changed"}
        # Context workspaces are plain directories. Their artifacts remain in
        # place; Git metadata, when present, must still pass the Git output gate.
        if (task.get("execution_mode") == "context" and (task.get("integration_mode") or "none") == "none"
                and path.is_dir() and not os.path.lexists(path / ".git")):
            return {"reason": ""}
        try:
            root = run_bounded(["git", "-C", str(path), "rev-parse", "--show-toplevel"], timeout=5, output_limit=8192)
            if root["status"] != "completed" or root["exit_code"] or Path(root["stdout"].strip()).resolve() != path.resolve():
                return {"reason": "clone_git_inventory_unknown"}
            # Collapse untracked directories before the output cap. Internal evidence
            # is already excluded by diagnosis; tracked files remain individually
            # visible, including tracked changes under an internal directory.
            result = run_bounded(["git", "-C", str(path), "status", "--porcelain", "--untracked-files=normal"], timeout=5, output_limit=65536)
            expected_commit = task.get("integrated_commit") or task.get("commit")
            head_sha = ""
            head_out = run_bounded(["git", "-C", str(path), "rev-parse", "HEAD"], timeout=5, output_limit=8192)
            if head_out["status"] != "completed":
                return {"reason": "clone_git_inventory_unknown"}
            if head_out["exit_code"] == 0:
                head_sha = head_out["stdout"].strip()
            elif expected_commit:
                return {"reason": "clone_git_inventory_unknown"}
        except (OSError, ValueError):
            return {"reason": "clone_git_inventory_unknown"}
        diagnosis = teardown_output_diagnosis(result["stdout"], task_id=task.get("task_id", ""))
        if diagnosis["reason"]:
            if (task.get("integration_mode") or "none") == "none":
                diagnosis["remediation_cmd"] = f"git -C <clone> status; herdr-task commit {task.get('task_id', '')}"
            return diagnosis
        if expected_commit and head_sha and head_sha != expected_commit:
            cmd = (
                f"git -C <clone> status; herdr-task commit {task.get('task_id', '')}"
                if (task.get("integration_mode") or "none") == "none"
                else f"git -C <clone> log; herdr-task integrate {task.get('task_id', '')}"
            )
            return {
                "reason": "unintegrated_commit_diverged",
                "remediation_cmd": cmd,
            }
    if (task.get("integration_mode") == "git" and task.get("status") in {"completed", "committed"}):
        return {"reason": "git_finalize_pending", "remediation_cmd": "herdr-task commit " + str(task.get("task_id")) + "; herdr-task integrate " + str(task.get("task_id"))}
    return {"reason": ""}


def _record_output_retention(task, diagnosis, *, authorized_via=""):
    store = _get_store()
    if store.get_task(task.get("task_id")):
        from herdr import kernel
        kernel.update_task_metadata(task["task_id"], {"resource_retention": "retained", "output_retention": diagnosis}, store=store)
        store.record_event("teardown_output_retained" if not authorized_via else "teardown_output_override", {**diagnosis, "authorized_via": authorized_via},
                           task_id=task["task_id"], workflow_id=task.get("workflow_id"), source="herdr-task")


def clone_deletable(task):
    """clone 承载的成果是否已安全沉淀。

    integration_ref/branch 存在说明 Controller 已完成 integrate;
    superseded 任务从未交付,由替代任务负责成果。其余情况
    (如 mode=none 的 docs 任务)成果只存在于 clone 与终端转写中,
    默认保留 clone,由 --purge-clones 显式授权删除。
    """
    output = _teardown_output_guard(task)
    if output["reason"]:
        return False, output["reason"]
    if task.get("execution_mode") == "context" and (task.get("integration_mode") or "none") == "none":
        return False, "context artifacts retained; explicit purge required"
    if task.get("integration_ref") or task.get("integration_branch"):
        return True, "integrated"
    if task.get("status") == "superseded":
        return True, "superseded"
    if task.get("status") == "committed":
        return False, "committed but not integrated — run herdr-task integrate first"
    return False, "no integration evidence"


def dump_transcript(task):
    """把 pane 终端转写落盘为验收证据;尽力而为,失败不阻塞。"""
    pane_id = task.get("pane_id")
    if not pane_id:
        return None
    read = _herdr(
        "pane", "read", pane_id,
        "--source", "recent-unwrapped",
        "--lines", "20000",
    )
    if read.returncode != 0 or not read.stdout.strip():
        return None

    task_dir = os.path.join(EVIDENCE_ROOT, task.get("task_id", "unknown"))
    os.makedirs(task_dir, exist_ok=True)
    path = os.path.join(task_dir, "terminal.log")
    with open(path, "w", encoding="utf-8") as f:
        f.write(read.stdout)

    meta = {
        "task_id": task.get("task_id"),
        "pane_id": pane_id,
        "agent": task.get("agent"),
        "dumped_at": _now(),
        "agent_session": None,
    }
    info = _herdr("pane", "get", pane_id)
    try:
        pane = json.loads(info.stdout)["result"]["pane"]
        meta["agent_session"] = pane.get("agent_session")
    except Exception:
        pass
    with open(os.path.join(task_dir, "meta.json"), "w", encoding="utf-8") as f:
        json.dump(meta, f, ensure_ascii=False, indent=2)
    return path


def close_pane(pane_id):
    if not pane_id:
        return False
    from herdr.task_resources import workflow_launch_lock
    with workflow_launch_lock(_get_store().db_path, 'managed-dynamic-pane-lifecycle'):
        return _herdr("pane", "close", pane_id).returncode == 0


def _advance_to_cleaned(task_id, status):
    """按 FINALIZE_ADVANCE 链把已验收任务推进到 cleaned。"""
    while status in FINALIZE_ADVANCE:
        nxt = FINALIZE_ADVANCE[status]
        try:
            set_status(task_id, nxt)
        except SystemExit:
            break
        status = nxt
    return status


def _close_task_identity(task):
    return {key: task.get(key) for key in (
        "task_id", "workflow_id", "run_id", "pane_id", "agent", "agent_session_id",
        "agent_name", "runtime",
    )}


def _close_owned_pane(identity):
    from herdr.task_resources import owned_live_pane
    from herdr.observer.live import probe_live_runtime

    def runner(argv, timeout):
        result = _herdr(*argv[1:])
        return result.returncode, result.stdout, result.stderr

    current = _get_store().get_task(identity.get("task_id")) if identity.get("task_id") else None
    if identity.get("task_id") and current is None:
        return False
    if current and _close_task_identity(current) != identity:
        return False
    proven, _ = owned_live_pane(
        identity, probe=lambda task: probe_live_runtime(task, runner=runner),
    )
    return proven


def _finalize_one(task, purge_clones=False, dry_run=False, close_claim=None, output_override="", reclaim_archive=None, reclaim_plan=None):
    """对单个已收敛任务执行物理收尾,返回报告行。幂等。"""
    task_id = task.get("task_id")
    status = task.get("status")
    pane_id = task.get("pane_id")

    row = {
        "task_id": task_id,
        "agent": task.get("agent"),
        "stage": task.get("stage"),
        "status": status,
        "pane_id": pane_id,
        "clone_path": task.get("clone_path"),
        "pane_closed": False,
        "evidence": None,
        "clone_deleted": False,
        "clone_retained_reason": None,
        "action": "finalized",
    }

    archive_required = close_claim is not None and not dry_run and not reclaim_archive

    def retain_unarchived_clone():
        clone = task.get("clone_path")
        if archive_required and clone and os.path.lexists(os.path.expanduser(clone)):
            diagnosis = {"reason": "recovery_archive_required"}
            row.update(action="retained", output_guard=diagnosis,
                       clone_retained_reason=diagnosis["reason"], pane_retained_reason=diagnosis["reason"])
            _record_output_retention(task, diagnosis)
            return True
        return False

    if retain_unarchived_clone():
        return row
    output = _teardown_output_guard(task)
    authorization = output_override or ("verified-archive" if reclaim_archive else
                                         "planned-archive" if dry_run and reclaim_plan else
                                         "purge-clones" if purge_clones else "")
    if output["reason"]:
        row["output_guard"] = output
        row["clone_retained_reason"] = output["reason"]
        if not dry_run:
            _record_output_retention(task, output, authorized_via=authorization)
        if not authorization:
            return {**row, "action": "retained", "pane_retained_reason": output["reason"], "pane_would_close": False, "clone_would_delete": False}
        row["output_override"] = authorization
    deletable, reason = clone_deletable(task)

    if dry_run:
        row["action"] = "dry-run"
        row["pane_would_close"] = False
        row["pane_retained_reason"] = "runtime ownership not probed in dry-run"
        row["clone_would_delete"] = bool(
            task.get("clone_path") and (deletable or purge_clones)
        )
        if reclaim_plan:
            row.update(reclaim_plan)
            row["clone_retained_reason"] = None
        elif not deletable and not purge_clones:
            row["clone_retained_reason"] = reason
        return row

    def retain_new_output():
        if reclaim_archive and task.get("clone_path") and os.path.exists(task["clone_path"]):
            from herdr.clone_archive import verify_source
            try:
                verify_source(task, CLONE_ROOT, reclaim_archive)
            except (OSError, ValueError, tarfile.TarError) as exc:
                diagnosis = {"reason": "archive_source_changed", "detail": str(exc)}
                row.update(action="retained", output_guard=diagnosis,
                           clone_retained_reason=diagnosis["reason"], pane_retained_reason=diagnosis["reason"])
                _record_output_retention(task, diagnosis)
                return True
        current_output = _teardown_output_guard(task)
        if current_output["reason"] and not authorization:
            row.update(action="retained", output_guard=current_output,
                       clone_retained_reason=current_output["reason"], pane_retained_reason=current_output["reason"])
            _record_output_retention(task, current_output)
            return True
        return False

    if close_claim is None:
        row["evidence"] = dump_transcript(task)
        if retain_new_output():
            return row
        row["pane_closed"] = close_pane(pane_id)
    else:
        identity = _close_task_identity(task)
        def close_owned():
            evidence = dump_transcript(task)
            # Transcript collection may race with runtime replacement.
            return {"closed": close_pane(pane_id) if _close_owned_pane(identity) and not retain_new_output() else False,
                    "evidence": evidence}
        action = close_claim.action(
            "pane:" + str(pane_id) + ':' + __import__('hashlib').sha256(
                json.dumps(identity, sort_keys=True).encode()).hexdigest(),
            identity, lambda value: not retain_new_output() and _close_owned_pane(value), close_owned,
        )
        result = action.get("result") or {}
        row["evidence"] = result.get("evidence")
        row["pane_closed"] = bool(result.get("closed"))
        if not row["pane_closed"]:
            row["pane_retained_reason"] = "runtime ownership unknown, changed, absent, or close failed"

    if row.get("action") == "retained":
        return row
    if retain_new_output():
        return row
    deletable, reason = clone_deletable(task)
    if task.get("clone_path"):
        if archive_required:
            # Never invoke delete without a workflow recovery point, even if
            # the clone appeared after preflight or after the initial check.
            retain_unarchived_clone()
        elif deletable or purge_clones or reclaim_archive:
            if close_claim is None:
                row["clone_deleted"] = delete_clone_safely(task["clone_path"])
            else:
                clone = os.path.realpath(os.path.expanduser(task["clone_path"]))
                stat = os.stat(clone) if os.path.isdir(clone) else None
                identity = {"path": clone, "device": stat.st_dev if stat else None,
                            "inode": stat.st_ino if stat else None}
                def owns_clone(original):
                    try:
                        current = os.stat(original["path"])
                        if (current.st_dev, current.st_ino) == (original["device"], original["inode"]):
                            return not retain_new_output()
                        from herdr.clone_archive import is_residual_clone_shell
                        if is_residual_clone_shell(Path(original["path"])):
                            return not retain_new_output()
                        return False
                    except OSError:
                        return False
                def delete_owned_clone():
                    if retain_new_output():
                        return False
                    if reclaim_archive:
                        from herdr import kernel
                        kernel.update_task_metadata(task_id, {
                            "clone_reclaim_started": reclaim_archive["manifest_sha256"],
                        }, store=_get_store())
                    path_obj = Path(clone)
                    from herdr.clone_archive import is_residual_clone_shell, delete_residual_clone_shell
                    if is_residual_clone_shell(path_obj):
                        return delete_residual_clone_shell(path_obj, clone_root=CLONE_ROOT)
                    return delete_clone_safely(clone)
                action = close_claim.action(
                    "clone:" + task_id, identity, owns_clone, delete_owned_clone,
                    retry_incomplete=bool(reclaim_archive),
                )
                row["clone_deleted"] = bool(action.get("result"))
            if not row["clone_deleted"]:
                row["clone_retained_reason"] = "clone path absent or unsafe"
        else:
            row["clone_retained_reason"] = reason

    if row.get("action") == "retained":
        return row

    if status in FINALIZE_ADVANCE:
        row["status"] = _advance_to_cleaned(task_id, status)

    store = _get_store()
    record = store.get_task(task_id)
    if record:
        from herdr import kernel
        meta_updates = {
            "pane_retained": bool(close_claim and not row["pane_closed"] and pane_id),
            "resource_retention": "retained" if (close_claim and not row["pane_closed"] and pane_id) or (task.get("clone_path") and not row["clone_deleted"] and os.path.exists(task["clone_path"])) else "purged",
            "clone_retained": bool(task.get("clone_path") and not row["clone_deleted"] and os.path.exists(task["clone_path"])),
        }
        if row["evidence"]:
            meta_updates["evidence"] = row["evidence"]
        kernel.update_task_metadata(task_id, meta_updates, store=store)
    return row


def finalize_task(task_id, force=False, purge_clones=False):
    data = load_tasks()
    task = find_task(data, task_id)

    if not task:
        print(f"Task not found: {task_id}")
        sys.exit(1)

    status = task.get("status")
    blocked = status in TEARDOWN_BLOCKING_STATUSES
    if blocked or (status == "failed" and not force):
        print(
            f"Task cannot finalize while {status}; "
            "only settled tasks can be torn down "
            "(use --force for failed tasks)."
        )
        sys.exit(2)

    row = _finalize_one(task, purge_clones=purge_clones)

    if row.get("action") == "retained":
        print("[FINALIZE ABORT] " + json.dumps(row, ensure_ascii=False))
        sys.exit(2)

    print(f"[FINALIZE] {task_id} status={row['status']} "
          f"pane_closed={row['pane_closed']}")
    if row["evidence"]:
        print(f"[EVIDENCE] {row['evidence']}")
    if row["clone_deleted"]:
        print(f"[CLONE PURGED] {task.get('clone_path')}")
    elif row["clone_retained_reason"]:
        print(
            f"[CLONE RETAINED] {task.get('clone_path')} "
            f"({row['clone_retained_reason']}; "
            "use --purge-clones to force)"
        )
    print(f"[FINALIZED] {task_id}")
    return row


def _load_workflow_entry(workflow_id):
    store = _get_store()
    wf = store.get_workflow(workflow_id)
    all_wfs = {w["workflow_id"]: w for w in store.list_workflows() if w.get("workflow_id")}
    return wf, all_wfs


def _mark_workflow_completed(workflow_id, outcome="delivered", force=False):
    store = _get_store()
    entry, _ = _load_workflow_entry(workflow_id)
    if entry is None:
        print(f"[WORKFLOW RECORD] no entry for {workflow_id}; skip marking")
        return

    try:
        from herdr import kernel
        kernel.transition_workflow(
            workflow_id=workflow_id,
            to_status="completed",
            reason=f"workflow_completed: {outcome}",
            source="herdr-task",
            metadata={"outcome": outcome, "completed_at": _now()},
            force=force,
            store=store,
        )
        try:
            from herdr import node_dispatch_store
            node_dispatch_store.reconcile_workflow(store.db_path, workflow_id, discover=False)
        except Exception:
            pass
    except Exception as exc:
        print(f"Error marking workflow {workflow_id} completed: {exc}", file=sys.stderr)
        raise

    wf_file = globals().get("WORKFLOWS_FILE") or os.environ.get("WORKFLOWS_FILE") or WORKFLOWS_FILE
    sync_workflows_projection(store=store, wf_file=Path(wf_file) if wf_file else None)


def _workflow_stage_tabs(workflow_id, tasks):
    """从项目 workflow 配置解析阶段 tab 与归属 pane 集合。

    返回 dict:tab_ids / coordinator_pane / workspace_id / owned_pane_ids。
    """
    empty = {
        "tab_ids": [],
        "coordinator_pane": None,
        "workspace_id": None,
        "owned_pane_ids": set(),
    }
    project = project_for_workflow(workflow_id) or {}
    cfg_file = (
        project.get("workflow_file")
        or next(
            (t.get("workflow_config") for t in tasks if t.get("workflow_config")),
            None,
        )
    )
    if not cfg_file or not os.path.exists(cfg_file):
        return empty
    try:
        with open(cfg_file, "r", encoding="utf-8") as f:
            cfg = json.load(f)
    except (json.JSONDecodeError, OSError):
        return empty

    from herdr.projects import _with_node_runtime
    cfg = _with_node_runtime(cfg, project)

    items = cfg.get("nodes") or cfg.get("stages", [])
    tab_ids = sorted({
        item.get("tab_id") for item in items if item.get("tab_id")
    })
    owned_pane_ids = {
        item.get("anchor_pane_id")
        for item in items
        if item.get("anchor_pane_id")
    }
    owned_pane_ids |= {
        t.get("pane_id") for t in tasks if t.get("pane_id")
    }
    return {
        "tab_ids": tab_ids,
        "coordinator_pane": (cfg.get("coordinator") or {}).get("pane_id"),
        "workspace_id": cfg.get("workspace_id"),
        "owned_pane_ids": owned_pane_ids,
    }


def _live_workspace_panes(workspace_id):
    """返回 workspace 存活 pane 列表;不可用时返回 None(宁可保留现场)。"""
    listing = _herdr("pane", "list", "--workspace", workspace_id)
    if listing.returncode != 0:
        return None
    try:
        result = json.loads(listing.stdout).get("result", {})
        panes = result.get("panes", result) if isinstance(result, dict) else result
        return panes or []
    except (json.JSONDecodeError, TypeError):
        return None


def _foreign_panes_in_tab(live_panes, tab_id, owned_pane_ids):
    """筛选 tab 内不属于本 workflow 的存活 pane。

    阶段 tab 可能被连续多个 workflow 复用;关闭 tab 会连带销毁
    共存的其他现场,所以有外来 pane 时必须放弃关 tab。
    """
    return sorted(
        pane_id
        for pane in (live_panes or [])
        if pane.get("tab_id") == tab_id
        and (pane_id := pane.get("pane_id"))
        and pane_id not in owned_pane_ids
    )


def resolve_workflow_id_for_close(input_id=None):
    entries = load_workflows().get("workflows", {})
    if input_id:
        if input_id in entries:
            return input_id
        tasks = load_tasks().get("tasks", [])
        if any(t.get("workflow_id") == input_id for t in tasks):
            return input_id

        # Suffix / substring match among active (non-terminal) workflows
        non_terminal = {wid: e for wid, e in entries.items() if e.get("status") not in {"completed"}}
        matches = [wid for wid in non_terminal if wid.endswith(input_id) or f"-{input_id}" in wid or input_id in wid]
        if len(matches) == 1:
            print(f"[AUTO RESOLVE] 匹配到活跃工作流: {matches[0]}")
            return matches[0]
        elif len(matches) > 1:
            print(f"[AMBIGUOUS WORKFLOW ID] 输入 '{input_id}' 匹配到多个活跃工作流: {', '.join(matches)}")
            sys.exit(1)

        all_matches = [wid for wid in entries if wid.endswith(input_id) or f"-{input_id}" in wid or input_id in wid]
        if len(all_matches) == 1:
            print(f"[AUTO RESOLVE] 匹配到工作流: {all_matches[0]}")
            return all_matches[0]
        elif len(all_matches) > 1:
            print(f"[AMBIGUOUS WORKFLOW ID] 输入 '{input_id}' 匹配到多个工作流: {', '.join(all_matches)}")
            sys.exit(1)

        return input_id

    # If input_id is not provided, detect from current git workspace
    try:
        root = detect_git_root()
        proj = project_by_root(root)
        if proj:
            pid = proj.get("project_id")
            active = [wid for wid, e in entries.items() if e.get("project_id") == pid and e.get("status") not in {"completed"}]
            if len(active) == 1:
                print(f"[AUTO DETECT] 检测到当前项目 {proj.get('project_name')} 唯一活跃工作流: {active[0]}")
                return active[0]
            elif len(active) > 1:
                print(f"当前项目存在多个活跃工作流，请显式指定 workflow_id:\n  " + "\n  ".join(active))
                sys.exit(1)
    except Exception:
        pass

    print("请指定 workflow_id，例如: herdr-task close-workflow <workflow_id>")
    sys.exit(1)


def close_workflow(
    workflow_id,
    include_coordinator=False,
    purge_clones=False,
    dry_run=False,
    abandon=False,
    force=False,
    accept_escalated=False,
    confirm_force=None,
):
    from herdr.workflow_close import workflow_close_claim
    if not abandon:
        from herdr.business_gate import business_gate_blockers
        store = _get_store()
        if store.get_workflow(workflow_id):
            authority, config, owned_tasks = store.read_workflow_snapshot(workflow_id)
            from herdr.workflow import validate_delivery_inventory
            try:
                validate_delivery_inventory(authority, config, owned_tasks)
            except ValueError as exc:
                print(f'[CLOSE ABORT] {exc}')
                sys.exit(2)
            missing_business = business_gate_blockers(store, authority, config, owned_tasks)
            if missing_business:
                print('[CLOSE ABORT] business acceptance unavailable: ' + ', '.join(missing_business))
                sys.exit(2)
    options = dict(include_coordinator=include_coordinator, purge_clones=purge_clones,
                   abandon=abandon, force=force, accept_escalated=accept_escalated)
    with workflow_close_claim(_get_store(), workflow_id, dry_run=dry_run, options=options) as claim:
        if claim.state == "completed":
            print(json.dumps(claim.receipt, ensure_ascii=False))
            return claim.receipt
        if claim.state == "in_progress":
            report = {"workflow_id": workflow_id, "close_state": "in_progress"}
            print(json.dumps(report))
            return report
        report = _close_workflow_owned(
            workflow_id, include_coordinator, purge_clones, dry_run, abandon,
            force, accept_escalated, confirm_force, close_claim=claim if not dry_run else None,
        )
        from herdr.delivery_report import build_delivery_report
        import hashlib
        facts = build_delivery_report(workflow_id, _get_store())
        report["delivery_report"] = facts
        report["delivery_report_sha256"] = hashlib.sha256(
            json.dumps(facts, sort_keys=True, ensure_ascii=False).encode()
        ).hexdigest()
        report["execution_mode"] = "dry-run" if dry_run else "execute"
        return report if dry_run else claim.complete(report)


def _close_workflow_owned(
    workflow_id, include_coordinator=False, purge_clones=False, dry_run=False,
    abandon=False, force=False, accept_escalated=False, confirm_force=None,
    close_claim=None,
):
    data = load_tasks()
    tasks = [
        t for t in data["tasks"]
        if t.get("workflow_id") == workflow_id
    ]
    entry, _ = _load_workflow_entry(workflow_id)
    if not tasks and entry is None:
        print(f"Unknown workflow (no tasks, no record): {workflow_id}")
        sys.exit(1)

    # 1. Preflight Gate: Validate workflow transition to 'closing' BEFORE any teardown side effects
    if entry:
        from herdr.transitions import validate_workflow_transition
        validate_workflow_transition(
            entry.get("status", "pending"),
            "closing",
            force=force,
        )

    if not tasks:
        # Empty configured deliveries were rejected before acquiring close ownership.
        print(f"[CLOSE REPORT] workflow={workflow_id} (no tasks)")
        if not dry_run:
            if entry.get("status") != "completed":
                _mark_workflow_completed(workflow_id, outcome="abandoned" if abandon else "delivered", force=force)
            stage_reset(workflow_id)
            print(f"[WORKFLOW CLOSED] {workflow_id}")
        else:
            print("[DRY RUN] no changes were made")
        return {
            "workflow_id": workflow_id,
            "dry_run": dry_run,
            "outcome": "abandoned" if abandon else "delivered",
            "tasks": [],
            "tabs_closed": [],
            "tabs_would_close": [],
            "tabs_skipped": {},
            "coordinator_closed": False,
            "include_coordinator": include_coordinator,
        }

    base_branch = (entry or {}).get("base_branch") or "main"

    blocked_verdicts = [
        t["task_id"] for t in tasks
        if t.get("status") != "superseded"
        and t.get("stage_verdict") == "blocked"
    ]
    if blocked_verdicts and not abandon:
        print(
            "[CLOSE ABORT] workflow has blocked gate verdicts awaiting "
            "fix-loop resolution: " + ", ".join(blocked_verdicts)
        )
        print(
            "Resolve via fix-loop (or supersede stale verdicts); "
            "to abandon the deliverable explicitly:"
        )
        print(f"  herdr-task close-workflow {workflow_id} --abandon")
        sys.exit(2)

    blocking = [
        t["task_id"] for t in tasks
        if t.get("status") in TEARDOWN_BLOCKING_STATUSES
    ]
    if blocking:
        print(
            "[CLOSE ABORT] workflow has unsettled tasks: "
            + ", ".join(blocking)
        )
        for t in tasks:
            if t.get("task_id") in blocking:
                print(f'  {t["task_id"]}({t.get("status")} @ {t.get("clone_path") or "no-clone"}): '
                      f'wait for settle, steer, or supersede with --reason')
        sys.exit(2)

    # completed/committed 且 git 集成的任务尚未走完 commit/integrate 管线;
    # 物理收尾会把它们直接推进到 cleaned,在跑的 git 子进程随后撞
    # 'cleaned -> committed' 非法转移,交付分支落不进集成链路
    # (2026-09-17 wf-nexusarchive-0917-01 wrapup 实测)。
    unsettled_git = [
        t["task_id"] for t in tasks
        if t.get("status") in ("completed", "committed")
        and (t.get("integration_mode") or "none") == "git"
        and not t.get("finalize_escalated")
    ]
    if unsettled_git:
        print(
            "[CLOSE ABORT] workflow has git tasks awaiting finalize "
            "(commit/integrate not settled): "
            + ", ".join(unsettled_git)
        )
        for t in tasks:
            if t.get("task_id") in unsettled_git:
                print(f'  {t["task_id"]}(completed @ {t.get("clone_path") or "no-clone"}): '
                      f'herdr-task commit {t["task_id"]} / herdr-task integrate {t["task_id"]}')
        print(
            "  等待 Controller 终化重试收敛;或手工收口: "
            "herdr-task commit <task_id>(completed)/ "
            "herdr-task integrate <task_id>(committed);"
        )
        print(
            "  确要丢弃交付物时: herdr-task supersede <task_id> --reason ..."
        )
        sys.exit(2)

    # H-1: machine-set finalize_escalated no longer implies closable.
    # Escalated git tasks stay unclosable until a human explicitly confirms
    # via --accept-escalated/--force/--abandon or supersedes the task.
    # Five choices cost model (FR-5.3, shown in help + abort text):
    # --accept-escalated keeps deliverables, scoped to escalated only;
    # --force directly bypasses the human-confirmation contract;
    # --abandon discards the entire workflow deliverable;
    # supersede permanently discards that branch commits;
    # clear-escalation revokes the flag and re-drives integrate (may re-conflict).
    escalated_git = [
        t["task_id"] for t in tasks
        if t.get("status") in ("completed", "committed")
        and (t.get("integration_mode") or "none") == "git"
        and t.get("finalize_escalated")
    ]
    # --force is the explicitly confirmed direct escape hatch.  It is the
    # historical command-line contract; no second confirmation flag is needed.
    escalated_via = "accept-escalated" if accept_escalated else ("force" if force else ("abandon" if abandon else ""))
    close_outcome = (
        "abandoned" if abandon else
        "escalated_accepted" if escalated_git and accept_escalated else
        "delivered"
    )
    if escalated_git and not (accept_escalated or force or abandon):
        print(
            "[CLOSE ABORT] workflow has escalated git tasks "
            "requiring human confirmation: " + ", ".join(escalated_git)
        )
        print(
            "  finalize_escalated is machine-set and revocable; "
            "it does not imply the deliverable is safe to close."
        )
        print(
            "  Five choices (costs differ, choose explicitly): "
            f"herdr-task close-workflow {workflow_id} --accept-escalated "
            "(keeps deliverables, scoped to escalated only) | "
            f"herdr-task close-workflow {workflow_id} --force "
            "(directly bypasses the whole human-confirmation contract) | "
            f"herdr-task close-workflow {workflow_id} --abandon "
            "(discards the entire workflow deliverable) | "
            "herdr-task supersede <task_id> --reason ... "
            "(permanently discards that branch commits) | "
            "herdr-task clear-escalation <task_id> after recovery "
            "(revokes flag, re-drives integrate, may re-conflict)."
        )
        sys.exit(2)

    # Preflight is read-only: pause may still win until the atomic closing
    # transition. Escape flags authorize output handling, never archive bypass.
    from herdr.clone_archive import plan_clone, preserve_clone
    reclaim_plans = {}
    output_authorizations = {}
    for task in tasks:
        task_id = task["task_id"]
        output = _teardown_output_guard(task)
        explicit = ("purge-clones" if purge_clones else "force" if force else "abandon" if abandon else
                    "accept-escalated" if accept_escalated and task_id in escalated_git else "")
        clone = task.get("clone_path")
        exists = bool(clone and os.path.lexists(os.path.expanduser(clone)))
        deleting_archive = task.get("clone_archive") and task.get("clone_reclaim_started") == task["clone_archive"].get("manifest_sha256")
        document_output = (output["reason"] in {"unpreserved_worktree_output", "unintegrated_commit_diverged"}
                           and (task.get("integration_mode") or "none") == "none")
        safe_path = exists and not os.path.islink(clone) and os.path.commonpath([CLONE_ROOT, os.path.realpath(clone)]) == CLONE_ROOT and os.path.realpath(clone) != CLONE_ROOT
        allowed = (not output["reason"] or explicit or task.get("status") == "failed"
                   or safe_path and (deleting_archive or document_output))
        if output["reason"] and not allowed:
            if not dry_run:
                _record_output_retention(task, output)
                shown = dict(output)
                if shown.get("remediation_cmd") and clone:
                    shown["remediation_cmd"] = shown["remediation_cmd"].replace("<clone>", str(clone))
                print("[CLOSE ABORT] unpreserved task output: " + json.dumps({"task_id": task_id, **shown}, ensure_ascii=False))
                sys.exit(2)
            continue
        if exists:
            try:
                reclaim_plans[task_id] = plan_clone(task, CLONE_ROOT)
            except (OSError, ValueError, tarfile.TarError) as exc:
                print(f"[CLOSE ABORT] sandbox archive planning failed: {task_id}: {exc}")
                sys.exit(2)
        output_authorizations[task_id] = explicit

    # Own the workflow state before the first archive or archive metadata write.
    # SQLite validates the current state in the same transaction as this change;
    # a concurrent pause either wins before this point or is rejected afterwards.
    if not dry_run and entry and entry.get("status") not in {"closing", "completed"}:
        from herdr import kernel
        kernel.transition_workflow(
            workflow_id=workflow_id, to_status="closing",
            reason=f"close_workflow: {'abandoned' if abandon else 'delivered'}",
            source="herdr-task", force=force, store=_get_store(),
            expected_status=entry.get("status"),
        )

    archives = {}
    if not dry_run:
        from herdr import kernel
        for task in tasks:
            task_id = task["task_id"]
            if task_id not in reclaim_plans:
                continue
            try:
                if task.get("clone_archive"):
                    archive = preserve_clone(task, CLONE_ROOT)
                else:
                    from herdr.deliverables import project_for_tasks
                    catalog = project_for_tasks(workflow_id, [task], include_expectations=False)
                    if catalog.get("error") or catalog.get("truncated"):
                        raise ValueError("deliverable inventory incomplete")
                    archive = preserve_clone(task, CLONE_ROOT)
                    archive["deliverables"] = catalog["items"]
                # A recovery snapshot must not grant an implicit Git-output
                # override when output appeared during the archive operation.
                recovering = task.get("clone_archive") and task.get("clone_reclaim_started") == task["clone_archive"].get("manifest_sha256")
                if ((task.get("integration_mode") or "none") == "git"
                        and task.get("status") != "failed" and not recovering
                        and not output_authorizations.get(task_id)):
                    current_output = _teardown_output_guard(task)
                    if current_output["reason"]:
                        _record_output_retention(task, current_output)
                        raise ValueError("Git output changed before archive publication: " + current_output["reason"])
            except (OSError, ValueError, tarfile.TarError) as exc:
                print(f"[CLOSE ABORT] sandbox archive failed: {task_id}: {exc}")
                sys.exit(2)
            archives[task_id] = archive
            kernel.update_task_metadata(task_id, {"clone_archive": archive}, store=_get_store())

    if dry_run:
        print(f"[DRY RUN] close-workflow {workflow_id}")

    report = {
        "workflow_id": workflow_id,
        "dry_run": dry_run,
        "outcome": close_outcome,
        "tasks": [],
        "tabs_closed": [],
        "tabs_would_close": [],
        "tabs_skipped": {},
        "coordinator_closed": False,
        "include_coordinator": include_coordinator,
        "escalated_accepted": [
            {"task_id": tid, "via": escalated_via}
            for tid in escalated_git
            if escalated_via
        ],
    }

    for task in tasks:
        if task.get("status") == "failed" and task["task_id"] not in reclaim_plans:
            report["tasks"].append({
                "task_id": task.get("task_id"),
                "status": "failed",
                "action": "retained-failed",
                "clone_retained_reason": "failed task kept for debugging",
            })
            continue
        finalize_options = dict(purge_clones=purge_clones, dry_run=dry_run, close_claim=close_claim)
        if dry_run and task["task_id"] in reclaim_plans:
            finalize_options["reclaim_plan"] = reclaim_plans[task["task_id"]]
        if task["task_id"] in archives:
            finalize_options["reclaim_archive"] = archives[task["task_id"]]
        authorization = output_authorizations.get(task["task_id"])
        if authorization:
            finalize_options["output_override"] = authorization
        report["tasks"].append(_finalize_one(task, **finalize_options))

    if any(row.get("action") == "retained" and (row.get("output_guard") or {}).get("reason")
           for row in report["tasks"]) and not dry_run:
        print("[CLOSE ABORT] output changed during teardown: " + json.dumps(report, ensure_ascii=False))
        sys.exit(2)

    if not dry_run:
        from herdr.clone_archive import is_residual_clone_shell, delete_residual_clone_shell
        remaining = []
        for task in tasks:
            clone = task.get("clone_path")
            if clone and os.path.lexists(os.path.expanduser(clone)):
                path = Path(clone).expanduser()
                if task.get("clone_archive") and is_residual_clone_shell(path):
                    if delete_residual_clone_shell(path, clone_root=CLONE_ROOT):
                        if not os.path.lexists(path):
                            continue
                remaining.append(task["task_id"])
        if remaining:
            print("[CLOSE ABORT] sandbox reclamation incomplete: " + ", ".join(remaining))
            sys.exit(2)

    topo = _workflow_stage_tabs(workflow_id, tasks)
    live_panes = (
        _live_workspace_panes(topo["workspace_id"])
        if topo["workspace_id"] and not dry_run else None
    )
    for tab_id in topo["tab_ids"]:
        if not topo["workspace_id"]:
            report["tabs_skipped"][tab_id] = (
                "workspace unknown; cannot verify ownership"
            )
            continue
        if live_panes is None:
            report["tabs_skipped"][tab_id] = "pane list unavailable"
            continue
        foreign = _foreign_panes_in_tab(
            live_panes, tab_id, topo["owned_pane_ids"]
        )
        if foreign:
            report["tabs_skipped"][tab_id] = (
                f"shared with foreign panes: {foreign}"
            )
            continue
        if dry_run:
            report["tabs_skipped"][tab_id] = "tab instance ownership unknown; retained"
        else:
            # Tab/anchor IDs lack an immutable instance identity. Closing a
            # reused or empty tab cannot be authorized by persisted IDs alone.
            report["tabs_skipped"][tab_id] = "tab instance ownership unknown; retained"
    if not dry_run:
        latest = _get_store().get_workflow(workflow_id)
        if latest and latest.get("status") != "completed":
            _mark_workflow_completed(
                workflow_id,
                outcome=close_outcome,
                force=force,
            )
        stage_reset(workflow_id)

    coordinator_pane = (
        topo.get("coordinator_pane")
        or (entry or {}).get("coordinator_pane_id")
    )
    if include_coordinator and not dry_run:
        coordinator = dict((entry or {}).get("coordinator_runtime") or {})
        identity = {"pane_id": coordinator_pane, "runtime": coordinator,
                    "agent": coordinator.get("agent")}
        action = close_claim.action(
            "coordinator:" + str(coordinator_pane), identity,
            _close_owned_pane, lambda: close_pane(coordinator_pane),
        )
        report["coordinator_closed"] = bool(action.get("result"))

    # ---- 收尾报告 ----
    print(f"[CLOSE REPORT] workflow={workflow_id} dry_run={dry_run}")
    for row in report["tasks"]:
        line = (
            f"  {row.get('task_id')} status={row.get('status')} "
            f"action={row.get('action')} pane_closed={row.get('pane_closed')}"
        )
        if row.get("evidence"):
            line += f" evidence={row['evidence']}"
        if row.get("clone_retained_reason"):
            line += f" clone_retained({row['clone_retained_reason']})"
        if row.get("pane_retained_reason"):
            line += f" pane_retained({row['pane_retained_reason']})"
        print(line)
    if report.get("escalated_accepted"):
        print("  [ESCALATED ACCEPTED] human-claimed escalated tasks (not ordinary cleaned):")
        for item in report["escalated_accepted"]:
            print(f"    {item.get('task_id')} via={item.get('via')}")
        print(
            "  [DELIVERABLE STATUS] workflow close was accepted with escalation; "
            "task commit/integration status and retained Clone are reported per task."
        )
    print(f"  tabs_closed={report['tabs_closed'] or '[]'}")
    if report.get("tabs_skipped"):
        for tab_id, reason in report["tabs_skipped"].items():
            print(f"  tab_skipped={tab_id} ({reason})")
    if include_coordinator:
        print(f"  coordinator_closed={report['coordinator_closed']}")
    else:
        print(
            "  [COORDINATOR KEPT] "
            f"pane={coordinator_pane or 'unknown'} — "
            "完成知识沉淀并合并 PR 后，请按以下步骤收尾：\n"
            "    1. 运行 six-step-finish 技能执行破坏性收尾步骤（步骤 3 最终确认 + 步骤 4-6）：\n"
            f"       bash .agents/skills/six-step-finish/scripts/finish-task.sh "
            f"<任务分支> --base {base_branch} --forge none\n"
            "       （<任务分支> 替换为已合入的任务分支名；存在多个已合入分支时分别对每个分支执行）\n"
            "       （绝对兜底：~/.agents/skills/six-step-finish/scripts/finish-task.sh）\n"
            "    2. 确认收尾完成后，运行：\n"
            f"       herdr-task close-workflow {workflow_id} --include-coordinator"
        )

    if dry_run:
        print("[DRY RUN] no changes were made")
    else:
        print(f"[WORKFLOW CLOSED] {workflow_id}")
    return report


def node_status(workflow_id, node_key):
    node = resolve_node(node_key, workflow_id)

    data = load_tasks()

    tasks = [
        task
        for task in data["tasks"]
        if task.get("workflow_id") == workflow_id
        and (task.get("node") == node_key or task.get("stage") == node_key)
    ]

    if not tasks:
        result = {
            "workflow_id": workflow_id,
            "node_id": node_key,
            "node": node_key,
            "stage": node_key,
            "node_label": node["node_label"],
            "stage_label": node["stage_label"],
            "status": "empty",
            "complete": False,
            "depends_on": node.get("depends_on", []),
            "next_stage": node.get("next"),
            "tasks": []
        }

        print(
            json.dumps(
                result,
                ensure_ascii=False,
                indent=2
            )
        )
        return

    # Superseded tasks do not block node completion — they were replaced by
    # another task whose outcome is the authoritative result for this node.
    active_tasks = [
        task for task in tasks
        if task.get("status") != "superseded" and not task.get("superseded_by")
    ]

    workflow, _ = _safe_workflow(workflow_id)
    cfg_node = next((n for n in _normalize_workflow_nodes(workflow or {}) if n.get("id") == node_key), {})
    complete = _node_delivery_complete(tasks, cfg_node.get("required_task_ids"))

    result = {
        "workflow_id": workflow_id,
        "node_id": node_key,
        "node": node_key,
        "stage": node_key,
        "node_label": node["node_label"],
        "stage_label": node["stage_label"],
        "status": (
            "completed"
            if complete
            else "in_progress"
        ),
        "complete": complete,
        "depends_on": node.get("depends_on", []),
        "next_stage": node.get("next"),
        "tasks": [
            {
                "task_id": task["task_id"],
                "status": task["status"]
            }
            for task in tasks
        ]
    }

    print(
        json.dumps(
            result,
            ensure_ascii=False,
            indent=2
        )
    )


stage_status = node_status


def _autosave_clone_wip(task):
    """Supersede 前把 clone 工作树变更存成 WIP commit(best-effort)。

    fix1/fix4 的实现曾以未提交形态 stranded 在 retained clone 里。
    只含工作树文件变更,不含 .herdr-loop 等内部装配目录;失败只告警，
    永不阻断作废本身。不 push（分支归属与网络留给集成流程）。
    """
    task_id = (task or {}).get("task_id") or "unknown-task"
    clone = (task or {}).get("clone_path") or ""
    branch = (task or {}).get("branch") or ""
    if not clone or not branch:
        return False
    if not os.path.isdir(os.path.join(clone, ".git")):
        return False

    def _git(*args, timeout=15):
        return subprocess.run(
            ["git", "-C", clone, *args],
            text=True,
            capture_output=True,
            timeout=timeout,
        )

    try:
        status = _git("status", "--porcelain")
        if status.returncode != 0 or not (status.stdout or "").strip():
            return False
        # 不能用 ':!path' 排除式 pathspec：被 .gitignore 忽略的内部文件
        # （.agent-task-context 等）会触发 git 的 ignored-file advice 让
        # add 直接 exit 1，每个 supersede 必现。先全量 add，再把内部
        # 路径从暂存区摘除（对不存在/未跟踪路径 reset 恒安全）。
        add = _git("add", "-A")
        if add.returncode != 0:
            print(f"[WIP AUTOSAVE WARN] {task_id}: git add failed: "
                  f"{(add.stderr or '').strip()[:200]}")
            return False
        _git("reset", "-q", "--", *sorted(INTERNAL_UNTRACKED_EXACT))
        staged = _git("diff", "--cached", "--quiet")
        if staged.returncode == 0:
            return False
        commit = _git("commit", "-m", f"wip: auto-save {task_id} on supersede")
        if commit.returncode != 0:
            print(f"[WIP AUTOSAVE WARN] {task_id}: git commit failed")
            return False
    except Exception as exc:
        print(f"[WIP AUTOSAVE WARN] {task_id}: {exc}")
        return False
    print(f"[WIP AUTOSAVE] {task_id}: work saved on {branch}")
    return True


def supersede_task(task_id, new_task_id=None, reason=None, allow_new_run=False, abandon=False, allow_pending=False):
    """Mark a task as superseded (replaced by another task or abandoned).

    Replacement obligations remain until the linked task delivers. Only an
    explicit abandon removes the obligation without a replacement.
    """
    if abandon and (new_task_id or not str(reason or "").strip()):
        print("[SUPERSEDE REJECTED] --abandon requires a reason and cannot be combined with --by")
        sys.exit(2)
    if not new_task_id and not abandon and not allow_pending:
        print(
            "[SUPERSEDE REJECTED] supersede requires either --by <replacement_task_id> "
            "or --abandon --reason <reason> to prevent unlinked zombie obligations"
        )
        sys.exit(2)
    data = load_tasks()
    task = find_task(data, task_id)

    if not task:
        print(f"Task not found: {task_id}")
        sys.exit(1)

    old_status = task["status"]

    # 补挂：任务已经是 superseded（auto-recover 先作废、direct_dispatch 之后才
    # 按谱系补派 -rN），此刻补上替代者指针。这不是状态转换 —— superseded 必须
    # 保持终态 —— 所以只回填 superseded_by，不动 status、run 与首次作废原因。
    #
    # 不补的后果不是「少个字段」：required_task_ids 的链式解析
    # （scheduler.node_is_complete）断在第一跳，实现节点永远判不出完成，
    # Controller 只会刷 [STAGE ADVANCE WAIT] coordinator=working。
    relinking = old_status == "superseded"
    if relinking and not new_task_id and not abandon:
        print(
            f"Illegal transition: "
            f"{task_id}: {old_status} -> superseded"
        )
        sys.exit(2)
    if relinking:
        existing = str(task.get("superseded_by") or "").strip()
        if existing:
            if existing == new_task_id:
                print(f"[SUPERSEDE NOOP] {task_id} already superseded by {existing}")
                return
            print(
                f"[SUPERSEDE REJECTED] {task_id} already superseded by "
                f"{existing}; refusing to repoint to {new_task_id}"
            )
            sys.exit(2)
    elif "superseded" not in TRANSITIONS.get(old_status, set()):
        print(
            f"Illegal transition: "
            f"{task_id}: {old_status} -> superseded"
        )
        sys.exit(2)

    if abandon and task.get("superseded_by"):
        print("[SUPERSEDE REJECTED] linked replacement cannot be abandoned by changing its predecessor")
        sys.exit(2)
    meta = {"replacement_pending": not abandon}
    if abandon:
        meta["abandon_reason"] = reason
    if new_task_id:
        meta["superseded_by"] = new_task_id
        replacement = find_task(data, new_task_id)
        if replacement:
            if replacement.get("workflow_id") != task.get("workflow_id"):
                print(
                    f"[SUPERSEDE REJECTED] replacement {new_task_id} "
                    "belongs to another workflow"
                )
                sys.exit(2)
            if (task.get("node") or task.get("stage")) != (replacement.get("node") or replacement.get("stage")):
                print("[SUPERSEDE REJECTED] replacement belongs to another node")
                sys.exit(2)
            # 补派按设计就是新执行：controller 保留 --execution-id 并注明
            # "sibling launches keep distinct run_ids"，所以补挂必须允许
            # run 不同，否则存量断链永远补不上。首次作废仍要求同 run。
            if (
                not relinking and not allow_new_run
                and task.get("run_id")
                and replacement.get("run_id") != task.get("run_id")
            ):
                print(
                    f"[SUPERSEDE REJECTED] replacement {new_task_id} "
                    "belongs to another run"
                )
                sys.exit(2)

    if reason and not relinking:
        meta["supersede_reason"] = reason

    store = _get_store()
    try:
        from herdr import kernel
        # 补挂是幂等自转移：核心状态机本就允许 old == new
        # （herdr.transitions.validate_task_transition），因此这里只借道
        # metadata 回填指针，status 保持终态不变。
        result = kernel.transition_task(
            task_id=task_id,
            to_status="superseded",
            reason=(task.get("supersede_reason") or reason) if relinking
            else (reason or "superseded"),
            source="herdr-task",
            metadata=meta,
            store=store,
            expected_status=old_status,
            expected_version=task.get("version"),
        )
        if not result.get("accepted", True):
            print(
                f"[SUPERSEDE CAS REJECTED] {task_id} changed during "
                f"{'link' if relinking else 'supersede'}",
                file=sys.stderr,
            )
            sys.exit(2)
    except (OSError, RuntimeError, ValueError, AttributeError) as exc:
        print(f"Error superseding task {task_id}: {exc}", file=sys.stderr)
        sys.exit(2)

    t_file = globals().get("TASKS_FILE") or os.environ.get("TASKS_FILE")
    sync_tasks_projection(store=store, tasks_file=Path(t_file) if t_file else None)

    if relinking:
        print(
            f"{task_id}: linked superseded_by={new_task_id} "
            f"(status unchanged: {old_status})"
        )
        return

    try:
        _autosave_clone_wip(task)
    except Exception as exc:
        print(f"[WIP AUTOSAVE WARN] {task_id}: {exc}")

    msg = f"{task_id}: {old_status} -> superseded"
    if new_task_id:
        msg += f" (by {new_task_id})"
    print(msg)


def clear_finalize_escalation(task_id):
    """H-1: revoke machine-set finalize_escalated so finalize can re-drive.

    Human recovery path after the cause (dirty main repo, flaky gate) is
    fixed. Clears the flag and reason **plus** the shared
    ``<task_id>:finalize`` attention episode, so the next controller sweep
    recomputes retry budget from scratch instead of seeing the stale
    ``attempts >= FINALIZE_RETRY_MAX`` snapshot and immediately
    re-escalating. (P1: flag-only clearing could never actually resume
    a retry_exhausted task.) The controller additionally drops its
    in-memory exhausted latch once the episode is gone.
    """
    data = load_tasks()
    task = find_task(data, task_id)
    if not task:
        print(f"Task not found: {task_id}")
        sys.exit(1)
    # P1 normalization: never early-return when the flag is already false.
    # A partially-failed escalation can leave attempts >= MAX in the
    # attention episode while finalize_escalated=false; skipping cleanup
    # then leaves the task wedged forever. Always clear + normalize.
    was_escalated = bool(task.get("finalize_escalated"))
    from herdr import kernel
    from herdr import liveness
    try:
        attention_cleared = liveness.EpisodeStore(ATTENTION_FILE).clear(
            f"{task_id}:finalize"
        )
    except (OSError, ValueError, RuntimeError, AttributeError) as exc:
        print(f"Error clearing attention for {task_id}: {exc}",
              file=sys.stderr)
        sys.exit(2)
    try:
        kernel.update_task_metadata(
            task_id,
            {"finalize_escalated": False,
             "finalize_escalate_reason": None},
            store=_get_store(),
        )
    except (OSError, ValueError, RuntimeError, AttributeError,
            subprocess.SubprocessError) as exc:
        print(f"Error clearing escalation for {task_id}: {exc}",
              file=sys.stderr)
        sys.exit(2)
    print(f"[ESCALATION CLEARED] {task_id} "
          f"attention_cleared={bool(attention_cleared)} "
          f"was_escalated={was_escalated}")


def pause_task(task_id, reason=None):
    """Pause an in-flight task (dispatched/working/rework)."""
    if reason:
        from herdr import kernel
        try:
            kernel.update_task_metadata(task_id, {"pause_reason": reason}, store=_get_store())
        except ValueError:
            print(f"Task not found: {task_id}")
            sys.exit(1)
    set_status(task_id, "paused")


def resume_task(task_id):
    """Resume a paused task back to working or rework based on history."""
    data = load_tasks()
    task = find_task(data, task_id)
    if not task:
        print(f"Task not found: {task_id}")
        sys.exit(1)
    if task.get("status") != "paused":
        print(f"Task {task_id} is not paused (currently: {task.get('status')})")
        sys.exit(2)
    target = "working"
    history = task.get("status_history", [])
    # 只看最近一次暂停事件：跳过较新的 paused 事件去挑更早的可恢复前态会把
    # 目标选错（rework -> paused -> rework -> working -> blocked -> paused 应回
    # working，而不是更早的 rework）。paused 的出边只有 working/rework/
    # agent_done/failed/superseded/interrupted；dispatched、blocked 等前态不在
    # 其中，必须落回 working，否则 set_status 会以 Illegal transition 拒绝。
    latest_pause_from = None
    for h in reversed(history):
        if h.get("to") == "paused":
            latest_pause_from = h.get("from")
            break
    if latest_pause_from in ("working", "rework"):
        target = latest_pause_from
    set_status(task_id, target)


def _clear_suppress_auto_close(workflow_id):
    """Fix-loop reopen 闩:该 workflow 任一任务进入 ACTIVE 时清除。

    闩存在的意义是封住 reopen 后"旧任务仍全为完成系、周期 sweep
    立即 auto-close"的自消除窗口;首个 fix task 落盘即为摘除时机,
    此时 implementation 节点已回归未完成。
    """
    if not workflow_id:
        return

    store = _get_store()
    entry = store.get_workflow(workflow_id)
    if entry is None or not entry.get("suppress_auto_close"):
        return

    from herdr import kernel
    kernel.update_workflow_metadata(workflow_id, {"suppress_auto_close": None}, store=store)

    print(f"[AUTO-CLOSE LATCH CLEARED] workflow={workflow_id}")


def reopen_workflow(workflow_id):
    from herdr.workflow_close import workflow_lifecycle_lock
    with workflow_lifecycle_lock(_get_store(), workflow_id) as acquired:
        if not acquired:
            print(f"[REOPEN BUSY] workflow={workflow_id}: lifecycle operation in progress")
            sys.exit(75)
        return _reopen_workflow_owned(workflow_id)


def _reopen_workflow_owned(workflow_id):
    """重开已关闭的 workflow(fix-loop 续用同一 workflow/PR 上下文)。

    仅 completed 可重开;总指挥 pane 必须存活(验收与派发的消息终点)。
    重开即置 suppress_auto_close 闩,防止周期 sweep 在 fix task 派发前
    将 workflow 自消除回 completed。
    """
    entry, entries = _load_workflow_entry(workflow_id)

    if entry is None:
        print(f"Unknown workflow: {workflow_id}")
        sys.exit(1)

    if entry.get("status") != "completed":
        print(
            f"[REOPEN ABORT] workflow={workflow_id} "
            f"status={entry.get('status')}: only completed workflows can reopen"
        )
        sys.exit(2)

    coordinator_pane = entry.get("coordinator_pane_id")

    if not coordinator_pane:
        print(
            f"[REOPEN ABORT] workflow={workflow_id}: "
            "record has no coordinator_pane_id"
        )
        sys.exit(2)

    listing = _herdr("pane", "list")
    alive = False

    if listing.returncode == 0:
        try:
            result = json.loads(listing.stdout).get("result", {})
            panes = (
                result.get("panes", result)
                if isinstance(result, dict)
                else result
            )
            alive = any(
                pane.get("pane_id") == coordinator_pane
                for pane in (panes or [])
            )
        except (json.JSONDecodeError, TypeError):
            alive = False

    if not alive:
        print(
            f"[REOPEN ABORT] coordinator pane {coordinator_pane} is not alive; "
            "rebuild the coordinator pane first, then reopen"
        )
        sys.exit(2)

    store = _get_store()
    try:
        from herdr import kernel
        kernel.transition_workflow(
            workflow_id=workflow_id,
            to_status="in_progress",
            reason="workflow_reopened",
            source="herdr-task",
            metadata={"suppress_auto_close": True, "reopened_at": _now()},
            store=store,
        )
    except Exception as exc:
        print(f"Error reopening workflow {workflow_id}: {exc}", file=sys.stderr)
        sys.exit(2)

    wf_file = globals().get("WORKFLOWS_FILE") or os.environ.get("WORKFLOWS_FILE") or WORKFLOWS_FILE
    sync_workflows_projection(store=store, wf_file=Path(wf_file) if wf_file else None)

    stage_reset(workflow_id)

    print(
        f"[WORKFLOW REOPENED] {workflow_id} "
        f"(suppress_auto_close latch set; clears on first active task)"
    )


def stage_reset(workflow_id, stage=None):
    """Clear stage-state.json advance lock(s) for a workflow.

    Removes 'queued' or 'notified' entries that may be permanently
    preventing the Controller from re-triggering stage advance events.
    Use when a workflow is stuck and manual intervention is needed.
    """
    stage_path = STAGE_STATE_FILE
    if not os.path.exists(stage_path):
        print("stage-state.json not found — nothing to reset.")
        return

    with open(stage_path, "r", encoding="utf-8") as f:
        state = json.load(f)

    prefix = f"{workflow_id}:"
    removed = []
    for key in list(state.keys()):
        if key.startswith(prefix):
            if stage is None or key == f"{prefix}{stage}":
                del state[key]
                removed.append(key)

    tmp = stage_path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(state, f, ensure_ascii=False, indent=2)
    os.replace(tmp, stage_path)

    if removed:
        for k in removed:
            print(f"[RESET] cleared: {k}")
    else:
        target = f"{prefix}{stage}" if stage else f"{prefix}*"
        print(f"[RESET] no entries found for: {target}")


def force_advance(workflow_id, stage=None):
    """Force re-evaluation of stage advance for a workflow.

    Clears existing stage-state locks for the given stage(s) so the
    Controller daemon will re-check DAG completion and re-notify the
    coordinator on its next cycle (~2 s).
    """
    stage_reset(workflow_id, stage)
    print(
        f"[ADVANCE] stage-state cleared for workflow={workflow_id}."
        " Controller will re-evaluate within ~2 seconds."
    )


def cmd_workflow_migration(args):
    from herdr import workflow_repair_migration as migration, state_db
    try:
        db_path = state_db.resolve_state_db_path()
        if args.output and Path(args.output).exists():
            raise ValueError('output file already exists')
        if args.action == 'plan':
            result = migration.plan(db_path, args.workflow_id)
        else:
            if not args.input:
                raise ValueError('--input reviewed plan/receipt is required')
            data = json.loads(Path(args.input).read_text())
            if data.get('workflow_id') != args.workflow_id:
                raise ValueError('workflow scope mismatch')
            result = migration.apply(db_path, data) if args.action == 'apply' else migration.rollback(db_path, data)
        output = json.dumps(result, ensure_ascii=False, indent=2)
        if args.output:
            path = Path(args.output)
            with path.open('x') as stream:
                stream.write(output + '\n')
        else:
            print(output)
    except (OSError, ValueError, TypeError, sqlite3.Error) as exc:
        print(f'[MIGRATION REJECTED] {exc}', file=sys.stderr)
        sys.exit(2)


def cmd_workflow_recovery(args):
    from herdr import recovery_store, state_db
    try:
        db_path = state_db.resolve_state_db_path()
        if args.command == 'recovery-status':
            result = {'workflow_id': args.workflow_id,
                      'operations': recovery_store.list_operations(db_path, args.workflow_id)}
        else:
            result = recovery_store.decide_operation(db_path, args.operation_id, args.expected_version,
                args.operator, args.action, args.reason, time.time(), until=args.until)
        print(json.dumps(result, ensure_ascii=False))
    except (OSError, ValueError, sqlite3.Error) as exc:
        print(f'[RECOVERY REJECTED] {exc}', file=sys.stderr)
        sys.exit(2)

def list_tasks(workflow_id=None):
    data = load_tasks()

    tasks = data["tasks"]

    if workflow_id:
        tasks = [
            task
            for task in tasks
            if task.get("workflow_id") == workflow_id
        ]

    print(
        json.dumps(
            {"tasks": tasks},
            ensure_ascii=False,
            indent=2
        )
    )


def _task_head_sha(task):
    """Best-effort: task branch head sha from its CoW clone (gate evidence)."""
    task = task or {}
    task_id = task.get("task_id") or ""
    branch = task.get("branch") or ""
    if not task_id or not branch:
        return ""
    clone_root = Path(
        os.environ.get("HERDR_CLONES_DIR")
        or (Path.home() / ".herdr-controller" / "clones")
    )
    clone = clone_root / task_id
    if not clone.exists():
        return ""
    try:
        result = subprocess.run(
            ["git", "-C", str(clone), "rev-parse", "--short", branch],
            text=True,
            capture_output=True,
            timeout=5,
        )
        if result.returncode == 0:
            return result.stdout.strip()
    except Exception:
        pass
    return ""


def note_add(args):
    from herdr import workflow_docs as wd

    if str(args.kind or "").strip() == "delivery":
        print(
            "Error: delivery 备注必须用 'herdr-task record-delivery' 写入 "
            "(需要 delivery_branch/candidate_sha/review_task/test_gate)；"
            "--kind delivery 已禁用，人工留痕请用 --kind note。"
        )
        sys.exit(2)

    task = None
    if args.task:
        task = find_task(load_tasks(), args.task)
        if not task:
            print(f"Task not found: {args.task}")
            sys.exit(1)

    if args.file:
        note_file = Path(args.file).expanduser()
        if not note_file.exists():
            print(f"Note file not found: {note_file}")
            sys.exit(2)
        try:
            with note_file.open(encoding="utf-8") as handle:
                body = handle.read(wd.MAX_BODY + 1)
        except OSError as exc:
            print(f"Error reading note file: {exc}")
            sys.exit(2)
    else:
        body = args.text or ""

    node = args.node or (task.get("node") or task.get("stage") if task else None)
    agent = args.agent or (task.get("agent") if task else None)
    base_sha = args.base_sha or _task_head_sha(task) or None

    # --field KEY=VALUE 只做解析与透传；字段名/保留名/长度仍由
    # append_note 的白名单统一裁决，CLI 不自建第二套校验。
    extra_fields = {}
    for raw in getattr(args, "field", None) or []:
        key, sep, value = str(raw).partition("=")
        if not sep or not key.strip():
            print(f"Error: --field expects KEY=VALUE, got: {raw}")
            sys.exit(2)
        extra_fields[key.strip()] = value

    try:
        record = wd.append_note(
            args.workflow_id,
            kind=args.kind,
            title=args.title,
            body=body,
            node=node,
            task_id=args.task or "",
            agent=agent,
            source=args.source,
            base_sha=base_sha,
            round=args.round,
            invalidates=args.invalidates,
            fields=extra_fields or None,
        )
    except ValueError as exc:
        print(f"Error: {exc}")
        sys.exit(2)

    print(f"[NOTE_ADDED] {record['note_id']}")
    print(f"[NOTE_DIR] {wd.workflow_docs_dir(args.workflow_id)}")


def note_list(args):
    from herdr import workflow_docs as wd

    try:
        annotated = wd.annotate_notes(
            wd.load_notes(args.workflow_id),
            current_base_sha=args.current_base_sha,
        )
    except ValueError as exc:
        print(f"Error: {exc}")
        sys.exit(2)
    if args.node:
        annotated = [n for n in annotated if (n.get("node") or "") == args.node]
    if args.limit and args.limit > 0:
        annotated = annotated[-args.limit:]

    if args.json:
        print(json.dumps(
            {
                "workflow_id": args.workflow_id,
                "docs_dir": str(wd.workflow_docs_dir(args.workflow_id)),
                "notes": annotated,
            },
            ensure_ascii=False,
            indent=2,
        ))
        return

    print(f"=== 工作流共享文档 [{args.workflow_id}] ===")
    print(f"目录: {wd.workflow_docs_dir(args.workflow_id)}")
    if not annotated:
        print("暂无条目")
        return
    for note in annotated:
        stale = (
            f"[STALE: {note.get('stale_reason') or 'stale'}] "
            if note.get("stale")
            else ""
        )
        print(
            f"{stale}[{note.get('kind')}][{note.get('node') or '-'}] "
            f"{note.get('title')} ({note.get('note_id')})"
        )


def _capture_verified_candidate(task):
    """Persist the clone revision that was live at verdict-write time.

    This is completion evidence, distinct from ``baseline_commit`` (launch
    evidence). Reading HEAD here catches an agent that pulled, checked out, or
    rebased while running: the recorded value then names what the verifier
    actually saw, and the join gate can refuse a verdict that never proved the
    frozen candidate.

    Never raises: the caller (set_status) inspects the returned value and
    refuses the verdict, so an unreadable clone fails closed at the decision
    boundary rather than being swallowed here.
    """
    clone = str((task or {}).get("clone_path") or "").strip()
    if not clone or not os.path.isdir(clone):
        return ""
    try:
        probe = subprocess.run(
            ["git", "-C", clone, "rev-parse", "--verify", "--quiet", "HEAD^{commit}"],
            text=True, capture_output=True, check=False, timeout=30,
        )
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError):
        return ""
    head = (probe.stdout or "").strip()
    if probe.returncode != 0 or not head:
        return ""

    task_id = str((task or {}).get("task_id") or "")
    if not task_id:
        return head
    try:
        store = _get_store()
        from herdr import kernel
        kernel.update_task_metadata(
            task_id=task_id,
            updates={"verified_candidate_sha": head},
            store=store,
        )
        task["verified_candidate_sha"] = head
        try:
            fresh = store.get_task(task_id)
            if fresh and isinstance(fresh, dict) and "version" in fresh:
                task["version"] = fresh["version"]
            elif task.get("version") is not None:
                task["version"] = int(task.get("version") or 0) + 1
        except Exception:
            if task.get("version") is not None:
                task["version"] = int(task.get("version") or 0) + 1
        print(f"[VERIFIED CANDIDATE] {task_id} head={head}")
    except Exception as exc:
        print(f"[VERIFIED CANDIDATE WARN] {task_id}: {exc}", file=sys.stderr)
    return head


def _record_gate_note(task, verdict, note):
    """Best-effort machine evidence: gate verdict -> workflow shared docs."""
    try:
        from herdr import workflow_docs as wd

        workflow_id = task.get("workflow_id")
        if not workflow_id:
            return
        provenance = wd.provenance_from_task(task)
        base_sha = provenance["base_sha"] or _task_head_sha(task)
        title = f"{provenance['node'] or '未知节点'} 门禁结论 {verdict}"

        for existing in wd.load_notes(workflow_id):
            if (
                existing.get("kind") == "gate"
                and existing.get("task_id") == provenance["task_id"]
                and existing.get("title") == title
                and (existing.get("base_sha") or "") == (base_sha or "")
            ):
                return

        wd.append_note(
            workflow_id,
            kind="gate",
            title=title,
            body=note or "",
            node=provenance["node"],
            task_id=provenance["task_id"],
            agent=provenance["agent"],
            source=wd.SOURCE_CONTROLLER,
            base_sha=base_sha,
        )
    except Exception as exc:
        print(f"[NOTE EVIDENCE WARN] {exc}")


def record_delivery_note(
    workflow_id, delivery_branch, candidate_sha, review_task, test_gate,
    base="", node="", agent="", supersedes=None,
):
    """Record one explicit candidate identity, rejecting implicit ambiguity."""
    from herdr import delivery_record as _dr
    from herdr import workflow_docs as wd

    candidate_sha = str(candidate_sha)
    payload = {
        "delivery_id": f"candidate-{candidate_sha}",
        "delivery_branch": delivery_branch,
        "candidate_sha": candidate_sha,
        "review_task": review_task,
        "test_gate": test_gate,
        "base": base,
        "supersedes": supersedes or "",
    }
    ok, missing = _dr.validate_delivery_payload(payload)
    if not ok:
        print(f"delivery payload missing fields: {missing}")
        sys.exit(2)
    identity = _dr.candidate_identity(payload)

    def _find_existing(existing_notes):
        annotated = wd.annotate_notes(
            existing_notes, current_base_sha=base or None
        )
        for existing in annotated:
            if existing.get("kind") != "delivery":
                continue
            if _dr.candidate_identity(existing) != identity:
                continue
            if existing.get("stale"):
                print(
                    f"[DELIVERY INVALIDATED] {identity} cannot be replayed; "
                    "record a new candidate identity"
                )
                sys.exit(2)
            if _dr._delivery_fingerprint(existing) != _dr._delivery_fingerprint(payload):
                print(f"[DELIVERY CONFLICT] identity {identity} has different payload")
                sys.exit(2)
            return existing
        return None

    def _can_append(existing_notes):
        if _find_existing(existing_notes) is not None:
            return False
        annotated = wd.annotate_notes(
            existing_notes, current_base_sha=base or None
        )
        if supersedes:
            known_aliases = {
                alias
                for existing in annotated
                if existing.get("kind") == "delivery"
                for alias in _dr._candidate_aliases(existing)
            }
            if str(supersedes) not in known_aliases:
                print(
                    f"[DELIVERY SUPERSEDES UNKNOWN] {supersedes}; "
                    "refusing an unverifiable replacement edge"
                )
                sys.exit(2)
        try:
            active = _dr.select_effective_delivery(annotated)
        except _dr.DeliveryAmbiguityError as exc:
            print(f"[DELIVERY AMBIGUOUS] {exc}")
            sys.exit(2)
        if active is not None and not supersedes:
            print(
                "[DELIVERY AMBIGUOUS] an active delivery candidate already exists; "
                "provide an explicit supersedes relation before replacing it"
            )
            sys.exit(2)
        prior_candidates = [
            item for item in annotated
            if item.get("kind") == "delivery"
            and _dr._is_delivery_claim(item)
        ]
        if prior_candidates and not supersedes:
            print(
                "[DELIVERY REPLACEMENT REQUIRED] a prior delivery candidate exists; "
                "provide --supersedes even when it was invalidated"
            )
            sys.exit(2)
        return True

    initial_notes = wd.load_notes(workflow_id)
    legacy = _dr.unidentified_delivery_notes(initial_notes)
    if legacy:
        shown = ", ".join(str(note.get("note_id") or "?") for note in legacy[:5])
        print(
            f"[BASELINE DEGRADED] {len(legacy)} identity-less delivery note(s) "
            f"ignored (human evidence, not delivery claims): {shown}"
        )
    existing = _find_existing(initial_notes)
    if existing is not None:
        print(f"[DELIVERY EXISTS] {existing.get('note_id')}")
        return existing
    _can_append(initial_notes)
    title = _dr.delivery_note_title(delivery_branch, candidate_sha)
    body_text = _dr.delivery_note_body(payload)
    fields = {
        "delivery_id": payload["delivery_id"],
        "delivery_branch": delivery_branch,
        "candidate_sha": candidate_sha,
        "review_task": review_task,
        "test_gate": test_gate,
    }
    if supersedes:
        fields["supersedes"] = supersedes
    try:
        record = wd.append_note(
            workflow_id,
            kind="delivery",
            title=title,
            body=body_text,
            node=node or "wrapup",
            task_id=review_task,
            agent=agent,
            source=wd.SOURCE_CONTROLLER,
            base_sha=base or None,
            fields=fields,
            precondition=lambda existing_notes, _record: _can_append(existing_notes),
        )
    except ValueError:
        existing = _find_existing(wd.load_notes(workflow_id))
        if existing is None:
            raise
        print(f"[DELIVERY EXISTS] {existing.get('note_id')}")
        return existing
    print(f"[DELIVERY RECORDED] {record['note_id']} {delivery_branch}@{candidate_sha}")
    return record


def check_delivery_for_pr(
    workflow_id, head_sha, head_ref_name="",
    merged_prs=None, cherry_lines=None,
    head_tree=None, candidate_tree=None, repo_path=None,
):
    """Thin PR gate (FR-4.2/4.3/4.4): equivalence + template + same-branch warn."""
    from herdr import delivery_record as _dr
    from herdr import workflow_docs as wd

    notes = wd.load_notes(workflow_id)
    # Candidate base identity is the recorded base, not the PR head.  First
    # select the raw identity, then apply base/invalidation annotations and
    # select again so a stale replacement cannot fall back to its predecessor.
    try:
        raw_effective = _dr.select_effective_delivery(notes)
    except _dr.DeliveryAmbiguityError as exc:
        print(f"[DELIVERY AMBIGUOUS] {exc}; refusing PR")
        sys.exit(2)
    if raw_effective is None:
        print("[DELIVERY CHECK] no effective delivery note; refusing ambiguous PR")
        sys.exit(2)
    current_base = str(
        raw_effective.get("base")
        or _dr._body_value(raw_effective, "base")
        or raw_effective.get("base_sha")
        or ""
    )
    annotated = wd.annotate_notes(notes, current_base_sha=current_base or None)
    try:
        effective = _dr.select_effective_delivery(annotated)
    except _dr.DeliveryAmbiguityError as exc:
        print(f"[DELIVERY AMBIGUOUS] {exc}; refusing PR")
        sys.exit(2)
    if effective is None:
        print("[DELIVERY CHECK] delivery candidate was invalidated; refusing PR")
        sys.exit(2)
    body = effective.get("body") or ""
    candidate_sha = str(effective.get("candidate_sha") or "")
    if not candidate_sha:
        for line in body.splitlines():
            if line.startswith("candidate_sha:"):
                candidate_sha = line.split(":", 1)[1].strip()
                break
    if not candidate_sha:
        candidate_sha = str(effective.get("base_sha") or "")
    repo_path = os.path.realpath(repo_path or os.getcwd())
    if merged_prs is None and head_ref_name:
        proc = subprocess.run(
            ["gh", "pr", "list", "--state", "merged", "--head",
             head_ref_name, "--json", "number,headRefName,headRefOid,state"],
            cwd=repo_path, text=True, capture_output=True, check=False,
        )
        if proc.returncode == 0:
            try:
                merged_prs = json.loads(proc.stdout or "[]")
            except (TypeError, ValueError):
                merged_prs = []
                print("[DELIVERY INPUT WARN] gh returned invalid merged-PR JSON")
        else:
            merged_prs = []
            print(
                "[DELIVERY INPUT WARN] merged PR history unavailable; "
                f"gh exit={proc.returncode}: {(proc.stderr or '').strip()[:300]}"
            )
    if head_tree is None or candidate_tree is None:
        def tree_for(sha):
            if not sha:
                return None
            proc = subprocess.run(
                ["git", "-C", repo_path, "rev-parse", "--verify", f"{sha}^{{tree}}"],
                text=True, capture_output=True, check=False,
            )
            return proc.stdout.strip() if proc.returncode == 0 else None
        head_tree = head_tree if head_tree is not None else tree_for(head_sha)
        candidate_tree = (
            candidate_tree if candidate_tree is not None else tree_for(candidate_sha)
        )
    equivalent, eq_reason = _dr.candidates_equivalent(
        candidate_sha=candidate_sha,
        head_sha=head_sha,
        cherry_lines=cherry_lines,
        head_tree=head_tree,
        candidate_tree=candidate_tree,
    )
    warn = _dr.same_branch_warning(
        head_ref_name=head_ref_name,
        merged_prs=merged_prs,
        candidate_sha=candidate_sha,
    )
    fields = _dr.pr_template_fields(
        branch=head_ref_name,
        head_sha=head_sha,
        base=current_base or "main",
        review_ref=effective.get("task_id") or "",
        delivery_id=_dr.candidate_identity(effective),
    )
    print(_dr.format_pr_body(fields))
    print(f"equivalent={equivalent} reason={eq_reason}")
    print(f"same_branch_warn={warn['warn']} detail={warn['detail']}")
    if not equivalent:
        print("[DELIVERY CHECK] head not equivalent to candidate; warn (not block)")
    if warn["warn"]:
        print(f"[DELIVERY WARN] {warn['detail']}")
    return {"equivalent": equivalent, "warn": warn, "fields": fields}


def create_pull_request(args):
    from herdr.pr_delivery import create_task_pr
    body = ""
    if args.body_file:
        path = Path(args.body_file).expanduser()
        if path.stat().st_size > 65536:
            raise ValueError("PR body exceeds publication budget")
        body = path.read_text()
    result = create_task_pr(_get_store(), args.task_id, title=args.title, body=body, draft=args.draft)
    print(json.dumps(result, ensure_ascii=False))


def merge_pull_request(args):
    from herdr.pr_delivery import merge_task_pr
    result = merge_task_pr(
        _get_store(),
        args.task_id,
        pr_number=args.number,
        merge_method=getattr(args, "method", "merge"),
    )
    print(json.dumps(result, ensure_ascii=False))


def check_zombie_obligations(data=None):
    if data is None:
        data = load_tasks()
    tasks = data.get("tasks", []) if isinstance(data, dict) else (data or [])
    zombies = []
    for t in tasks:
        if isinstance(t, dict):
            if (t.get("status") == "superseded"
                    and t.get("replacement_pending")
                    and not t.get("superseded_by")):
                zombies.append(t)
    return zombies



def main():
    from herdr.task_cli_parser import build_parser
    args = build_parser().parse_args()

    if args.command == 'sync-experience':
        from herdr.experience.collector import ExperienceCollector
        explicit_token = getattr(args, "token", None)
        hub_client = None
        if explicit_token:
            from herdr.experience.client import ExperienceClient
            hub_client = ExperienceClient(token=explicit_token)
        collector = ExperienceCollector(hub_client=hub_client)
        if getattr(args, "workflow_id", None):
            collector.collect_workflow_tasks(args.workflow_id)
        if getattr(args, "include_lessons", False):
            les_path = getattr(args, "lessons_path", None)
            les_res = collector.collect_and_sync_lessons(lessons_path=les_path)
            if not les_res.get("ok"):
                print(f"[EXPERIENCE SYNC WARNING] lessons sync notice: {les_res.get('reason')}", file=sys.stderr)
        res = collector.recover_and_sync(force=getattr(args, "force", False) or bool(getattr(args, "workflow_id", None) or getattr(args, "include_lessons", False)))
        if getattr(args, "json", False):
            print(json.dumps(res, ensure_ascii=False, indent=2))
        else:
            print(f"[EXPERIENCE SYNC] collected={res.get('pending_collected', 0)} retried={res.get('retried', 0)} succeeded={res.get('succeeded', 0)} failed={res.get('failed', 0)}")
        # Fail loud when uploads remain unrecoverable: operator automation must
        # not mistake an untouched or failed queue for recovery success.
        # A forced drain attempts every eligible row, so any remainder means
        # something did not go through.
        if res.get("pending_upload_remaining", 0) > 0 and (
            res.get("reason") == "no_hub_client"
            or res.get("failed", 0) > 0
            or getattr(args, "force", False)
        ):
            print("[EXPERIENCE SYNC FAILED] pending uploads remain; recovery did not complete", file=sys.stderr)
            sys.exit(2)
        if res.get("pending_collection_failed", 0) > 0:
            print("[EXPERIENCE SYNC FAILED] pending collections failed; recovery did not complete", file=sys.stderr)
            sys.exit(2)
        if res.get("pending_collection_error", 0) > 0:
            print("[EXPERIENCE SYNC FAILED] quarantined collections remain; a settlement was dropped", file=sys.stderr)
            sys.exit(2)
        sys.exit(0)
    elif args.command == 'acceptance-record':
        from herdr.task_checkpoint import record_business_acceptance
        try:
            references = []
            for item in args.artifact:
                obs, digest = item.split(':', 1)
                references.append({'observation_id': obs, 'sha256': digest})
            print(json.dumps(record_business_acceptance(_get_store(), args.task_id, args.run_id,
                args.epoch, args.candidate_sha, args.verdict, references, args.criterion), ensure_ascii=False))
        except (ValueError, OSError) as exc:
            print(f'[ACCEPTANCE REJECTED] {exc}', file=sys.stderr)
            sys.exit(2)
    elif args.command == 'node-budget-extend':
        from herdr.node_config import extend_budget
        try:
            print(json.dumps(extend_budget(_get_store(), args.workflow_id, args.node,
                expected_sha=args.expected_sha, additional=args.additional,
                operator=args.operator, reason=args.reason), ensure_ascii=False))
        except ValueError as exc:
            print(f'[BUDGET REJECTED] {exc}', file=sys.stderr)
            sys.exit(2)
    elif args.command == 'workflow-migrate':
        cmd_workflow_migration(args)
    elif args.command == 'partial-launch-preview':
        import hashlib
        try:
            probe = subprocess.run(['herdr', 'pane', 'read', args.pane_id], text=True,
                capture_output=True, check=False, timeout=10)
            if probe.returncode != 0 or len(probe.stdout.encode()) > 65536:
                raise ValueError('Pane transcript 不可读或超过 64 KiB')
            print(json.dumps({'pane_id': args.pane_id, 'transcript': probe.stdout,
                'sha256': hashlib.sha256(probe.stdout.encode()).hexdigest()}, ensure_ascii=False))
        except (OSError, ValueError, subprocess.SubprocessError) as exc:
            print(f'[PARTIAL LAUNCH PREVIEW REJECTED] {exc}', file=sys.stderr)
            sys.exit(2)
    elif args.command == 'partial-launch-retire':
        from herdr import dispatch_recovery, state_db
        try:
            report = dispatch_recovery.abandon_partial_launch(state_db.resolve_state_db_path(),
                args.workflow_id, args.operation_id, args.expected_version,
                args.prior_operation_id, args.expected_prior_version, operator=args.operator,
                reason=args.reason, candidate_sha=args.candidate_sha, intent_id=args.intent_id,
                task_id=args.task_id, pane_id=args.pane_id, terminal_id=args.terminal_id,
                transcript_sha256=args.transcript_sha256,
                confirmed_startup_only=args.confirm_startup_only)
            print(json.dumps(report, ensure_ascii=False))
        except (OSError, ValueError, RuntimeError, sqlite3.Error) as exc:
            print(f'[PARTIAL LAUNCH RETIREMENT REJECTED] {exc}', file=sys.stderr)
            sys.exit(2)
    elif args.command in ('recovery-status', 'recovery-decide'):
        cmd_workflow_recovery(args)
    elif args.command == "add":
        add_task(args)

    elif args.command == "launch":
        launch_task(args)

    elif args.command in ('checkpoint-publish', 'checkpoint-read', 'checkpoint-aggregate'):
        cmd_task_checkpoint(args)

    elif args.command == 'tool-run':
        cmd_tool_run(args)

    elif args.command == 'launch-reconcile':
        cmd_launch_reconcile(args)

    elif args.command == "rework":
        cmd_rework(args)

    elif args.command == "reap":
        cmd_reap(args)

    elif args.command == "panes":
        cmd_panes(args)

    elif args.command == "dispatch":
        dispatch_task(
            args.task_id,
            args.prompt
        )

    elif args.command == "verify-baseline":
        verify_baseline(
            args.task_id
        )

    elif args.command == "verify-metrics":
        verify_metrics(
            args.task_id,
            min_score=args.min_score,
            if_present=args.if_present,
        )

    elif args.command == "differential-test":
        differential_test(args)

    elif args.command == "commit":
        commit_task(
            args.task_id,
            args.message,
            allow_rebase=getattr(args, "allow_rebase", False),
        )

    elif args.command == "integrate":
        integrate_task(args.task_id)

    elif args.command == "cleanup":
        cleanup_task(args.task_id)

    elif args.command == "purge":
        purge_task(args.task_id)

    elif args.command == "finalize":
        finalize_task(
            args.task_id,
            force=args.force,
            purge_clones=args.purge_clones,
        )

    elif args.command == "close-workflow":
        target_wid = resolve_workflow_id_for_close(args.workflow_id)
        try:
            close_workflow(
                target_wid,
                include_coordinator=args.include_coordinator,
                purge_clones=args.purge_clones,
                dry_run=args.dry_run,
                abandon=args.abandon,
                force=args.force,
                accept_escalated=getattr(args, "accept_escalated", False),
            )
        except Exception as exc:
            print(f"Error closing workflow {target_wid}: {exc}", file=sys.stderr)
            sys.exit(2)

    elif args.command == "reopen-workflow":
        reopen_workflow(args.workflow_id)

    elif args.command == "get":
        get_task(args.task_id)

    elif args.command == "set":
        set_status(args.task_id, args.status, args.verdict, args.note,
                   affected_task_ids=args.affected_task_ids,
                   skip_review_closure=args.skip_review_closure,
                   skip_operator=args.operator,
                   operator_token=getattr(args, "operator_token", None),
                   operator_credentials=getattr(args, "operator_credentials", None))


    elif args.command == "adopt-verdict":
        adopt_verdict_cli(
            args.task_id,
            verdict=args.verdict,
            note=args.note,
            operator=args.operator,
            as_json=getattr(args, "json", False),
        )

    elif args.command == "record-review-closure":
        record_review_closure(args.task_id, pr_url=args.pr_url,
                              ci_status=args.ci_status, findings=args.findings,
                              deferred=args.deferred, reason=args.reason,
                              head_sha=args.head_sha,
                              unresolved_p1=args.unresolved_p1,
                              unresolved_p2=args.unresolved_p2)

    elif args.command == "bypass-gate":
        bypass_gate_cli(
            args.task_id,
            reason=args.reason,
            operator=args.operator,
            note=getattr(args, "note", None),
            as_json=getattr(args, "json", False),
        )

    elif args.command == "stage-status":
        stage_status(
            args.workflow_id,
            args.stage
        )

    elif args.command == "node-status":
        node_status(
            args.workflow_id,
            args.node
        )

    elif args.command == "ops-center":
        ops_center(args)

    elif args.command == "ensure-runtime":
        res = ensure_node_runtime(
            args.workflow_id,
            args.node
        )
        print(json.dumps(res, ensure_ascii=False, indent=2))

    elif args.command == "list":
        list_tasks(args.workflow_id)

    elif args.command == "supersede":
        supersede_task(
            args.task_id,
            new_task_id=args.new_task_id,
            reason=args.reason,
            abandon=args.abandon,
            allow_pending=getattr(args, "allow_pending", False),
        )

    elif args.command == "clear-escalation":
        clear_finalize_escalation(args.task_id)

    elif args.command == "stage-reset":
        stage_reset(args.workflow_id, args.stage)

    elif args.command == "advance":
        force_advance(args.workflow_id, args.stage)

    elif args.command == "pause":
        pause_task(args.task_id, reason=args.reason)

    elif args.command == "resume":
        resume_task(args.task_id)

    elif args.command == "halt":
        import herdr.steering as herdr_steering
        try:
            res = herdr_steering.halt_task(
                args.task_id,
                reason=args.reason,
                operator=args.operator,
            )
            if not res.get("ok"):
                print(
                    f"[HALT FAILED] {res.get('task_id', args.task_id)}: "
                    f"{res.get('error', 'unknown_error')} "
                    f"(status unchanged: {res.get('status', 'unknown')})"
                )
                sys.exit(1)
            print(f"[HALTED] {res['task_id']}: {res['reason']}")
        except Exception as e:
            print(f"Error halting task: {e}")
            sys.exit(1)

    elif args.command == "steer":
        import herdr.steering as herdr_steering
        try:
            res = herdr_steering.queue_steer(
                args.task_id,
                instruction=args.instruction,
                operator=args.operator,
                urgent=args.urgent,
            )
            mode = ("IMMEDIATE" if args.urgent else "QUEUED") if res.get("ok") else "FAILED"
            print(f"[STEER_{mode}] {res['steer_id']} for {res['task_id']}")
            if not res.get("ok"):
                print(f"Steering not delivered: {res.get('reason') or 'delivery_failed'}")
                sys.exit(1)
        except Exception as e:
            print(f"Error steering task: {e}")
            sys.exit(1)

    elif args.command == "steer-queue":
        import herdr.steering as herdr_steering
        steers = herdr_steering.list_task_steers(args.task_id)
        if not steers:
            print(f"No steers for task {args.task_id}")
        else:
            for s in steers:
                print(f"- [{s['status']}] {s['steer_id']} (urgent={s['urgent']}): {s['instruction']}")

    elif args.command == "adapters":
        from herdr.agent_adapter import list_agent_adapters
        adapters = list_agent_adapters()
        if getattr(args, "json", False):
            print(json.dumps(adapters, ensure_ascii=False, indent=2))
        else:
            print("=== Herdr Agent Adapter Capability Matrix (TTY Prototype) ===")
            for name, item in adapters.items():
                caps = item.get("capabilities", {})
                print(f"- [{name}] (protocol: {item.get('protocol_level')}):")
                print(f"    supports_interrupt:        {caps.get('supports_interrupt')}")
                print(f"    supports_soft_steer:       {caps.get('supports_soft_steer')}")
                print(f"    supports_resume:           {caps.get('supports_resume')}")
                print(f"    supports_prompt_injection: {caps.get('supports_prompt_injection')}")

    elif args.command == "project":
        import herdr.projection as herdr_projection
        try:
            res = herdr_projection.project_task(args.task_id)
            if getattr(args, "json", False):
                print(json.dumps(res, ensure_ascii=False, indent=2))
            else:
                print(f"=== 任务白盒简报 [{res['task_id']}] ===")
                print(f"状态: {res['status']} | 执行者: {res.get('agent', '-')}")
                print(f"当前意图: {res.get('intent', '-')}")
                if res.get("blockers"):
                    print(f"⚠️ 卡点告警: {', '.join(res['blockers'])}")
                print("\n[动态路标]")
                for m in res.get("milestones", []):
                    st = "✓" if m["status"] == "completed" else (">" if m["status"] == "in_progress" else " ")
                    print(f"  [{st}] {m['label']}")
                print("\n[产物列表]")
                for a in res.get("artifacts", []):
                    print(f"  - [{a.get('kind')}] {a.get('name')}: {a.get('summary')}")
                print("\n[近期动态]")
                for act in res.get("recent_activity", []):
                    print(f"  • {act}")
        except Exception as e:
            print(f"Error projecting task: {e}")
            sys.exit(1)

    elif args.command == "artifacts":
        import herdr.projection as herdr_projection
        try:
            res = herdr_projection.project_task(args.task_id)
            artifacts = res.get("artifacts", [])
            if getattr(args, "json", False):
                print(json.dumps(artifacts, ensure_ascii=False, indent=2))
            else:
                print(f"=== 任务产物清单 [{res['task_id']}] ===")
                if not artifacts:
                    print("暂无产物生成")
                for a in artifacts:
                    print(f"[{a.get('kind')}] {a.get('name')}")
                    print(f"  摘要: {a.get('summary')}")
                    if a.get("path"):
                        print(f"  路径: {a.get('path')}")
        except Exception as e:
            print(f"Error collecting artifacts: {e}")
            sys.exit(1)

    elif args.command == "delivery-report":
        from herdr.delivery_report import build_delivery_report
        print(json.dumps(build_delivery_report(args.workflow_id, _get_store()), ensure_ascii=False))

    elif args.command == "renew-completion":
        cmd_renew_completion(args)

    elif args.command == "delivery-check":
        from herdr.task_delivery import check_delivery
        try:
            result = check_delivery(args.task_id, store=_get_store())
            print(json.dumps(result, ensure_ascii=False))
            sys.exit(0 if result["status"] == "ready" else 3)
        except (OSError, ValueError, KeyError) as exc:
            from herdr.supervisor.state import redact_text
            print(json.dumps({"status": "unknown", "error": redact_text(str(exc))}, ensure_ascii=False))
            sys.exit(2)

    elif args.command == "report-completion":
        from herdr.completion_receipt import report_completion
        identity = json.loads(Path(args.identity_file).read_text())
        references = []
        for reference in args.artifact:
            observation_id, digest = reference.split(":", 1)
            references.append({"observation_id": observation_id, "sha256": digest})
        print(json.dumps(report_completion(args.task_id, identity, references, _get_store()), ensure_ascii=False))

    elif args.command == "checkpoint-create":
        import herdr.kernel as herdr_kernel
        try:
            res = herdr_kernel.create_checkpoint(
                args.workflow_id,
                tag=args.tag,
                parent_checkpoint_id=args.parent,
            )
            print(f"[CHECKPOINT_CREATED] {res['checkpoint_id']} (tag={res['tag']}, tasks={res['task_count']})")
        except Exception as e:
            print(f"Error creating checkpoint: {e}")
            sys.exit(1)

    elif args.command == "checkpoint-list":
        import herdr.kernel as herdr_kernel
        try:
            cps = herdr_kernel.list_checkpoints(args.workflow_id)
            if getattr(args, "json", False):
                print(json.dumps(cps, ensure_ascii=False, indent=2))
            else:
                print(f"=== 工作流检查点列表 [{args.workflow_id}] ===")
                if not cps:
                    print("暂无快照记录")
                for cp in cps:
                    parent_str = f" (parent={cp.get('parent_checkpoint_id')})" if cp.get("parent_checkpoint_id") else ""
                    print(f"- {cp['checkpoint_id']} [tag={cp.get('tag') or '-'}] tasks={cp['task_count']} status={cp.get('workflow_status')}{parent_str}")
        except Exception as e:
            print(f"Error listing checkpoints: {e}")
            sys.exit(1)

    elif args.command == "checkpoint-restore":
        import herdr.kernel as herdr_kernel
        try:
            res = herdr_kernel.restore_checkpoint(args.workflow_id, args.checkpoint_id)
            print(f"[CHECKPOINT_RESTORED] {res['checkpoint_id']} -> workflow={res['workflow_id']}, tasks={res['restored_tasks']}, status={res['status']}")
        except Exception as e:
            print(f"Error restoring checkpoint: {e}")
            sys.exit(1)

    elif args.command == "checkpoint-fork":
        import herdr.kernel as herdr_kernel
        try:
            res = herdr_kernel.fork_workflow_from_checkpoint(
                args.checkpoint_id,
                args.new_workflow_id,
                new_title=args.title,
            )
            print(f"[WORKFLOW_FORKED] {res['new_workflow_id']} from {res['source_checkpoint_id']} (tasks={res['cloned_tasks']})")
        except Exception as e:
            print(f"Error forking workflow: {e}")
            sys.exit(1)

    elif args.command == "note-add":
        note_add(args)

    elif args.command == "note-list":
        note_list(args)

    elif args.command == "record-delivery":
        record_delivery_note(
            args.workflow_id,
            args.delivery_branch,
            args.candidate_sha,
            args.review_task,
            args.test_gate,
            base=getattr(args, "base", ""),
            node=getattr(args, "node", "wrapup"),
            supersedes=getattr(args, "supersedes", None),
        )

    elif args.command == "freeze-candidate":
        from herdr.scheduler_facts import record_candidate_frozen
        res = record_candidate_frozen(
            args.workflow_id,
            args.candidate_sha,
            source_node=getattr(args, "source_node", ""),
            delivery_branch=getattr(args, "delivery_branch", ""),
        )
        print(f"[CANDIDATE FROZEN] workflow={args.workflow_id} candidate_sha={args.candidate_sha} status={res.get('status', 'recorded')}")

    elif args.command in {"node-config", "node-config-set", "authorize-completion"}:
        try:
            if args.command == "authorize-completion":
                from herdr.completion_receipt import authorize_legacy_completion
                result = authorize_legacy_completion(args.task_id, args.run_id, args.expected_version, args.reason, _get_store())
                import shlex
                result["report_command"] = shlex.join(["herdr-task", "report-completion", args.task_id, "--identity-file", result["path"]])
            elif args.command == "node-config-set":
                from herdr.node_config import update_required_tasks
                result = update_required_tasks(_get_store(), args.workflow_id, args.node,
                    args.required_task_id or [], expected_sha=args.expected_sha, reason=args.reason)
            else:
                from herdr.node_config import read_configuration
                _, config, sha = read_configuration(_get_store(), args.workflow_id)
                matches = [n for n in config.get("nodes", []) if (n.get("id") or n.get("key")) == args.node]
                if len(matches) != 1:
                    raise ValueError("node missing or ambiguous")
                result = {"workflow_id":args.workflow_id,"node":matches[0],"config_sha":sha}
            print(json.dumps(result, ensure_ascii=False))
        except (ValueError, OSError, RuntimeError) as exc:
            print(f"[CONFIGURATION/RECOVERY REFUSED] {exc}", file=sys.stderr)
            sys.exit(2)

    elif args.command == "create-pr":
        try:
            create_pull_request(args)
        except (ValueError, RuntimeError, OSError, subprocess.SubprocessError) as exc:
            print(f"[PR PUBLICATION REFUSED] {exc}", file=sys.stderr)
            sys.exit(2)

    elif args.command == "merge-pr":
        try:
            merge_pull_request(args)
        except (ValueError, RuntimeError, OSError, subprocess.SubprocessError) as exc:
            print(f"[PR MERGE REFUSED] {exc}", file=sys.stderr)
            sys.exit(2)

    elif args.command == "check-obligations":
        zombies = check_zombie_obligations()
        if args.workflow_id:
            zombies = [z for z in zombies if str(z.get("workflow_id") or "") == str(args.workflow_id)]
        if args.json:
            print(json.dumps(zombies, ensure_ascii=False))
        else:
            if not zombies:
                print("[OBLIGATIONS CLEAN] No zombie obligations found")
            else:
                for z in zombies:
                    print(
                        f"[ZOMBIE OBLIGATION] task_id={z.get('task_id')} "
                        f"workflow_id={z.get('workflow_id')} node={z.get('node') or z.get('stage')}"
                    )
        sys.exit(1 if zombies else 0)

    elif args.command == "check-delivery":
        check_delivery_for_pr(
            args.workflow_id,
            args.head_sha,
            head_ref_name=getattr(args, "head_ref", ""),
            repo_path=getattr(args, "repo_path", None),
        )

    elif args.command == "observe":
        cmd_observe(args)

    elif args.command == "compact":
        cmd_compact(args)

    elif args.command == "metrics":
        cmd_metrics(args)

    elif args.command == "working-context":
        cmd_working_context(args)

    elif args.command == "eval":
        cmd_eval(args)

    elif args.command == "replay":
        cmd_replay(args)

    elif args.command == "eval-compare":
        cmd_eval_compare(args)

    elif args.command == "route-shadow":
        cmd_route_shadow(args)

    elif args.command == "shadow-eval":
        cmd_shadow_eval(args)

    elif args.command == "canary-eval":
        cmd_canary_eval(args)

    elif args.command == "rollout":
        cmd_rollout(args)

    elif args.command == "reverification":
        cmd_reverification(args)


if __name__ == "__main__":
    from herdr.completion_receipt import WorkflowClosedError

    try:
        main()
    except WorkflowClosedError as exc:
        # 派单/续作/回执撞上已关闭工作流：给一行可操作的错误，
        # 不再把 ValueError 裸 traceback 抛给调用方。
        print(
            f"[WORKFLOW CLOSED] 工作流已关闭（{exc}）。"
            "请先 `herdr-task reopen-workflow <workflow-id>` 恢复后再派单或续作。",
            file=sys.stderr,
        )
        sys.exit(2)
