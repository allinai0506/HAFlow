def bypass_gate_cli(task_id, reason, operator="human", note=None, as_json=False):
    """Universal human-in-the-loop gate bypass CLI entrypoint."""
    from herdr import kernel
    try:
        res = kernel.bypass_task_gate(task_id, reason=reason, operator=operator, note=note)
        if as_json:
            print(json.dumps(res, indent=2, ensure_ascii=False))
            return 0
        print(
            f"[GATE BYPASS] task={task_id} bypass_id={res.get('bypass_id')} "
            f"verdict={res.get('previous_verdict')} -> {res.get('stage_verdict')} "
            f"status={res.get('previous_status')} -> {res.get('status')} "
            f"reason=\"{res.get('reason')}\" operator={res.get('operator')}"
        )
        print("HERDR_GATE_BYPASS_RESULT=" + json.dumps(res, ensure_ascii=False))
        return 0
    except Exception as exc:
        print(f"Error bypassing gate for task {task_id}: {exc}", file=sys.stderr)
        sys.exit(1)


