def cmd_panes(args):
    from herdr.node_capacity import node_usage
    store = _get_store()
    project = store.get_workflow(args.workflow_id)
    if not project:
        print(f"Workflow not found: {args.workflow_id}", file=sys.stderr)
        sys.exit(2)
    try:
        definition = _capacity_definition(project)
        tasks = store.list_tasks(workflow_id=args.workflow_id)
        nodes = definition.get("nodes", [])
        known = {n.get("id") or n.get("key") for n in nodes}
        nodes = list(nodes) + [{"id": nid} for nid in sorted({
            t.get("node") or t.get("stage") for t in tasks
        } - known - {None})]
        rows = [node_usage(n, tasks, args.workflow_id) for n in nodes]
    except (OSError, ValueError, TypeError) as exc:
        print(f"Pane usage unavailable: {exc}", file=sys.stderr)
        sys.exit(2)
    result = {"workflow_id": args.workflow_id, "nodes": rows,
              "note": "pane counts are persisted references, not verified live panes"}
    if args.json:
        print(json.dumps(result, ensure_ascii=False))
    else:
        print("NODE  TASKS  ACTIVE/MAX_CONCURRENCY  PANE_REFS  MAX_TASKS  OVERFLOW")
        for row in rows:
            print(
                f"{row['node']}  {row['task_count']}  "
                f"{row['active_task_count']}/{row['max_concurrency'] or 'unset'}  "
                f"{row['pane_count']}  {row['max_tasks_per_node'] or 'unset'}  "
                f"{'YES' if row['overflow'] else '-'}"
            )
        print(result["note"])


