def _herdr(*args):
    """调用 herdr CLI;显式解析绝对路径以兼容 LaunchAgent 精简 PATH。"""
    binary = resolve_binary("herdr") or "herdr"
    return subprocess.run(
        [binary, *args],
        text=True,
        capture_output=True,
        timeout=20,
    )


def delete_clone_safely(clone_path):
    """删除 CoW clone;仅允许 ~/.herdr-controller/clones 下的路径。"""
    if not clone_path:
        return False
    clone_real = os.path.realpath(os.path.expanduser(clone_path))
    try:
        common = os.path.commonpath([CLONE_ROOT, clone_real])
    except ValueError:
        return False
    if common != CLONE_ROOT or clone_real == CLONE_ROOT:
        return False
    if not os.path.exists(clone_real):
        return False
    shutil.rmtree(clone_real)
    return True


def _teardown_output_guard(task):
    """Bounded read-only output gate before closing a Pane or deleting its clone."""
    from herdr.repo_hygiene import teardown_output_diagnosis
    from herdr.bounded_tools import run_bounded
    clone = task.get("clone_path")
    if clone and os.path.lexists(os.path.expanduser(clone)):
        path = Path(clone).expanduser()
        if path.is_symlink():
            return {"reason": "clone_identity_unknown"}
        from herdr.clone_archive import is_residual_clone_shell
        if task.get("clone_archive") and is_residual_clone_shell(path):
            return {"reason": ""}
        tag = path / ".herdr-launch-identity.json"
        if tag.exists():
            try:
                identity = json.loads(tag.read_text()) if not tag.is_symlink() and tag.stat().st_size <= 8192 else {}
            except (OSError, ValueError):
                identity = {}
            if identity.get("task_id") != task.get("task_id") or (task.get("run_id") and identity.get("run_id") != task.get("run_id")):
                return {"reason": "clone_identity_changed"}
        # Context workspaces are plain directories. Their artifacts remain in
        # place; Git metadata, when present, must still pass the Git output gate.
        if (task.get("execution_mode") == "context" and (task.get("integration_mode") or "none") == "none"
                and path.is_dir() and not os.path.lexists(path / ".git")):
            return {"reason": ""}
        try:
            root = run_bounded(["git", "-C", str(path), "rev-parse", "--show-toplevel"], timeout=5, output_limit=8192)
            if root["status"] != "completed" or root["exit_code"] or Path(root["stdout"].strip()).resolve() != path.resolve():
                return {"reason": "clone_git_inventory_unknown"}
            # Collapse untracked directories before the output cap. Internal evidence
            # is already excluded by diagnosis; tracked files remain individually
            # visible, including tracked changes under an internal directory.
            result = run_bounded(["git", "-C", str(path), "status", "--porcelain", "--untracked-files=normal"], timeout=5, output_limit=65536)
            expected_commit = task.get("integrated_commit") or task.get("commit")
            head_sha = ""
            head_out = run_bounded(["git", "-C", str(path), "rev-parse", "HEAD"], timeout=5, output_limit=8192)
            if head_out["status"] != "completed":
                return {"reason": "clone_git_inventory_unknown"}
            if head_out["exit_code"] == 0:
                head_sha = head_out["stdout"].strip()
            elif expected_commit:
                return {"reason": "clone_git_inventory_unknown"}
        except (OSError, ValueError):
            return {"reason": "clone_git_inventory_unknown"}
        diagnosis = teardown_output_diagnosis(result["stdout"], task_id=task.get("task_id", ""))
        if diagnosis["reason"]:
            if (task.get("integration_mode") or "none") == "none":
                diagnosis["remediation_cmd"] = f"git -C <clone> status; herdr-task commit {task.get('task_id', '')}"
            return diagnosis
        if expected_commit and head_sha and head_sha != expected_commit:
            cmd = (
                f"git -C <clone> status; herdr-task commit {task.get('task_id', '')}"
                if (task.get("integration_mode") or "none") == "none"
                else f"git -C <clone> log; herdr-task integrate {task.get('task_id', '')}"
            )
            return {
                "reason": "unintegrated_commit_diverged",
                "remediation_cmd": cmd,
            }
    if (task.get("integration_mode") == "git" and task.get("status") in {"completed", "committed"}):
        return {"reason": "git_finalize_pending", "remediation_cmd": "herdr-task commit " + str(task.get("task_id")) + "; herdr-task integrate " + str(task.get("task_id"))}
    return {"reason": ""}


def _record_output_retention(task, diagnosis, *, authorized_via=""):
    store = _get_store()
    if store.get_task(task.get("task_id")):
        from herdr import kernel
        kernel.update_task_metadata(task["task_id"], {"resource_retention": "retained", "output_retention": diagnosis}, store=store)
        store.record_event("teardown_output_retained" if not authorized_via else "teardown_output_override", {**diagnosis, "authorized_via": authorized_via},
                           task_id=task["task_id"], workflow_id=task.get("workflow_id"), source="herdr-task")


def clone_deletable(task):
    """clone 承载的成果是否已安全沉淀。

    integration_ref/branch 存在说明 Controller 已完成 integrate;
    superseded 任务从未交付,由替代任务负责成果。其余情况
    (如 mode=none 的 docs 任务)成果只存在于 clone 与终端转写中,
    默认保留 clone,由 --purge-clones 显式授权删除。
    """
    output = _teardown_output_guard(task)
    if output["reason"]:
        return False, output["reason"]
    if task.get("execution_mode") == "context" and (task.get("integration_mode") or "none") == "none":
        return False, "context artifacts retained; explicit purge required"
    if task.get("integration_ref") or task.get("integration_branch"):
        return True, "integrated"
    if task.get("status") == "superseded":
        return True, "superseded"
    if task.get("status") == "committed":
        return False, "committed but not integrated — run herdr-task integrate first"
    return False, "no integration evidence"


def dump_transcript(task):
    """把 pane 终端转写落盘为验收证据;尽力而为,失败不阻塞。"""
    pane_id = task.get("pane_id")
    if not pane_id:
        return None
    read = _herdr(
        "pane", "read", pane_id,
        "--source", "recent-unwrapped",
        "--lines", "20000",
    )
    if read.returncode != 0 or not read.stdout.strip():
        return None

    task_dir = os.path.join(EVIDENCE_ROOT, task.get("task_id", "unknown"))
    os.makedirs(task_dir, exist_ok=True)
    path = os.path.join(task_dir, "terminal.log")
    with open(path, "w", encoding="utf-8") as f:
        f.write(read.stdout)

    meta = {
        "task_id": task.get("task_id"),
        "pane_id": pane_id,
        "agent": task.get("agent"),
        "dumped_at": _now(),
        "agent_session": None,
    }
    info = _herdr("pane", "get", pane_id)
    try:
        pane = json.loads(info.stdout)["result"]["pane"]
        meta["agent_session"] = pane.get("agent_session")
    except Exception:
        pass
    with open(os.path.join(task_dir, "meta.json"), "w", encoding="utf-8") as f:
        json.dump(meta, f, ensure_ascii=False, indent=2)
    return path


def close_pane(pane_id):
    if not pane_id:
        return False
    from herdr.task_resources import workflow_launch_lock
    with workflow_launch_lock(_get_store().db_path, 'managed-dynamic-pane-lifecycle'):
        return _herdr("pane", "close", pane_id).returncode == 0


def _advance_to_cleaned(task_id, status):
    """按 FINALIZE_ADVANCE 链把已验收任务推进到 cleaned。"""
    while status in FINALIZE_ADVANCE:
        nxt = FINALIZE_ADVANCE[status]
        try:
            set_status(task_id, nxt)
        except SystemExit:
            break
        status = nxt
    return status


def _close_task_identity(task):
    return {key: task.get(key) for key in (
        "task_id", "workflow_id", "run_id", "pane_id", "agent", "agent_session_id",
        "agent_name", "runtime",
    )}


def _close_owned_pane(identity):
    from herdr.task_resources import owned_live_pane
    from herdr.observer.live import probe_live_runtime

    def runner(argv, timeout):
        result = _herdr(*argv[1:])
        return result.returncode, result.stdout, result.stderr

    current = _get_store().get_task(identity.get("task_id")) if identity.get("task_id") else None
    if identity.get("task_id") and current is None:
        return False
    if current and _close_task_identity(current) != identity:
        return False
    proven, _ = owned_live_pane(
        identity, probe=lambda task: probe_live_runtime(task, runner=runner),
    )
    return proven


def _finalize_one(task, purge_clones=False, dry_run=False, close_claim=None, output_override="", reclaim_archive=None, reclaim_plan=None):
    from herdr.task_cli_teardown import finalize_one
    return finalize_one(
        task, purge_clones=purge_clones, dry_run=dry_run, close_claim=close_claim,
        output_override=output_override, reclaim_archive=reclaim_archive,
        reclaim_plan=reclaim_plan, deps={
            "clone_root": CLONE_ROOT, "finalize_advance": FINALIZE_ADVANCE,
            "advance_to_cleaned": _advance_to_cleaned,
            "close_owned_pane": _close_owned_pane,
            "close_task_identity": _close_task_identity, "get_store": _get_store,
            "record_output_retention": _record_output_retention,
            "teardown_output_guard": _teardown_output_guard,
            "clone_deletable": clone_deletable, "close_pane": close_pane,
            "delete_clone_safely": delete_clone_safely,
            "dump_transcript": dump_transcript, "set_status": set_status,
        },
    )


def finalize_task(task_id, force=False, purge_clones=False):
    from herdr.task_cli_delivery import finalize_task as handle_finalize
    return handle_finalize(
        task_id, force=force, purge_clones=purge_clones,
        load_tasks=load_tasks, find_task=find_task,
        teardown_blocking_statuses=TEARDOWN_BLOCKING_STATUSES,
        finalize_one=_finalize_one,
    )


def _load_workflow_entry(workflow_id):
    store = _get_store()
    wf = store.get_workflow(workflow_id)
    all_wfs = {w["workflow_id"]: w for w in store.list_workflows() if w.get("workflow_id")}
    return wf, all_wfs


def _mark_workflow_completed(workflow_id, outcome="delivered", force=False):
    store = _get_store()
    entry, _ = _load_workflow_entry(workflow_id)
    if entry is None:
        print(f"[WORKFLOW RECORD] no entry for {workflow_id}; skip marking")
        return

    try:
        from herdr import kernel
        kernel.transition_workflow(
            workflow_id=workflow_id,
            to_status="completed",
            reason=f"workflow_completed: {outcome}",
            source="herdr-task",
            metadata={"outcome": outcome, "completed_at": _now()},
            force=force,
            store=store,
        )
        try:
            from herdr import node_dispatch_store
            node_dispatch_store.reconcile_workflow(store.db_path, workflow_id, discover=False)
        except Exception:
            pass
    except Exception as exc:
        print(f"Error marking workflow {workflow_id} completed: {exc}", file=sys.stderr)
        raise

    wf_file = globals().get("WORKFLOWS_FILE") or os.environ.get("WORKFLOWS_FILE") or WORKFLOWS_FILE
    sync_workflows_projection(store=store, wf_file=Path(wf_file) if wf_file else None)


def _workflow_stage_tabs(workflow_id, tasks):
    """从项目 workflow 配置解析阶段 tab 与归属 pane 集合。

    返回 dict:tab_ids / coordinator_pane / workspace_id / owned_pane_ids。
    """
    empty = {
        "tab_ids": [],
        "coordinator_pane": None,
        "workspace_id": None,
        "owned_pane_ids": set(),
    }
    project = project_for_workflow(workflow_id) or {}
    cfg_file = (
        project.get("workflow_file")
        or next(
            (t.get("workflow_config") for t in tasks if t.get("workflow_config")),
            None,
        )
    )
    if not cfg_file or not os.path.exists(cfg_file):
        return empty
    try:
        with open(cfg_file, "r", encoding="utf-8") as f:
            cfg = json.load(f)
    except (json.JSONDecodeError, OSError):
        return empty

    from herdr.projects import _with_node_runtime
    cfg = _with_node_runtime(cfg, project)

    items = cfg.get("nodes") or cfg.get("stages", [])
    tab_ids = sorted({
        item.get("tab_id") for item in items if item.get("tab_id")
    })
    owned_pane_ids = {
        item.get("anchor_pane_id")
        for item in items
        if item.get("anchor_pane_id")
    }
    owned_pane_ids |= {
        t.get("pane_id") for t in tasks if t.get("pane_id")
    }
    return {
        "tab_ids": tab_ids,
        "coordinator_pane": (cfg.get("coordinator") or {}).get("pane_id"),
        "workspace_id": cfg.get("workspace_id"),
        "owned_pane_ids": owned_pane_ids,
    }


def _live_workspace_panes(workspace_id):
    """返回 workspace 存活 pane 列表;不可用时返回 None(宁可保留现场)。"""
    listing = _herdr("pane", "list", "--workspace", workspace_id)
    if listing.returncode != 0:
        return None
    try:
        result = json.loads(listing.stdout).get("result", {})
        panes = result.get("panes", result) if isinstance(result, dict) else result
        return panes or []
    except (json.JSONDecodeError, TypeError):
        return None


def _foreign_panes_in_tab(live_panes, tab_id, owned_pane_ids):
    """筛选 tab 内不属于本 workflow 的存活 pane。

    阶段 tab 可能被连续多个 workflow 复用;关闭 tab 会连带销毁
    共存的其他现场,所以有外来 pane 时必须放弃关 tab。
    """
    return sorted(
        pane_id
        for pane in (live_panes or [])
        if pane.get("tab_id") == tab_id
        and (pane_id := pane.get("pane_id"))
        and pane_id not in owned_pane_ids
    )


def resolve_workflow_id_for_close(input_id=None):
    entries = load_workflows().get("workflows", {})
    if input_id:
        if input_id in entries:
            return input_id
        tasks = load_tasks().get("tasks", [])
        if any(t.get("workflow_id") == input_id for t in tasks):
            return input_id

        # Suffix / substring match among active (non-terminal) workflows
        non_terminal = {wid: e for wid, e in entries.items() if e.get("status") not in {"completed"}}
        matches = [wid for wid in non_terminal if wid.endswith(input_id) or f"-{input_id}" in wid or input_id in wid]
        if len(matches) == 1:
            print(f"[AUTO RESOLVE] 匹配到活跃工作流: {matches[0]}")
            return matches[0]
        elif len(matches) > 1:
            print(f"[AMBIGUOUS WORKFLOW ID] 输入 '{input_id}' 匹配到多个活跃工作流: {', '.join(matches)}")
            sys.exit(1)

        all_matches = [wid for wid in entries if wid.endswith(input_id) or f"-{input_id}" in wid or input_id in wid]
        if len(all_matches) == 1:
            print(f"[AUTO RESOLVE] 匹配到工作流: {all_matches[0]}")
            return all_matches[0]
        elif len(all_matches) > 1:
            print(f"[AMBIGUOUS WORKFLOW ID] 输入 '{input_id}' 匹配到多个工作流: {', '.join(all_matches)}")
            sys.exit(1)

        return input_id

    # If input_id is not provided, detect from current git workspace
    try:
        root = detect_git_root()
        proj = project_by_root(root)
        if proj:
            pid = proj.get("project_id")
            active = [wid for wid, e in entries.items() if e.get("project_id") == pid and e.get("status") not in {"completed"}]
            if len(active) == 1:
                print(f"[AUTO DETECT] 检测到当前项目 {proj.get('project_name')} 唯一活跃工作流: {active[0]}")
                return active[0]
            elif len(active) > 1:
                print(f"当前项目存在多个活跃工作流，请显式指定 workflow_id:\n  " + "\n  ".join(active))
                sys.exit(1)
    except Exception:
        pass

    print("请指定 workflow_id，例如: herdr-task close-workflow <workflow_id>")
    sys.exit(1)


def close_workflow(
    workflow_id,
    include_coordinator=False,
    purge_clones=False,
    dry_run=False,
    abandon=False,
    force=False,
    accept_escalated=False,
    confirm_force=None,
):
    from herdr.workflow_close import workflow_close_claim
    if not abandon:
        from herdr.business_gate import business_gate_blockers
        store = _get_store()
        if store.get_workflow(workflow_id):
            authority, config, owned_tasks = store.read_workflow_snapshot(workflow_id)
            from herdr.workflow import validate_delivery_inventory
            try:
                validate_delivery_inventory(authority, config, owned_tasks)
            except ValueError as exc:
                print(f'[CLOSE ABORT] {exc}')
                sys.exit(2)
            missing_business = business_gate_blockers(store, authority, config, owned_tasks)
            if missing_business:
                print('[CLOSE ABORT] business acceptance unavailable: ' + ', '.join(missing_business))
                sys.exit(2)
    options = dict(include_coordinator=include_coordinator, purge_clones=purge_clones,
                   abandon=abandon, force=force, accept_escalated=accept_escalated)
    with workflow_close_claim(_get_store(), workflow_id, dry_run=dry_run, options=options) as claim:
        if claim.state == "completed":
            print(json.dumps(claim.receipt, ensure_ascii=False))
            return claim.receipt
        if claim.state == "in_progress":
            report = {"workflow_id": workflow_id, "close_state": "in_progress"}
            print(json.dumps(report))
            return report
        report = _close_workflow_owned(
            workflow_id, include_coordinator, purge_clones, dry_run, abandon,
            force, accept_escalated, confirm_force, close_claim=claim if not dry_run else None,
        )
        from herdr.delivery_report import build_delivery_report
        import hashlib
        facts = build_delivery_report(workflow_id, _get_store())
        report["delivery_report"] = facts
        report["delivery_report_sha256"] = hashlib.sha256(
            json.dumps(facts, sort_keys=True, ensure_ascii=False).encode()
        ).hexdigest()
        report["execution_mode"] = "dry-run" if dry_run else "execute"
        return report if dry_run else claim.complete(report)


def _close_workflow_owned(
    workflow_id, include_coordinator=False, purge_clones=False, dry_run=False,
    abandon=False, force=False, accept_escalated=False, confirm_force=None,
    close_claim=None,
):
    from herdr.task_cli_workflow_close import close_workflow_owned
    return close_workflow_owned(
        workflow_id, include_coordinator, purge_clones, dry_run, abandon,
        force, accept_escalated, confirm_force, close_claim,
        load_tasks=load_tasks, load_workflow_entry=_load_workflow_entry,
        get_store=_get_store, finalize_one=_finalize_one, close_pane=close_pane,
        stage_reset=stage_reset, mark_workflow_completed=_mark_workflow_completed,
        workflow_stage_tabs=_workflow_stage_tabs,
        live_workspace_panes=_live_workspace_panes,
        foreign_panes_in_tab=_foreign_panes_in_tab,
        close_owned_pane=_close_owned_pane,
        teardown_output_guard=_teardown_output_guard,
        record_output_retention=_record_output_retention,
        clone_root=CLONE_ROOT,
        teardown_blocking_statuses=TEARDOWN_BLOCKING_STATUSES,
    )


