def _enforce_wrapup_review_closure(task_id, task, *, skip, note, operator=None,
                                   operator_token=None, operator_credentials=None):
    """CLI-side pre-check for the shared wrapup review-closure invariant.

    The authoritative gate lives in ``herdr.kernel.transition_task`` — every
    completion source (CLI ``set``, the controller's CAS auto-accept path and
    repair flows) funnels through it. This pre-check only exists for a
    friendly refusal message. The audited ``--skip-review-closure`` bypass
    requires an authenticated operator identity independent of the task worker
    plus the ``HERDR_OPERATOR=1`` shell capability (task workers do not carry it);
    it records a ``review_closure_skipped`` event, which also satisfies the
    kernel gate (Codex review P1, Issue #228 Item 1).
    """
    from herdr import review_closure
    store = _get_store()
    if skip:
        reason = str(note or "").strip()
        if not reason:
            print(
                "[REVIEW CLOSURE SKIP REFUSED] --skip-review-closure requires "
                "--note with the audited reason",
                file=sys.stderr,
            )
            sys.exit(2)
        operator_id = str(operator or "").strip()
        if not operator_id:
            print(
                "[REVIEW CLOSURE SKIP REFUSED] --skip-review-closure requires "
                "--operator <identity> (an operator independent of the task "
                "worker)",
                file=sys.stderr,
            )
            sys.exit(2)
        if os.environ.get("HERDR_OPERATOR") != "1":
            print(
                "[REVIEW CLOSURE SKIP REFUSED] the emergency bypass requires an "
                "operator shell capability (HERDR_OPERATOR=1); task workers do "
                "not carry it",
                file=sys.stderr,
            )
            sys.exit(2)
        auth_ok, auth_why = review_closure.authenticate_operator(
            store, task, operator_id,
            token=operator_token,
            credentials_path=operator_credentials,
        )
        if not auth_ok:
            print(
                f"[REVIEW CLOSURE SKIP REFUSED] operator authentication failed: {auth_why}",
                file=sys.stderr,
            )
            sys.exit(2)
        head = review_closure.clone_head_sha(task.get("clone_path"))
        if not head:
            print(
                "[REVIEW CLOSURE SKIP REFUSED] cannot bind the bypass: the "
                "task clone/HEAD is unavailable (keep the clone retained or "
                "fix clone_path before bypassing)",
                file=sys.stderr,
            )
            sys.exit(2)
        store.record_event(
            "review_closure_skipped",
            {"task_id": task_id, "reason": reason, "head_sha": head, "operator": operator_id},
            task_id=task_id,
            workflow_id=task.get("workflow_id"),
            node_id=task.get("node") or task.get("stage"),
            source="herdr-task",
        )
        print(f"[REVIEW CLOSURE SKIPPED] {task_id}: completion allowed with audited bypass")
        return

    ok, why = review_closure.check_completion_allowed(store, task, bind_guard=False)
    if ok:
        print(f"[REVIEW CLOSURE RECEIPT] {task_id}: receipt present")
        return
    print(f"[REVIEW CLOSURE REQUIRED] {why}", file=sys.stderr)
    sys.exit(2)


def record_review_closure(task_id, pr_url=None, ci_status=None, findings=None,
                          deferred=False, reason=None, head_sha=None,
                          unresolved_p1=None, unresolved_p2=None):
    """Record the machine-readable review-closure receipt for a task.

    The receipt is what the completion transition validates for wrapup tasks:
    the head SHA it closed out (a later commit makes it stale) plus, for a
    normal closure, the delivery PR URL, ``ci_status=pass``, the structured
    unresolved P1/P2 counts (P1 must be 0) and a disposition text — or, for a
    deferred closure, a reason with the blocking evidence. Content is
    validated here so an unacceptable receipt can never be written; when the
    task clone is readable the supplied head must match its current HEAD.
    """
    from herdr import review_closure
    data = load_tasks()
    task = find_task(data, task_id)
    if not task:
        print(f"Task not found: {task_id}")
        sys.exit(1)
    payload = {
        "task_id": task_id,
        "pr_url": str(pr_url or "").strip(),
        "ci_status": str(ci_status or "").strip().lower(),
        "findings": str(findings or "").strip(),
        "deferred": bool(deferred),
        "reason": str(reason or "").strip(),
        "head_sha": str(head_sha or "").strip().lower(),
        "unresolved_p1": unresolved_p1,
        "unresolved_p2": unresolved_p2,
    }
    ok, why = review_closure.validate_receipt_payload(
        payload, require_verification=False,
    )
    if not ok:
        print(f"[REVIEW CLOSURE REFUSED] {why}", file=sys.stderr)
        sys.exit(2)
    current_head = review_closure.clone_head_sha(task.get("clone_path"))
    if current_head and current_head != payload["head_sha"]:
        print(
            f"[REVIEW CLOSURE REFUSED] --head-sha {payload['head_sha'][:12]} "
            f"does not match the task clone HEAD {current_head[:12]}; the "
            "receipt must certify the current reviewed head",
            file=sys.stderr,
        )
        sys.exit(2)
    store = _get_store()
    if not deferred:
        identity_why = review_closure.identity_mismatch(
            store, task, payload["pr_url"], payload["head_sha"],
        )
        if identity_why:
            print(
                f"[REVIEW CLOSURE REFUSED] delivery identity check failed: {identity_why}",
                file=sys.stderr,
            )
            sys.exit(2)
        verified, detail, verification = review_closure.verify_against_forge(
            payload["pr_url"], payload["head_sha"],
            declared_p2=payload.get("unresolved_p2"),
            findings=payload.get("findings"),
        )

        if not verified:
            print(
                f"[REVIEW CLOSURE REFUSED] forge verification failed: {detail}",
                file=sys.stderr,
            )
            sys.exit(2)
        payload["verification"] = verification
    else:
        evidence_ok, evidence_detail, evidence = review_closure.collect_deferred_evidence(store, task)
        if not evidence_ok:
            print(
                f"[REVIEW CLOSURE REFUSED] deferred is not justified: {evidence_detail}",
                file=sys.stderr,
            )
            sys.exit(2)
        payload["verification"] = evidence
    ok, why = review_closure.validate_receipt_payload(payload)
    if not ok:
        print(f"[REVIEW CLOSURE REFUSED] {why}", file=sys.stderr)
        sys.exit(2)
    store.record_event(
        "review_closure_recorded",
        payload,
        task_id=task_id,
        workflow_id=task.get("workflow_id"),
        node_id=task.get("node") or task.get("stage"),
        source="herdr-task",
    )
    print("[REVIEW CLOSURE RECORDED] " + json.dumps(payload, ensure_ascii=False))


def _is_gate_task(t):
    if not t:
        return False
    if t.get("gate") is False:
        return False

    workflow_id = t.get("workflow_id")
    node_id = t.get("node") or t.get("stage")

    # Authoritative workflow configuration check FIRST
    wf_cfg = None
    if workflow_id:
        try:
            from herdr.projects import workflow_config_for
            wf_cfg = workflow_config_for(workflow_id) or {}
        except Exception:
            pass
    if not wf_cfg and t.get("workflow_config") and node_id:
        try:
            import yaml
            from pathlib import Path
            p = Path(t["workflow_config"]).expanduser()
            if p.exists():
                with open(p, "r", encoding="utf-8") as f:
                    wf_cfg = yaml.safe_load(f) or {}
        except Exception:
            pass

    if wf_cfg and isinstance(wf_cfg, dict):
        for n in wf_cfg.get("nodes", []):
            if n.get("id") == node_id:
                if n.get("gate") or n.get("node_type") == "gate":
                    return True
                if n.get("node_type") in ("agent", "implementation", "worker", "code") and not n.get("gate"):
                    return False
                break

    if t.get("gate") is True:
        return True

    # Legacy fallback: exact names or word-boundary tokens, NOT arbitrary substring
    node = str(node_id or "").lower()
    if node in ("test", "review", "wrapup", "gate", "cleanroom", "cleanroom_test", "cleanroom_review", "cleanroom_gate"):
        return True
    if re.search(r"(^|[_-])(gate|cleanroom)($|[_-])", node):
        return True
    return bool(t.get("gate"))


def _gate_verdict_file_candidates(task):
    """PR #250 & Codex review: Return ordered list of candidate gate-verdict file paths."""
    candidates = []
    task_id = task.get("task_id") or task.get("id")
    if task_id:
        try:
            from herdr.direct_dispatch import gate_verdict_path
            candidates.append(gate_verdict_path(task_id))
        except Exception:
            pass
        override = os.environ.get("HERDR_GATE_VERDICT_DIR")
        vdir = Path(override).expanduser() if override else (Path.home() / ".herdr-controller" / "gate-verdicts")
        candidates.append(str(vdir / f"{task_id}.json"))

    clone_path = task.get("clone_path")
    if clone_path:
        candidates.append(os.path.join(clone_path, ".herdr/gate-verdict.json"))
        candidates.append(os.path.join(clone_path, ".herdr", "gate-verdict.json"))

    seen = set()
    result = []
    for c in candidates:
        if c and c not in seen:
            seen.add(c)
            result.append(c)
    return result


def _authenticate_gate_verdict_evidence(task, expected_verdict=None):
    """Authenticate durable gate verdict evidence from disk for task.

    Verifies that a valid gate verdict file exists for the task, belongs to
    the current execution epoch, has a fresh mtime (not older than rework_started_at,
    and not in the future beyond clock skew allowance), and matches expected_verdict.

    Returns (True, (verdict, note, affected_ids, st_mtime)) if valid and matches expected_verdict.
    Returns (False, err_msg) if missing, stale, invalid, or mismatched.
    """
    candidates = _gate_verdict_file_candidates(task)
    rework_started = task.get("rework_started_at")
    expected_token = task.get("execution_token") or task.get("rework_request_id")
    skew_limit = 5.0
    try:
        raw_skew = os.environ.get("HERDR_MAX_CLOCK_SKEW_SECONDS")
        if raw_skew is not None and raw_skew.strip():
            skew_limit = float(raw_skew.strip())
    except Exception:
        skew_limit = 5.0

    now = time.time()
    found_any = False
    last_err = "no durable gate verdict file found"

    for path in candidates:
        try:
            if not os.path.exists(path):
                continue
            found_any = True
            st = os.stat(path)
            if rework_started and st.st_mtime < (rework_started - 1.0):
                last_err = f"gate verdict file {path} is stale (mtime {st.st_mtime} < rework_started {rework_started})"
                continue
            if (st.st_mtime - now) > skew_limit:
                last_err = f"gate verdict file {path} has future timestamp exceeding clock skew allowance ({st.st_mtime - now:.1f}s > {skew_limit}s)"
                continue
            with open(path, "r", encoding="utf-8") as f:
                payload = json.load(f)
            if not isinstance(payload, dict):
                last_err = f"gate verdict file {path} is not a valid JSON dictionary"
                continue
            if expected_token:
                file_token = (
                    payload.get("execution_token")
                    or payload.get("rework_request_id")
                    or payload.get("rework_token")
                )
                if not file_token or file_token != expected_token:
                    # Codex Review Round 7 P2: Authenticate operator bypass receipts as a trusted path
                    bypass = payload.get("bypass")
                    tid = task.get("task_id") or task.get("id")
                    if bool(tid) and isinstance(bypass, dict) and (bypass.get("task_id") == tid) and bypass.get("bypass_id"):
                        pass
                    else:
                        last_err = f"execution token mismatch in {path} ({file_token} != {expected_token})"
                        continue
            file_v = str(payload.get("verdict") or "").strip().lower()
            if file_v not in ("pass", "blocked"):
                last_err = f"gate verdict file {path} contains invalid verdict: '{file_v}'"
                continue
            if expected_verdict:
                norm_exp = str(expected_verdict).strip().lower()
                if file_v != norm_exp:
                    return False, f"durable gate verdict on disk changed to '{file_v}' (expected '{norm_exp}')"
            note = str(payload.get("note") or "").strip()
            affected_ids = []
            if file_v == "blocked":
                raw_aff = payload.get("affected_task_ids")
                if raw_aff is not None:
                    if not isinstance(raw_aff, list):
                        print(
                            f"[ADOPT VERDICT WARN] Malformed affected_task_ids in {path}: "
                            f"expected list, got {type(raw_aff).__name__}; rejecting attribution",
                            file=sys.stderr,
                        )
                        affected_ids = []
                    else:
                        valid = True
                        ids = []
                        for item in raw_aff:
                            text = str(item).strip() if isinstance(item, str) else ""
                            if not text:
                                valid = False
                                break
                            if text not in ids:
                                ids.append(text)
                        if valid:
                            affected_ids = ids
                        else:
                            print(
                                f"[ADOPT VERDICT WARN] Malformed affected_task_ids in {path}: "
                                f"contains non-string or blank item; rejecting attribution",
                                file=sys.stderr,
                            )
                            affected_ids = []
            return True, (file_v, note, affected_ids, st.st_mtime)
        except Exception as exc:
            last_err = f"error inspecting gate verdict candidate {path}: {exc}"
            continue

    if not found_any:
        return False, "no durable gate verdict file found"
    return False, last_err


def set_status(task_id, new_status, verdict=None, note=None, affected_task_ids=None,
               skip_review_closure=False, skip_operator=None,
               operator_token=None, operator_credentials=None):

    data = load_tasks()
    task = find_task(data, task_id)

    if not task:
        print(f"Task not found: {task_id}")
        sys.exit(1)

    if (verdict in ('pass', 'approved') and task.get('completion_protocol') == 'receipt-v1'
            and (task.get('node') or task.get('stage')) in ('test', 'review')):
        from herdr.task_checkpoint import has_business_acceptance
        if not has_business_acceptance(_get_store(), task, task.get('candidate_sha')):
            print('Business acceptance checkpoint receipt required before passing gate', file=sys.stderr)
            sys.exit(2)

    # PR #110: 结构化归因目标仅允许随 blocked 结论持久化;pass 或未给
    # verdict 时携带 affected-task-id 直接拒绝(不静默忽略)。
    affected_ids = []
    for raw in affected_task_ids or []:
        text = str(raw or "").strip()
        if text and text not in affected_ids:
            affected_ids.append(text)
    if affected_ids and verdict != "blocked":
        print(
            "--affected-task-id is only valid with '--verdict blocked'",
            file=sys.stderr,
        )
        sys.exit(2)

    # Completion evidence, before any verdict is accepted.
    #
    # baseline_commit is *launch* evidence: the clone HEAD when the worker
    # started. An agent may pull, check out, or rebase mid-task, so it cannot
    # prove which revision was verified once the verdict is submitted. Re-read
    # the live clone now and store that as verified_candidate_sha, which is
    # what the join gate must trust (AGENTS.md §4.4: program-produced, never
    # model-reported).
    if verdict in ("pass", "blocked"):
        _capture_verified_candidate(task)
        # Fail closed at the verdict boundary, for scheduler-managed tasks
        # only. A task that carries a candidate claim is asserting "I verified
        # revision X"; if the clone HEAD could not be read at verdict time,
        # that assertion is unproven, and letting it through would let launch
        # evidence quietly reinstate the "they happened to start from the same
        # candidate" claim this whole mechanism exists to eliminate.
        #
        # A task with no candidate claim makes no such assertion: it is outside
        # scheduler identity semantics, so refusing its verdict would break
        # unrelated work without closing any real hole.
        if (
            str(task.get("candidate_sha") or "").strip()
            and not str(task.get("verified_candidate_sha") or "").strip()
        ):
            print(
                f"[VERDICT REFUSED] {task_id}: refusing verdict "
                f"'{verdict}' without completion evidence. The clone HEAD "
                "could not be read at verdict time, so the revision actually "
                "verified is unproven. Re-run the verification and submit the "
                "verdict again (AGENTS.md §4.4: fail closed, no silent pass).",
                file=sys.stderr,
            )
            sys.exit(2)

    if new_status not in TRANSITIONS:
        print(f"Invalid status: {new_status}")
        sys.exit(1)

    if (verdict or note or affected_ids) and new_status != "completed":
        print("verdict/note only apply to 'set <task> completed'")
        sys.exit(2)

    if verdict == "blocked" and not (note or "").strip():
        print("blocked verdict requires --note with the blocker list")
        sys.exit(2)

    # 先写入字段再判同状态:同状态重复 set completed 补落 verdict 也要生效。
    if verdict:
        task["stage_verdict"] = verdict

    if note:
        task["stage_verdict_note"] = note

    # PR #110:归因字段随结论一起覆盖写。只在非空时写会让上一次的
    # affected_task_ids 存活过新一轮结论——本轮 Verifier 明确「无法归因」
    # (不写该字段)时,系统会拿着上一轮的旧归因去做选择性返工。
    if verdict:
        task["stage_verdict_affected_task_ids"] = list(affected_ids)

    old_status = task["status"]

    if old_status == new_status:
        if verdict or note or affected_ids:
            updates = {}
            if verdict:
                updates["stage_verdict"] = verdict
            if note:
                updates["stage_verdict_note"] = note
            if verdict:
                updates["stage_verdict_affected_task_ids"] = list(affected_ids)
            store = _get_store()
            try:
                from herdr import kernel
                kernel.update_task_metadata(
                    task_id=task_id,
                    updates=updates,
                    store=store,
                )
            except Exception as exc:
                print(f"Error updating task {task_id}: {exc}", file=sys.stderr)
                sys.exit(2)

            t_file = globals().get("TASKS_FILE") or os.environ.get("TASKS_FILE")
            sync_tasks_projection(store=store, tasks_file=Path(t_file) if t_file else None)

            if verdict:
                _record_gate_note(task, verdict, note)

            print(f"{task_id}: already {new_status}; verdict/note updated")
            return

        print(f"{task_id}: already {new_status}")
        return

    allowed_transitions = set(TRANSITIONS.get(old_status, set()))
    force_transition = False
    is_watchdog_gate = (
        _is_gate_task(task)
        and task.get("failure_reason") == "hard_timeout_watchdog"
    )
    if old_status == "failed" and new_status == "completed" and verdict and is_watchdog_gate:
        # Issue #250 & Codex review: Allow adopting gate verdict from failed state ONLY for watchdog-failed gate tasks
        allowed_transitions.add("completed")
        force_transition = True

    if new_status not in allowed_transitions:
        print(
            f"Illegal transition: "
            f"{task_id}: {old_status} -> {new_status}"
        )
        sys.exit(2)

    # Wrapup completion must carry the review-closure receipt (machine-
    # produced). Prompt-text-only requirements can still be bypassed by a
    # bare `set ... completed` — including the controller's auto-accept path,
    # which is also a CLI set (Codex review P1, wf-haflow-1015-01).
    if new_status == "completed" and (task.get("node") or task.get("stage")) == "wrapup":
        _enforce_wrapup_review_closure(task_id, task, skip=skip_review_closure,
                                       note=note, operator=skip_operator,
                                       operator_token=operator_token,
                                       operator_credentials=operator_credentials)


    metadata = {}
    if verdict:
        metadata["stage_verdict"] = verdict
    if note:
        metadata["stage_verdict_note"] = note
    if verdict:
        metadata["stage_verdict_affected_task_ids"] = list(affected_ids)

    expected_status = old_status if force_transition else None
    store = _get_store()
    if force_transition:
        # P2: Validate that the current persistent snapshot still satisfies the authorized
        # watchdog-recovery invariants before adopting the verdict. If another writer updated
        # the task (e.g. different failure reason, execution epoch, or status), abort adoption.
        fresh = store.get_task(task_id)
        if not fresh or not isinstance(fresh, dict):
            print(f"Task not found: {task_id}", file=sys.stderr)
            sys.exit(2)
        fresh_watchdog_gate = (
            _is_gate_task(fresh)
            and fresh.get("status") == "failed"
            and fresh.get("failure_reason") == "hard_timeout_watchdog"
        )
        if not fresh_watchdog_gate:
            print(
                f"Concurrent state change: task {task_id} is no longer an authorized watchdog-failed gate (status={fresh.get('status')}, reason={fresh.get('failure_reason')})",
                file=sys.stderr,
            )
            sys.exit(2)
        if task.get("execution_token") and fresh.get("execution_token") != task.get("execution_token"):
            print(
                f"Concurrent state change: task {task_id} execution token changed ({fresh.get('execution_token')} != {task.get('execution_token')})",
                file=sys.stderr,
            )
            sys.exit(2)
        # Retain the version bound to the authorized snapshot / candidate capture;
        # do not overwrite with an unverified newer version from another writer.
        if task.get("version") is not None and fresh.get("version") != task.get("version"):
            print(
                f"Concurrent state change: task {task_id} was modified by another writer (expected version {task.get('version')}, found {fresh.get('version')})",
                file=sys.stderr,
            )
            sys.exit(2)
        elif task.get("version") is None:
            task["version"] = fresh.get("version")

        # Codex Review P1 (Round 7): Re-read and authenticate durable gate verdict evidence from disk
        # before committing transition, binding the adopted verdict to the durable evidence snapshot.
        ok, res_or_err = _authenticate_gate_verdict_evidence(fresh, expected_verdict=verdict)
        if not ok:
            print(
                f"[VERDICT REFUSED] task {task_id}: {res_or_err}",
                file=sys.stderr,
            )
            sys.exit(2)
        file_v, file_note, file_aff, file_mtime = res_or_err
        metadata["gate_verdict_evidence_mtime"] = file_mtime
        if not note and file_note:
            metadata["stage_verdict_note"] = file_note
        if file_v == "blocked" and file_aff and not affected_ids:
            metadata["stage_verdict_affected_task_ids"] = file_aff
    expected_version = task.get("version") if force_transition else None
    try:
        from herdr import kernel
        res = kernel.transition_task(
            task_id=task_id,
            to_status=new_status,
            reason="cli_set_status",
            source="herdr-task",
            metadata=metadata,
            force=force_transition,
            store=store,
            expected_status=expected_status,
            expected_version=expected_version,
        )
        if force_transition and not res.get("accepted", True):
            print(
                f"Concurrent state change: task {task_id} is no longer at observed failed state (version {expected_version})",
                file=sys.stderr,
            )
            sys.exit(2)
    except Exception as exc:
        print(f"Error transitioning task {task_id}: {exc}", file=sys.stderr)
        sys.exit(2)

    t_file = globals().get("TASKS_FILE") or os.environ.get("TASKS_FILE")
    sync_tasks_projection(store=store, tasks_file=Path(t_file) if t_file else None)

    if new_status in ACTIVE_TASK_STATUSES:
        _clear_suppress_auto_close(task.get("workflow_id") or res.get("workflow_id"))

    if verdict:
        _record_gate_note(task, verdict, note)

    print(f"{task_id}: {old_status} -> {new_status}")


def auto_init_task_loop(clone_path, goal, acceptance_list, test_cmd=None, lint_cmd=None, repro_cmd=None, node=None, task_type=None):
    from herdr.task_cli_launch import auto_init_task_loop as initialize
    return initialize(clone_path, goal, acceptance_list, test_cmd=test_cmd,
                      lint_cmd=lint_cmd, repro_cmd=repro_cmd, node=node,
                      task_type=task_type)


def _refuse_loop_launch(args, refusal, *, clone_path, pane_id, pane_source):
    from herdr.task_cli_launch import refuse_loop_launch
    return refuse_loop_launch(
        args,
        refusal,
        clone_path=clone_path,
        pane_id=pane_id,
        pane_source=pane_source,
        reclaim_resources=_reclaim_unregistered_launch_resources,
        get_store=_get_store,
    )


def _is_isolation_rejection(exc):
    try:
        from herdr.agent_router import RouterIsolationRejection
        if isinstance(exc, RouterIsolationRejection):
            return True
    except ImportError:
        pass
    msg = str(exc).lower()
    return "isolation" in msg or "prohibited for stage" in msg or ("candidates" in msg and "used in stage" in msg)


def _record_router_failure_task(args, node_id, error, *,
                                reason="router_isolation_rejected",
                                failure_code=None, remediation=None):
    from herdr.task_cli_launch import record_router_failure_task
    return record_router_failure_task(
        args,
        node_id,
        error,
        reason=reason,
        failure_code=failure_code,
        remediation=remediation,
        get_store=_get_store,
        new_run_id=new_run_id,
        now=_now,
        release_agent_reservation=release_agent_reservation,
    )


def _frozen_candidate_sha(workflow_id):
    """Latest scheduler-frozen candidate revision, or "" when none/failed.

    A frozen candidate is a first-class identity claim produced by the
    Critical-Path Scheduler when implementation completes. It carries no
    verifier ids: the delivery record is written later, with real ones.
    """
    try:
        from herdr import scheduler_facts as _sf
    except ImportError:
        return ""
    try:
        return str(_sf.latest_frozen_candidate_sha(workflow_id) or "").strip()
    except (OSError, ValueError, RuntimeError, AttributeError, sqlite3.Error):
        return ""


def _resolve_expected_candidate(workflow_id, claim):
    """Resolve the candidate revision test/review must verify.

    Returns (candidate_sha, source) with source in {"delivery", "frozen"}.
    - "delivery": an explicit delivery record exists (authoritative; the
      caller must still run select_effective_delivery for ambiguity).
    - "frozen": no delivery record yet; the scheduler-frozen candidate is
      accepted ONLY when the dispatch claim names exactly that revision.
    Returns ("", "") when nothing provable exists (fail-closed).
    """
    claim = str(claim or "").strip()
    frozen = _frozen_candidate_sha(workflow_id)
    if frozen and claim and claim == frozen:
        return frozen, "frozen"
    return "", ""


def _preflight_delivery_identity(workflow_id, node_id, task_id, claim=""):
    """Reject ambiguous/invalidated/unprovable delivery before creating resources."""
    if node_id not in {"test", "review"}:
        return None
    from herdr import delivery_record as _dr
    from herdr import workflow_docs as _wd

    notes = _wd.load_notes(workflow_id)
    legacy = _dr.unidentified_delivery_notes(notes)
    if legacy:
        shown = ", ".join(str(note.get("note_id") or "?") for note in legacy[:5])
        print(
            f"[BASELINE DEGRADED] {len(legacy)} identity-less delivery note(s) "
            f"ignored (human evidence, not delivery claims): {shown}"
        )
    delivery_notes = [note for note in notes if note.get("kind") == "delivery"]
    def reject(code, detail):
        payload = {
            "workflow_id": workflow_id,
            "task_id": task_id,
            "stage": node_id,
            "failure_code": code,
            "detail": str(detail)[:500],
            "actionable": True,
            "remediation": (
                "record a valid delivery with herdr-task record-delivery "
                "before launching test/review"
            ),
        }
        try:
            _get_store().record_event(
                "test_baseline_rejected", payload,
                workflow_id=workflow_id, node_id=node_id, task_id=task_id,
                source="herdr-task",
            )
        except (OSError, ValueError, RuntimeError, AttributeError, sqlite3.Error) as exc:
            print(f"[BASELINE EVENT WARN] rejection audit unavailable: {exc}", file=sys.stderr)
        print(
            f"[BASELINE REJECTED] {code}: workflow={workflow_id} "
            f"task={task_id}; {detail}; launch refused (FR-6.2 fail-closed)."
        )
        raise SystemExit(2)

    if not delivery_notes:
        # No delivery record yet: the scheduler-frozen candidate is the only
        # acceptable identity, and only when the dispatch claim proves it.
        candidate, source = _resolve_expected_candidate(workflow_id, claim)
        if source == "frozen":
            return {"candidate_sha": candidate, "identity_source": "frozen"}
        reject(
            "delivery_missing",
            "no valid delivery baseline exists and no matching frozen "
            "candidate is recorded for this dispatch claim",
        )
    try:
        effective = _dr.select_effective_delivery(notes)
    except _dr.DeliveryAmbiguityError as exc:
        reject("delivery_ambiguous", exc)
    if effective is None:
        # A prior candidate exists but none is eligible (invalidated by a
        # fix-loop rework). The frozen candidate for the CURRENT revision is
        # the legitimate identity: it never resurrects the invalidated one,
        # and the join gate still requires every verifier on that revision.
        candidate, source = _resolve_expected_candidate(workflow_id, claim)
        if source == "frozen":
            return {"candidate_sha": candidate, "identity_source": "frozen"}
        reject(
            "delivery_invalidated",
            "delivery candidate was invalidated and no matching frozen "
            "candidate exists for this dispatch claim",
        )
    return effective


def _preflight_baseline_freshness(args, source_repo, base_branch):
    """Refuse a stale candidate baseline before creating clone/Pane (scheme A).

    Position is the contract: this runs after routing + delivery-identity
    checks and before `ensure_stage_topology` / pane acquisition / worker
    spawn, so a refusal provably creates zero clone/Pane side effects.
    The launch intent is already claimed at this point, so refusal winds it
    down exactly like a router failure (failed task + finish intent +
    release reservation). Post-resource FR-6.2 validators stay untouched as
    the fail-closed backstop for the residual check-to-checkout race.
    """
    node_id = getattr(args, "node", "") or getattr(args, "stage", "")
    claim = str(getattr(args, "candidate_sha", None) or "").strip()
    onto = str(getattr(args, "onto", None) or "").strip()
    if not claim and not onto:
        # Fresh-branch launches check out live origin/<base>; nothing to prove.
        return None
    from herdr import launch_baseline as _lb
    probe = _lb.probe_claim_freshness(
        source_repo, base_branch=base_branch,
        claim_sha=claim, onto_branch=onto or None,
    )
    if probe["status"] in ("fresh", "skipped"):
        return probe
    if probe["status"] == "unknown":
        print(
            "[BASELINE PREFLIGHT] baseline freshness unknown "
            f"({probe.get('detail')}); proceeding, FR-6.2 stays fail-closed."
        )
        return probe
    verdict = _lb.decide_baseline_failfast(
        dev_tip=probe["dev_tip"], claim_sha=probe["claim_sha"],
        behind_by=probe["behind_by"], claim_label=onto or "candidate",
    )
    detail = f"{verdict['message']} {verdict['remediation']}"[:1000]
    try:
        _get_store().record_event(
            "baseline_stale_refused",
            {
                "workflow_id": getattr(args, "workflow_id", ""),
                "task_id": getattr(args, "task_id", ""),
                "stage": node_id,
                "failure_code": "baseline_stale",
                "behind_by": verdict["behind_by"],
                "dev_tip": verdict["dev_tip"],
                "claim_sha": verdict["claim_sha"],
                "detail": detail[:500],
                "actionable": True,
                "remediation": verdict["remediation"],
            },
            workflow_id=getattr(args, "workflow_id", ""),
            node_id=node_id, task_id=getattr(args, "task_id", ""),
            source="herdr-task",
        )
    except (OSError, ValueError, RuntimeError, AttributeError,
            sqlite3.Error) as exc:
        print(f"[BASELINE EVENT WARN] rejection audit unavailable: {exc}",
              file=sys.stderr)
    _record_router_failure_task(
        args, node_id, detail,
        reason="baseline_stale",
        failure_code="baseline_stale",
        remediation=verdict["remediation"],
    )
    print(
        f"[BASELINE STALE] workflow={getattr(args, 'workflow_id', '')} "
        f"task={getattr(args, 'task_id', '')}; {detail}; "
        "launch refused before creating clone/Pane (fail-fast)."
    )
    raise SystemExit(2)


def _reclaim_unregistered_launch_resources(
    args, clone_path="", pane_id="", pane_source="",
):
    """Release pane/clone/reservation when a launch is refused pre-registration.

    The baseline check runs after the worker created a clone and a Pane but
    before the Task is registered, so the normal release path (which runs after
    registration) never fires. Without this, a rejected test/review launch
    leaves an orphan clone, an orphan Pane, and a held agent reservation, and
    every retry accumulates another set (AGENTS.md §4.6 idempotency/recovery).

    Pane ownership matters. A "dynamic" pane was created for this task, so this
    process owns it and closing it is correct. A "prebuilt"/persistent pane is
    borrowed shared infrastructure that outlives any one task; killing it would
    destroy the pool, so only the task's occupancy is released. Herdr Panes are
    managed through the ``herdr`` CLI rather than raw tmux, so teardown goes
    through the same backend the rest of the repo uses.

    Best-effort and ordered so a failure at one step still attempts the rest.
    """
    from herdr.task_cli_resources import reclaim_unregistered_launch_resources
    return reclaim_unregistered_launch_resources(
        args,
        clone_path,
        pane_id,
        pane_source,
        close_pane=close_pane,
        delete_clone_safely=delete_clone_safely,
        release_agent_reservation=release_agent_reservation,
    )


def _validate_supersedes_for_launch(args, node_id, store):
    """Enforce that relaunching / replacing in a node with pending replacement obligations
    MUST explicitly provide --supersedes <prev_task_id>."""
    if not getattr(args, "workflow_id", None) or not node_id:
        return
    if getattr(args, "supersedes", None):
        return
    node_tasks = [
        t for t in store.list_tasks(workflow_id=args.workflow_id)
        if (t.get("node") == node_id or t.get("stage") == node_id)
    ]
    # Any task in this node that was superseded with replacement_pending: True and no superseded_by
    unreplaced = [
        t["task_id"] for t in node_tasks
        if t.get("status") == "superseded" and t.get("replacement_pending") and not t.get("superseded_by")
    ]
    if unreplaced:
        raise ValueError(
            f"Node '{node_id}' has pending replacement obligation(s): {', '.join(unreplaced)}. "
            f"Relaunch must explicitly specify --supersedes <prev_task_id> to close the lineage chain."
        )


def _validate_test_review_baseline(args, baseline_commit, source_repo):
    """Fail-closed baseline proof for a test/review launch.

    Refuses the launch (SystemExit) unless the clone the worker just checked
    out provably sits on the exact candidate revision this dispatch must
    verify. Extracted from the launch path so the refusal has one owner and the
    caller's resource-reclaim logic stays readable.
    """
    from herdr import delivery_record as _dr2
    from herdr import workflow_docs as _wd2

    node_id = getattr(args, "node", "") or getattr(args, "stage", "")
    _notes = _wd2.load_notes(args.workflow_id)
    try:
        _effective = _dr2.select_effective_delivery(_notes)
    except _dr2.DeliveryAmbiguityError as exc:
        print(f"[DELIVERY AMBIGUOUS] {exc}; launch refused")
        sys.exit(2)
    if _effective is not None:
        _base = str(
            _effective.get("base")
            or _dr2._body_value(_effective, "base")
            or _effective.get("base_sha")
            or ""
        )
        _effective = _dr2.select_effective_delivery(
            _wd2.annotate_notes(_notes, current_base_sha=_base or None)
        )
    _claim = str(getattr(args, "candidate_sha", None) or "").strip()
    if _effective is not None:
        _cand = str(_effective.get("candidate_sha") or "")
        if not _cand:
            _body = _effective.get("body") or ""
            for _line in _body.splitlines():
                if _line.startswith("candidate_sha:"):
                    _cand = _line.split(":", 1)[1].strip()
                    break
        if not _cand:
            _cand = str(_effective.get("base_sha") or "")
        # Scheduler v1: the dispatch claim must name the same revision as the
        # delivery identity, otherwise the join gate could certify a revision
        # no delivery record ever named.
        if _claim and not _same_commit(_claim, _cand, source_repo):
            _validate_test_delivery_baseline(
                args, _cand, "claim_mismatch:" + _claim, source_repo,
            )
    else:
        # No eligible delivery record (none at all, or all invalidated): the
        # frozen candidate is the identity, and the dispatch claim must prove
        # it. Never falls back to a bare branch HEAD.
        _frozen, _source = _resolve_expected_candidate(args.workflow_id, _claim)
        if _source != "frozen":
            _validate_test_delivery_baseline(
                args, "", baseline_commit, source_repo,
            )
        _cand = _frozen
    _validate_test_delivery_baseline(args, _cand, baseline_commit, source_repo)


def _canonical_commit(sha, source_repo):
    """Resolve a revision to its full object ID, or "" when unresolvable.

    Git accepts abbreviated object IDs, so a delivery record holding "abc1234"
    and a clone reporting the full hash name the same commit. Canonicalising
    first keeps the comparison strict without falsely rejecting a match.
    """
    sha = str(sha or "").strip()
    if not sha:
        return ""
    try:
        probe = subprocess.run(
            ["git", "-C", str(source_repo), "rev-parse", "--verify", "--quiet",
             f"{sha}^{{commit}}"],
            text=True, capture_output=True, check=False, timeout=30,
        )
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError):
        return ""
    if probe.returncode != 0:
        return ""
    return (probe.stdout or "").strip().lower()


def _same_commit(left, right, source_repo):
    """Strict same-commit equality; never ancestor containment.

    At this boundary a real repository is reachable, so Git is the only
    authority. Both sides are canonicalised with ``rev-parse <sha>^{commit}``
    and compared as full object IDs. If either side fails to resolve, Git has
    said the revision cannot be uniquely identified (an ambiguous abbreviation,
    or a repository that is absent/unreadable) — that is a proof failure, so
    the answer is False.

    Falling back to string-prefix matching here would accept exactly the case
    Git refused to prove, re-opening a false "same commit" verdict on the
    launch gate.
    """
    left = str(left or "").strip().lower()
    right = str(right or "").strip().lower()
    if not left or not right:
        return False
    if left == right:
        return True
    full_left = _canonical_commit(left, source_repo)
    full_right = _canonical_commit(right, source_repo)
    if not full_left or not full_right:
        return False
    return full_left == full_right


def _validate_test_delivery_baseline(args, candidate_sha, baseline_commit, source_repo):
    """Require test/review to verify exactly the frozen candidate revision.

    Scheduler v1 invariant: every verifier must verify the SAME immutable
    candidate revision. Ancestor containment (candidate is an ancestor of
    the clone baseline) is NOT sufficient: the agent would actually verify
    baseline_commit, while the join gate would claim candidate_sha. Only
    strict equality proves the claim. Empty values fail closed.
    """
    candidate_sha = str(candidate_sha or "").strip()
    baseline_commit = str(baseline_commit or "").strip()
    if candidate_sha and baseline_commit and _same_commit(
        candidate_sha, baseline_commit, source_repo
    ):
        return
    try:
        _get_store().record_event(
            "test_baseline_rejected",
            {"candidate_sha": candidate_sha, "baseline_commit": baseline_commit,
             "stage": getattr(args, "node", "") or getattr(args, "stage", ""),
             "failure_code": "baseline_unproven", "actionable": True,
             "remediation": "rebase the test/review clone onto the recorded delivery candidate and relaunch"},
            workflow_id=args.workflow_id,
            node_id=getattr(args, "node", "") or getattr(args, "stage", ""),
            task_id=args.task_id,
            source="herdr-task",
        )
    except (OSError, ValueError, RuntimeError, AttributeError, sqlite3.Error) as event_exc:
        print(
            f"[BASELINE EVENT WARN] could not persist rejection: {event_exc}",
            file=sys.stderr,
        )
    print(
        f"[BASELINE REJECTED] test/review task {args.task_id} baseline "
        f"{baseline_commit} does not contain candidate {candidate_sha}; "
        "launch refused (FR-6.2 fail-closed)."
    )
    raise SystemExit(2)


def _validate_selective_replacement_baseline(args, candidate_sha, baseline_commit, source_repo):
    """Require a replacement checkout to sit exactly on its claimed candidate.

    P1-3 (PR #110 round-2): the controller binds a selective replacement to
    `--onto <frozen_branch>` + `--candidate-sha <frozen_sha>`, but nothing
    proves the branch HEAD still equals the frozen SHA at checkout time —
    the branch may have advanced after the freeze. The worker reports the
    actual checkout HEAD as baseline_commit; claim and checkout must be
    strictly identical, otherwise task metadata (candidate_sha=AAA) diverges
    from the real baseline (BBB) — the claim/execution split #107 exists to
    prevent. Empty values fail closed. Refusal is SystemExit(2), mirroring
    the test/review gate above.
    """
    candidate_sha = str(candidate_sha or "").strip()
    baseline_commit = str(baseline_commit or "").strip()
    if candidate_sha and baseline_commit and _same_commit(
        candidate_sha, baseline_commit, source_repo
    ):
        return
    try:
        _get_store().record_event(
            "selective_baseline_rejected",
            {"candidate_sha": candidate_sha, "baseline_commit": baseline_commit,
             "stage": getattr(args, "node", "") or getattr(args, "stage", ""),
             "onto_branch": str(getattr(args, "onto", None) or ""),
             "failure_code": "replacement_baseline_mismatch", "actionable": True,
             "remediation": "re-freeze the candidate and relaunch the replacement onto the frozen branch"},
            workflow_id=args.workflow_id,
            node_id=getattr(args, "node", "") or getattr(args, "stage", ""),
            task_id=args.task_id,
            source="herdr-task",
        )
    except (OSError, ValueError, RuntimeError, AttributeError, sqlite3.Error) as event_exc:
        print(
            f"[BASELINE EVENT WARN] could not persist rejection: {event_exc}",
            file=sys.stderr,
        )
    print(
        f"[BASELINE REJECTED] replacement task {args.task_id} baseline "
        f"{baseline_commit} != claimed candidate {candidate_sha}; "
        "launch refused (selective-replan fail-closed)."
    )
    raise SystemExit(2)


