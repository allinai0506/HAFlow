def cmd_panes(args):
    from herdr.node_capacity import node_usage
    store = _get_store()
    project = store.get_workflow(args.workflow_id)
    if not project:
        print(f"Workflow not found: {args.workflow_id}", file=sys.stderr)
        sys.exit(2)
    try:
        definition = _capacity_definition(project)
        tasks = store.list_tasks(workflow_id=args.workflow_id)
        nodes = definition.get("nodes", [])
        known = {n.get("id") or n.get("key") for n in nodes}
        nodes = list(nodes) + [{"id": nid} for nid in sorted({
            t.get("node") or t.get("stage") for t in tasks
        } - known - {None})]
        rows = [node_usage(n, tasks, args.workflow_id) for n in nodes]
    except (OSError, ValueError, TypeError) as exc:
        print(f"Pane usage unavailable: {exc}", file=sys.stderr)
        sys.exit(2)
    result = {"workflow_id": args.workflow_id, "nodes": rows,
              "note": "pane counts are persisted references, not verified live panes"}
    if args.json:
        print(json.dumps(result, ensure_ascii=False))
    else:
        print("NODE  TASKS  ACTIVE/MAX_CONCURRENCY  PANE_REFS  MAX_TASKS  OVERFLOW")
        for row in rows:
            print(f"{row['node']}  {row['task_count']}  "
                  f"{row['active_task_count']}/{row['max_concurrency'] or 'unset'}  "
                  f"{row['pane_count']}  {row['max_tasks_per_node'] or 'unset'}  "
                  f"{'YES' if row['overflow'] else '-'}")
        print(result["note"])


def _launch_task(args):
    agent_policy = None
    raw_policy = getattr(args, "agent_policy", None)
    if raw_policy:
        try:
            agent_policy = json.loads(raw_policy)
        except ValueError as exc:
            print(f"Invalid --agent-policy JSON: {exc}")
            sys.exit(2)
        if agent_policy is not None and not isinstance(agent_policy, dict):
            print("--agent-policy must be a JSON object")
            sys.exit(2)

    data = load_tasks()

    node_id = getattr(args, "node", None) or getattr(args, "stage", None)
    if not node_id:
        print("Error: either --node or --stage is required")
        sys.exit(1)
    run_id = getattr(args, "run_id", None) or new_run_id()
    args.run_id = run_id

    # Project/workflow identity is read before routing.  Pane topology is
    # intentionally deferred until the router has accepted the task, so an
    # empty review pool cannot create a Pane as a side effect.
    project = project_for_workflow(args.workflow_id)
    if not project:
        print(f"[WORKFLOW NOT FOUND] {args.workflow_id}; refusing launch")
        sys.exit(2)

    # New/migrated workflows own the execution identity. A manual Task launch
    # inherits it just like scheduler dispatch, and cannot override it.
    execution_id = project.get('execution_id')
    if execution_id:
        requested_execution = getattr(args, 'execution_id', None)
        if requested_execution and requested_execution != execution_id:
            print('[EXECUTION IDENTITY REJECTED] workflow generation mismatch', file=sys.stderr)
            sys.exit(2)
        args.execution_id = execution_id

    exec_fields = execution_fields_from_workflow(project)
    try:
        from herdr.workflow import validate_artifact_contract
        from herdr.task_resources import find_dispatch_task, begin_launch_intent
        store = _get_store()
        definition = _capacity_definition(project)
        from herdr.business_gate import business_gate_blockers
        authority, pinned, owned_tasks = store.read_workflow_snapshot(args.workflow_id)
        missing_business = business_gate_blockers(store, authority, pinned or definition, owned_tasks, node_id)
        if missing_business:
            raise ValueError('business acceptance unavailable: ' + ', '.join(missing_business))
        node = next((n for n in definition.get("nodes", []) if n.get("id") == node_id), {})
        if node.get("delivery_contract") is not None:
            from herdr.task_delivery import validate_contract
            validate_contract(node["delivery_contract"])
        configured_mode = node.get("artifact_mode")
        requested_mode = getattr(args, "artifact_mode", None)
        if configured_mode and requested_mode and configured_mode != requested_mode:
            raise ValueError("artifact_mode override conflicts with node delivery contract")
        args.artifact_mode = configured_mode or requested_mode
        validate_artifact_contract(args.artifact_mode, args.integration_mode, node_id=node_id, task_type=args.task_type)
        predecessor = store.get_task(args.supersedes) if getattr(args, "supersedes", None) else None
        roles = (node.get("agent_policy") or {}).get("roles") or []
        requested_role = getattr(args, "dispatch_role", None)
        if len(roles) > 1 and not requested_role and not predecessor:
            raise ValueError("parallel role node requires explicit --dispatch-role")
        args.dispatch_role = requested_role or (predecessor or {}).get("dispatch_role") or "worker"
        args.dispatch_round = getattr(args, "dispatch_round", None) or (int(predecessor.get("dispatch_round") or 1) + 1 if predecessor else 1)
        _validate_supersedes_for_launch(args, node_id, store)
        clone_root = Path(os.environ.get('HERDR_CLONES_DIR') or Path.home() / '.herdr-controller/clones').expanduser().resolve()
        if Path(args.task_id).name != args.task_id or args.task_id in {'.', '..'} or len(args.task_id) > 128:
            raise ValueError('task_id must be a bounded single workspace name')
        planned_clone = clone_root / args.task_id
        from herdr.domain import get_domain_adapter
        _domain_adapter = get_domain_adapter(
            domain=getattr(args, "domain", None) or node.get("domain"),
            task_type=getattr(args, "task_type", None) or node.get("default_task_type"),
        )
        if node.get("delivery_contract"):
            node["delivery_contract"] = _domain_adapter.prepare_delivery_contract(
                node["delivery_contract"],
                {
                    "task_id": args.task_id,
                    "task_type": getattr(args, "task_type", None),
                    "node_id": node_id,
                    "branch": getattr(args, "onto", None),
                },
            )
        from herdr.task_delivery import validate_fix_retrospective
        validate_fix_retrospective(task_id=args.task_id, task_type=getattr(args, "task_type", None),
                                   node_id=node_id, contract=node.get("delivery_contract"),
                                   integration_mode=getattr(args, "integration_mode", None) or node.get("integration_mode") or node.get("default_integration_mode"))

        candidate = str(getattr(args, "candidate_sha", None) or "").strip()
        onto = getattr(args, "onto", None)
        committed_recovery = bool(predecessor and predecessor.get('status') == 'committed')
        if committed_recovery:
            if candidate != predecessor.get('commit'):
                raise ValueError('Committed recovery requires exact predecessor --candidate-sha')
            if onto and onto == predecessor.get('branch'):
                raise ValueError('Committed recovery cannot use predecessor branch as --onto')
            workflow_execution = (store.get_workflow(args.workflow_id) or {}).get('execution_id')
            if (not workflow_execution or getattr(args, 'execution_id', None) != workflow_execution
                    or (predecessor.get('execution_id') and predecessor['execution_id'] != workflow_execution)):
                raise ValueError('Committed recovery requires authoritative workflow execution identity')
        if onto and not candidate and exec_fields["execution_mode"] == "git":
            source = str(Path(project.get("project_root") or args.source).expanduser().resolve())
            remote = subprocess.run(["git", "-C", source, "show-ref", "--verify", "--quiet",
                                     f"refs/remotes/origin/{onto}"], capture_output=True)
            local = subprocess.run(["git", "-C", source, "rev-parse", "--verify",
                                    f"refs/heads/{onto}^{{commit}}"], text=True, capture_output=True)
            if remote.returncode and local.returncode == 0:
                raise ValueError(f"Local-only --onto {onto} requires --candidate-sha {local.stdout.strip()}; "
                                 "read and verify this frozen commit before relaunching")
        duplicate = find_dispatch_task(store, args.workflow_id, node_id, args.dispatch_role,
                                       candidate, args.dispatch_round)
        if duplicate:
            if getattr(args, 'dispatch_operation_id', None) is not None and duplicate.get('dispatch_operation_id') != args.dispatch_operation_id:
                raise ValueError('existing task belongs to another dispatch operation')
            if committed_recovery:
                _finish_committed_recovery_launch(store, duplicate, predecessor, args.supersede_reason)
            print(f"[DISPATCH DUPLICATE] proposed={args.task_id} existing={duplicate['task_id']}")
            return
        if find_task(data, args.task_id):
            raise ValueError(f"Task ID already exists with another dispatch identity: {args.task_id}")
        validate_integration_for_execution(
            exec_fields["execution_mode"],
            args.integration_mode,
        )
        validate_onto_for_execution(
            exec_fields["execution_mode"],
            getattr(args, "onto", None),
        )
    except ValueError as exc:
        print(str(exc))
        sys.exit(2)

    # Fail closed on mandatory experience rules BEFORE any launch resource
    # exists. Running this inside dispatch_task() is too late: by then the
    # worker holds a clone/pane, the task is persisted and the launch intent
    # finalized, so a Hub outage would leave an undispatchable task whose
    # retry is consumed by the duplicate check above.
    if getattr(args, "mandatory_experience_rules", False):
        try:
            _prefetched_experience_suffix, _prefetched_experience_refs = _mandatory_experience_gate(args, node_id)
        except Exception:
            sys.exit(2)
    else:
        _prefetched_experience_suffix = None
        _prefetched_experience_refs = None

    _check_launch_capacity(args, project, data.get("tasks", []), node_id)
    try:
        claim = begin_launch_intent(store, workflow_id=args.workflow_id, node_id=node_id,
                                    role=args.dispatch_role, candidate_sha=candidate,
                                    dispatch_round=args.dispatch_round, task_id=args.task_id,
                                    supersedes=getattr(args, "supersedes", None),
                                    dispatch_operation_id=getattr(args, "dispatch_operation_id", None),
                                    dispatch_attempt=getattr(args, "dispatch_attempt", None),
                                    run_id=run_id, execution_id=getattr(args, "execution_id", None))
    except ValueError as exc:
        print(f"[DISPATCH REJECTED] {exc}")
        sys.exit(2)
    if claim['status'] == 'recovery_required':
        from herdr.task_resources import recover_launch_resources
        recovered = recover_launch_resources(store, claim['intent'])
        if recovered['status'] == 'resources_absent':
            release_agent_reservation(claim['intent']['task_id'])
            claim = begin_launch_intent(store, workflow_id=args.workflow_id, node_id=node_id, role=args.dispatch_role, candidate_sha=candidate, dispatch_round=args.dispatch_round, task_id=args.task_id, supersedes=getattr(args, 'supersedes', None), dispatch_operation_id=getattr(args, 'dispatch_operation_id', None), dispatch_attempt=getattr(args, 'dispatch_attempt', None), run_id=run_id, execution_id=getattr(args, 'execution_id', None))
    if claim['status'] != 'claimed':
        if claim['status'] == 'duplicate':
            if committed_recovery:
                _finish_committed_recovery_launch(store, claim['task'], predecessor, args.supersede_reason)
            print(f"[DISPATCH DUPLICATE] proposed={args.task_id} existing={claim['task']['task_id']}")
            return
        print(f"[DISPATCH {claim['status'].upper()}] task={claim['intent']['task_id']}; "
              "reconcile intent-owned resources before retrying")
        sys.exit(75)
    launch_intent = claim['intent']
    args._launch_intent = launch_intent
    from herdr.task_resources import record_launch_resources
    launch_intent = record_launch_resources(store, launch_intent, {
        'planned_clone_path': str(planned_clone), 'run_id': run_id,
    })

    source_repo = os.path.realpath(
        os.path.expanduser(
            project.get("project_root")
            or args.source
        )
    )

    base_branch = (
        project.get("base_branch")
        or "dev"
    )

    onto_branch = getattr(args, "onto", None)

    if onto_branch:
        try:
            ensure_branch_available(
                onto_branch,
                data.get("tasks", []),
                task_id=args.task_id,
            )
        except BranchOwnershipError as exc:
            print(f"[BRANCH OWNERSHIP ERROR] {exc}")
            sys.exit(2)

        try:
            pinned_local = pinned_local_onto_matches(
                source_repo, onto_branch, getattr(args, "candidate_sha", None),
            )
        except RuntimeError as exc:
            print(str(exc))
            sys.exit(2)
        if not pinned_local:
            # Fix-loop 续接:任务必须落在既有分支(如开放中的 PR 分支)上。
            fetch = subprocess.run(
                [
                    "git", "-C", source_repo,
                    "fetch", "origin", onto_branch,
                ],
                text=True,
                capture_output=True,
            )
            remote_ref = subprocess.run(
                [
                    "git", "-C", source_repo,
                    "rev-parse", "--verify", "--quiet",
                    f"refs/remotes/origin/{onto_branch}",
                ],
                text=True,
                capture_output=True,
            )

            if fetch.returncode != 0 or remote_ref.returncode != 0:
                print(
                    f"Onto branch not found on origin: {onto_branch}\n"
                    f"{(fetch.stderr.strip() or fetch.stdout.strip())}"
                )
                sys.exit(2)

    requested_agent = args.agent if args.agent else "auto"

    # FR-6.1 opt-out via launch flags (R9: reason required, no approval).
    # Injected into the workflow node_policy for this routing decision only.
    _opt_out_active = bool(getattr(args, "allow_reuse", False))
    _opt_reason = str(getattr(args, "reuse_reason", "") or "").strip()
    if _opt_out_active and not _opt_reason:
        print(
            "Isolation opt-out requires --reuse-reason "
            "(R9: reason field mandatory, no approval needed)"
        )
        sys.exit(2)
    if _opt_out_active:
        _orig_wcf = workflow_config_for

        def _patched_wcf(wid, _orig=_orig_wcf, _node=node_id,
                         _reason=_opt_reason):
            cfg = _orig(wid)
            if not cfg or wid != args.workflow_id:
                return cfg
            try:
                import copy as _copy

                cfg = _copy.deepcopy(cfg)
                for _n in cfg.get("nodes", []):
                    if _n.get("id") == _node:
                        _pol = dict(_n.get("agent_policy") or {})
                        _pol["allow_reuse_implementation_agents"] = True
                        _pol["reuse_reason"] = _reason
                        _n["agent_policy"] = _pol
            except (TypeError, AttributeError, ValueError):
                pass
            return cfg

        import herdr.agent_router as _router

        _orig_router_wcf = _router.workflow_config_for
        _router.workflow_config_for = _patched_wcf
        try:
            from herdr import projects as _projects

            _orig_proj_wcf = _projects.workflow_config_for
            _projects.workflow_config_for = _patched_wcf
            try:
                try:
                    resolved_agent = choose_agent(
                        args.workflow_id,
                        node_id,
                        args.task_type,
                        requested_agent,
                        reservation_key=args.task_id,
                        run_id=getattr(args, "run_id", None),
                        dispatch_role=args.dispatch_role,
                    )
                except RuntimeError as exc:
                    if _is_isolation_rejection(exc):
                        try:
                            _record_router_failure_task(args, node_id, exc)
                        except RuntimeError as persist_exc:
                            print(f"[ROUTER LIFECYCLE ERROR] {persist_exc}")
                            sys.exit(2)
                        print(f"[ROUTER OPT-OUT REJECTED] {exc}")
                        sys.exit(2)
                    else:
                        launch_intent = getattr(args, "_launch_intent", None)
                        if launch_intent:
                            try:
                                from herdr.task_resources import abort_launch_intent
                                abort_launch_intent(store, launch_intent, reason="router_rejected")
                            except Exception:
                                pass
                        try:
                            release_agent_reservation(args.task_id)
                        except Exception:
                            pass
                        print(f"[ROUTER REJECTED] {exc}")
                        if "preflight" in str(exc).lower():
                            print("Run './bin/herdr-deep-preflight --deep' to inspect agent connectivity and credentials.")
                        sys.exit(2)
            finally:
                _projects.workflow_config_for = _orig_proj_wcf
        finally:
            _router.workflow_config_for = _orig_router_wcf
        # ``choose_agent`` already persists the required audit event before
        # returning.  Do not write a second event here: one opt-out decision
        # has one authoritative audit row, and a failed write has already
        # caused the branch above to fail closed.
    else:
        try:
            resolved_agent = choose_agent(
                args.workflow_id,
                node_id,
                args.task_type,
                requested_agent,
                reservation_key=args.task_id,
                run_id=getattr(args, "run_id", None),
                dispatch_role=args.dispatch_role,
            )
        except RuntimeError as exc:
            if _is_isolation_rejection(exc):
                # Fail-closed lifecycle: persist a task-level actionable failure;
                # topology/Pane creation has not happened yet.
                try:
                    _record_router_failure_task(args, node_id, exc)
                except RuntimeError as persist_exc:
                    print(f"[ROUTER LIFECYCLE ERROR] {persist_exc}")
                    sys.exit(2)
                print(f"[ROUTER REJECTED] {exc}")
                print(
                    "Isolation is fail-closed. Re-launch with explicit "
                    "--allow-reuse-implementation-agents --reuse-reason '<why>' "
                    "to opt out (the opt-out audit must persist)."
                )
                sys.exit(2)
            else:
                launch_intent = getattr(args, "_launch_intent", None)
                if launch_intent:
                    try:
                        from herdr.task_resources import abort_launch_intent
                        abort_launch_intent(store, launch_intent, reason="router_rejected")
                    except Exception:
                        pass
                try:
                    release_agent_reservation(args.task_id)
                except Exception:
                    pass
                from herdr.agent_router import RouterHealthRejection, RouterPolicyRejection
                if not isinstance(exc, (RouterHealthRejection, RouterPolicyRejection)):
                    _record_router_failure_task(args, node_id, exc)
                print(f"[ROUTER REJECTED] {exc}")
                if "preflight" in str(exc).lower():
                    print("Run './bin/herdr-deep-preflight --deep' to inspect agent connectivity and credentials.")
                sys.exit(2)

    args._launch_reservation_acquired = True
    # Only after routing and delivery identity checks succeed do we create
    # runtime resources.  All gates are deliberately before topology/Panes:
    # delivery identity, then baseline freshness (scheme A fail-fast).
    _preflight_delivery_identity(
        args.workflow_id, node_id, args.task_id,
        claim=getattr(args, "candidate_sha", None),
    )
    _preflight_baseline_freshness(args, source_repo, base_branch)
    args._launch_resources_started = True
    stage_config = ensure_stage_topology(
        args.workflow_id,
        node_id,
    )
    workspace_id = stage_config["workspace_id"]
    parent_pane = stage_config["anchor_pane_id"]

    prebuilt_pane = acquire_pane_for_task(
        args.workflow_id,
        node_id,
        resolved_agent,
    )

    # integration_mode=git 时，
    # 源仓库 tracked 文件必须 clean。
    # untracked 文件允许存在，因为 CoW Clone 需要保留完整上下文。
    # FR-3.2: launch-time precheck is warning-only; the blocking gate stays
    # at integrate (TOCTOU-safe: precheck pass never promises later clean).
    if args.integration_mode == "git":
        source = os.path.realpath(
            os.path.expanduser(args.source)
        )

        tracked_status = subprocess.check_output(
            [
                "git",
                "-C",
                source,
                "status",
                "--porcelain",
                "--untracked-files=no"
            ],
            text=True
        ).strip()

        if tracked_status:
            try:
                from herdr import repo_hygiene as _pre_hygiene

                _warn = _pre_hygiene.launch_precheck_message(
                    porcelain=tracked_status,
                    task_id=args.task_id,
                    integration_mode=args.integration_mode,
                )
            except (ImportError, AttributeError, ValueError):
                _warn = None
            if _warn:
                print(_warn)
            else:
                print(
                    "[PRECHECK WARNING] source has tracked changes; "
                    "launch continues, integrate will gate with exit 5."
                )
            print(tracked_status)

    # 1. 创建 Clone + Pane + Agent
    try:
        from herdr.workspace_trust import (
            ensure_workspace_trust as _ensure_clone_trust,
            preseed_trust_target as _preseed_target,
        )
        _preseed_path = _preseed_target(str(planned_clone), resolved_agent)
        if _preseed_path is not None:
            _ensure_clone_trust(_preseed_path, [resolved_agent])
    except Exception as exc:
        print(f"[WORKSPACE TRUST WARN] pre-seed failed for {args.task_id}: {exc}")
    worker_script = HERDR_ROOT / "services" / "herdr-worker.py"
    if not worker_script.exists():
        worker_script = Path(os.path.expanduser("~/HAFlow/services/herdr-worker.py"))

    worker_cmd = [
        str(worker_script),
        "--task-id", args.task_id,
        "--source", args.source,
        "--agent", resolved_agent,
        "--task-type", args.task_type,
    ]
    if exec_fields["execution_mode"] == "context":
        worker_cmd += [
            "--execution-mode", "context",
            "--context-json",
            json.dumps(exec_fields.get("context") or {}),
        ]
    else:
        worker_cmd += ["--base-branch", base_branch]

    try:
        from herdr import workflow_docs as wd
        worker_cmd += [
            "--shared-docs", str(wd.workflow_docs_dir(args.workflow_id))
        ]
    except Exception:
        pass

    if onto_branch:
        worker_cmd += ["--onto", onto_branch]
    if getattr(args, "candidate_sha", None):
        worker_cmd += ["--candidate-sha", args.candidate_sha]

    if prebuilt_pane:
        worker_cmd += ["--pane-id", prebuilt_pane]
    else:
        worker_cmd += ["--parent-pane", parent_pane]

    try:
        worker = subprocess.run(
            worker_cmd + ["--run-id", run_id, '--launch-intent-id', launch_intent['intent_id']],
            text=True,
            capture_output=True,
            timeout=300,
        )
    except subprocess.TimeoutExpired:
        store.record_event('launch_recovery_required', {
            'task_id': args.task_id, 'run_id': run_id, 'side_effects': 'unknown',
            'failure_type': 'worker_timeout', 'recovery_required': True,
            'intent_id': launch_intent['intent_id'],
        }, workflow_id=args.workflow_id, node_id=node_id, task_id=args.task_id,
            run_id=run_id, source='herdr-task')
        print('[WORKER TIMEOUT] resource effects unknown; reconcile launch intent before retry')
        sys.exit(75)

    if worker.returncode != 0:
        try:
            from herdr.workspace_trust import (
                is_trust_required_failure as _is_trust_failure,
                merge_trust_failure_unhealthy as _merge_trust_unhealthy,
            )
            _worker_output = (worker.stderr or "") + "\n" + (worker.stdout or "")
            if _is_trust_failure(_worker_output):
                _wf_record = store.get_workflow(args.workflow_id) or {}
                _unhealthy, _healthy = _merge_trust_unhealthy(_wf_record, resolved_agent)
                store.update_workflow_metadata(args.workflow_id, {
                    "healthy_agents": _healthy, "unhealthy_agents": _unhealthy,
                })
                try:
                    from herdr.state_store import sync_workflows_projection
                    sync_workflows_projection(store=store)
                except Exception:
                    pass
                print(f"[ROUTER HEALTH] {resolved_agent} marked TRUST_REQUIRED; "
                      f"auto retry will pick another agent")
        except Exception as exc:
            print(f"[ROUTER HEALTH WARN] trust failure write-back failed: {exc}")
        for line in worker.stderr.splitlines():
            if line.startswith("HERDR_WORKER_FAILURE="):
                try:
                    failure = json.loads(line.split("=", 1)[1])
                    if failure.get("task_id") == args.task_id and failure.get("run_id") == run_id:
                        if failure.get("recovery_required") is False and failure.get("disposition") in ("rolled_back", "pane_reclaimed"):
                            from herdr.task_resources import abort_launch_intent
                            abort_launch_intent(store, launch_intent, reason=failure.get("failure_type", "worker_startup_failed"))
                        else:
                            from herdr.task_resources import record_launch_resources
                            launch_intent = record_launch_resources(store, launch_intent, {
                                'pane_id': failure.get('pane_id'), 'clone_path': failure.get('clone'),
                                'run_id': run_id, 'agent_session_id': failure.get('agent_session_id'),
                                'agent_name': failure.get('agent_name'), 'ownership': 'unknown',
                                'recovery_required': True, 'allocation_failed': True,
                            })
                            _get_store().record_event("launch_recovery_required", failure,
                                workflow_id=args.workflow_id, node_id=node_id, task_id=args.task_id,
                                run_id=run_id, source="herdr-task")
                except (ValueError, TypeError):
                    pass
        print(
            "Worker failed:",
            worker.stderr.strip()
            or worker.stdout.strip()
        )
        sys.exit(1)

    worker_result = None

    for line in worker.stdout.splitlines():
        if line.startswith("HERDR_WORKER_RESULT="):
            worker_result = json.loads(
                line.split("=", 1)[1]
            )
            break

    if not worker_result:
        print("Worker result not found")
        print(worker.stdout)
        sys.exit(1)

    from herdr.task_resources import record_launch_resources
    launch_intent = record_launch_resources(store, launch_intent, {
        "clone_path": worker_result.get("clone"), "pane_id": worker_result.get("pane_id"),
        "pane_source": worker_result.get("pane_source", "dynamic"), "run_id": run_id,
        "agent_session_id": worker_result.get("agent_session_id"),
    })

    clone_path = worker_result["clone"]
    branch = worker_result["branch"]
    try:
        ensure_branch_available(
            branch,
            data.get("tasks", []),
            task_id=args.task_id,
        )
    except BranchOwnershipError as exc:
        print(f"[BRANCH OWNERSHIP ERROR] {exc}")
        sys.exit(2)
    baseline_untracked = worker_result.get(
        "baseline_untracked",
        []
    )
    baseline_fingerprint = worker_result.get(
        "baseline_fingerprint",
        {
            "tracked": {},
            "untracked": {}
        }
    )
    baseline_commit = worker_result.get("baseline_commit")
    recorded_onto = worker_result.get("onto_branch", onto_branch)
    pane_id = worker_result["pane_id"]
    pane_source = worker_result.get("pane_source", "dynamic")
    # FR-6.2: test/review must be based on a recorded candidate when a
    # delivery identity exists. Fail-closed: mismatch or unprovable
    # baseline rejects the launch (exit 2, actionable). No delivery yet
    # -> router isolation (FR-6.1) is the guard; no silent pass is claimed.
    if node_id in ("test", "review"):
        try:
            _validate_test_review_baseline(args, baseline_commit, source_repo)
        except SystemExit:
            # Fail-closed refusal happens AFTER the pane and clone exist but
            # BEFORE the task is registered, so a retry would otherwise
            # accumulate orphan clones, panes, and agent reservations with no
            # task record to account for them (AGENTS.md §4.6/§4.11).
            _reclaim_unregistered_launch_resources(
                args, clone_path=clone_path, pane_id=pane_id,
                pane_source=pane_source,
            )
            raise
        except (ImportError, AttributeError, OSError, ValueError, RuntimeError,
                sqlite3.Error, subprocess.SubprocessError) as exc:
            _reclaim_unregistered_launch_resources(
                args, clone_path=clone_path, pane_id=pane_id,
                pane_source=pane_source,
            )
            try:
                _get_store().record_event(
                    "test_baseline_rejected",
                    {"stage": node_id, "failure_code": "baseline_check_unavailable",
                     "detail": str(exc)[:300], "actionable": True,
                     "remediation": "repair workflow delivery metadata and relaunch"},
                    workflow_id=args.workflow_id, node_id=node_id,
                    task_id=args.task_id, source="herdr-task",
                )
            except (OSError, ValueError, RuntimeError, AttributeError,
                    sqlite3.Error) as event_exc:
                print(
                    f"[BASELINE EVENT WARN] could not persist rejection: {event_exc}",
                    file=sys.stderr,
                )
            print(
                f"[BASELINE REJECTED] could not prove test/review baseline: {exc}; "
                "launch refused (FR-6.2 fail-closed)."
            )
            sys.exit(2)

    # P1-3 (PR #110 round-2): selective replacement binds `--onto` +
    # `--candidate-sha` to a frozen baseline; the branch may have advanced
    # after the freeze, so the actual checkout HEAD (baseline_commit) must
    # still equal the claim. Fresh-branch launches (no --onto) create new
    # work and skip. test/review keep their own gate above.
    # NOTE: baseline_commit is deliberately NOT part of the gate condition:
    # a missing baseline must enter the validator (fail-closed) instead of
    # silently skipping it — otherwise the task would be registered with
    # candidate_sha=AAA and no proof it ever started from AAA.
    _selective_claim = str(getattr(args, "candidate_sha", None) or "").strip()
    if node_id not in ("test", "review") and _selective_claim and onto_branch:
        try:
            _validate_selective_replacement_baseline(
                args, _selective_claim, baseline_commit, source_repo)
        except SystemExit:
            _reclaim_unregistered_launch_resources(
                args, clone_path=clone_path, pane_id=pane_id,
                pane_source=pane_source,
            )
            raise
        except (ImportError, AttributeError, OSError, ValueError, RuntimeError,
                sqlite3.Error, subprocess.SubprocessError) as exc:
            _reclaim_unregistered_launch_resources(
                args, clone_path=clone_path, pane_id=pane_id,
                pane_source=pane_source,
            )
            try:
                _get_store().record_event(
                    "selective_baseline_rejected",
                    {"stage": node_id, "failure_code": "baseline_check_unavailable",
                     "detail": str(exc)[:300], "actionable": True,
                     "remediation": "repair workflow delivery metadata and relaunch"},
                    workflow_id=args.workflow_id, node_id=node_id,
                    task_id=args.task_id, source="herdr-task",
                )
            except (OSError, ValueError, RuntimeError, AttributeError,
                    sqlite3.Error) as event_exc:
                print(
                    f"[BASELINE EVENT WARN] could not persist rejection: {event_exc}",
                    file=sys.stderr,
                )
            print(
                f"[BASELINE REJECTED] could not prove replacement baseline: {exc}; "
                "launch refused (selective-replan fail-closed)."
            )
            sys.exit(2)

    print(f"[WORKER] clone={clone_path}")
    print(f"[WORKER] pane={pane_id}")
    print(f"[WORKER] pane_source={pane_source}")
    print(f"[WORKER] agent={resolved_agent} requested={requested_agent}")

    # 2. 初始化工位自优化微循环 (.herdr-loop)
    _loop_refusal = auto_init_task_loop(
        clone_path,
        args.goal,
        args.acceptance,
        test_cmd=getattr(args, "test_cmd", None),
        lint_cmd=getattr(args, "lint_cmd", None),
        repro_cmd=getattr(args, "repro_cmd", None),
        node=node_id,
        task_type=args.task_type,
    )
    if _loop_refusal:
        # C05b: 缺显式契约且栈歧义时拒绝启动——宁可失败也不跑错测试。
        _refuse_loop_launch(
            args, _loop_refusal, clone_path=clone_path,
            pane_id=pane_id, pane_source=pane_source,
        )

    # 3. 注册 Task
    data = load_tasks()

    now = _now()

    # RuntimeState:只记录本次真实执行的位置证据,不改变任务编排字段。
    try:
        from herdr import runtime_state as _runtime_state
    except ImportError:
        _runtime_state = None

    runtime = None
    if _runtime_state is not None:
        runtime = _runtime_state.build_runtime_state(
            agent=resolved_agent,
            agent_session_id=worker_result.get("agent_session_id"),
            agent_name=worker_result.get("agent_name"),
            workspace_id=workspace_id,
            tab_id=stage_config.get("tab_id"),
            pane_id=pane_id,
            cwd=clone_path,
            status="running",
            now=now,
        )

    launch_delivery_identities = []
    if source_repo:
        try:
            from herdr.review_closure import _path_delivery_identities
            launch_delivery_identities = _path_delivery_identities(source_repo)
        except Exception:
            launch_delivery_identities = []

    task = {
        "task_id": args.task_id,
        "workflow_id": args.workflow_id,
        "run_id": run_id,
        "project_id": project.get("project_id"),
        "project_name": project.get("project_name"),
        "source_repo": source_repo,
        "delivery_identities": launch_delivery_identities,
        "base_branch": base_branch,
        "coordinator_pane_id": project.get("coordinator_pane_id"),
        "workflow_config": project.get("workflow_file"),
        "node": node_id,
        "node_label": stage_config.get("node_label") or stage_config.get("stage_label", ""),
        "stage": node_id,
        "stage_label": stage_config.get("stage_label") or stage_config.get("node_label", ""),
        "tab_id": stage_config["tab_id"],
        "workspace_id": workspace_id,
        "pane_id": pane_id,
        "pane_source": pane_source,
        "pane_persistent": True,
        "agent": resolved_agent,
        "requested_agent": requested_agent,
        "clone_path": clone_path,
        "branch": branch,
        "baseline_commit": baseline_commit,
        "onto_branch": onto_branch,
        "baseline_untracked": baseline_untracked,
        "baseline_fingerprint": baseline_fingerprint,
        "baseline_commit": baseline_commit,
        "onto_branch": recorded_onto,
        "integration_mode": args.integration_mode,
        "artifact_mode": args.artifact_mode,
        "dispatch_role": args.dispatch_role,
        "dispatch_round": args.dispatch_round,
        "launch_intent_id": launch_intent['intent_id'],
        "task_type": args.task_type,
        "status": "pending",
        "goal": args.goal,
        "acceptance_criteria": args.acceptance,
        "candidate_episode_id": project.get("candidate_episode_id"),
    }
    # Enterprise experience attribution: persist only when provided so legacy
    # records stay byte-identical.
    if getattr(args, "customer", None):
        task["customer"] = str(args.customer).strip()
    if getattr(args, "business_task_type", None):
        task["business_task_type"] = str(args.business_task_type).strip()
    if getattr(args, "mandatory_experience_rules", False):
        task["mandatory_experience_rules"] = True
    replay_of = getattr(args, "replay_of", None)
    if replay_of:
        task["replay_of"] = replay_of
    # Scheduler v1:冻结候选版本绑定(只做持久化,不改变任何派发语义)。
    bound_sha = str(getattr(args, "candidate_sha", None) or "").strip()
    if bound_sha:
        task["candidate_sha"] = bound_sha
    _apply_execution_identity(task, args)
    if launch_intent.get('dispatch_operation_id') is not None:
        task['dispatch_operation_id'] = launch_intent['dispatch_operation_id']
        if launch_intent.get('supersedes'):
            task['supersedes'] = launch_intent['supersedes']
    if raw_policy:
        task["agent_policy"] = agent_policy
    if exec_fields["execution_mode"] == "context":
        # Git 模式任务记录保持字节级不变；context 附加字段仅在 context 模式出现。
        task["execution_mode"] = "context"
        task["context"] = exec_fields.get("context") or {}
    if runtime is not None:
        task["runtime"] = runtime
    _init_status_history(
        task,
        "pending",
        now,
    )

    is_gate = False
    if node:
        if node.get("gate") or node.get("node_type") == "gate":
            is_gate = True
        elif node.get("node_type") in ("agent", "implementation", "worker", "code"):
            is_gate = False
        else:
            is_gate = _is_gate_task(task)
    else:
        is_gate = _is_gate_task(task)
    if is_gate:
        task["gate"] = True

    if node.get("delivery_contract") is not None:
        from herdr.task_delivery import validate_contract
        task["delivery_contract"] = validate_contract(node["delivery_contract"])

    if committed_recovery:
        task.update(recovery_predecessor=predecessor['task_id'],
                    expected_predecessor_version=predecessor['version'],
                    expected_predecessor_sha=predecessor['commit'])
    store.save_task(task)

    from herdr.task_resources import finish_launch_intent
    finish_launch_intent(store, launch_intent)

    trajectory_ledger = TrajectoryLedger(getattr(_get_store(), "db_path", None))
    record_trajectory_event_best_effort(
        task, "run_started", ledger=trajectory_ledger, status="pending"
    )
    record_trajectory_event_best_effort(
        task, "task_started", ledger=trajectory_ledger, status="pending"
    )
    record_trajectory_event_best_effort(
        task,
        "agent_started",
        ledger=trajectory_ledger,
        status=(task.get("runtime") or {}).get("status") or "running",
    )

    release_agent_reservation(
        args.task_id
    )

    print(f"[REGISTERED] {args.task_id}")

    # 4. Dispatch
    dispatch_task(
        args.task_id,
        args.prompt,
        prefetched_experience_suffix=_prefetched_experience_suffix,
        prefetched_experience_refs=_prefetched_experience_refs,
    )
    # Retire the previous Task only after the replacement was registered and
    # delivered. Validation or worker startup failures retain its ownership.
    if getattr(args, "supersedes", None):
        if committed_recovery:
            _finish_committed_recovery_launch(store, store.get_task(args.task_id), predecessor, args.supersede_reason)
        else:
            supersede_task(args.supersedes, new_task_id=args.task_id,
                           reason=args.supersede_reason, allow_new_run=True)

def _finish_committed_recovery_launch(store, task, predecessor, reason):
    from herdr.recovery_successor import has_confirmed_delivery, link_committed_successor
    if not has_confirmed_delivery(store, task):
        print('[DISPATCH RECOVERY_REQUIRED] registered successor delivery unconfirmed; reconcile retained intent')
        sys.exit(2)
    if (task.get('recovery_predecessor') != predecessor['task_id']
            or task.get('expected_predecessor_sha') != predecessor.get('commit')
            or type(task.get('expected_predecessor_version')) is not int):
        raise ValueError('Recovery successor lacks captured predecessor identity')
    return link_committed_successor(store, predecessor['task_id'], task['task_id'],
        task['expected_predecessor_version'], task['expected_predecessor_sha'], reason)

def _apply_execution_identity(task, args):
    """Persist the caller's workflow execution identity on a launched Task.

    The per-task run_id stays independent; execution_id is the shared
    proof that sibling launches belong to one workflow execution.
    Absent flag preserves legacy tasks without execution identity.
    """
    execution_id = str(getattr(args, "execution_id", None) or "").strip()
    if execution_id:
        task["execution_id"] = execution_id


def _compile_working_context_ref(task):
    """Compile a launch-boundary context without changing task state."""
    try:
        from herdr.context_compiler import compile_working_context, infer_agent_role
        context = compile_working_context(
            workflow_id=task.get("workflow_id"),
            task_id=task.get("task_id"),
            agent_role=infer_agent_role(task),
            store=_get_store(),
        )
        return context.context_id
    except Exception as exc:
        print(f"[WORKING_CONTEXT SKIPPED] task={task.get('task_id')}: {type(exc).__name__}")
        return None


def _fetch_experience_rules_block(task):
    """Fetch active published enterprise business rules for this task."""
    try:
        # Best-effort background sync: never block dispatch on Hub I/O.
        # Single-flight daemon worker; overlapping dispatches skip.
        try:
            from herdr.experience.collector import trigger_background_sync
            trigger_background_sync()
        except Exception:
            pass
        from herdr.experience.client import fetch_experience_rules_block
        return fetch_experience_rules_block(task, store=_get_store())
    except Exception as exc:
        if task.get("mandatory_experience_rules"):
            raise RuntimeError(f"Experience Hub is unreachable but mandatory rules required: {exc}")
        return ""


def _prefetch_mandatory_rules(task):
    """Fetch mandatory experience rules before any dispatch side effect.

    Runs unconditionally for mandatory tasks: receipt-style tasks carry run_id
    from creation, so gating on it would silently skip the check while the
    later fetch still fail-closes. Returns the prompt suffix (may be "").
    """
    return _fetch_experience_rules_block(task)


def _mandatory_experience_gate(args, node_id):
    """Fail closed on an unreachable Hub before any launch resource exists.

    Must run before the worker allocates a clone/pane and before the task is
    persisted: a failure after registration leaves a pending task whose retry
    is consumed by the duplicate check, never dispatching it. The task context
    is synthesized from validated args (the task is not registered yet, so no
    store metadata can be written). The returned block is handed to
    dispatch_task so the mandatory task is never queried twice — a second
    fail-closed query after allocation would recreate the stranded task this
    gate exists to prevent. Applied-rule metadata is recorded by the launcher
    once the task is registered.
    """
    if not getattr(args, "mandatory_experience_rules", False):
        return None, []
    context = {
        "task_id": getattr(args, "task_id", None),
        "customer": getattr(args, "customer", None),
        "business_task_type": getattr(args, "business_task_type", None),
        "task_type": getattr(args, "task_type", None),
        "stage": node_id,
        "node": node_id,
        "mandatory_experience_rules": True,
    }
    try:
        from herdr.experience.client import fetch_experience_rules_block as _fetch_block
        refs: List[Dict[str, Any]] = []
        block = _fetch_block(context, references=refs)
        return block, refs
    except Exception as exc:
        print(
            "[EXPERIENCE GATE] mandatory experience rules could not be resolved "
            f"before allocating launch resources: {exc}",
            file=sys.stderr,
        )
        raise


def dispatch_task(task_id, prompt, prefetched_experience_suffix=None,
                  prefetched_experience_refs=None):
    # Reliable delivery protocol:
    # 1) try herdr agent prompt
    # 2) verify lifecycle / prompt marker
    # 3) if prompt is sitting in the composer, focus + Enter
    # 4) if it never arrived, focus + send-text + delayed Enter
    data = load_tasks()
    task = find_task(data, task_id)

    if not task:
        print(f"Task not found: {task_id}")
        sys.exit(1)

    receipt_delivery = bool(task.get("run_id"))
    if task["status"] != "pending" and not (receipt_delivery and task["status"] == "dispatched"):
        print(
            f"Task cannot dispatch from status: "
            f"{task['status']}; use herdr-task rework {task_id} --prompt '<repair instructions>' for the same owned execution"
        )
        sys.exit(2)

    # Fail-closed: mandatory rules must resolve before marking dispatched,
    # otherwise Hub outage would leave a false dispatched state with no
    # instructions delivered. Unconditional: run_id is assigned at creation,
    # so a receipt_delivery condition would skip this for every normal task.
    # A block already resolved by the pre-allocation gate wins: re-querying
    # here would re-open the stranded-task window this gate closed, so an
    # outage between the two must not abort an already-authorized dispatch.
    if prefetched_experience_suffix is not None:
        _prefetched_experience_suffix = prefetched_experience_suffix
        _prefetched_experience = True
        # The gate ran before registration, so attribution was not written.
        # Persist it now that the task exists, or a dispatch under specific
        # rule versions keeps no record of which rules applied.
        if prefetched_experience_refs:
            try:
                _store = _get_store()
                if hasattr(_store, "update_task_metadata"):
                    meta = dict(task.get("metadata") or {})
                    meta["applied_experience_rules"] = prefetched_experience_refs
                    _store.update_task_metadata(task_id, meta)
            except (OSError, ValueError, RuntimeError, AttributeError, KeyError):
                pass
    else:
        _prefetched_experience_suffix = None
        _prefetched_experience = False
        if task.get("mandatory_experience_rules"):
            _prefetched_experience_suffix = _prefetch_mandatory_rules(task)
            _prefetched_experience = True

    # Runtime closure: the dispatched transition happens before context
    # compilation and prompt delivery, so the compiled context never
    # carries a stale pending task_status.
    if not receipt_delivery:
        set_status(task_id, "dispatched")
    task = find_task(load_tasks(), task_id)
    if not task:
        print(f"Task not found after dispatch transition: {task_id}")
        sys.exit(1)

    import shlex
    from herdr.workflow_docs import cli_path
    artifact_task = shlex.quote(str(cli_path()))
    artifact_loop = shlex.quote(str(cli_path().with_name('herdr-loop')))
    loop_dir = Path(task.get("clone_path", "")) / ".herdr-loop"
    loop_suffix = ""
    if loop_dir.exists():
        loop_suffix = (
            "\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"
            + "【工位内循环铁律 - Inner Loop Protocol】\n"
            + "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"
            + "工位已装配量化评估环境，请严格遵循以下工作法则：\n\n"
            + "【正常完成流程】\n"
            + "1. 阅读 .herdr-loop/GOAL.md 了解目标契约与验收标准；\n"
            + "2. 实现或修改代码；\n"
            + f"3. 运行自检评估：{artifact_loop} eval\n"
            + "   → 查看 .herdr-loop/EVALUATION.md 了解失败原因；\n"
            + "4. 若自检未通过（得分 < 100.0），继续就地修改，回到步骤 2；\n"
            + "5. 自检 100% 通过后，方可输出完成标记。\n\n"
            + "【铁律禁止项】\n"
            + "❌ 严禁在自检未通过前输出完成标记（HERDR_TASK_DONE）；\n"
            + "❌ 严禁在自检未通过时放弃工位或声称无法继续；\n"
            + "❌ 严禁向上层汇报局部问题（如单个语法错误）—— 工位负责就地解决；\n\n"
            + "【熔断求助流程（连续自愈失败≥3次）】\n"
            + "若遇到外部依赖或环境障碍导致连续 3 次自愈仍未通过，执行以下步骤：\n"
            + f"1. 运行 {artifact_loop} eval 更新最终评分；\n"
            + "2. 检查 .herdr-loop/STATE.md，若 status=exhausted，说明已达上限；\n"
            + "3. 在终端输出求助总结（包含复现路径与阻碍点）；\n"
            + "4. 在终端单独输出一行：HERDR_TASK_BLOCKER:" + task_id + "\n"
            + "   （表示工位主动请求总指挥仲裁，等待外部指示）；\n"
            + "5. 不要输出 HERDR_TASK_DONE，静默等待。\n"
        )

    context_suffix = ""
    if task.get("execution_mode") == "context":
        block = render_context_reference_block(task.get("context") or {})
        if block:
            context_suffix = "\n\n" + block + "\n"

    working_context_ref = _compile_working_context_ref(task)
    working_context_suffix = ""
    if working_context_ref:
        working_context_suffix = (
            "\n\nWORKING_CONTEXT REF:\n"
            f"WORKING_CONTEXT_REF:{working_context_ref}\n"
            "Load this immutable context by reference before continuing:\n"
            f"{artifact_task} working-context get --context-id {working_context_ref}\n"
        )

    experience_rules_suffix = _prefetched_experience_suffix if _prefetched_experience else _fetch_experience_rules_block(task)

    checkpoint_suffix = ""
    completion_suffix = "" if receipt_delivery else (
        "When all requested work is finished, output on its own line "
        "the prefix HERDR_TASK_DONE: followed immediately by this task id.\n")

    prompt = (
        (f"WORKER_WRITE_ROOT: {task['clone_path']}\n"
         "业务相对路径以此目录为根；来源项目路径仅供定位，业务产物写入本工位克隆。\n"
         "共享报告使用工作流受管文档接口发布；不要把来源目录文件视为本 Task 的产物。\n\n"
         if task.get("clone_path") and task.get("execution_mode") != "context" else "")
        + prompt
        + context_suffix
        + working_context_suffix
        + experience_rules_suffix
        + loop_suffix
        + checkpoint_suffix
        + "\nHERDR orchestration protocol:\n"
        + "HERDR_ORCH_TASK:" + task_id + "\n"
        + completion_suffix
    )

    # T3b prompt hygiene (FR-1.3): strip literal task-id markers from every
    # upstream source at the single delivery choke point. The orchestration
    # protocol above intentionally carries no task-id marker.
    try:
        from herdr import completion as _completion

        prompt, _sanitized_n = _completion.sanitize_prompt(prompt, task_id)
        if _sanitized_n:
            try:
                _get_store().record_event(
                    "prompt_marker_sanitized",
                    {"task_id": task_id, "replaced": _sanitized_n},
                    workflow_id=task.get("workflow_id"),
                    node_id=task.get("node") or task.get("stage"),
                    task_id=task_id,
                    source="herdr-task",
                )
            except (OSError, ValueError, RuntimeError, AttributeError):
                pass
            print(f"[PROMPT HYGIENE] task={task_id} sanitized_markers={_sanitized_n}")
    except (ImportError, AttributeError):
        pass

    if not receipt_delivery:
        from herdr.task_delivery import instruction_block
        prompt += instruction_block(task)

    if receipt_delivery:
        from herdr.supervisor_delivery import deliver, DeliveryUnknown
        from herdr import state_db
        store = _get_store()
        if task['status'] == 'dispatched' and not store.list_events(
                task_id=task_id, event_type='initial_dispatch_prepared', source='herdr-task', limit=1):
            raise DeliveryUnknown('INITIAL', 'initial:' + task['run_id'])
        def prepare_task(conn):
            current = state_db._decode_task_row(conn.execute('SELECT * FROM tasks WHERE task_id=?', (task_id,)).fetchone())
            result = state_db.transition_task(task_id, 'dispatched', source='herdr-task',
                reason='initial_delivery_prepared', expected_status=current['status'],
                expected_version=current['version'], conn=conn)
            if not result.get('accepted'):
                raise ValueError('Task changed before prepared delivery')
        def send(pane, text):
            from herdr.supervisor_delivery import current_delivery_task
            pane = current_delivery_task(task, store, native=True)['pane_id']
            result = subprocess.run(['herdr', 'agent', 'prompt', str(pane), text],
                text=True, capture_output=True, timeout=PROMPT_DELIVERY_TIMEOUT)
            if result.returncode != 0:
                raise RuntimeError('Initial native prompt transport failed')
        return deliver(task, store, 'INITIAL', {'intervention_id':'initial:' + task['run_id'],
                       'action':'INITIAL'}, prompt, send, prepare_task=prepare_task)

    pane_id = task["pane_id"]
    marker = "HERDR_ORCH_TASK:" + task_id

    def _run(cmd, timeout=None):
        try:
            return subprocess.run(
                cmd,
                text=True,
                capture_output=True,
                timeout=timeout,
            )
        except subprocess.TimeoutExpired as exc:
            return subprocess.CompletedProcess(
                cmd, 124, "", f"command timed out after {timeout}s: {exc}"
            )

    def _status():
        r = _run(["herdr", "agent", "get", pane_id])
        if r.returncode != 0:
            return None
        try:
            return json.loads(r.stdout)["result"]["agent"].get("agent_status")
        except Exception:
            return None

    def _visible():
        r = _run([
            "herdr", "pane", "read",
            pane_id,
            "--source", "visible"
        ])
        return (r.stdout or "") + "\n" + (r.stderr or "")

    def _focus():
        _run(["herdr", "agent", "focus", pane_id])
        time.sleep(0.25)

    def _press_enter():
        return _run([
            "herdr", "pane", "send-keys",
            pane_id, "enter"
        ])

    def _send_full_prompt():
        _focus()
        r1 = _run([
            "herdr", "pane", "send-text",
            pane_id, prompt
        ])
        time.sleep(0.35)
        r2 = _press_enter()
        return r1.returncode == 0 and r2.returncode == 0

    # Clear previous conversation context before dispatching new task.
    # Sends /clear to reset agent history so each task starts with a clean slate.
    _run(["herdr", "agent", "focus", pane_id])
    time.sleep(0.25)
    _run(["herdr", "pane", "send-text", pane_id, "/clear"])
    _run(["herdr", "pane", "send-keys", pane_id, "enter"])
    print(f"[CONTEXT CLEAR] task={task_id} pane={pane_id}")

    # Wait for /clear to complete (agent returns to idle)
    clear_deadline = time.time() + 8
    while time.time() < clear_deadline:
        state = _status()
        if state in {"idle", None}:
            break
        time.sleep(0.4)

    time.sleep(1.5)

    primary = _run(
        [
            "herdr",
            "agent",
            "prompt",
            pane_id,
            prompt,
        ],
        timeout=PROMPT_DELIVERY_TIMEOUT,
    )
    if primary.returncode == 124:
        print(f"[PROMPT TIMEOUT] task={task_id} pane={pane_id} after={PROMPT_DELIVERY_TIMEOUT}s")

    deadline = time.time() + 6
    while time.time() < deadline:
        state = _status()
        screen = _visible()

        if state in {"working", "blocked", "done"}:
            print(f"[PROMPT DELIVERED] task={task_id} via=agent-prompt state={state}")
            print(f"Task dispatched: {task_id} -> {pane_id}")
            return

        if marker in screen and state in {"idle", "unknown", None}:
            _focus()
            _press_enter()
            time.sleep(1.0)

            state2 = _status()
            if state2 in {"working", "blocked", "done"}:
                print(f"[PROMPT DELIVERED] task={task_id} via=enter-fallback state={state2}")
                print(f"Task dispatched: {task_id} -> {pane_id}")
                return

        time.sleep(0.5)

    if marker not in _visible():
        ok = _send_full_prompt()
        if not ok:
            set_status(task_id, "failed")
            print(
                f"Prompt delivery failed for {task_id}: "
                f"{primary.stderr or primary.stdout}"
            )
            sys.exit(3)
        print(f"[PROMPT FALLBACK] task={task_id} via=send-text+enter")
    else:
        print(f"[PROMPT PENDING] task={task_id} marker-visible; sentinel will monitor")

    print(f"Task dispatched: {task_id} -> {pane_id}")


from herdr.repo_hygiene import INTERNAL_EXACT as INTERNAL_UNTRACKED_EXACT, INTERNAL_PREFIXES as INTERNAL_UNTRACKED_PREFIXES


def _is_internal_untracked(path):
    from herdr.workspace_fingerprint import is_internal_untracked
    return is_internal_untracked(path, INTERNAL_UNTRACKED_EXACT,
                                 INTERNAL_UNTRACKED_PREFIXES)


def fingerprint_file(repo, relpath):
    from herdr.workspace_fingerprint import fingerprint_file as fingerprint
    return fingerprint(repo, relpath)


def current_workspace_fingerprint(repo):
    from herdr.workspace_fingerprint import current_workspace_fingerprint as fingerprint
    return fingerprint(repo, is_internal_untracked=_is_internal_untracked,
                       fingerprint_file=fingerprint_file)


def execution_fields_from_workflow(workflow_record):
    from herdr.workspace_fingerprint import execution_fields_from_workflow as fields
    return fields(workflow_record, execution_mode=execution_mode)


def context_workspace_fingerprint(repo):
    from herdr.workspace_fingerprint import context_workspace_fingerprint as fingerprint
    return fingerprint(repo, is_internal_untracked=_is_internal_untracked,
                       fingerprint_file=fingerprint_file)


def verify_baseline(task_id):
    from herdr.task_cli_verification import verify_baseline as verify
    return verify(task_id, load_tasks=load_tasks, find_task=find_task,
                  _git_head_sha=_git_head_sha,
                  _git_interval_commits=_git_interval_commits,
                  context_workspace_fingerprint=context_workspace_fingerprint,
                  current_workspace_fingerprint=current_workspace_fingerprint)


def verify_metrics(task_id, min_score=99.9, if_present=False):
    from herdr.task_cli_verification import verify_metrics as verify
    return verify(task_id, min_score, if_present,
                  load_tasks=load_tasks, find_task=find_task)


def differential_test(args):
    from herdr.task_cli_verification import differential_test as handle
    return handle(args)


def bypass_gate_cli(task_id, reason, operator="human", note=None, as_json=False):
    """Universal human-in-the-loop gate bypass CLI entrypoint."""
    from herdr import kernel
    try:
        res = kernel.bypass_task_gate(task_id, reason=reason, operator=operator, note=note)
        if as_json:
            print(json.dumps(res, indent=2, ensure_ascii=False))
            return 0
        print(
            f"[GATE BYPASS] task={task_id} bypass_id={res.get('bypass_id')} "
            f"verdict={res.get('previous_verdict')} -> {res.get('stage_verdict')} "
            f"status={res.get('previous_status')} -> {res.get('status')} "
            f"reason=\"{res.get('reason')}\" operator={res.get('operator')}"
        )
        print("HERDR_GATE_BYPASS_RESULT=" + json.dumps(res, ensure_ascii=False))
        return 0
    except Exception as exc:
        print(f"Error bypassing gate for task {task_id}: {exc}", file=sys.stderr)
        sys.exit(1)


def adopt_verdict_cli(task_id, verdict=None, note=None, operator="human", as_json=False):
    """Adopt gate verdict from gate-verdict file into task (productizing manual arbitration)."""
    data = load_tasks()
    task = find_task(data, task_id)
    if not task:
        print(f"Task not found: {task_id}", file=sys.stderr)
        sys.exit(1)

    if not _is_gate_task(task):
        print(f"Task {task_id} is not a gate task", file=sys.stderr)
        sys.exit(2)

    affected_ids = []
    if not verdict:
        ok, res_or_err = _authenticate_gate_verdict_evidence(task)
        if not ok:
            print(f"No valid gate verdict found for task {task_id}", file=sys.stderr)
            sys.exit(2)
        verdict, file_note, affected_ids, _ = res_or_err
        note = note or file_note
    else:
        ok, res_or_err = _authenticate_gate_verdict_evidence(task, expected_verdict=verdict)
        if not ok:
            print(f"[ADOPT VERDICT REFUSED] task {task_id}: {res_or_err}", file=sys.stderr)
            sys.exit(2)
        _, file_note, file_aff, _ = res_or_err
        note = note or file_note
        if verdict == "blocked" and file_aff and not affected_ids:
            affected_ids = file_aff

    if not verdict or verdict not in ("pass", "blocked"):
        print(f"No valid gate verdict found for task {task_id}", file=sys.stderr)
        sys.exit(2)

    if verdict == "blocked" and not (note or "").strip():
        note = f"gate verdict blocked (adopted by {operator})"

    old_status = task.get("status")
    set_status(
        task_id,
        "completed",
        verdict=verdict,
        note=note,
        affected_task_ids=affected_ids if affected_ids else None,
        skip_operator=operator,
    )

    result = {
        "task_id": task_id,
        "status": "completed",
        "previous_status": old_status,
        "verdict": verdict,
        "note": note,
        "affected_task_ids": affected_ids,
        "operator": operator,
    }
    if as_json:
        print(json.dumps(result, ensure_ascii=False, indent=2))
    else:
        print(
            f"[GATE VERDICT ADOPTED] task={task_id} status={old_status} -> completed "
            f"verdict={verdict} note=\"{note}\""
        )
        print("HERDR_GATE_ADOPT_RESULT=" + json.dumps(result, ensure_ascii=False))
    return 0


def _with_git_operation_lock(*, include_source_repo=False):
    """Serialize Git operations and fail closed while another Git process runs."""
    def decorate(func):
        @wraps(func)
        def wrapped(task_id, *args, **kwargs):
            task = find_task(load_tasks(), task_id)
            paths = []
            if task and task.get("clone_path"):
                paths.append(task["clone_path"])
            if include_source_repo and task:
                project = project_for_workflow(task.get("workflow_id")) or {}
                source = task.get("source_repo") or project.get("project_root")
                if source:
                    paths.append(source)
            try:
                with ExitStack() as stack:
                    locks = []
                    for path in dict.fromkeys(paths):
                        lock = GitOperationLock(path)
                        lock.acquire()
                        stack.callback(lock.release)
                        locks.append(path)
                    for path in locks:
                        ensure_no_git_processes(path)
                    return func(task_id, *args, **kwargs)
            except (GitOperationBusyError, GitProcessActiveError) as exc:
                print(f"[GIT BUSY] task={task_id}: {exc}")
                sys.exit(75)
        return wrapped
    return decorate


def launch_task(args):
    """Serialize the workflow budget check through task registration across sources."""
    from herdr.task_resources import workflow_launch_lock, NodeLaunchBusy, record_launch_rejection
    source = getattr(args, "source", None)
    entered = False

    def run_launch():
        nonlocal entered
        entered = True
        try:
            return _launch_task(args)
        except BaseException:
            settled = record_launch_rejection(_get_store(), args, reason='launch_preallocation_rejected',
                resources_absent=not getattr(args, '_launch_resources_started', False))
            if settled and getattr(args, '_launch_reservation_acquired', False):
                release_agent_reservation(args.task_id)
            raise

    try:
        with workflow_launch_lock(_get_store().db_path, args.workflow_id):
            if not source:
                return run_launch()
            with GitOperationLock(source):
                ensure_no_git_processes(source)
                return run_launch()
    except (GitOperationBusyError, GitProcessActiveError, NodeLaunchBusy) as exc:
        if not entered:
            record_launch_rejection(_get_store(), args, reason='launch_lock_busy', resources_absent=True)
        print(f"[LAUNCH BUSY] {exc}")
        sys.exit(75)


