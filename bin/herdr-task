    return fetch_experience_rules_block(task, get_store=_get_store)


def _prefetch_mandatory_rules(task):
    """Fetch mandatory experience rules before any dispatch side effect.

    Runs unconditionally for mandatory tasks: receipt-style tasks carry run_id
    from creation, so gating on it would silently skip the check while the
    later fetch still fail-closes. Returns the prompt suffix (may be "").
    """
    from herdr.task_cli_execution import prefetch_mandatory_rules
    return prefetch_mandatory_rules(task, get_store=_get_store)


def _mandatory_experience_gate(args, node_id):
    """Fail closed on an unreachable Hub before any launch resource exists.

    Must run before the worker allocates a clone/pane and before the task is
    persisted: a failure after registration leaves a pending task whose retry
    is consumed by the duplicate check, never dispatching it. The task context
    is synthesized from validated args (the task is not registered yet, so no
    store metadata can be written). The returned block is handed to
    dispatch_task so the mandatory task is never queried twice — a second
    fail-closed query after allocation would recreate the stranded task this
    gate exists to prevent. Applied-rule metadata is recorded by the launcher
    once the task is registered.
    """
    from herdr.task_cli_execution import mandatory_experience_gate
    return mandatory_experience_gate(args, node_id)


