    return verify(task_id, min_score, if_present,
                  load_tasks=load_tasks, find_task=find_task)


def differential_test(args):
    from herdr.task_cli_verification import differential_test as handle
    return handle(args)


def bypass_gate_cli(task_id, reason, operator="human", note=None, as_json=False):
    """Universal human-in-the-loop gate bypass CLI entrypoint."""
    from herdr import kernel
    try:
        res = kernel.bypass_task_gate(task_id, reason=reason, operator=operator, note=note)
        if as_json:
            print(json.dumps(res, indent=2, ensure_ascii=False))
            return 0
        print(
            f"[GATE BYPASS] task={task_id} bypass_id={res.get('bypass_id')} "
            f"verdict={res.get('previous_verdict')} -> {res.get('stage_verdict')} "
            f"status={res.get('previous_status')} -> {res.get('status')} "
            f"reason=\"{res.get('reason')}\" operator={res.get('operator')}"
        )
        print("HERDR_GATE_BYPASS_RESULT=" + json.dumps(res, ensure_ascii=False))
        return 0
    except Exception as exc:
        print(f"Error bypassing gate for task {task_id}: {exc}", file=sys.stderr)
        sys.exit(1)


def adopt_verdict_cli(task_id, verdict=None, note=None, operator="human", as_json=False):
    from herdr.task_cli_status import adopt_task_verdict
    return adopt_task_verdict(
        task_id, verdict, note, operator, as_json,
        load_tasks=load_tasks, find_task=find_task, is_gate_task=_is_gate_task,
        authenticate_evidence=_authenticate_gate_verdict_evidence,
        set_task_status=set_status,
    )


def _with_git_operation_lock(*, include_source_repo=False):
    """Serialize Git operations and fail closed while another Git process runs."""
    def decorate(func):
        @wraps(func)
        def wrapped(task_id, *args, **kwargs):
            task = find_task(load_tasks(), task_id)
            paths = []
            if task and task.get("clone_path"):
                paths.append(task["clone_path"])
            if include_source_repo and task:
                project = project_for_workflow(task.get("workflow_id")) or {}
                source = task.get("source_repo") or project.get("project_root")
                if source:
                    paths.append(source)
            try:
                with ExitStack() as stack:
                    locks = []
                    for path in dict.fromkeys(paths):
                        lock = GitOperationLock(path)
                        lock.acquire()
                        stack.callback(lock.release)
                        locks.append(path)
                    for path in locks:
                        ensure_no_git_processes(path)
                    return func(task_id, *args, **kwargs)
            except (GitOperationBusyError, GitProcessActiveError) as exc:
                print(f"[GIT BUSY] task={task_id}: {exc}")
                sys.exit(75)
        return wrapped
    return decorate


def launch_task(args):
    """Serialize the workflow budget check through task registration across sources."""
    from herdr.task_resources import workflow_launch_lock, NodeLaunchBusy, record_launch_rejection
    source = getattr(args, "source", None)
    entered = False

    def run_launch():
        nonlocal entered
        entered = True
        try:
            return _launch_task(args)
        except BaseException:
            settled = record_launch_rejection(_get_store(), args, reason='launch_preallocation_rejected',
                resources_absent=not getattr(args, '_launch_resources_started', False))
            if settled and getattr(args, '_launch_reservation_acquired', False):
                release_agent_reservation(args.task_id)
            raise

    try:
        with workflow_launch_lock(_get_store().db_path, args.workflow_id):
            if not source:
                return run_launch()
            with GitOperationLock(source):
                ensure_no_git_processes(source)
                return run_launch()
    except (GitOperationBusyError, GitProcessActiveError, NodeLaunchBusy) as exc:
        if not entered:
            record_launch_rejection(_get_store(), args, reason='launch_lock_busy', resources_absent=True)
        print(f"[LAUNCH BUSY] {exc}")
        sys.exit(75)


def _capture_pane_transcript(pane):
    from herdr.task_cli_resources import capture_pane_transcript
    return capture_pane_transcript(pane, herdr=_herdr)


def cmd_reap(args):
    from herdr.task_cli_resources import handle_reap
    return handle_reap(args, get_store=_get_store, herdr=_herdr,
                       evidence_root=EVIDENCE_ROOT,
                       capture=_capture_pane_transcript)


def cmd_renew_completion(args):
    from herdr.task_cli_resources import handle_renew_completion
    return handle_renew_completion(args, get_store=_get_store, herdr=_herdr)

def _is_gate_cleanup_completed(task, delivery_id, store):
    """Check if a durable gate cleanup completion phase was already persisted for this delivery."""
    if not delivery_id or not store:
        return False
    from herdr import state_db
    conn = state_db.get_db_connection(store.db_path)
    try:
        row = conn.execute(
            "SELECT 1 FROM events WHERE task_id=? AND event_type='gate_cleanup_completed' AND json_extract(payload_json, '$.delivery_id')=? LIMIT 1",
            (task["task_id"], delivery_id),
        ).fetchone()
        return bool(row)
    finally:
        conn.close()


def _recover_unconsumed_gate_cleanup_id(task, store):
    """Recover existing gate cleanup operation ID when retrying a rework before delivery committed."""
    if not task or not store or not _is_gate_task(task):
        return None
    from herdr import state_db
    conn = state_db.get_db_connection(store.db_path)
    try:
        meta_id = task.get("rework_cleanup_id")
        if meta_id:
            dispatched = conn.execute(
                """
                SELECT 1 FROM events
                WHERE task_id=? AND json_extract(payload_json, '$.intervention_id')=? AND event_type IN ('rework_dispatched', 'rework_dispatch_prepared')
                LIMIT 1
                """,
                (task["task_id"], meta_id),
            ).fetchone()
            if not dispatched and not (task.get("rework_delivery") == "delivered" and task.get("execution_token") == meta_id):
                return meta_id

        row = conn.execute(
            """
            SELECT json_extract(payload_json, '$.delivery_id') AS delivery_id
            FROM events
            WHERE task_id=? AND (run_id=? OR ? IS NULL) AND event_type='gate_cleanup_completed'
            ORDER BY id DESC LIMIT 1
            """,
            (task["task_id"], task.get("run_id"), task.get("run_id")),
        ).fetchone()
        if not row or not row["delivery_id"]:
            return None
        candidate_id = row["delivery_id"]

        dispatched = conn.execute(
            """
            SELECT 1 FROM events
            WHERE task_id=? AND json_extract(payload_json, '$.intervention_id')=? AND event_type IN ('rework_dispatched', 'rework_dispatch_prepared')
            LIMIT 1
            """,
            (task["task_id"], candidate_id),
        ).fetchone()
        if dispatched:
            return None

        if task.get("rework_delivery") == "delivered" and (task.get("rework_request_id") == candidate_id or task.get("execution_token") == candidate_id):
            return None

        return candidate_id
    finally:
        conn.close()


def _cleanup_gate_for_rework(task, delivery_id=None, store=None):
    """PR #250 & Codex review: Stop old writer and purge prior verdicts for gate tasks in a two-phase recoverable cleanup."""
    if not _is_gate_task(task):
        return
    # If this delivery is already pending retry, skip interrupt side-effect
    if task.get("status") == "rework" and task.get("rework_delivery") == "pending" and not task.get("_force_cleanup"):
        return
    if not task.get("_force_cleanup") and store and delivery_id and _is_gate_cleanup_completed(task, delivery_id, store):
        # P1/P2: Completed cleanup phase was already persisted and executed for this delivery attempt.
        # Do not repeat C-c to avoid terminating work started after the first interruption.
        return
    # P1: Persist cleanup intent before issuing the pane interrupt side effect
    if store and delivery_id:
        store.record_event(
            "gate_cleanup_intent",
            {"delivery_id": delivery_id, "task_id": task["task_id"], "run_id": task.get("run_id")},
            task_id=task["task_id"],
            workflow_id=task.get("workflow_id"),
            run_id=task.get("run_id"),
            source="herdr-task",
        )
    from herdr.node_capacity import pane_reference
    pane_ref = pane_reference(task)
    if pane_ref:
        res = _herdr("pane", "send-keys", str(pane_ref), "C-c")
        # P1: Check returncode; abort rework if the pane interrupt fails so we never continue with an old writer running
        if res.returncode != 0:
            raise RuntimeError(f"Failed to interrupt gate pane {pane_ref} (exit {res.returncode}): {res.stderr or res.stdout}")
    candidates = _gate_verdict_file_candidates(task)

    for cand in candidates:
        if cand and os.path.exists(cand):
            try:
                os.remove(cand)
            except FileNotFoundError:
                pass
            except OSError as exc:
                raise RuntimeError(f"Failed to purge gate verdict file {cand}: {exc}") from exc
            if os.path.exists(cand):
                raise RuntimeError(f"Gate verdict file still exists after removal attempt: {cand}")
    # P1: Persist cleanup completion phase only after interrupt and purge succeed
    if store and delivery_id:
        store.record_event(
            "gate_cleanup_completed",
            {"delivery_id": delivery_id, "task_id": task["task_id"], "run_id": task.get("run_id")},
            task_id=task["task_id"],
            workflow_id=task.get("workflow_id"),
            run_id=task.get("run_id"),
            source="herdr-task",
        )


def cmd_rework(args):
    from herdr.task_cli_rework import handle_rework
    return handle_rework(
        args, get_store=_get_store, herdr=_herdr, is_gate_task=_is_gate_task,
        recover_unconsumed_gate_cleanup_id=_recover_unconsumed_gate_cleanup_id,
        cleanup_gate_for_rework=_cleanup_gate_for_rework, now=time.time,
    )


def _run_commit_index_command(task_id, clone, command):
    """Report native index contention without claiming or removing the lock."""
    def native_lock():
        resolved = subprocess.run(
            ["git", "-C", clone, "rev-parse", "--path-format=absolute", "--git-path", "index"],
            text=True, capture_output=True, check=False,
        )
        return Path(resolved.stdout.strip() + ".lock") if resolved.returncode == 0 and resolved.stdout.strip() else None

    def identity(path):
        try:
            stat = path.stat()
            return (stat.st_dev, stat.st_ino, stat.st_mtime_ns, stat.st_size)
        except (OSError, AttributeError):
            return None

    # Both add (clean filters) and commit (hooks) include external stderr.
    # Text alone is not a native lock receipt. Require the same lock before
    # and after the command; disappeared/replaced locks retain error budget.
    before_path = native_lock()
    before_identity = identity(before_path) if before_path else None
    result = subprocess.run(command, text=True, capture_output=True, check=False)
    if result.stdout:
        print(result.stdout, end="")
    if result.stderr:
        print(result.stderr, end="", file=sys.stderr)
    if result.returncode:
        lock_path = native_lock()
        expected = f"fatal: Unable to create '{lock_path}': File exists."
        verified = (before_identity is not None
                    and lock_path == before_path
                    and identity(lock_path) == before_identity)
        if lock_path is not None and verified and expected in result.stderr.splitlines():
            print("HERDR_COMMIT_RESULT=" + json.dumps({
                "task_id": task_id, "result": "wait", "reason": "git_index_lock",
            }))
            sys.exit(75)
    return result


